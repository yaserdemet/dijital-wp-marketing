@{
    ViewData["Title"] = "Yorum Taşıma";
}

@Html.AntiForgeryToken()

<style>
    .store-item {
        transition: background .15s ease, border-color .15s ease;
        cursor: pointer;
        border-left: 3px solid transparent;
    }

    .store-item:hover {
        background-color: #f0f7ff;
    }

    .store-item.active {
        background-color: #eff6ff;
        border-left-color: #2563eb;
    }

    .product-select-card {
        border: 1.5px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 0.875rem;
        cursor: pointer;
        transition: all .15s ease;
        background: #fff;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .product-select-card:hover {
        border-color: #93c5fd;
        background: #f0f7ff;
    }

    .product-select-card.selected {
        border-color: #2563eb;
        background: #eff6ff;
    }

    .select-indicator {
        width: 1.125rem;
        height: 1.125rem;
        border-radius: 50%;
        border: 2px solid #d1d5db;
        background: #fff;
        flex-shrink: 0;
        margin-top: 0.125rem;
        transition: all .15s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-select-card.selected .select-indicator {
        background: #2563eb;
        border-color: #2563eb;
    }

    .product-select-card.selected .select-indicator::after {
        content: "";
        display: block;
        width: 4px;
        height: 7px;
        border: 2px solid white;
        border-top: none;
        border-left: none;
        transform: rotate(45deg) translate(-1px, -1px);
    }

    .star-filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.875rem;
        border-radius: 0.625rem;
        border: 1.5px solid #e5e7eb;
        font-size: 0.8125rem;
        font-weight: 500;
        color: #374151;
        background: #fff;
        cursor: pointer;
        transition: all .15s ease;
    }

    .star-filter-btn:hover {
        border-color: #93c5fd;
        background: #f0f7ff;
    }

    .star-filter-btn.selected {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        border-color: #3b82f6;
        color: white;
    }

    .star-filter-btn.selected .star-yellow {
        color: white;
    }

    .wf-step-circle {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        font-size: 0.8125rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f3f4f6;
        color: #9ca3af;
        margin: 0 auto 0.5rem;
        transition: all .3s ease;
        position: relative;
        z-index: 1;
    }

    .wf-step.done .wf-step-circle {
        background: #d1fae5;
        color: #059669;
    }

    .wf-step.active .wf-step-circle {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: white;
        box-shadow: 0 4px 12px rgba(59, 130, 246, .35);
    }

    .wf-step.done .wf-label,
    .wf-step.active .wf-label {
        color: #111827;
        font-weight: 600;
    }

    .badge-pending {
        background: #fef9c3;
        color: #92400e;
    }

    .badge-running {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-completed {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-failed {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-cancelled {
        background: #f3f4f6;
        color: #6b7280;
    }
</style>

<main class="min-h-screen bg-gray-50/50 pb-20">

    <!-- STICKY HEADER -->
    <div class="sticky top-2 lg:top-4 z-20 px-2 lg:px-6 mb-6">
        <div
            class="max-w-[1600px] mx-auto flex flex-col md:flex-row items-center justify-between gap-3 bg-white/90 backdrop-blur-md border border-gray-200 rounded-2xl shadow-sm px-4 py-3 lg:px-6 lg:py-4">
            <div class="flex items-center gap-3 lg:gap-4 w-full md:w-auto">
                <div
                    class="p-2.5 bg-gradient-to-br from-yellow-400 to-orange-400 rounded-xl text-white shadow-sm flex-shrink-0">
                    <i class="fas fa-star text-lg"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-lg lg:text-xl font-bold text-gray-900 truncate">Yorum Taşıma</h2>
                    <div class="text-xs text-gray-500">Trendyol ürün yorumlarını otomatik aktarın</div>
                </div>
            </div>
            <div class="hidden md:flex items-center gap-2">
                <span
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-600 bg-gray-100 rounded-lg px-3 py-1.5">
                    <i class="fas fa-store text-gray-400 text-[10px]"></i>
                    <span id="headerStoreCount">—</span> mağaza
                </span>
                <span
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-600 bg-gray-100 rounded-lg px-3 py-1.5">
                    <i class="fas fa-box text-gray-400 text-[10px]"></i>
                    <span id="headerProductCount">—</span> ürün
                </span>
                <span id="activeJobsBadge"
                    class="hidden items-center gap-1.5 text-xs font-semibold text-blue-700 bg-blue-50 rounded-lg px-3 py-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
                    <span id="headerActiveJobs">0</span> aktif iş
                </span>

                <!-- QUOTA ICON BUTTON -->
                <div class="relative" id="quotaIconWrapper" style="display:none">
                    <button id="quotaIconBtn" onclick="toggleQuotaPopover()"
                        class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#02379c] bg-[#02379c]/8 hover:bg-[#02379c]/15 border border-[#02379c]/20 rounded-lg px-3 py-1.5 transition-all"
                        title="Paket kullanım durumu">
                        <i class="fas fa-box-open text-[10px]"></i>
                        <span id="quotaHeaderPct">—</span>% kaldı
                    </button>
                    <!-- POPOVER -->
                    <div id="quotaPopover"
                        class="hidden absolute right-0 top-full mt-2 w-72 bg-white rounded-2xl shadow-xl border border-gray-100 p-4 z-50">
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 bg-[#02379c]/10 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-box-open text-[#02379c] text-xs"></i>
                                </div>
                                <div>
                                    <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-wide">Aktif
                                        Paket</p>
                                    <p class="text-sm font-bold text-gray-900" id="popoverPackageName">—</p>
                                </div>
                            </div>
                            <button onclick="toggleQuotaPopover()"
                                class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-gray-100 text-gray-400 hover:text-gray-600 transition-all">
                                <i class="fas fa-times text-[10px]"></i>
                            </button>
                        </div>
                        <div class="mb-3">
                            <div class="flex items-center justify-between text-[11px] text-gray-500 mb-1.5">
                                <span><strong class="text-gray-800" id="popoverRemaining">—</strong> kullanım
                                    kaldı</span>
                                <span id="popoverTotal" class="text-gray-400">— toplam</span>
                            </div>
                            <div class="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden">
                                <div id="popoverBar" class="h-2.5 rounded-full bg-[#02379c] transition-all duration-700"
                                    style="width:0%"></div>
                            </div>
                            <p class="text-right text-[10px] text-gray-400 mt-1" id="popoverPctText">— kullanıldı</p>
                        </div>
                        <a href="@Url.Action("Index", "Store")"
                            class="flex items-center justify-center gap-1.5 w-full py-2 bg-[#02379c] hover:bg-[#001f5c] text-white text-xs font-semibold rounded-xl transition-all">
                            <i class="fas fa-plus text-[9px]"></i> Paket Yükselt / Yenile
                        </a>
                    </div>
                </div>
            </div>
            <button onclick="openAddStoreModal()"
                class="flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-gray-900 rounded-xl hover:bg-black shadow-sm transition-all whitespace-nowrap w-full md:w-auto">
                <i class="fas fa-plus text-xs"></i> Yeni Mağaza Ekle
            </button>
        </div>
    </div>

    <div class="max-w-[1600px] mx-auto px-2 lg:px-6">

        <!-- STATS CARDS -->

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-store text-blue-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Mağazalar</p>
                    <p class="text-2xl font-extrabold text-gray-900" id="statStoreCount">—</p>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-box-open text-purple-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Senkronize Ürün</p>
                    <p class="text-2xl font-extrabold text-gray-900" id="statProductCount">—</p>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-yellow-50 rounded-xl flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-circle-notch fa-spin text-yellow-500 text-xl" id="activeJobsSpinner"
                        style="display:none"></i>
                    <i class="fas fa-tasks text-yellow-600 text-xl" id="activeJobsIcon"></i>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Aktif İşler</p>
                    <p class="text-2xl font-extrabold text-gray-900" id="statActiveJobs">—</p>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-check-circle text-green-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Tamamlanan</p>
                    <p class="text-2xl font-extrabold text-gray-900" id="statCompletedJobs">—</p>
                </div>
            </div>
        </div>

