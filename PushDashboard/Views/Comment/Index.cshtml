                </div>
            </div>
        </div>

        <!-- TRANSFER JOBS -->
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-yellow-50 rounded-xl flex items-center justify-center">
                        <i class="fas fa-tasks text-yellow-600"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-gray-900">Transfer İşleri</h3>
                        <p class="text-xs text-gray-400">Tüm aktarım geçmişi ve canlı ilerleme durumu</p>
                    </div>
                </div>
                <button onclick="loadTransferJobs()"
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500 bg-gray-50 hover:bg-gray-100 rounded-lg px-3 py-2 transition-colors">
                    <i class="fas fa-sync-alt text-[10px]"></i> Yenile
                </button>
            </div>
            <div class="p-6">
                <div id="transfersLoading" class="flex flex-col items-center justify-center py-12">
                    <div
                        class="w-8 h-8 border-[3px] border-blue-600 border-t-transparent rounded-full animate-spin mb-3">
                    </div>
                    <p class="text-sm text-gray-400">Transfer işleri yükleniyor...</p>
                </div>
                <div id="transfersEmpty" class="hidden flex flex-col items-center justify-center py-12 text-center">
                    <div class="w-16 h-16 bg-gray-100 rounded-2xl flex items-center justify-center mb-5">
                        <i class="fas fa-inbox text-gray-300 text-2xl"></i>
                    </div>
                    <h4 class="text-sm font-semibold text-gray-700 mb-1">Henüz transfer işi yok</h4>
                    <p class="text-xs text-gray-400">Ürün seçip transfer başlattığınızda burada takip edebilirsiniz.</p>
                </div>
                <div id="transfersList" class="hidden space-y-3"></div>
            </div>
        </div>

    </div>
</main>

<!-- MODAL: Add New Store -->
<div id="addStoreModal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm" onclick="closeAddStoreModal()"></div>
    <div class="fixed inset-0 z-10 flex items-center justify-center p-4">
        <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden">
            <div class="bg-gray-50/50 border-b border-gray-100 px-6 py-5 flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Yeni Mağaza Ekle</h3>
                    <p class="text-xs text-gray-400 mt-0.5">Trendyol mağaza bilgilerini girin</p>
                </div>
                <button onclick="closeAddStoreModal()"
                    class="w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center text-gray-400 hover:text-gray-600 transition-all">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>
            <form id="addStoreForm" class="p-6 space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Mağaza Adı</label>
                    <div class="relative">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
                            <i class="fas fa-tag text-gray-400 text-sm"></i>
                        </div>
                        <input type="text" id="storeName" name="storeName" required placeholder="Örn: Moda Dünyası"
                            class="block w-full rounded-xl border-0 py-3 pl-10 pr-4 text-gray-900 ring-1 ring-inset ring-gray-200 bg-gray-50/50 placeholder:text-gray-400 focus:ring-2 focus:ring-blue-600 focus:bg-white transition-all text-sm">
                    </div>
                    <p class="mt-1.5 text-xs text-gray-400">Size hatırlatmak için bir takma ad</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Mağaza URL'si</label>
                    <div class="relative">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
                            <i class="fas fa-link text-gray-400 text-sm"></i>
                        </div>
                        <input type="url" id="storeUrl" name="storeUrl" required
                            placeholder="https://www.trendyol.com/magaza/..."
                            class="block w-full rounded-xl border-0 py-3 pl-10 pr-4 text-gray-900 ring-1 ring-inset ring-gray-200 bg-gray-50/50 placeholder:text-gray-400 focus:ring-2 focus:ring-blue-600 focus:bg-white transition-all text-sm">
                    </div>
                    <p class="mt-1.5 text-xs text-gray-400">Trendyol mağaza sayfasının tam adresi</p>
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="closeAddStoreModal()"
                        class="flex-1 py-3 rounded-xl text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 bg-white hover:bg-gray-50 transition-all">
                        Vazgeç
                    </button>
                    <button type="submit" id="addStoreSubmitBtn"
                        class="flex-1 py-3 rounded-xl text-sm font-semibold text-white bg-gray-900 hover:bg-black shadow-sm transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-plus text-xs"></i> Mağaza Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Transfer Settings -->
<div id="transferModal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm" onclick="closeTransferModal()"></div>
    <div class="fixed inset-0 z-10 flex items-center justify-center p-4">
        <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden">
            <div class="bg-gray-50/50 border-b border-gray-100 px-6 py-5 flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Transfer Ayarları</h3>
                    <p class="text-xs text-gray-400 mt-0.5">
                        <span id="transferProductCount" class="font-bold text-gray-700">0</span> ürün için yorum
                        aktarımı yapılacak
                    </p>
                </div>
                <button onclick="closeTransferModal()"
                    class="w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center text-gray-400 hover:text-gray-600 transition-all">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>
            <div class="p-6 space-y-6">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Ürün Başına Yorum Sayısı</label>
                    <div class="relative">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
                            <i class="fas fa-comment text-gray-400 text-sm"></i>
                        </div>
                        <input type="number" id="commentCount" value="100" min="10" max="1000"
                            class="block w-full rounded-xl border-0 py-3 pl-10 pr-4 text-gray-900 ring-1 ring-inset ring-gray-200 bg-gray-50/50 focus:ring-2 focus:ring-blue-600 focus:bg-white transition-all text-sm">
                    </div>
                    <p class="mt-1.5 text-xs text-gray-400">Minimum 10, maksimum 1000 yorum</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                        Yıldız Filtresi <span class="text-xs font-normal text-gray-400">(Opsiyonel)</span>
                    </label>
                    <p class="text-xs text-gray-400 mb-3">Boş bırakırsanız tüm yıldızlardan aktarır.</p>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="star-filter-btn" data-star="1"><span
                                class="star-yellow text-yellow-400">★</span> 1</button>
                        <button type="button" class="star-filter-btn" data-star="2"><span
                                class="star-yellow text-yellow-400">★★</span> 2</button>
                        <button type="button" class="star-filter-btn" data-star="3"><span
                                class="star-yellow text-yellow-400">★★★</span> 3</button>
                        <button type="button" class="star-filter-btn" data-star="4"><span
                                class="star-yellow text-yellow-400">★★★★</span> 4</button>
                        <button type="button" class="star-filter-btn" data-star="5"><span
                                class="star-yellow text-yellow-400">★★★★★</span> 5</button>
                    </div>
                </div>
                <div class="border-t border-gray-100 pt-5">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <div class="flex items-center pt-0.5">
                            <input type="checkbox" id="autoSync"
                                class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                        </div>
                        <div>
                            <span class="block text-sm font-semibold text-gray-800">Otomatik Aktarım</span>
                            <span class="text-xs text-gray-400 leading-relaxed">Bu seçenek aktifken sistem bu ayarları
                                hafızaya alır ve Trendyol'a gelen yeni yorumları otomatik olarak aktarmaya devam
                                eder.</span>
                        </div>
                    </label>
                </div>
            </div>
            <div class="px-6 pb-6 flex gap-3">
                <button type="button" onclick="closeTransferModal()"
                    class="flex-1 py-3 rounded-xl text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 bg-white hover:bg-gray-50 transition-all">
                    İptal
                </button>
                <button type="button" id="confirmTransferBtn" onclick="confirmTransfer()"
                    class="flex-1 py-3 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 shadow-sm transition-all flex items-center justify-center gap-2">
                    <i class="fas fa-download text-xs"></i> Transfer Başlat
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStoreId = null;
        let selectedProducts = new Set();
        let allStores = [];

        $(document).ready(function () {
            loadStores();
            loadTransferJobs();
            loadQuotaInfo();
            $('#commentCount').on('input', function () {
                const v = parseInt($(this).val());
                if (v < 10) $(this).val(10);
                if (v > 1000) $(this).val(1000);
            });
            $(document).on('click', '.star-filter-btn', function () { $(this).toggleClass('selected'); });
            setInterval(loadTransferJobs, 30000);
        });

        function loadQuotaInfo() {
            $.ajax({
                url: '@Url.Action("GetQuotaInfo")', type: 'GET',
                success: function (r) {
                    if (!r.success || !r.data) return;
                    const d = r.data;
                    const total = d.totalQuota || 0;
                    const remaining = d.remainingQuota || 0;
                    const pct = total > 0 ? Math.round((remaining / total) * 100) : 0;
                    const usedPct = 100 - pct;
                    const barColor = pct > 50 ? 'bg-[#02379c]' : (pct > 20 ? 'bg-orange-400' : 'bg-red-500');

                    // Header icon button
                    $('#quotaHeaderPct').text(pct);
                    $('#quotaIconWrapper').show();

                    // Popover content
                    $('#popoverPackageName').text(d.packageName || 'Paket');
                    $('#popoverRemaining').text(remaining.toLocaleString('tr-TR'));
                    $('#popoverTotal').text(total.toLocaleString('tr-TR') + ' toplam');
                    $('#popoverBar').css('width', pct + '%')
                                   .removeClass('bg-[#02379c] bg-orange-400 bg-red-500')
                                   .addClass(barColor);
                    $('#popoverPctText').text('%' + usedPct + ' kullanıldı');
                }
            });
        }

        function toggleQuotaPopover() {
            const popover = $('#quotaPopover');
            popover.toggleClass('hidden');
        }

        // Close popover when clicking outside
        $(document).on('click', function(e) {
            if (!$(e.target).closest('#quotaIconWrapper').length) {
                $('#quotaPopover').addClass('hidden');
            }
        });

        function highlightWorkflowStep(step) {
            for (let i = 1; i <= 5; i++) {
                const el = document.getElementById('wf' + i);
                if (!el) continue;
                el.classList.remove('active', 'done');
                if (i < step) el.classList.add('done');
                else if (i === step) el.classList.add('active');
            }
        }

        function loadStores() {
            $('#storesLoading').show();
            $('#storesList, #storesEmpty').hide();
            $.ajax({
                url: '@Url.Action("GetStores")', type: 'GET',
                success: function (r) {
                    $('#storesLoading').hide();
                    if (r.success && r.data.length > 0) {
                        allStores = r.data;
                        renderStores(r.data);
                        $('#storesList').show();
                    } else {
                        allStores = [];
                        $('#storesEmpty').show();
                        highlightWorkflowStep(1);
                    }
                    updateStatCards();
                },
                error: function () { $('#storesLoading').hide(); showNotification('Mağazalar yüklenirken hata oluştu.', 'error'); }
            });
        }

        function renderStores(stores) {
            const c = $('#storesList').empty();
            $('#storeCountBadge, #statStoreCount, #headerStoreCount').text(stores.length);
            const sm = {
                Syncing: { cls: 'text-blue-600 bg-blue-50', icon: 'fa-sync fa-spin', lbl: 'Senkronize ediliyor' },
                Synced: { cls: 'text-green-600 bg-green-50', icon: 'fa-check-circle', lbl: 'Senkronize' },
                Failed: { cls: 'text-red-500 bg-red-50', icon: 'fa-exclamation-circle', lbl: 'Hata' },
                Pending: { cls: 'text-yellow-600 bg-yellow-50', icon: 'fa-clock', lbl: 'Bekliyor' }
            };
            stores.forEach(s => {
                const si = sm[s.syncStatus] || { cls: 'text-gray-500 bg-gray-50', icon: 'fa-minus', lbl: s.syncStatus };
                c.append(`<div class="store-item px-5 py-4 flex items-center gap-3 group" data-store-id="${s.id}"
                              onclick="selectStore(${s.id},'${escapeHtml(s.storeName || 'Mağaza')}')">
                    <div class="w-9 h-9 bg-gray-100 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-blue-100 transition-colors">
                        <i class="fas fa-store text-gray-500 text-sm group-hover:text-blue-600 transition-colors"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-gray-900 truncate">${escapeHtml(s.storeName || 'Mağaza')}</p>
                        <div class="flex items-center gap-2 mt-0.5">
                            <span class="inline-flex items-center gap-1 text-[10px] font-medium px-1.5 py-0.5 rounded-md ${si.cls}">
                                <i class="fas ${si.icon} text-[9px]"></i> ${si.lbl}
                            </span>
                            ${s.productCount ? `<span class="text-[10px] text-gray-400">${s.productCount} ürün</span>` : ''}
                        </div>
                        ${s.errorMessage ? `<p class="text-[10px] text-red-500 mt-0.5 truncate">${escapeHtml(s.errorMessage)}</p>` : ''}
                    </div>
                    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity" onclick="event.stopPropagation()">
                        <button onclick="syncStore(${s.id})" title="Senkronize et"
                                class="w-7 h-7 rounded-lg flex items-center justify-center text-gray-400 hover:bg-blue-50 hover:text-blue-600 transition-all"
                                ${s.syncStatus === 'Syncing' ? 'disabled' : ''}>
                            <i class="fas fa-sync-alt text-xs ${s.syncStatus === 'Syncing' ? 'fa-spin' : ''}"></i>
                        </button>
                        <button onclick="deleteStore(${s.id})" title="Sil"
                                class="w-7 h-7 rounded-lg flex items-center justify-center text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all">
                            <i class="fas fa-trash-alt text-xs"></i>
                        </button>
                    </div>
                    <i class="fas fa-chevron-right text-gray-200 text-xs flex-shrink-0"></i>
                </div>`);
            });
            if (currentStoreId && stores.find(s => s.id === currentStoreId))
                $(`[data-store-id="${currentStoreId}"]`).addClass('active');
        }

        function selectStore(storeId, storeName) {
            currentStoreId = storeId;
            $('.store-item').removeClass('active');
            $(`[data-store-id="${storeId}"]`).addClass('active');
            const store = allStores.find(s => s.id === storeId);
            const hasProducts = store && store.productCount > 0;
            openProductsPanel(storeId, storeName, !hasProducts);
            highlightWorkflowStep(hasProducts ? 3 : 2);
        }

        function syncStore(storeId) {
            showNotification('Senkronizasyon başlatılıyor...', 'info');
            $.ajax({
                url: '@Url.Action("SyncStoreProducts")', type: 'POST',
                data: JSON.stringify({ storeId: storeId, productCount: 100 }),
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (r) {
                    r.success ? (showNotification('Senkronizasyon başlatıldı.', 'success'), setTimeout(loadStores, 2000))
                        : showNotification(r.message, 'error');
                },
                error: function () { showNotification('Senkronizasyon başlatılırken hata oluştu.', 'error'); }
            });
        }

        function deleteStore(storeId) {
            showConfirmationDialog('Mağazayı Sil', 'Bu mağazayı silmek istediğinizden emin misiniz?', 'Evet, Sil', 'İptal', () => {
                $.ajax({
                    url: '@Url.Action("DeleteStore")', type: 'POST',
                    data: JSON.stringify({ storeId: storeId }),
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (r) {
                        if (r.success) {
                            showNotification('Mağaza silindi.', 'success');
                            if (currentStoreId === storeId) closeProductsPanel();
                            loadStores();
                        } else showNotification(r.message, 'error');
                    },
                    error: function () { showNotification('Mağaza silinirken hata oluştu.', 'error'); }
                });
            });
        }

        function openAddStoreModal() { $('#addStoreForm')[0].reset(); $('#addStoreModal').removeClass('hidden'); }
        function closeAddStoreModal() { $('#addStoreModal').addClass('hidden'); }

        $('#addStoreForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $('#addStoreSubmitBtn');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin text-xs"></i> Ekleniyor...');
            $.ajax({
                url: '@Url.Action("CreateStore")', type: 'POST',
                data: JSON.stringify({ storeUrl: $('#storeUrl').val(), storeName: $('#storeName').val() }),
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (r) {
                    btn.prop('disabled', false).html('<i class="fas fa-plus text-xs"></i> Mağaza Ekle');
                    if (r.success) { showNotification('Mağaza başarıyla eklendi.', 'success'); closeAddStoreModal(); loadStores(); highlightWorkflowStep(2); }
                    else showNotification(r.message, 'error');
                },
                error: function () { btn.prop('disabled', false).html('<i class="fas fa-plus text-xs"></i> Mağaza Ekle'); showNotification('Hata oluştu.', 'error'); }
            });
        });

        function openProductsPanel(storeId, storeName, noProducts) {
            selectedProducts.clear(); updateTransferButton();
            $('#productsEmptyState').addClass('hidden');
            $('#productsPanel').removeClass('hidden');
            $('#productsPanelTitle').text(storeName);
            if (noProducts) {
                $('#productsLoading').hide();
                $('#productsPanelSubtitle').text('Ürünler henüz senkronize edilmemiş');
                $('#productsGrid').html(`
                    <div class="col-span-full flex flex-col items-center justify-center py-12 text-center">
                        <div class="w-14 h-14 bg-yellow-50 rounded-full flex items-center justify-center mb-4">
                            <i class="fas fa-sync-alt text-yellow-500 text-xl"></i>
                        </div>
                        <h4 class="text-sm font-semibold text-gray-700 mb-2">Ürünler senkronize edilmemiş</h4>
                        <p class="text-xs text-gray-400 mb-4 max-w-xs">Ürünleri görmek için önce senkronizasyon başlatın.</p>
                        <button onclick="syncStore(${storeId})"
                                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-all shadow-sm">
                            <i class="fas fa-sync-alt text-xs"></i> Ürünleri Senkronize Et
                        </button>
                    </div>`).show();
                return;
            }
            $('#productsLoading').show(); $('#productsGrid').hide();
            $('#productsPanelSubtitle').text('Aktarmak istediğiniz ürünleri seçin');
            $.ajax({
                url: '@Url.Action("GetStoreProducts")', type: 'GET',
                data: { storeId: storeId, pageSize: 100 },
                success: function (r) {
                    $('#productsLoading').hide();
                    r.success ? renderProductGrid(r.data.products, r.data.stats)
                        : $('#productsGrid').html(`<div class="col-span-full text-center py-8 text-sm text-red-500">${escapeHtml(r.message)}</div>`).show();
                },
                error: function () { $('#productsLoading').hide(); $('#productsGrid').html('<div class="col-span-full text-center py-8 text-sm text-red-500">Ürünler yüklenirken hata oluştu.</div>').show(); }
            });
        }

        function renderProductGrid(products, stats) {
            const grid = $('#productsGrid').empty();
            if (!products || products.length === 0) {
                grid.html('<div class="col-span-full flex flex-col items-center justify-center py-12 text-center"><i class="fas fa-box-open text-gray-200 text-4xl mb-3"></i><p class="text-sm text-gray-400">Bu mağazada ürün bulunamadı.</p></div>').show();
                return;
            }
            if (stats) { $('#productsPanelSubtitle').text(`${stats.totalProducts} ürün bulundu`); }
            products.forEach(p => {
                grid.append(`<div class="product-select-card" data-product-id="${p.id}" onclick="toggleProduct(${p.id},this)">
                    <div class="select-indicator"></div>
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-semibold text-gray-900 leading-snug line-clamp-2" title="${escapeHtml(p.title)}">${escapeHtml(p.shortTitle)}</p>
                        <p class="text-[10px] text-gray-400 mt-1">ID: ${p.productId}</p>
                        <a href="${p.fullUrl}" target="_blank" onclick="event.stopPropagation()"
                           class="inline-flex items-center gap-0.5 text-[10px] font-medium text-blue-500 hover:text-blue-700 mt-1 transition-colors">
                            Görüntüle <i class="fas fa-external-link-alt" style="font-size:9px"></i>
                        </a>
                    </div>
                </div>`);
            });
            grid.show();
        }

        function closeProductsPanel() {
            $('#productsPanel').addClass('hidden');
            $('#productsEmptyState').removeClass('hidden');
            $('.store-item').removeClass('active');
            currentStoreId = null; selectedProducts.clear(); updateTransferButton();
            highlightWorkflowStep(allStores.length > 0 ? 2 : 1);
        }

        function toggleProduct(id, el) {
            selectedProducts.has(id) ? (selectedProducts.delete(id), $(el).removeClass('selected'))
                : (selectedProducts.add(id), $(el).addClass('selected'));
            updateTransferButton();
        }
        function selectAllProducts() {
            $('.product-select-card').each(function () { selectedProducts.add(parseInt($(this).data('product-id'))); $(this).addClass('selected'); });
            updateTransferButton();
        }
        function clearProductSelection() { selectedProducts.clear(); $('.product-select-card').removeClass('selected'); updateTransferButton(); }
        function updateTransferButton() {
            const n = selectedProducts.size;
            $('#selectedProductCount').text(n);
            $('#startTransferBtn').prop('disabled', n === 0);
            if (n > 0) highlightWorkflowStep(4);
            else if (currentStoreId) highlightWorkflowStep(3);
        }

        function showTransferModal() {
            if (selectedProducts.size === 0) { showNotification('Lütfen en az bir ürün seçin.', 'warning'); return; }
            $('#transferProductCount').text(selectedProducts.size);
            $('#commentCount').val(100); $('#autoSync').prop('checked', false);
            $('.star-filter-btn').removeClass('selected');
            $('#transferModal').removeClass('hidden');
        }
        function closeTransferModal() { $('#transferModal').addClass('hidden'); }

        function confirmTransfer() {
            const cnt = parseInt($('#commentCount').val());
            if (cnt < 10 || cnt > 1000) { showNotification('Yorum sayısı 10-1000 arasında olmalıdır.', 'warning'); return; }
            const stars = [];
            $('.star-filter-btn.selected').each(function () { stars.push(parseInt($(this).data('star'))); });
            const btn = $('#confirmTransferBtn');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin text-xs"></i> Başlatılıyor...');
            $.ajax({
                url: '@Url.Action("TransferSelectedProducts")', type: 'POST',
                data: JSON.stringify({ storeId: currentStoreId, productIds: Array.from(selectedProducts), commentCount: cnt, starRatings: stars.length > 0 ? stars : null, autoSync: $('#autoSync').is(':checked') }),
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function (r) {
                    btn.prop('disabled', false).html('<i class="fas fa-download text-xs"></i> Transfer Başlat');
                    if (r.success) { showNotification('Transfer başlatıldı!', 'success'); closeTransferModal(); closeProductsPanel(); highlightWorkflowStep(5); loadTransferJobs(); }
                    else showNotification(r.message, 'error');
                },
                error: function () { btn.prop('disabled', false).html('<i class="fas fa-download text-xs"></i> Transfer Başlat'); showNotification('Hata oluştu.', 'error'); }
            });
        }

        function loadTransferJobs() {
            $('#transfersLoading').show(); $('#transfersList, #transfersEmpty').hide();
            $.ajax({
                url: '@Url.Action("GetTransferJobs")', type: 'GET',
                success: function (r) {
                    $('#transfersLoading').hide();
                    if (r.success && r.data.length > 0) { renderTransferJobs(r.data); $('#transfersList').show(); updateJobStats(r.data); }
                    else { $('#transfersEmpty').show(); updateJobStats([]); }
                },
                error: function () { $('#transfersLoading').hide(); }
            });
        }

        function renderTransferJobs(jobs) {
            const c = $('#transfersList').empty();
            const sm = {
                Pending: { cls: 'badge-pending', icon: 'fa-clock', lbl: 'Bekliyor' },
                Running: { cls: 'badge-running', icon: 'fa-circle-notch fa-spin', lbl: 'Çalışıyor' },
                Completed: { cls: 'badge-completed', icon: 'fa-check', lbl: 'Tamamlandı' },
                Failed: { cls: 'badge-failed', icon: 'fa-times', lbl: 'Hata' },
                Cancelled: { cls: 'badge-cancelled', icon: 'fa-ban', lbl: 'İptal' }
            };
            jobs.forEach(job => {
                const s = sm[job.status] || { cls: 'badge-cancelled', icon: 'fa-minus', lbl: job.status };
                const dt = new Date(job.createdAt).toLocaleString('tr-TR');
                const active = job.status === 'Running' || job.status === 'Pending';
                const strip = job.status === 'Completed' ? 'bg-green-400' : active ? 'bg-blue-500' : job.status === 'Failed' ? 'bg-red-400' : 'bg-gray-200';
                c.append(`<div class="flex rounded-xl border border-gray-100 bg-white hover:border-gray-200 hover:shadow-sm transition-all overflow-hidden">
                    <div class="w-1 flex-shrink-0 ${strip}"></div>
                    <div class="flex-1 px-5 py-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1 flex-wrap">
                                    <span class="text-sm font-bold text-gray-900">${escapeHtml(job.jobTypeDisplay || job.jobType)}</span>
                                    <span class="inline-flex items-center gap-1 text-[10px] font-semibold px-2 py-0.5 rounded-full ${s.cls}">
                                        <i class="fas ${s.icon}" style="font-size:9px"></i> ${s.lbl}
                                    </span>
                                </div>
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-gray-400">
                                    <span><i class="fas fa-store text-[9px]"></i> ${escapeHtml(job.storeName || 'Bilinmeyen')}</span>
                                    ${job.totalProducts ? `<span><i class="fas fa-box text-[9px]"></i> ${job.totalProducts} ürün</span>` : ''}
                                    ${job.totalComments ? `<span><i class="fas fa-comment text-[9px]"></i> ${job.totalComments} yorum</span>` : ''}
                                    <span><i class="fas fa-calendar-alt text-[9px]"></i> ${dt}</span>
                                </div>
                                ${job.progressPercent ? `<div class="mt-3">
                                    <div class="flex items-center justify-between text-[10px] mb-1">
                                        <span class="text-gray-500">${escapeHtml(job.currentStep || 'İşleniyor...')}</span>
                                        <span class="font-bold text-gray-700">${job.progressPercent}%</span>
                                    </div>
                                    <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
                                        <div class="h-full rounded-full transition-all duration-500 ${job.status === 'Completed' ? 'bg-green-500' : 'bg-blue-500'}" style="width:${job.progressPercent}%"></div>
                                    </div>
                                </div>`: ''}
                                ${job.errorMessage ? `<p class="text-[11px] text-red-500 mt-2"><i class="fas fa-exclamation-circle text-[9px]"></i> ${escapeHtml(job.errorMessage)}</p>` : ''}
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                ${job.status === 'Completed' && job.jobType === 'Comments' ? `<a href="@Url.Action("TransferJobDetails")?jobId=${job.id}" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors"><i class="fas fa-list text-[10px]"></i> Detaylar</a>` : ''}
                                ${job.resultFileUrl ? `<a href="${job.resultFileUrl}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-600 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors"><i class="fas fa-download text-[10px]"></i> İndir</a>` : ''}
                                ${active ? `<button onclick="cancelTransferJob(${job.id})" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors"><i class="fas fa-times text-[10px]"></i> İptal</button>` : ''}
                            </div>
                        </div>
                    </div>
                </div>`);
            });
        }

        function cancelTransferJob(jobId) {
            showConfirmationDialog('İptal Et', 'Bu transfer işini iptal etmek istediğinizden emin misiniz?', 'Evet, İptal Et', 'Hayır', () => {
                $.ajax({
                    url: '@Url.Action("CancelTransferJob")', type: 'POST',
                    data: JSON.stringify({ jobId: jobId }),
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (r) { r.success ? (showNotification('İptal edildi.', 'success'), loadTransferJobs()) : showNotification(r.message, 'error'); },
                    error: function () { showNotification('İptal sırasında hata oluştu.', 'error'); }
                });
            });
        }

        function updateStatCards() {
            $('#statStoreCount, #headerStoreCount').text(allStores.length);
            const tp = allStores.reduce((s, x) => s + (x.productCount || 0), 0);
            $('#statProductCount, #headerProductCount').text(tp);
        }

        function updateJobStats(jobs) {
            const active = jobs.filter(j => j.status === 'Running' || j.status === 'Pending').length;
            const done = jobs.filter(j => j.status === 'Completed').length;
            $('#statActiveJobs').text(active); $('#statCompletedJobs').text(done); $('#headerActiveJobs').text(active);
            if (active > 0) { $('#activeJobsBadge').css('display', 'inline-flex'); $('#activeJobsSpinner').show(); $('#activeJobsIcon').hide(); }
            else { $('#activeJobsBadge').hide(); $('#activeJobsSpinner').hide(); $('#activeJobsIcon').show(); }
        }

        function escapeHtml(str) {
            if (str == null) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
    </script>
}
