        <!-- MAIN 2-PANE: Stores + Products -->
        <div class="flex flex-col lg:flex-row gap-5 mb-6">

            <!-- LEFT: Store List -->
            <div class="w-full lg:w-[38%] xl:w-[32%] flex-shrink-0">
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden h-full flex flex-col">
                    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-store text-gray-600 text-sm"></i>
                            </div>
                            <span class="text-sm font-bold text-gray-900">Mağazalarım</span>
                        </div>
                        <span
                            class="text-xs font-semibold text-gray-500 bg-gray-100 rounded-full px-2.5 py-1 min-w-[1.75rem] text-center"
                            id="storeCountBadge">0</span>
                    </div>
                    <div class="flex-1 overflow-y-auto" style="max-height:520px;">
                        <div id="storesLoading" class="flex flex-col items-center justify-center py-16">
                            <div
                                class="w-8 h-8 border-[3px] border-blue-600 border-t-transparent rounded-full animate-spin mb-3">
                            </div>
                            <p class="text-sm text-gray-400">Yükleniyor...</p>
                        </div>
                        <div id="storesEmpty"
                            class="hidden flex flex-col items-center justify-center py-14 px-6 text-center">
                            <div class="w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                                <i class="fas fa-store-slash text-gray-300 text-2xl"></i>
                            </div>
                            <h4 class="text-sm font-semibold text-gray-700 mb-1">Henüz mağaza yok</h4>
                            <p class="text-xs text-gray-400 mb-4 leading-relaxed">Trendyol mağaza URL'nizi ekleyerek
                                başlayın.</p>
                            <button onclick="openAddStoreModal()"
                                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-700">
                                <i class="fas fa-plus text-[10px]"></i> İlk Mağazayı Ekle
                            </button>
                        </div>
                        <div id="storesList" class="hidden divide-y divide-gray-50"></div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Product Panel -->
            <div class="flex-1 min-w-0">
                <div id="productsEmptyState"
                    class="bg-white rounded-xl border border-gray-100 shadow-sm flex flex-col items-center justify-center text-center py-20 px-8 h-full min-h-[380px]">
                    <div
                        class="w-20 h-20 bg-gradient-to-br from-blue-50 to-indigo-100 rounded-2xl flex items-center justify-center mb-6">
                        <i class="fas fa-hand-point-left text-blue-400 text-3xl"></i>
                    </div>
                    <h3 class="text-base font-bold text-gray-800 mb-2">Bir mağaza seçin</h3>
