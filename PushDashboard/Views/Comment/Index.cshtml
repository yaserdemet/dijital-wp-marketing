                        <div class="flex items-start justify-between mb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 bg-purple-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-box-open text-purple-600 text-sm"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-bold text-gray-900" id="productsPanelTitle">Ürünler</h3>
                                    <p class="text-xs text-gray-400" id="productsPanelSubtitle">Aktarmak istediğiniz
                                        ürünleri seçin</p>
                                </div>
                            </div>
                            <button onclick="closeProductsPanel()"
                                class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center text-gray-300 hover:text-gray-600 transition-all">
