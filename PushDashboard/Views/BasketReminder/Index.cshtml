        // ================== LOGS FUNCTIONALITY ==================
        
        let logsCurrentPage = 1;
        let logsLoading = false;
        let logsAllLoaded = false;
        
        // Load logs with filters
        async function loadLogs(resetPage = false) {
            if (logsLoading || logsAllLoaded) return;
            
            if (resetPage) {
                logsCurrentPage = 1;
                logsAllLoaded = false;
                document.getElementById('logsContent').innerHTML = '';
            }
            
            logsLoading = true;
            showLogsLoading(true);
            
            try {
                const scheduleId = document.getElementById('filterSchedule').value;
                const status = document.getElementById('filterStatus').value;
                const startDate = document.getElementById('filterStartDate').value;
                const endDate = document.getElementById('filterEndDate').value;
                
                const params = new URLSearchParams({
                    page: logsCurrentPage,
                    pageSize: 20
                });
                
                if (scheduleId) params.append('scheduleId', scheduleId);
                if (status !== '') params.append('isSuccessful', status);
                if (startDate) params.append('startDate', startDate);
                if (endDate) params.append('endDate', endDate);
                
                const response = await fetch(`/BasketReminder/GetScheduleLogs?${params.toString()}`);
                const data = await response.json();
                
                if (data.success) {
                    if (data.logs.length === 0 && logsCurrentPage === 1) {
                        showEmptyLogsState();
                    } else {
                        appendLogs(data.logs);
                        
                        // Check if there are more pages based on hasMore flag
                        if (!data.hasMore) {
                            logsAllLoaded = true;
                            document.getElementById('loadMoreContainer').classList.add('hidden');
                        } else {
                            document.getElementById('loadMoreContainer').classList.remove('hidden');
                        }
                    }
                } else {
                    showNotification('Loglar yüklenirken hata oluştu: ' + data.message, 'error');
                }
            } catch (error) {
                console.error('Error loading logs:', error);
                showNotification('Loglar yüklenirken hata oluştu.', 'error');
            } finally {
                logsLoading = false;
                showLogsLoading(false);
            }
        }
        
        // Initialize global logs store
        window.basketReminderLogs = window.basketReminderLogs || {};

        function appendLogs(logs) {
            const container = document.getElementById('logsContent');
            
            // Create table if first load
            if (logsCurrentPage === 1 && container.innerHTML.trim() === '') {
                container.innerHTML = `
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tarih</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Hatırlatma</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Müşteri</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sepet ID</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Durum</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Detay</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200" id="logsTableBody">
                        </tbody>
                    </table>
                `;
            }
            
            const tbody = document.getElementById('logsTableBody');
            
            logs.forEach(log => {
                // Store log in global object
                window.basketReminderLogs[log.id || log.Id] = log;

                const row = document.createElement('tr');
                row.className = 'hover:bg-gray-50';
                
                const formattedDate = new Date(log.sentAt).toLocaleString('tr-TR', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
                });
                
                row.innerHTML = `
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${formattedDate}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                        ${log.scheduleName || '-'}
                        <div class="text-xs text-gray-500">${log.reminderTimeText}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">${log.customerName || 'Bilinmiyor'}</div>
                        <div class="text-sm text-gray-500">${log.customerEmail || '-'}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${log.basketExternalId}</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${log.statusBadgeClass}">
                            ${log.statusText}
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                        <button onclick="showLogDetail('${log.id || log.Id}')" class="text-blue-600 hover:text-blue-900">
                            Görüntüle
                        </button>
                    </td>
                `;
                
                tbody.appendChild(row);
            });
        }
        
