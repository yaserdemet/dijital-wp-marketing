@model PushDashboard.ViewModels.SettingsViewModel

<div id="payment" class="tab-content">
    <!-- Kredi Bakiyesi ve Yükleme Alanı -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
        <div class="flex flex-col md:flex-row justify-between items-center">
            <div class="mb-4 md:mb-0">
                <h3 class="text-lg font-semibold text-gray-800">Mevcut Kredi Bakiyesi</h3>
                <p class="text-3xl font-bold text-primary mt-2">
                    <span id="current-credit-balance">₺0.00</span>
                </p>
            </div>
            <button onclick="openAddCreditModal()" class="px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-primary-dark transition-colors flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Kredi Yükle
            </button>
        </div>
    </div>

    <!-- Kayıtlı Kartlar -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-semibold text-gray-800">Kayıtlı Kartlarım</h3>
        </div>
        
        <div id="saved-cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Kartlar JS ile buraya yüklenecek -->
            <div class="flex justify-center items-center p-8 text-gray-500 w-full col-span-full">
                <svg class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
        </div>
    </div>

    <!-- İşlem Geçmişi -->
    <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-6">Kredi İşlem Geçmişi</h3>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tarih</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">İşlem</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Açıklama</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tutar</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Durum</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bakiye</th>
                    </tr>
                </thead>
                <tbody id="transaction-history-body" class="bg-white divide-y divide-gray-200">
                    <!-- İşlemler JS ile buraya yüklenecek -->
                </tbody>
            </table>
        </div>
        <!-- Pagination controls can be added here -->
        <div id="transaction-pagination" class="mt-4 flex justify-end space-x-2"></div>
    </div>
</div>

<!-- Kredi Yükleme Modalı -->
<div id="add-credit-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-900/40 transition-opacity" aria-hidden="true" onclick="closeAddCreditModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.08)] border border-gray-200 transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">Kredi Yükle</h3>
                        <div class="mt-4 space-y-4">
                            <!-- Tutar Seçimi -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Yüklenecek Tutar (₺)</label>
                                <div class="grid grid-cols-3 gap-2 mb-2">
                                    <button type="button" onclick="selectAmount(100)" class="amount-btn px-4 py-2 border rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary">100 ₺</button>
                                    <button type="button" onclick="selectAmount(250)" class="amount-btn px-4 py-2 border rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary">250 ₺</button>
                                    <button type="button" onclick="selectAmount(500)" class="amount-btn px-4 py-2 border rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary">500 ₺</button>
                                </div>
                                <input type="number" id="custom-amount" placeholder="Farklı Tutar Giriniz" min="10" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-primary focus:border-primary sm:text-sm">
                                <p class="text-xs text-gray-500 mt-1">Minimum yükleme tutarı 10 ₺'dir.</p>
                            </div>

                            <!-- Ödeme Yöntemi Seçimi -->
                            <div class="mt-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Ödeme Yöntemi</label>
                                <select id="payment-method-select" onchange="togglePaymentForm()" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md">
                                    <option value="new_card">Yeni Kart ile Öde</option>
                                    <!-- Kayıtlı kartlar JS ile buraya eklenecek -->
                                </select>
                            </div>

                            <!-- Yeni Kart Formu -->
                            <div id="new-card-form" class="mt-4 space-y-3 bg-gray-50 p-4 rounded-md">
                                <div>
                                    <label class="block text-xs font-medium text-gray-700">Kart Sahibi</label>
                                    <input type="text" id="card-holder" class="mt-1 block w-full border-gray-300 rounded-md focus:ring-primary focus:border-primary sm:text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-700">Kart Numarası</label>
                                    <input type="text" id="card-number" placeholder="**** **** **** ****" class="mt-1 block w-full border-gray-300 rounded-md focus:ring-primary focus:border-primary sm:text-sm">
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-xs font-medium text-gray-700">Son Kullanma (Ay/Yıl)</label>
                                        <div class="flex space-x-2">
                                            <input type="text" id="expiry-month" placeholder="AA" maxlength="2" class="mt-1 block w-full border-gray-300 rounded-md focus:ring-primary focus:border-primary sm:text-sm">
                                            <input type="text" id="expiry-year" placeholder="YY" maxlength="2" class="mt-1 block w-full border-gray-300 rounded-md focus:ring-primary focus:border-primary sm:text-sm">
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-700">CVV</label>
                                        <input type="text" id="cvv" placeholder="***" maxlength="4" class="mt-1 block w-full border-gray-300 rounded-md focus:ring-primary focus:border-primary sm:text-sm">
                                    </div>
                                </div>
                                <div class="flex items-center mt-2">
                                    <input id="store-card" type="checkbox" checked class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded">
                                    <label for="store-card" class="ml-2 block text-sm text-gray-900">
                                        Kartımı sonraki işlemler için kaydet
                                    </label>
                                </div>
                            </div>
                            
                            <!-- Kayıtlı Kart CVV Alanı (Gizli) -->
                            <div id="saved-card-cvv-area" class="mt-4 hidden p-4 bg-gray-50 rounded-md">
                                <label class="block text-sm font-medium text-gray-700">Güvenlik Kodu (CVV)</label>
                                <input type="text" id="saved-card-cvv" placeholder="***" maxlength="4" class="mt-1 block w-24 border-gray-300 rounded-md focus:ring-primary focus:border-primary sm:text-sm p-2">
                                <p class="text-xs text-gray-500 mt-1">İşlemi tamamlamak için lütfen kartınızın güvenlik kodunu giriniz.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                <button type="button" onclick="processPayment()" class="w-full inline-flex justify-center rounded-md border border-transparent px-4 py-2 bg-primary text-base font-medium text-white hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary sm:ml-3 sm:w-auto sm:text-sm">
                    Ödeme Yap
                </button>
                <button type="button" onclick="closeAddCreditModal()" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                    İptal
                </button>
            </div>
        </div>
    </div>
</div>
