@model PushDashboard.ViewModels.SettingsViewModel

<!-- Profil Bilgileri -->
<div id="profile" class="tab-content active transition-all duration-300 ease-in-out">
  <div class="space-y-8">
    
    <!-- Kullanıcı Kartı -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <!-- Header -->
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
        <div>
          <h3 class="text-lg font-semibold text-gray-800">Kişisel Bilgiler</h3>
          <p class="text-sm text-gray-500">Hesabınıza ait temel kimlik ve iletişim bilgileri</p>
        </div>
        <div class="flex items-center space-x-2 bg-emerald-50 px-3 py-1 rounded-md border border-emerald-100">
          <div class="w-2 h-2 bg-emerald-400 rounded-full"></div>
          <span class="text-xs font-medium text-emerald-700">Hesap Aktif</span>
        </div>
      </div>

      <div class="p-6">
        @if (TempData["SuccessMessage"] != null)
        {
          <script>
            document.addEventListener('DOMContentLoaded', function() {
              showNotification('@Html.Raw(Html.Encode(TempData["SuccessMessage"]?.ToString()))', 'success');
            });
          </script>
        }
        @if (TempData["ErrorMessage"] != null)
        {
          <script>
            document.addEventListener('DOMContentLoaded', function() {
              showNotification('@Html.Raw(Html.Encode(TempData["ErrorMessage"]?.ToString()))', 'error');
            });
          </script>
        }

        <form id="user-profile-form">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-1">
              <label asp-for="UserProfile.FirstName" class="block text-sm font-medium text-gray-700">Ad</label>
              <div class="relative">
                <input asp-for="UserProfile.FirstName" class="block w-full px-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm" placeholder="Adınız">
              </div>
              <span asp-validation-for="UserProfile.FirstName" class="text-red-500 text-xs"></span>
            </div>
            
            <div class="space-y-1">
              <label asp-for="UserProfile.LastName" class="block text-sm font-medium text-gray-700">Soyad</label>
              <div class="relative">
                <input asp-for="UserProfile.LastName" class="block w-full px-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm" placeholder="Soyadınız">
              </div>
              <span asp-validation-for="UserProfile.LastName" class="text-red-500 text-xs"></span>
            </div>

            <div class="space-y-1">
              <label for="UserProfile_Email" class="block text-sm font-medium text-gray-700">E-posta Adresi</label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                  </svg>
                </div>
                <input id="UserProfile_Email" name="UserProfile.Email" type="email" value="@Model.UserProfile.Email" readonly 
                       class="block w-full pl-10 pr-4 py-2.5 bg-gray-100 text-gray-500 border border-gray-200 rounded-lg cursor-not-allowed text-sm">
              </div>
              <p class="text-xs text-gray-500 mt-1">E-posta adresi değiştirilemez.</p>
            </div>

            <div class="space-y-1">
              <label for="UserProfile_PhoneNumber" class="block text-sm font-medium text-gray-700">Telefon Numarası</label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <input id="UserProfile_PhoneNumber" name="UserProfile.PhoneNumber" type="tel" value="@Model.UserProfile.PhoneNumber" 
                       class="block w-full pl-10 pr-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm">
              </div>
            </div>
          </div>
          
          <div class="mt-6 flex justify-end">
            <button type="submit" class="px-6 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg transition-colors text-sm font-medium flex items-center gap-2">
              <i class="fas fa-save"></i>
              Değişiklikleri Kaydet
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Firma Bilgileri Kartı -->
    @if (Model.CanEditCompany)
    {
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
          <div>
            <h3 class="text-lg font-semibold text-gray-800">Firma Bilgileri</h3>
            <p class="text-sm text-gray-500">Şirketinizin iletişim ve adres bilgileri</p>
          </div>
        </div>
        
        <div class="p-6">
          <form id="company-profile-form">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-1">
                <label for="CompanyProfile_Name" class="block text-sm font-medium text-gray-700">
                  Firma Adı <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                     <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                      </svg>
                  </div>
                  <input id="CompanyProfile_Name" name="CompanyProfile.Name" value="@Model.CompanyProfile.Name" placeholder="Şirket adınız" 
                         class="block w-full pl-10 pr-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm">
                </div>
              </div>

              <div class="space-y-1">
                <label for="CompanyProfile_Phone" class="block text-sm font-medium text-gray-700">Firma Telefonu</label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <input id="CompanyProfile_Phone" name="CompanyProfile.Phone" value="@Model.CompanyProfile.Phone" 
                         class="block w-full pl-10 pr-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm">
                </div>
              </div>

              <div class="md:col-span-2 space-y-1">
                <label for="CompanyProfile_Address" class="block text-sm font-medium text-gray-700">Firma Adresi</label>
                <textarea id="CompanyProfile_Address" name="CompanyProfile.Address" rows="3" placeholder="Şirket adresiniz..." 
                          class="block w-full px-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm resize-none">@Model.CompanyProfile.Address</textarea>
              </div>
            </div>

            <div class="mt-6 flex justify-end">
              <button type="submit" class="px-6 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg transition-colors text-sm font-medium flex items-center gap-2">
                <i class="fas fa-save"></i>
                Firma Bilgilerini Güncelle
              </button>
            </div>
          </form>
        </div>
      </div>
    }
    else
    {
      <div class="bg-gray-50 rounded-xl border border-gray-200 p-6 flex items-start gap-4">
        <div class="bg-white p-2 rounded-lg border border-gray-200">
             <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
        </div>
        <div>
          <h4 class="text-base font-semibold text-gray-800">@Model.CompanyName</h4>
          <p class="text-sm text-gray-500 mt-1">Bu firma profilini düzenleme yetkiniz bulunmamaktadır. Değişiklik yapmak için firma yöneticinizle iletişime geçiniz.</p>
        </div>
      </div>
    }

    <!-- Fatura Bilgileri Kartı -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
        <div>
          <h3 class="text-lg font-semibold text-gray-800">Fatura Bilgileri</h3>
          <p class="text-sm text-gray-500">Faturalandırma için kullanılacak yasal bilgiler</p>
        </div>
        
        @if (!Model.CanManageUsers)
        {
          <div class="flex items-center space-x-2 bg-gray-50 px-3 py-1 rounded-md border border-gray-200">
            <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
            <span class="text-xs font-medium text-gray-600">Sadece Görüntüleme</span>
          </div>
        }
      </div>

      <div class="p-6">
        <form id="billing-form" novalidate>
          @Html.AntiForgeryToken()
          
          <!-- Fatura Türü -->
          <div class="mb-8">
            <label class="text-sm font-medium text-gray-700 block mb-3">Fatura Türü Seçimi</label>
            <div class="flex items-center space-x-6">
               <label class="flex items-center relative cursor-pointer group">
                  <input type="radio" name="BillingType" value="Corporate" id="type_corporate" class="peer sr-only" 
                         @((Model.BillingInformation.BillingType == "Corporate" || string.IsNullOrEmpty(Model.BillingInformation.BillingType)) ? "checked" : "")
                         @(!Model.CanManageUsers ? "disabled" : "") >
                  <div class="w-5 h-5 border-2 border-gray-300 rounded-full peer-checked:border-primary peer-checked:bg-primary transition-all relative">
                     <div class="absolute inset-0 m-auto w-2 h-2 rounded-full bg-white opacity-0 peer-checked:opacity-100 transform scale-0 peer-checked:scale-100 transition-all"></div>
                  </div>
                  <span class="ml-3 text-sm text-gray-600 font-medium peer-checked:text-gray-900 transition-colors">Kurumsal Fatura</span>
               </label>

               <label class="flex items-center relative cursor-pointer group">
                  <input type="radio" name="BillingType" value="Individual" id="type_individual" class="peer sr-only" 
                         @((Model.BillingInformation.BillingType == "Individual") ? "checked" : "")
                         @(!Model.CanManageUsers ? "disabled" : "") >
                  <div class="w-5 h-5 border-2 border-gray-300 rounded-full peer-checked:border-primary peer-checked:bg-primary transition-all relative">
                     <div class="absolute inset-0 m-auto w-2 h-2 rounded-full bg-white opacity-0 peer-checked:opacity-100 transform scale-0 peer-checked:scale-100 transition-all"></div>
                  </div>
                  <span class="ml-3 text-sm text-gray-600 font-medium peer-checked:text-gray-900 transition-colors">Bireysel Fatura</span>
               </label>
               
               <!-- Hidden select for script compatibility if needed, but radios are better UX -->
               <select id="BillingType" class="hidden">
                 <option value="Corporate">Kurumsal</option>
                 <option value="Individual">Bireysel</option>
               </select>
               
               <script>
                  // Sync radios with hidden select for existing scripts
                  document.querySelectorAll('input[name="BillingType"]').forEach(radio => {
                    radio.addEventListener('change', function() {
                      const select = document.getElementById('BillingType');
                      if(select) {
                        select.value = this.value;
                        // Trigger change event on select for other listeners
                        const event = new Event('change');
                        select.dispatchEvent(event);
                      }
                    });
                  });
                  
                  // Initial sync on load - ensure the select matches the radio
                  document.addEventListener('DOMContentLoaded', () => {
                     const selectedRadio = document.querySelector('input[name="BillingType"]:checked');
                     const select = document.getElementById('BillingType');
                     if(selectedRadio && select) {
                        select.value = selectedRadio.value;
                        // Don't dispatch event here to avoid double initialization loops, 
                        // handleBillingTypeChange in partial script should handle visibility init
                     }
                  });
               </script>
            </div>
          </div>

          <!-- Kurumsal Alanlar -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 transition-all duration-300 relative group" id="corporate-fields-container" style="display: @(Model.BillingInformation.BillingType == "Individual" ? "none" : "grid")">
            
            <div id="tax-number-field" class="space-y-1">
              <label for="TaxNumber" class="block text-sm font-medium text-gray-700">Vergi Numarası</label>
              <input type="text" id="TaxNumber" name="TaxNumber" value="@Model.BillingInformation.TaxNumber" maxlength="10" 
                     @(!Model.CanManageUsers ? "readonly" : "")
                     class="block w-full px-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm" placeholder="10 haneli vergi no">
            </div>

            <div id="company-name-field" class="space-y-1">
              <label for="CompanyName" class="block text-sm font-medium text-gray-700">Firma Ünvanı</label>
              <input type="text" id="CompanyName" name="CompanyName" value="@Model.BillingInformation.CompanyName" maxlength="100" 
                     @(!Model.CanManageUsers ? "readonly" : "")
                     class="block w-full px-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm" placeholder="Resmi firma ünvanı">
            </div>

            <div id="tax-office-field" class="space-y-1">
              <label for="TaxOffice" class="block text-sm font-medium text-gray-700 mb-1">Vergi Dairesi</label>
              <input type="text" id="TaxOffice" name="TaxOffice" value="@Model.BillingInformation.TaxOffice" maxlength="100"
                     @(!Model.CanManageUsers ? "readonly" : "")
                     class="block w-full px-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm" placeholder="Bağlı olunan vergi dairesi">
            </div>
          </div>

          <!-- Bireysel Alanlar -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 transition-all duration-300" id="individual-fields-container" style="display: @(Model.BillingInformation.BillingType == "Individual" ? "grid" : "none")">
            <div id="identity-number-field" class="space-y-1">
              <label for="IdentityNumber" class="block text-sm font-medium text-gray-700">TC Kimlik Numarası</label>
              <input type="text" id="IdentityNumber" name="IdentityNumber" value="@Model.BillingInformation.IdentityNumber" maxlength="11"
                     @(!Model.CanManageUsers ? "readonly" : "")
                     class="block w-full px-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm" placeholder="11 haneli TC No">
            </div>

            <div id="full-name-field" class="space-y-1">
              <label for="FullName" class="block text-sm font-medium text-gray-700">Ad Soyad</label>
              <input type="text" id="FullName" name="FullName" value="@Model.BillingInformation.FullName" maxlength="100"
                     @(!Model.CanManageUsers ? "readonly" : "")
                     class="block w-full px-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm" placeholder="adınız soyadınız">
            </div>
          </div>

          <!-- Ortak Alanlar (Adres) -->
          <div class="mt-6 space-y-1">
            <label for="BillingAddress" class="block text-sm font-medium text-gray-700">Fatura Adresi</label>
            <textarea id="BillingAddress" name="BillingAddress" rows="3" required minlength="10" maxlength="500"
                      @(!Model.CanManageUsers ? "readonly" : "")
                      placeholder="Tam fatura adresi..." 
                      class="block w-full px-4 py-2.5 bg-white border border-gray-200 rounded-lg focus:ring-1 focus:ring-primary focus:border-primary transition-colors text-gray-900 text-sm resize-none">@Model.BillingInformation.BillingAddress</textarea>
            <p class="text-xs text-gray-500 text-right mt-1">Min. 10 karakter</p>
          </div>

          @if (Model.CanManageUsers)
          {
            <div class="mt-8 pt-6 border-t border-gray-100 flex justify-end">
              <button type="submit" id="billing-submit-btn" class="px-6 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg transition-colors text-sm font-medium flex items-center gap-2">
                <span class="btn-text flex items-center gap-2">
                   <i class="fas fa-save"></i>
                   Fatura Bilgilerini Kaydet
                </span>
                <span class="btn-loading hidden flex items-center gap-2">
                  <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  Kaydediliyor...
                </span>
              </button>
            </div>
          }
        </form>
      </div>
    </div>
  </div>
</div>

