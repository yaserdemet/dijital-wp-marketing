@{
    ViewData["Title"] = "Stok Hatırlatma Widget Ayarları";
    ViewData["PageHeader"] = "Stok Hatırlatma Widget Ayarları";
}

@section Styles {
<style>
    /* Color Input */
    .sr-color-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }
    .sr-color-input-wrapper input[type="color"] {
        -webkit-appearance: none;
        border: none;
        width: 40px;
        height: 40px;
        cursor: pointer;
        padding: 0;
        background: none;
        flex-shrink: 0;
    }
    .sr-color-input-wrapper input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
    .sr-color-input-wrapper input[type="color"]::-webkit-color-swatch {
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
    }
    /* Toggle Switch */
    .sr-toggle {
        position: relative;
        display: inline-flex;
        align-items: center;
        cursor: pointer;
    }
    .sr-toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
    .sr-toggle .sr-slider {
        width: 36px; height: 20px;
        background: #d1d5db;
        border-radius: 999px;
        transition: all 0.2s ease;
        position: relative;
    }
    .sr-toggle .sr-slider::after {
        content: '';
        position: absolute;
        top: 2px; left: 2px;
        width: 16px; height: 16px;
        background: white;
        border-radius: 50%;
        border: 1px solid #e5e7eb;
        transition: all 0.2s ease;
    }
    .sr-toggle input:checked + .sr-slider {
        background: #3b82f6;
    }
    .sr-toggle input:checked + .sr-slider::after {
        transform: translateX(16px);
        border-color: transparent;
    }
    /* Collapsible Section */
    .sr-section-header {
        cursor: pointer;
        user-select: none;
        transition: all 0.15s ease;
    }
    .sr-section-header:hover {
        background: rgba(59, 130, 246, 0.03);
    }
    .sr-section-body {
        max-height: 2000px;
        overflow: hidden;
        transition: max-height 0.35s ease, opacity 0.25s ease, padding 0.35s ease;
        opacity: 1;
    }
    .sr-section-body.collapsed {
        max-height: 0;
        opacity: 0;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }
    .sr-section-chevron {
        transition: transform 0.25s ease;
    }
    .sr-section-chevron.collapsed {
        transform: rotate(-90deg);
    }
    /* Phone Mockup */
    .sr-phone-mockup {
        position: relative;
        width: 280px;
        min-height: 520px;
        background: #f3f4f6;
        border-radius: 36px;
        border: 8px solid #1f2937;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.3), inset 0 2px 4px rgba(255,255,255,0.1);
        overflow: hidden;
        flex-shrink: 0;
    }
    .sr-phone-notch {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 20px;
        background: #1f2937;
        border-radius: 0 0 16px 16px;
        z-index: 10;
    }
    /* Preview popup */
    .sr-preview-popup {
        font-family: system-ui, -apple-system, sans-serif;
        position: absolute;
        bottom: 0; left: 0; right: 0;
        padding: 20px 16px 16px;
        z-index: 5;
        box-shadow: 0 -8px 25px rgba(0,0,0,0.15);
    }
    .sr-variant-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        border: 1.5px solid #e5e7eb;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        cursor: default;
        background: white;
        transition: all 0.15s;
    }
    .sr-variant-btn.selected {
        border-color: #111;
        background: #111;
        color: white;
    }
</style>
}

@Html.AntiForgeryToken()

