@model PushDashboard.ViewModels.DashboardChartsViewModel

@{
    var minimalPalette = new[] { "#6366f1", "#14b8a6", "#fb7185", "#fbbf24", "#38bdf8" };
}

<!-- Maliyet analizi ve kanal dağılımı -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- Maliyet analizi -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 transition-all duration-300 transition-shadow hover:shadow-[0_2px_8px_rgba(0,0,0,0.05)]">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    Maliyet Analizi
                </h3>
                <p class="text-sm text-gray-500 mt-1">Haftalık harcama trendi</p>
            </div>
            <div class="text-right">
                <div class="text-xs text-gray-500">Toplam</div>
                <div class="text-lg font-bold text-emerald-600">₺@Model.CostTrend.Sum(c => c.Value).ToString("N2")</div>
            </div>
        </div>
        <div class="relative h-52">
            <canvas id="costAreaChart" class="w-full h-full"></canvas>
        </div>
        <div class="mt-4 grid grid-cols-3 gap-3 text-center">
            <div class="p-3 bg-gray-50 rounded-xl">
                <div class="text-xs text-gray-500">Ortalama</div>
                <div class="text-base font-semibold text-gray-800">₺@(Model.CostTrend.Any() ? (Model.CostTrend.Sum(c => c.Value) / Model.CostTrend.Count).ToString("N2") : "0,00")</div>
            </div>
            <div class="p-3 bg-emerald-50 rounded-xl">
                <div class="text-xs text-emerald-600">En Yüksek</div>
                <div class="text-base font-semibold text-gray-700">₺@(Model.CostTrend.Any() ? Model.CostTrend.Max(c => c.Value).ToString("N2") : "0,00")</div>
            </div>
            <div class="p-3 bg-gray-50 rounded-xl">
                <div class="text-xs text-gray-500">En Düşük</div>
                <div class="text-base font-semibold text-gray-700">₺@(Model.CostTrend.Any() ? Model.CostTrend.Min(c => c.Value).ToString("N2") : "0,00")</div>
            </div>
        </div>
    </div>

    <!-- Kanal dağılımı  -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 transition-all duration-300 transition-shadow hover:shadow-[0_2px_8px_rgba(0,0,0,0.05)]">
        <div class="mb-5">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-gray-500"></span>
                Kanal Dağılımı
            </h3>
            <p class="text-sm text-gray-500 mt-1">Bildirim kanallarına göre kullanım</p>
        </div>
        <div class="relative h-52">
            <canvas id="channelDistributionChart" class="w-full h-full"></canvas>
        </div>
        <div class="mt-4 space-y-2 max-h-40 overflow-y-auto pr-1">
            @if (Model.ChannelDistribution.Any())
            {
                @foreach (var channel in Model.ChannelDistribution.Select((c, i) => new { c.Label, c.Percentage, Color = minimalPalette[i % minimalPalette.Length] }))
                {
                    <div class="flex items-center justify-between py-2 px-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <div class="flex items-center gap-2 min-w-0">
                            <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: @channel.Color"></div>
                            <span class="text-sm text-gray-700 truncate">@channel.Label</span>
                        </div>
                        <span class="text-sm font-semibold text-gray-800 flex-shrink-0 ml-2">%@channel.Percentage.ToString("0.#")</span>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-gray-500 py-6">Henüz veri bulunmuyor</div>
            }
        </div>
    </div>
</div>

<!-- Grafikler -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <!-- Kullanım trendi -->
    <div class="lg:col-span-3 bg-white p-6 rounded-xl border border-gray-200 transition-all duration-300 transition-shadow hover:shadow-[0_2px_8px_rgba(0,0,0,0.05)]">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h3 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-gray-500"></span>
                    Kullanım Trendi
                </h3>
                <p class="text-sm text-gray-500 mt-1">Son 7 günlük modül kullanımı</p>
            </div>
            <div class="flex items-center gap-2">
                <button class="px-3 py-1.5 text-xs font-medium bg-gray-900 text-white rounded-lg transition-colors" onclick="toggleChartPeriod('usage', '7d')">7 Gün</button>
                <button class="px-3 py-1.5 text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 rounded-lg transition-colors" onclick="toggleChartPeriod('usage', '30d')">30 Gün</button>
                <button class="p-2 text-gray-400 hover:text-gray-600 rounded-lg hover:bg-gray-100 transition-colors" onclick="refreshChart('usage')" title="Yenile">
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                </button>
            </div>
        </div>
        <div class="relative h-64">
            <canvas id="usageLineChart" class="w-full h-full"></canvas>
        </div>
        <div class="mt-4 flex items-center justify-between text-sm text-gray-600">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-gray-500"></span>
                <span>Kullanım</span>
            </div>
            <span class="text-xs text-gray-500">Toplam: <strong class="text-gray-700">@Model.UsageTrend.Sum(u => u.Value)</strong> kullanım</span>
        </div>
    </div>
</div>

<script>
    // Store chart data globally to be used by scripts loaded at the bottom of the page
    window.dashboardChartData = {
        usage: @Html.Raw(Json.Serialize(Model.UsageTrend.Select(u => new { label = u.Label, value = u.Value }))),
        cost: @Html.Raw(Json.Serialize(Model.CostTrend.Select(c => new { label = c.Label, value = c.Value }))),
        channel: @Html.Raw(Json.Serialize(Model.ChannelDistribution.Select((c, i) => new { label = c.Label, percentage = c.Percentage, color = minimalPalette[i % minimalPalette.Length] })))
    };
</script>
