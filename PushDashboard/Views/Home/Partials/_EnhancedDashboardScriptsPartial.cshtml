function initializeEnhancedCharts() {
    if (!window.dashboardChartData || typeof Chart === 'undefined') {
        console.warn('Chart data or Chart.js not available');
        return;
    }

    // Helper to safely destroy existing chart
    const destroyChartIfExists = (canvasId) => {
        const canvas = document.getElementById(canvasId);
        if (canvas) {
            const existingChart = Chart.getChart(canvas);
            if (existingChart) {
                existingChart.destroy();
            }
        }
        return canvas;
    };

    try {
        const usageCanvas = destroyChartIfExists('usageLineChart');
        if (usageCanvas) {
            const usageCtx = usageCanvas.getContext('2d');
            const usageData = window.dashboardChartData.usage;
            const grad = usageCtx.createLinearGradient(0, 0, 0, 260);
            grad.addColorStop(0, 'rgba(99, 102, 241, 0.22)');
            grad.addColorStop(1, 'rgba(99, 102, 241, 0)');

            new Chart(usageCtx, {
                type: 'line',
                data: {
                    labels: usageData.map(d => d.label),
                    datasets: [{
                        label: 'Kullanım',
                        data: usageData.map(d => d.value),
                        borderColor: 'rgb(99, 102, 241)',
                        backgroundColor: grad,
                        borderWidth: 2,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: 'rgb(99, 102, 241)',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(30, 41, 59, 0.95)',
                            titleColor: '#f1f5f9',
                            bodyColor: '#e2e8f0',
                            borderColor: 'rgba(148, 163, 184, 0.3)',
                            borderWidth: 1,
                            cornerRadius: 10,
                            padding: 12,
                            displayColors: false,
                            callbacks: {
                                label: function(ctx) { return 'Kullanım: ' + ctx.raw; }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0, 0, 0, 0.04)' },
                            ticks: { color: '#64748b', font: { size: 11 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#64748b', font: { size: 11 } }
                        }
                    },
                    interaction: { intersect: false, mode: 'index' },
                    animation: { duration: 1200, easing: 'easeOutQuart' }
                }
            });
        }
    } catch (e) {
        console.error('Error initializing usage chart:', e);
    }

    try {
        const costCanvas = destroyChartIfExists('costAreaChart');
        if (costCanvas) {
            const costCtx = costCanvas.getContext('2d');
            const costData = window.dashboardChartData.cost;
            const costGrad = costCtx.createLinearGradient(0, 0, 0, 220);
            costGrad.addColorStop(0, 'rgba(20, 184, 166, 0.22)');
            costGrad.addColorStop(1, 'rgba(20, 184, 166, 0)');

            new Chart(costCtx, {
                type: 'line',
                data: {
                    labels: costData.map(d => d.label),
                    datasets: [{
                        label: 'Maliyet',
                        data: costData.map(d => d.value),
                        borderColor: 'rgb(20, 184, 166)',
                        backgroundColor: costGrad,
                        borderWidth: 2,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: 'rgb(20, 184, 166)',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(30, 41, 59, 0.95)',
                            titleColor: '#f1f5f9',
                            bodyColor: '#e2e8f0',
                            borderColor: 'rgba(148, 163, 184, 0.3)',
                            borderWidth: 1,
                            cornerRadius: 10,
                            padding: 12,
                            callbacks: {
                                label: function(ctx) { return 'Maliyet: ₺' + Number(ctx.raw).toLocaleString('tr-TR', { minimumFractionDigits: 2 }); }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0, 0, 0, 0.04)' },
                            ticks: { color: '#64748b', font: { size: 11 }, callback: function(v) { return '₺' + Number(v).toLocaleString('tr-TR', { minimumFractionDigits: 0 }); } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#64748b', font: { size: 11 } }
                        }
                    },
                    animation: { duration: 1200, easing: 'easeOutQuart' }
                }
            });
        }
    } catch (e) {
        console.error('Error initializing cost chart:', e);
    }

    try {
        const channelCanvas = destroyChartIfExists('channelDistributionChart');
        if (channelCanvas) {
            const channelCtx = channelCanvas.getContext('2d');
            let channelData = window.dashboardChartData.channel;
            let isDataEmpty = false;

            if (!channelData || channelData.length === 0) {
                isDataEmpty = true;
                channelData = [{ label: 'Veri yok', percentage: 100, color: '#e5e7eb' }];
            }

            new Chart(channelCtx, {
                type: 'doughnut',
                data: {
                    labels: channelData.map(d => d.label),
                    datasets: [{
                        data: channelData.map(d => d.percentage),
                        backgroundColor: channelData.map(d => d.color),
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            enabled: !isDataEmpty,
                            backgroundColor: 'rgba(30, 41, 59, 0.95)',
                            titleColor: '#f1f5f9',
                            bodyColor: '#e2e8f0',
                            borderColor: 'rgba(148, 163, 184, 0.3)',
                            borderWidth: 1,
                            cornerRadius: 10,
                            padding: 12,
                            displayColors: true,
                            callbacks: {
                                label: function(ctx) {
                                    var total = ctx.dataset.data.reduce(function(a, b) { return a + b; }, 0);
                                    var pct = total > 0 ? ((ctx.raw / total) * 100).toFixed(1) : 0;
                                    return ' ' + ctx.label + ': %' + pct;
                                }
                            }
                        }
                    },
                    animation: { duration: 1200, easing: 'easeOutQuart' }
                }
            });
        }
    } catch (e) {
        console.error('Error initializing channel chart:', e);
    }
}

window.initializeEnhancedCharts = initializeEnhancedCharts;

window.currentChartPeriod = '7d';

window.toggleChartPeriod = async function(chartType, period) {
    console.log('Toggling chart period:', chartType, period);

    if (window.currentChartPeriod === period) {
        return;
    }

    const days = period === '30d' ? 30 : 7;

    try {
        updatePeriodButtons(period);

        showChartLoading(true);

        const response = await fetch(`/Home/GetUsageTrendData?days=${days}`);
        const result = await response.json();

        if (result.success) {
            window.dashboardChartData.usage = result.data.usage;
            window.dashboardChartData.cost = result.data.cost;

            updateUsageChart(result.data);
            updateCostChart(result.data);

            updateChartStats(result.data, days);

            window.currentChartPeriod = period;

            console.log('Charts updated successfully for', days, 'days');
        } else {
            console.error('Failed to fetch chart data:', result.message);
            showNotification('⚠️ Grafik verileri alınamadı', 'warning');
        }
    } catch (error) {
        console.error('Error fetching chart data:', error);
        showNotification('❌ Grafik verileri alınırken hata oluştu', 'error');
    } finally {
        showChartLoading(false);
    }
};

function updatePeriodButtons(activePeriod) {
    const buttons = document.querySelectorAll('[onclick*="toggleChartPeriod"]');
    buttons.forEach(btn => {
        const btnPeriod = btn.getAttribute('onclick').includes("'7d'") ? '7d' : '30d';

        if (btnPeriod === activePeriod) {
            btn.classList.remove('bg-gray-100', 'text-gray-600', 'text-gray-700', 'hover:bg-gray-200');
            btn.classList.add('bg-gray-900', 'text-white');
        } else {
            btn.classList.remove('bg-gray-900', 'text-white');
            btn.classList.add('bg-gray-100', 'text-gray-600', 'hover:bg-gray-200');
        }
    });
}

function showChartLoading(isLoading) {
    const chartContainers = ['usageLineChart', 'costAreaChart'];
    chartContainers.forEach(id => {
        const canvas = document.getElementById(id);
        if (canvas) {
            const parent = canvas.parentElement;
            if (isLoading) {
                parent.style.opacity = '0.5';
                parent.style.pointerEvents = 'none';
            } else {
                parent.style.opacity = '1';
                parent.style.pointerEvents = 'auto';
            }
        }
    });
}

function updateUsageChart(data) {
    const canvas = document.getElementById('usageLineChart');
    if (!canvas || typeof Chart === 'undefined') return;

    const existingChart = Chart.getChart(canvas);
    if (existingChart) {
        existingChart.data.labels = data.usage.map(d => d.label);
        existingChart.data.datasets[0].data = data.usage.map(d => d.value);
        existingChart.update('active');
    }
}

function updateCostChart(data) {
    const canvas = document.getElementById('costAreaChart');
    if (!canvas || typeof Chart === 'undefined') return;

    const existingChart = Chart.getChart(canvas);
    if (existingChart) {
        existingChart.data.labels = data.cost.map(d => d.label);
        existingChart.data.datasets[0].data = data.cost.map(d => d.value);
        existingChart.update('active');
    }
}

function updateChartStats(data, days) {
    const usageTotalEl = document.querySelector('.text-xs.text-gray-500 .font-medium.text-gray-700');
    if (usageTotalEl) {
        usageTotalEl.textContent = data.totalUsage;
    }

    const periodDescEl = document.querySelector('.lg\\:col-span-3 .text-sm.text-gray-600.ml-6');
    if (periodDescEl) {
        periodDescEl.textContent = `Son ${days} günlük modül kullanım analizi`;
    }

    const costTotalEl = document.querySelector('.text-lg.font-bold.text-emerald-600');
    if (costTotalEl) {
        costTotalEl.textContent = '₺' + data.totalCost.toFixed(2);
    }

    const statContainers = document.querySelectorAll('.bg-white .grid.grid-cols-1.sm\\:grid-cols-3 .p-3');
    if (statContainers.length >= 3) {
        const avgEl = statContainers[0].querySelector('.text-lg.font-semibold');
        if (avgEl) avgEl.textContent = '₺' + data.averageCost.toFixed(2);

        const maxEl = statContainers[1].querySelector('.text-lg.font-semibold');
        if (maxEl) maxEl.textContent = '₺' + data.maxCost.toFixed(2);

        const minEl = statContainers[2].querySelector('.text-lg.font-semibold');
        if (minEl) minEl.textContent = '₺' + data.minCost.toFixed(2);
    }
}

window.refreshChart = async function(chartType) {
    console.log('Refreshing chart:', chartType);
    const days = window.currentChartPeriod === '30d' ? 30 : 7;

    try {
        const refreshBtn = event?.target?.closest('button');
        if (refreshBtn) {
            const svg = refreshBtn.querySelector('svg');
            if (svg) {
                svg.style.transition = 'transform 0.5s ease';
                svg.style.transform = 'rotate(360deg)';
                setTimeout(() => {
                    svg.style.transform = 'rotate(0deg)';
                }, 500);
            }
        }

        const response = await fetch(`/Home/GetUsageTrendData?days=${days}`);
        const result = await response.json();

        if (result.success) {
            window.dashboardChartData.usage = result.data.usage;
            window.dashboardChartData.cost = result.data.cost;

            updateUsageChart(result.data);
            updateCostChart(result.data);
            updateChartStats(result.data, days);

            showNotification('📊 Grafikler güncellendi', 'success');
        } else {
            showNotification('⚠️ Grafikler güncellenemedi', 'warning');
        }
    } catch (error) {
        console.error('Error refreshing charts:', error);
        showNotification('❌ Grafik yenilenirken hata oluştu', 'error');
    }
};
</script>
