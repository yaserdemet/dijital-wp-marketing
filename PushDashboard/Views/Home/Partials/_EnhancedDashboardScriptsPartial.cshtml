// Setup Tooltip
function setupTooltip() {
    console.log('Setting up tooltip...');

    const syncInfoBtn = document.getElementById("syncInfoBtn");
    const syncInfoTooltip = document.getElementById("syncInfoTooltip");

    console.log('syncInfoBtn:', syncInfoBtn);
    console.log('syncInfoTooltip:', syncInfoTooltip);

    if (syncInfoBtn && syncInfoTooltip) {
        console.log('Tooltip elements found, attaching event listeners');

        syncInfoBtn.addEventListener("click", function(e) {
            e.stopPropagation();
            console.log('Tooltip button clicked');

            const isHidden = syncInfoTooltip.style.display === 'none' || !syncInfoTooltip.style.display;
            console.log('isHidden:', isHidden);

            if (isHidden) {
                // Tooltip'i aç
                console.log('Opening tooltip');
                syncInfoTooltip.style.display = 'block';
                setTimeout(() => {
                    syncInfoTooltip.classList.remove('opacity-0');
                    syncInfoTooltip.classList.remove('invisible');
                    syncInfoTooltip.classList.remove('pointer-events-none');
                }, 10);
            } else {
                // Tooltip'i kapat
                syncInfoTooltip.classList.add('opacity-0');
                syncInfoTooltip.classList.add('invisible');
                syncInfoTooltip.classList.add('pointer-events-none');
                setTimeout(() => {
                    syncInfoTooltip.style.display = 'none';
                }, 200);
            }
        });

        // Close tooltip when clicking outside
        document.addEventListener("click", function(e) {
            if (!syncInfoBtn.contains(e.target) && !syncInfoTooltip.contains(e.target)) {
                const isVisible = syncInfoTooltip.style.display !== 'none' && syncInfoTooltip.style.display !== '';
                if (isVisible) {
                    syncInfoTooltip.classList.add('opacity-0');
                    syncInfoTooltip.classList.add('invisible');
                    syncInfoTooltip.classList.add('pointer-events-none');
                    setTimeout(() => {
                        syncInfoTooltip.style.display = 'none';
                    }, 200);
                }
            }
        });

        // Custom styled hover tooltip for full timestamps (replaces native title)
        (function(){
            let customTooltip = document.getElementById('customTimeTooltip');
            if (!customTooltip) {
                customTooltip = document.createElement('div');
                customTooltip.id = 'customTimeTooltip';
                customTooltip.style.position = 'fixed';
                customTooltip.style.zIndex = '11000';
                customTooltip.style.display = 'none';
                customTooltip.style.pointerEvents = 'none';
                customTooltip.style.padding = '6px 8px';
                customTooltip.style.borderRadius = '6px';
                customTooltip.style.background = 'rgba(55,65,81,0.95)'; // gray-700
                customTooltip.style.color = '#fff';
                customTooltip.style.fontSize = '12px';
                customTooltip.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
                customTooltip.style.transition = 'opacity 0.12s ease, transform 0.12s ease';
                customTooltip.style.opacity = '0';
                document.body.appendChild(customTooltip);
            }

            function showCustomTooltip(target) {
                if (!target) return;
                const full = target.getAttribute('data-full') || '';
                if (!full) return;
                customTooltip.textContent = full;
                customTooltip.style.display = 'block';

                // position centered above the element, or below if not enough space
                const rect = target.getBoundingClientRect();
                const tooltipWidth = customTooltip.offsetWidth || 160;
                let left = rect.left + (rect.width / 2) - (tooltipWidth / 2);
                left = Math.max(8, Math.min(left, window.innerWidth - tooltipWidth - 8));

                let top = rect.top - customTooltip.offsetHeight - 8;
                if (top < 8) {
                    top = rect.bottom + 8;
                }

                customTooltip.style.left = left + 'px';
                customTooltip.style.top = top + 'px';
                requestAnimationFrame(() => {
                    customTooltip.style.opacity = '1';
                    customTooltip.style.transform = 'translateY(0)';
                });
            }

            function hideCustomTooltip() {
                if (!customTooltip) return;
                customTooltip.style.opacity = '0';
                customTooltip.style.transform = 'translateY(-4px)';
                setTimeout(() => {
                    customTooltip.style.display = 'none';
                }, 120);
            }

            // Delegated handlers on tooltip container
            syncInfoTooltip.addEventListener('mouseover', function(e){
                const t = e.target.closest && e.target.closest('time[data-full]');
                if (t) {
                    // prevent native title
                    t.removeAttribute('title');
                    showCustomTooltip(t);
                }
            });

            syncInfoTooltip.addEventListener('mousemove', function(e){
                const t = e.target.closest && e.target.closest('time[data-full]');
                if (t && customTooltip.style.display !== 'none') {
                    const rect = t.getBoundingClientRect();
                    // keep tooltip centered horizontally over element
                    const tooltipWidth = customTooltip.offsetWidth;
                    let left = rect.left + (rect.width / 2) - (tooltipWidth / 2);
                    left = Math.max(8, Math.min(left, window.innerWidth - tooltipWidth - 8));
                    let top = rect.top - customTooltip.offsetHeight - 8;
                    if (top < 8) top = rect.bottom + 8;
                    customTooltip.style.left = left + 'px';
                    customTooltip.style.top = top + 'px';
                }
            });

            syncInfoTooltip.addEventListener('mouseout', function(e){
                const t = e.target.closest && e.target.closest('time[data-full]');
                if (t) {
                    hideCustomTooltip();
                }
            });

            // Hide tooltip when the info popover is closed
            const observer = new MutationObserver(function(){
                if (syncInfoTooltip.style.display === 'none') hideCustomTooltip();
            });
            observer.observe(syncInfoTooltip, { attributes: true, attributeFilter: ['style'] });
        })();

    } else {
        console.error('Tooltip elements not found!');
    }
}

