// Sync All Data Function - Müşteriler, Sepetler ve Entegrasyonları Senkronize Et
async function syncAllData() {
    console.log('syncAllData function called');

    const syncBtn = document.getElementById('syncAllBtn');
    const syncBtnText = document.getElementById('syncAllBtnText');

    console.log('syncBtn:', syncBtn);
    console.log('syncBtnText:', syncBtnText);

    if (!syncBtn || !syncBtnText) {
        console.error('Button or text element not found!');
        return;
    }

    const icon = syncBtn.querySelector('svg');
    const originalText = syncBtnText.textContent;

    console.log('Starting sync process...');

    try {
        // Butonu devre dışı bırak
        syncBtn.disabled = true;
        syncBtn.classList.add('opacity-75', 'cursor-not-allowed');

        // Animate icon rotation
        icon.style.transform = 'rotate(360deg)';
        icon.style.transition = 'transform 0.6s ease';
        syncBtnText.textContent = 'Senkronize ediliyor...';

        // Adım 1: Müşteriler ve Sepetleri Senkronize Et
        const response = await fetch('/Home/SyncAll', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            }
        });

        const data = await response.json();
        let overallSuccess = data.success;
        let messages = [data.message];
        let integrationsSuccess = false;

        // Adım 2: Entegrasyonları Senkronize Et
        try {
            const integrationsResult = await syncAllIntegrations();
            integrationsSuccess = integrationsResult.success;

            if (integrationsResult.success) {
                messages.push(integrationsResult.message);
                if (integrationsResult.errors && integrationsResult.errors.length > 0) {
                    messages.push('<br><strong>Hatalar:</strong><br>' + integrationsResult.errors.join('<br>'));
                }
            } else {
                messages.push('Entegrasyonlar: ' + integrationsResult.message);
                if (integrationsResult.errors && integrationsResult.errors.length > 0) {
                    messages.push('<br><strong>Hatalar:</strong><br>' + integrationsResult.errors.join('<br>'));
                }
                overallSuccess = false;
            }
        } catch (error) {
            console.error('Error syncing integrations:', error);
            messages.push('Entegrasyonlar: Senkronizasyon başarısız - ' + error.message);
            overallSuccess = false;
        }

        if (overallSuccess) {
            // Success feedback
            syncBtnText.textContent = 'Tamamlandı!';
            syncBtn.classList.remove('bg-white');
            syncBtn.classList.add('bg-gray-100');

            // Senkronizasyon bildirimi göster
            const combinedMessage = messages.join(' <br> ');
            showNotification('✅ ' + combinedMessage, 'success');

            // Tooltip'i güncelle
            updateSyncInfoTooltip();

            // Dashboard'u sessizce güncelle (bildirim göstermeden)
            refreshDashboardDataSilent();

            setTimeout(() => {
                // Reset button state
                syncBtn.disabled = false;
                syncBtn.classList.remove('opacity-75', 'cursor-not-allowed', 'bg-gray-100');
                syncBtn.classList.add('bg-white');
                syncBtnText.textContent = originalText;
                icon.style.transform = 'rotate(0deg)';
            }, 2000);
        } else if (integrationsSuccess && !data.success) {
            // Partial Success feedback (Main sync failed, but integrations succeeded)
            syncBtnText.textContent = 'Kısmen Tamamlandı';
            syncBtn.classList.remove('bg-white');
            syncBtn.classList.add('bg-yellow-50', 'text-yellow-600');

            // Senkronizasyon bildirimi göster (Warning)
            const combinedMessage = messages.join(' <br> ');
            showNotification('⚠️ ' + combinedMessage, 'warning');

            // Tooltip'i güncelle
            updateSyncInfoTooltip();

            // Dashboard'u sessizce güncelle
            refreshDashboardDataSilent();

            setTimeout(() => {
                // Reset button state
                syncBtn.disabled = false;
                syncBtn.classList.remove('opacity-75', 'cursor-not-allowed', 'bg-yellow-50', 'text-yellow-600');
                syncBtn.classList.add('bg-white');
                syncBtnText.textContent = originalText;
                icon.style.transform = 'rotate(0deg)';
            }, 3000);
        } else {
            // Error feedback
            syncBtnText.textContent = 'Hata!';
            syncBtn.classList.remove('bg-white');
            syncBtn.classList.add('bg-red-50', 'text-red-600');

            // Hata bildirimi göster
            const combinedMessage = messages.join(' <br> ');
            showNotification('❌ Hata: ' + combinedMessage, 'error');

            setTimeout(() => {
                // Reset button state
                syncBtn.disabled = false;
                syncBtn.classList.remove('opacity-75', 'cursor-not-allowed', 'bg-red-50', 'text-red-600');
                syncBtn.classList.add('bg-white');
                syncBtnText.textContent = originalText;
                icon.style.transform = 'rotate(0deg)';
            }, 2000);
        }
    } catch (error) {
        console.error('Error:', error);

        // Error feedback
        syncBtnText.textContent = 'Hata!';
        syncBtn.classList.remove('bg-white');
        syncBtn.classList.add('bg-red-50', 'text-red-600');

        setTimeout(() => {
            // Reset button state
            syncBtn.disabled = false;
            syncBtn.classList.remove('opacity-75', 'cursor-not-allowed', 'bg-red-50', 'text-red-600');
            syncBtn.classList.add('bg-white');
            syncBtnText.textContent = originalText;
            icon.style.transform = 'rotate(0deg)';
        }, 2000);
    }
}

// Tüm entegrasyonları senkronize et (Entegrasyonlar sayfasından taşındı)
async function syncAllIntegrations() {
    console.log('syncAllIntegrations called from dashboard');

    try {
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!csrfToken) {
            return { success: false, message: 'Güvenlik token\'ı bulunamadı' };
        }

        // Entegrasyonlar sayfasından tüm senkronize et butonlarını bul
        // Dashboard'da bu butonlar olmayabileceği için, backend'den entegrasyonları al
        const response = await fetch('/Integration/GetAllIntegrations', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': csrfToken.value
            }
        });

        if (!response.ok) {
            return { success: false, message: 'Entegrasyonlar alınamadı' };
        }

        const integrationsData = await response.json();
        if (!integrationsData.success || !integrationsData.integrations) {
            return { success: false, message: 'Entegrasyon listesi boş' };
        }

        let successCount = 0;
        let failureCount = 0;
        const results = [];
        const errors = [];

        // Tüm entegrasyonları sırayla senkronize et
        for (const integration of integrationsData.integrations) {
            try {
                const syncResponse = await fetch('/Integration/SyncIntegration', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': csrfToken.value
                    },
                    body: JSON.stringify({
                        integrationId: integration.id
                    })
                });

                const syncData = await syncResponse.json();
                if (syncData.success) {
                    successCount++;
                    results.push(`✓ ${integration.name}`);
                } else {
                    failureCount++;
                    results.push(`✗ ${integration.name}`);
                    errors.push(`${integration.name}: ${syncData.message || 'Bilinmeyen hata'}`);
                }
            } catch (error) {
                failureCount++;
                results.push(`✗ ${integration.name}`);
                errors.push(`${integration.name}: ${error.message || 'Bağlantı hatası'}`);
            }

            // Kısa bir gecikme ekle
            await new Promise(resolve => setTimeout(resolve, 300));
        }

        const message = `Entegrasyonlar: ${successCount} başarılı, ${failureCount} başarısız`;
        return {
            success: successCount > 0,
            message: message,
            details: results,
            errors: errors
        };
    } catch (error) {
        console.error('Error in syncAllIntegrations:', error);
        return { success: false, message: 'Entegrasyon senkronizasyonu başarısız: ' + error.message };
    }
}

// Son güncelleme zamanını güncelle (Yenile veya Dashboard click'i)
function updateLastUpdateTime() {
    const now = new Date();
    const formattedTime = now.toLocaleString('tr-TR', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
    });

    // Son güncelleme zamanını güncelle (kısa gösterim + full timestamp title)
    const lastUpdateTimeElement = document.getElementById('lastUpdateTime');
    if (lastUpdateTimeElement) {
        const timeEl = lastUpdateTimeElement.querySelector('time');
        if (timeEl) {
            timeEl.textContent = 'Az önce';
            // store full timestamp in data-full to use with custom tooltip
            timeEl.setAttribute('data-full', formattedTime);
            // remove native title to prevent default browser tooltip
            timeEl.removeAttribute('title');
        } else {
            // Fallback: eğer <time> yoksa doğrudan elemente yaz
            lastUpdateTimeElement.textContent = 'Az önce';
            lastUpdateTimeElement.setAttribute('data-full', formattedTime);
            lastUpdateTimeElement.removeAttribute('title');
        }
    }
}

// Son senkronizasyon zamanını güncelle (Senkronize Et click'i)
function updateLastSyncTime() {
    const now = new Date();
    const formattedTime = now.toLocaleString('tr-TR', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
    });

    // Son senkronizasyon zamanını güncelle (kısa gösterim + full timestamp title)
    const lastSyncTimeElement = document.getElementById('lastSyncTime');
    if (lastSyncTimeElement) {
        const timeEl = lastSyncTimeElement.querySelector('time');
        if (timeEl) {
            timeEl.textContent = 'Az önce';
            timeEl.setAttribute('data-full', formattedTime);
            timeEl.removeAttribute('title');
        } else {
            lastSyncTimeElement.textContent = 'Az önce';
            lastSyncTimeElement.setAttribute('data-full', formattedTime);
            lastSyncTimeElement.removeAttribute('title');
        }
    }
}

// Senkronizasyon bilgisi tooltip'ini güncelle
function updateSyncInfoTooltip() {
    updateLastSyncTime();
