@model PushDashboard.ViewModels.DashboardIndexViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Scripts
{
    @await Html.PartialAsync("Partials/_EnhancedDashboardScriptsPartial")
    
    <script>
        // Sync All butonu için event listener
        document.addEventListener('DOMContentLoaded', function() {
            const syncAllBtn = document.getElementById('syncAllBtn');

            if (syncAllBtn) {
                syncAllBtn.addEventListener('click', function(e) {
                    e.preventDefault();

                    if (typeof syncAllData === 'function') {
                        syncAllData();
                    } else {
                        performSyncAll();
                    }
                });
            } else {
            }
        });

        // Fallback sync function
        async function performSyncAll() {
            const syncBtn = document.getElementById('syncAllBtn');
            const syncBtnText = document.getElementById('syncAllBtnText');

            if (!syncBtn || !syncBtnText) {
                console.error('Button elements not found');
                showNotification('Buton bulunamadı!', 'error');
                return;
            }

            const icon = syncBtn.querySelector('svg');
            const originalText = syncBtnText.textContent;

            try {
                // Butonu devre dışı bırak
                syncBtn.disabled = true;
                syncBtn.classList.add('opacity-75', 'cursor-not-allowed');

                // Animate icon rotation
                if (icon) {
                    icon.style.transform = 'rotate(360deg)';
                    icon.style.transition = 'transform 0.6s ease';
                }
                syncBtnText.textContent = 'Senkronize ediliyor...';

                // Bilgilendirme mesajı göster
                showNotification('🔄 Sistem senkronize ediliyor...', 'info');

                const response = await fetch('/Home/SyncAll', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const text = await response.text();
                let data;
                try {
                    data = JSON.parse(text);
                } catch (e) {
                    console.error('Failed to parse JSON:', text);
                    throw new Error('Sunucudan geçersiz yanıt alındı.');
                }

                if (data.success) {
                    syncBtnText.textContent = 'Tamamlandı!';
                    syncBtn.classList.remove('bg-white');
                    syncBtn.classList.add('bg-gray-100');

                    showNotification('✅ ' + data.message, 'success');

                    // Dashboard'u yenile
                    setTimeout(() => {
                        if (typeof refreshDashboardData === 'function') {
                            refreshDashboardData();
                        } else {
                            window.location.reload();
                        }
                    }, 1000);

                    setTimeout(() => {
                        syncBtn.disabled = false;
                        syncBtn.classList.remove('opacity-75', 'cursor-not-allowed', 'bg-gray-100');
                        syncBtn.classList.add('bg-white');
                        syncBtnText.textContent = originalText;
                        if (icon) icon.style.transform = 'rotate(0deg)';
                    }, 2000);
                } else {
                    syncBtnText.textContent = 'Hata!';
                    syncBtn.classList.remove('bg-white');
                    syncBtn.classList.add('bg-red-50', 'text-red-600');

                    showNotification('❌ Hata: ' + data.message, 'error');

                    setTimeout(() => {
                        syncBtn.disabled = false;
                        syncBtn.classList.remove('opacity-75', 'cursor-not-allowed', 'bg-red-50', 'text-red-600');
                        syncBtn.classList.add('bg-white');
                        syncBtnText.textContent = originalText;
                        if (icon) icon.style.transform = 'rotate(0deg)';
                    }, 2000);
                }
            } catch (error) {
                console.error('Error:', error);

                syncBtnText.textContent = 'Hata!';
                syncBtn.classList.remove('bg-white');
                syncBtn.classList.add('bg-red-50', 'text-red-600');

                showNotification('❌ Senkronizasyon hatası: ' + error.message, 'error');

                setTimeout(() => {
                    syncBtn.disabled = false;
                    syncBtn.classList.remove('opacity-75', 'cursor-not-allowed', 'bg-red-50', 'text-red-600');
                    syncBtn.classList.add('bg-white');
                    syncBtnText.textContent = originalText;
                    if (icon) icon.style.transform = 'rotate(0deg)';
                }, 2000);
            }
        }

        // Tooltip: move to body and position to avoid header scroll / clipping
        document.addEventListener('DOMContentLoaded', function() {
            const syncInfoBtn = document.getElementById('syncInfoBtn');
            const tooltip = document.getElementById('syncInfoTooltip');
            let isOpen = false;
            let outsideClickHandler = null;
            let repositionHandler = null;

            function positionTooltip() {
                if (!tooltip || !syncInfoBtn) return;
                const rect = syncInfoBtn.getBoundingClientRect();
                // ensure tooltip is measured
                tooltip.style.display = 'block';
                tooltip.style.position = 'fixed';
                tooltip.style.zIndex = '10000';
                // right-align to the button but prevent going off-screen
                tooltip.style.left = Math.min(window.innerWidth - tooltip.offsetWidth - 8, rect.right - tooltip.offsetWidth) + 'px';
                tooltip.style.top = (rect.bottom + 8) + 'px';
            }

            function openTooltip() {
                if (!tooltip || !syncInfoBtn || isOpen) return;
                // append to body to avoid parent's overflow creating scroll/clipping
                if (tooltip.parentElement !== document.body) document.body.appendChild(tooltip);
                tooltip.classList.remove('opacity-0','invisible','pointer-events-none');
                tooltip.style.pointerEvents = 'auto';
                positionTooltip();
                isOpen = true;
                syncInfoBtn.setAttribute('aria-expanded','true');

                outsideClickHandler = function(e){ if (!tooltip.contains(e.target) && e.target !== syncInfoBtn) closeTooltip(); };
                repositionHandler = function(){ if (isOpen) positionTooltip(); };

                window.addEventListener('resize', repositionHandler);
                window.addEventListener('scroll', repositionHandler, true);
                document.addEventListener('click', outsideClickHandler);
            }

            function closeTooltip() {
                if (!tooltip || !isOpen) return;
                tooltip.classList.add('opacity-0','invisible','pointer-events-none');
                tooltip.style.pointerEvents = 'none';
                tooltip.style.display = 'none';
                syncInfoBtn.setAttribute('aria-expanded','false');
                isOpen = false;
                window.removeEventListener('resize', repositionHandler);
                window.removeEventListener('scroll', repositionHandler, true);
                document.removeEventListener('click', outsideClickHandler);
            }

            if (syncInfoBtn && tooltip) {
                // ensure tooltip is hidden initially
                tooltip.style.display = 'none';
                syncInfoBtn.addEventListener('click', function(e){
                    e.preventDefault();
                    e.stopPropagation();
                    if (isOpen) closeTooltip(); else openTooltip();
                });
            }
        });
    </script>
}

<div class="mb-6" id="dashboardHeader">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 md:gap-0">
        <div>
            <h2 class="text-2xl font-semibold text-gray-900 cursor-pointer hover:text-gray-600 transition-colors" id="dashboardTitle">Pushboard</h2>
            <p class="text-gray-500">E-ticaret bildirim sistemi genel bakış</p>
        </div>
        <div class="flex items-center space-x-3 w-full md:w-auto justify-start md:justify-end overflow-x-auto pb-2 md:pb-0">
            <a href="/Settings?tab=payment&openModal=true" class="flex-shrink-0 flex items-center px-3 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg transition-colors border border-transparent" title="Hızlı Bakiye Ekle">
                <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                <span class="text-sm font-medium">Bakiye Ekle</span>
            </a>
            <button id="refreshBtn" class="flex-shrink-0 flex items-center px-3 py-2 bg-white hover:bg-gray-50 text-gray-700 rounded-lg transition-colors border border-gray-200" title="Dashboard'u yenile">
                <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span class="text-sm font-medium">Yenile</span>
            </button>
            <div class="flex items-center space-x-1 flex-shrink-0">
                <button id="syncAllBtn" class="flex items-center px-3 py-2 bg-white hover:bg-gray-50 text-gray-700 rounded-lg transition-colors border border-gray-200" title="Tüm sistemi senkronize et">
                    <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    <span id="syncAllBtnText" class="text-sm font-medium">Senkronize Et</span>
                </button>
                <div class="relative">
                    <button type="button" id="syncInfoBtn" class="flex items-center justify-center w-6 h-6 text-gray-400 hover:text-gray-600 rounded-full hover:bg-gray-100 transition-all duration-200" title="Senkronizasyon bilgisi">
                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </button>
                    <!-- Tooltip -->
                    <div id="syncInfoTooltip" class="absolute right-0 mt-2 w-72 bg-white border border-gray-200 rounded-lg p-4 opacity-0 invisible transition-all duration-200 z-50 pointer-events-none" style="display: none;">
                        <div class="space-y-2 text-sm">
                            <div class="font-semibold text-gray-800 border-b pb-2">Senkronizasyon Bilgisi</div>
                            <div class="flex justify-between items-start">
                                <span class="text-gray-600">Son Senkronizasyon:</span>
                                <span class="text-gray-800 font-medium text-right">
                                    <div id="lastSyncTime"><time data-full="@Model.SyncInfo.FormattedLastSync" class="cursor-default">@Model.SyncInfo.TimeAgoLastSync</time></div>
                                </span>
                            </div>
                            <div class="flex justify-between items-start">
                                <span class="text-gray-600">Son Güncelleme:</span>
                                <span class="text-gray-800 font-medium text-right">
                                    <div id="lastUpdateTime"><time data-full="@Model.SyncInfo.FormattedLastUpdate" class="cursor-default">@Model.SyncInfo.TimeAgoLastUpdate</time></div>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("Partials/_LoadingSkeletonPartial")

<div id="dashboardContent">
    @await Html.PartialAsync("Partials/_EnhancedStatsPartial", Model.Stats)

    <div class="w-full mb-6">
        @await Html.PartialAsync("Partials/_RevenueByModulePartial", Model.ModuleRevenues)
    </div>

    @await Html.PartialAsync("Partials/_EnhancedChartsPartial", Model.Charts)

    <div class="mt-6">
        @await Html.PartialAsync("Partials/_NotificationMetricsPartial", Model.NotificationMetrics)
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
        @await Html.PartialAsync("Partials/_ModuleUsagePartial", Model.ModuleUsage)
        @await Html.PartialAsync("Partials/_IntegrationStatusPartial", Model.IntegrationStatus)
    </div>
</div>
