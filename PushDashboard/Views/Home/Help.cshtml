@{
    ViewData["Title"] = "Yardım Merkezi";
    Layout = "_BlankLayout";
}

<div class="min-h-screen bg-slate-50 font-sans text-slate-600">
    <div class="bg-white border-b border-slate-200">
        <div class="w-full px-4 sm:px-6 lg:px-8 py-12">
            <div class="max-w-3xl">
                <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-700/10 mb-4">
                    Destek & Dokümantasyon
                </span>
                <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl mb-4">@ViewData["Title"]</h1>
                <p class="text-lg text-slate-500">
                    Dijitaldesin kullanım rehberi, hizmet detayları ve sıkça sorulan sorular.
                </p>
            </div>
        </div>
    </div>

    <div class="w-full px-4 sm:px-6 lg:px-8 py-12">
        <div class="lg:grid lg:grid-cols-12 lg:gap-8">
            
            <div class="hidden lg:block lg:col-span-3">
                <nav class="sticky top-6 overflow-y-auto pb-4">
                    <h3 class="font-semibold text-slate-900 mb-4">İçindekiler</h3>
                    <ul class="space-y-3 text-sm">
                        <li><a href="#intro" class="js-scroll-link block text-slate-600 hover:text-emerald-600 hover:pl-1 transition-all">1. Dijitaldesin Nedir?</a></li>
                        <li><a href="#steps" class="js-scroll-link block text-slate-600 hover:text-emerald-600 hover:pl-1 transition-all">2. Nasıl Başlarım?</a></li>
                        <li><a href="#services" class="js-scroll-link block text-slate-600 hover:text-emerald-600 hover:pl-1 transition-all">3. Hizmetler</a></li>
                        <li><a href="#faq" class="js-scroll-link block text-slate-600 hover:text-emerald-600 hover:pl-1 transition-all">4. Sıkça Sorulanlar</a></li>
                        <li><a href="#contact" class="js-scroll-link block text-slate-600 hover:text-emerald-600 hover:pl-1 transition-all">5. Destek & İletişim</a></li>
                    </ul>
                </nav>
            </div>

            <main class="lg:col-span-9">
                <div class="prose prose-slate prose-lg max-w-none bg-white rounded-2xl shadow-sm border border-slate-100 p-8 md:p-12">
                    
                    <section id="intro" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center">
                            <span class="bg-emerald-100 text-emerald-600 w-8 h-8 rounded-lg flex items-center justify-center text-sm mr-3">1</span> 
                            Dijitaldesin Nedir?
                        </h2>
                        <p class="leading-relaxed text-lg">
                            Dijitaldesin, e-ticaret markalarının müşteri etkileşimini artırmak,
                            dönüşüm oranlarını yükseltmek ve satış sonrası iletişimi güçlendirmek için
                            geliştirilen <strong>pazarlama ve otomasyon çözümleri</strong> sunar.
                        </p>
                    </section>

                    <section id="steps" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center">
                            <span class="bg-emerald-100 text-emerald-600 w-8 h-8 rounded-lg flex items-center justify-center text-sm mr-3">2</span>
                            Nasıl Başlarım?
                        </h2>
                        <div class="space-y-6">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <div class="flex items-center justify-center h-10 w-10 rounded-full bg-emerald-600 text-white font-bold">1</div>
                                </div>
                                <div class="ml-4">
                                    <h3 class="text-lg font-medium text-slate-900">Hizmet Belirleme</h3>
                                    <p class="mt-1 text-slate-500">İhtiyacınıza uygun hizmeti web sitemizden veya rehberlerimizden belirleyin.</p>
                                </div>
                            </div>
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <div class="flex items-center justify-center h-10 w-10 rounded-full bg-emerald-600 text-white font-bold">2</div>
                                </div>
                                <div class="ml-4">
                                    <h3 class="text-lg font-medium text-slate-900">İletişime Geçin</h3>
                                    <p class="mt-1 text-slate-500">İletişim veya teklif formu üzerinden talebinizi bize iletin.</p>
                                </div>
                            </div>
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <div class="flex items-center justify-center h-10 w-10 rounded-full bg-emerald-600 text-white font-bold">3</div>
                                </div>
                                <div class="ml-4">
                                    <h3 class="text-lg font-medium text-slate-900">Planlama ve Kurulum</h3>
                                    <p class="mt-1 text-slate-500">Ekibimiz sizinle iletişime geçerek en uygun çözümü planlar ve entegrasyonu başlatır.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section id="services" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center">
                            <span class="bg-emerald-100 text-emerald-600 w-8 h-8 rounded-lg flex items-center justify-center text-sm mr-3">3</span>
                            Hangi Hizmetleri Sunuyorsunuz?
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex items-start p-4 border border-slate-200 rounded-lg hover:border-emerald-400 transition-colors">
                                <svg class="h-6 w-6 text-emerald-500 mt-1 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <div>
                                    <h4 class="font-semibold text-slate-900">Karşılama & Teşvik</h4>
                                    <p class="text-sm text-slate-500 mt-1">Yeni üye karşılama ve ilk alışveriş teşvikleri.</p>
                                </div>
                            </div>
                             <div class="flex items-start p-4 border border-slate-200 rounded-lg hover:border-emerald-400 transition-colors">
                                <svg class="h-6 w-6 text-emerald-500 mt-1 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                                <div>
                                    <h4 class="font-semibold text-slate-900">Sepet & Stok</h4>
                                    <p class="text-sm text-slate-500 mt-1">Sepet kurtarma ve stok hatırlatma otomasyonları.</p>
                                </div>
                            </div>
                             <div class="flex items-start p-4 border border-slate-200 rounded-lg hover:border-emerald-400 transition-colors">
                                <svg class="h-6 w-6 text-emerald-500 mt-1 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" /></svg>
                                <div>
                                    <h4 class="font-semibold text-slate-900">Yorum Otomasyonları</h4>
                                    <p class="text-sm text-slate-500 mt-1">Trendyol ve pazar yeri yorum artırma çözümleri.</p>
                                </div>
                            </div>
                             <div class="flex items-start p-4 border border-slate-200 rounded-lg hover:border-emerald-400 transition-colors">
                                <svg class="h-6 w-6 text-emerald-500 mt-1 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                                <div>
                                    <h4 class="font-semibold text-slate-900">KVKK & Raporlama</h4>
                                    <p class="text-sm text-slate-500 mt-1">Çerez yönetimi, yasal uyum ve AI raporlama.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section id="faq" class="scroll-mt-24 mb-12">
                         <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center">
                            <span class="bg-emerald-100 text-emerald-600 w-8 h-8 rounded-lg flex items-center justify-center text-sm mr-3">4</span>
                            Sık Sorulan Sorular
                        </h2>
                        <div class="space-y-4">
                            <div class="bg-slate-50 rounded-lg p-6">
                                <h3 class="font-bold text-slate-900 mb-2">Dijitaldesin hangi altyapılarla çalışır?</h3>
                                <p class="text-slate-600">Dijitaldesin, tüm popüler e-ticaret altyapılarına (Ticimax, Ideasoft, Shopify vb.) ve özel yazılımlara entegre çalışabilecek şekilde tasarlanmıştır.</p>
                            </div>
                            <div class="bg-slate-50 rounded-lg p-6">
                                <h3 class="font-bold text-slate-900 mb-2">Kurulum süresi ne kadar?</h3>
                                <p class="text-slate-600">Seçilen hizmete bağlı olarak değişmekle birlikte, standart entegrasyonlar genellikle 24-48 saat içinde tamamlanmaktadır.</p>
                            </div>
                            <div class="bg-slate-50 rounded-lg p-6">
                                <h3 class="font-bold text-slate-900 mb-2">Teknik bilgiye ihtiyacım var mı?</h3>
                                <p class="text-slate-600">Hayır. Tüm kurulum, test ve teknik entegrasyon süreçleri uzman Dijitaldesin ekibi tarafından yönetilir.</p>
                            </div>
                        </div>
                    </section>

                    <section id="contact" class="scroll-mt-24">
                        <div class="bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 rounded-2xl p-8 text-white">
                            <h2 class="text-2xl font-bold mb-4">5. Destek ve İletişim</h2>
                            <p class="text-slate-300 mb-6">
                                Geri bildirimleriniz bizim için çok değerli. Yardım almak veya önerilerinizi iletmek için bize ulaşın.
                            </p>
                            <div class="flex flex-col md:flex-row gap-6">
                                <a href="mailto:info@dijitaldesin.com" class="flex items-center group">
                                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-emerald-500 transition-colors">
                                        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                    </div>
                                    <span class="ml-3 text-sm font-medium">info@dijitaldesin.com</span>
                                </a>
                                <a href="https://dijitaldesin.com" class="flex items-center group">
                                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-indigo-500 transition-colors">
                                        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                                    </div>
                                    <span class="ml-3 text-sm font-medium">dijitaldesin.com</span>
                                </a>
                            </div>
                        </div>
                    </section>
                </div>
            </main>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Select all links with the class 'js-scroll-link'
        const links = document.querySelectorAll('.js-scroll-link');

        links.forEach(link => {
            link.addEventListener('click', function(e) {
                // Prevent the default anchor click behavior
                e.preventDefault();

                // Get the target element id
                const targetId = this.getAttribute('href').substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    // Smooth scroll
                    targetElement.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    });
</script>