@{
    ViewData["Title"] = "Gizlilik Politikası";
    Layout = "_BlankLayout";
}

<div class="min-h-screen bg-slate-50 font-sans text-slate-600">
    <div class="bg-white border-b border-slate-200">
        <div class="w-full px-4 sm:px-6 lg:px-8 py-12">
            <div class="max-w-3xl">
                <span class="inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10 mb-4">
                    Yasal Dokümanlar
                </span>
                <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl mb-4">@ViewData["Title"]</h1>
            </div>
        </div>
    </div>

    <div class="w-full px-4 sm:px-6 lg:px-8 py-12">
        <div class="lg:grid lg:grid-cols-12 lg:gap-8">
            
            <div class="hidden lg:block lg:col-span-3">
                <nav class="sticky top-6 overflow-y-auto pb-4">
                    <h3 class="font-semibold text-slate-900 mb-4">İçindekiler</h3>
                    <ul class="space-y-3 text-sm">
                        <li><a href="#section-1" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">1. Giriş</a></li>
                        <li><a href="#section-2" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">2. Toplanan Veriler</a></li>
                        <li><a href="#section-3" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">3. Toplama Yöntemi</a></li>
                        <li><a href="#section-4" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">4. İşlenme Amaçları</a></li>
                        <li><a href="#section-5" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">5. Veri Aktarımı</a></li>
                        <li><a href="#section-6" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">6. Saklama Süresi</a></li>
                        <li><a href="#section-7" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">7. Çerezler</a></li>
                        <li><a href="#section-8" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">8. Veri Güvenliği</a></li>
                        <li><a href="#section-9" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">9. Haklarınız</a></li>
                        <li><a href="#section-10" class="js-scroll-link block text-slate-600 hover:text-indigo-600 hover:pl-1 transition-all">10. İletişim</a></li>
                    </ul>
                </nav>
            </div>

            <main class="lg:col-span-9">
                <div class="prose prose-slate prose-lg max-w-none bg-white rounded-2xl shadow-sm border border-slate-100 p-8 md:p-12">
                    
                    <section id="section-1" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-4 flex items-center">
                            <span class="text-indigo-600 mr-2">1.</span> Giriş
                        </h2>
                        <p class="leading-relaxed">
                            Dijitaldesin (“Şirket”, “biz”, “bizim”) olarak, kullanıcılarımızın gizliliğine önem veriyoruz.
                            Bu Gizlilik Politikası, <a href="https://dijitaldesin.com" class="text-indigo-600 hover:underline font-medium">https://dijitaldesin.com</a> adresini ziyaret ettiğinizde
                            hangi kişisel verilerin toplandığını, nasıl kullanıldığını ve nasıl korunduğunu açıklar.
                        </p>
                    </section>

                    <section id="section-2" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-4 flex items-center">
                            <span class="text-indigo-600 mr-2">2.</span> Toplanan Kişisel Veriler
                        </h2>
                        <p class="mb-4">Aşağıdaki kişisel veriler toplanabilir:</p>
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 list-none pl-0">
                            <li class="flex items-center space-x-3 bg-slate-50 p-3 rounded-lg">
                                <svg class="h-5 w-5 text-indigo-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>Ad, soyad</span>
                            </li>
                            <li class="flex items-center space-x-3 bg-slate-50 p-3 rounded-lg">
                                <svg class="h-5 w-5 text-indigo-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>E-posta adresi</span>
                            </li>
                            <li class="flex items-center space-x-3 bg-slate-50 p-3 rounded-lg">
                                <svg class="h-5 w-5 text-indigo-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>Telefon numarası</span>
                            </li>
                            <li class="flex items-center space-x-3 bg-slate-50 p-3 rounded-lg">
                                <svg class="h-5 w-5 text-indigo-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>Şirket ve web sitesi bilgileri</span>
                            </li>
                            <li class="flex items-center space-x-3 bg-slate-50 p-3 rounded-lg">
                                <svg class="h-5 w-5 text-indigo-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>IP ve tarayıcı bilgileri</span>
                            </li>
                            <li class="flex items-center space-x-3 bg-slate-50 p-3 rounded-lg">
                                <svg class="h-5 w-5 text-indigo-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>Kullanım verileri</span>
                            </li>
                        </ul>
                    </section>

                    <section id="section-3" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-4 flex items-center">
                            <span class="text-indigo-600 mr-2">3.</span> Kişisel Verilerin Toplanma Yöntemi
                        </h2>
                        <p class="mb-4">Kişisel verileriniz aşağıdaki yöntemlerle otomatik veya otomatik olmayan yollarla toplanır:</p>
                        <div class="flex flex-wrap gap-2">
                            <span class="inline-flex items-center rounded-md bg-white border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm">İletişim formları</span>
                            <span class="inline-flex items-center rounded-md bg-white border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm">Teklif talepleri</span>
                            <span class="inline-flex items-center rounded-md bg-white border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm">Çerezler</span>
                            <span class="inline-flex items-center rounded-md bg-white border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm">E-posta iletişimi</span>
                        </div>
                    </section>

                    <section id="section-4" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-4 flex items-center">
                            <span class="text-indigo-600 mr-2">4.</span> Kişisel Verilerin İşlenme Amaçları
                        </h2>
                        <ul class="list-disc pl-5 space-y-2 marker:text-indigo-500">
                            <li>Hizmetlerin sunulması ve geliştirilmesi</li>
                            <li>Teklif ve taleplerin yanıtlanması</li>
                            <li>Müşteri ilişkileri yönetimi</li>
                            <li>Pazarlama ve bilgilendirme faaliyetleri</li>
                            <li>Yasal yükümlülüklerin yerine getirilmesi</li>
                        </ul>
                    </section>

                    <section id="section-5" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-4 flex items-center">
                            <span class="text-indigo-600 mr-2">5.</span> Kişisel Verilerin Aktarılması
                        </h2>
                        <p class="mb-4">Kişisel verileriniz, KVKK ve ilgili mevzuata uygun olarak şu taraflarla paylaşılabilir:</p>
                        <ul class="list-disc pl-5 space-y-2 marker:text-indigo-500">
                            <li>Yetkili kamu kurumları</li>
                            <li>Hizmet aldığımız altyapı ve yazılım sağlayıcıları</li>
                            <li>Yasal zorunluluklar kapsamında üçüncü taraflar</li>
                        </ul>
                    </section>

                    <section id="section-6" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-4 flex items-center">
                            <span class="text-indigo-600 mr-2">6.</span> Saklama Süresi ve Güvenlik
                        </h2>
                        <div class="bg-indigo-50 rounded-xl p-6 border border-indigo-100 mb-6">
                            <h3 class="font-semibold text-indigo-900 mb-2">Saklama Süresi</h3>
                            <p class="text-indigo-800 text-sm">
                                Kişisel verileriniz, işlenme amacının gerektirdiği süre boyunca veya ilgili mevzuatta öngörülen süreler kadar saklanır. Süre sonunda veriler silinir, yok edilir veya anonim hale getirilir.
                            </p>
                        </div>
                        <h3 class="font-bold text-slate-900 mb-2">Çerezler (Cookies)</h3>
                        <p class="mb-4">
                            Dijitaldesin, kullanıcı deneyimini iyileştirmek amacıyla çerezler kullanır. Detaylı bilgi için <strong>Çerez Politikası</strong> sayfamızı inceleyebilirsiniz.
                        </p>
                        <h3 id="section-8" class="font-bold text-slate-900 mb-2">Veri Güvenliği</h3>
                        <p>
                            Kişisel verilerinizin güvenliği için uygun teknik ve idari tedbirler alınmaktadır. Yetkisiz erişim, veri kaybı veya hukuka aykırı işlem risklerine karşı gerekli önlemler uygulanır.
                        </p>
                    </section>

                    <section id="section-9" class="scroll-mt-24 mb-12">
                        <h2 class="text-2xl font-bold text-slate-900 mb-4 flex items-center">
                            <span class="text-indigo-600 mr-2">9.</span> KVKK Kapsamındaki Haklarınız
                        </h2>
                        <p class="mb-4 text-sm text-slate-500">6698 sayılı Kişisel Verilerin Korunması Kanunu’nun 11. maddesi uyarınca aşağıdaki haklara sahipsiniz:</p>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="border border-slate-200 rounded-lg p-4 hover:border-indigo-300 transition-colors">
                                <span class="block font-medium text-slate-900">Bilgi Alma Hakkı</span>
                                <span class="text-sm text-slate-500">Verilerinizin işlenip işlenmediğini öğrenme.</span>
                            </div>
                            <div class="border border-slate-200 rounded-lg p-4 hover:border-indigo-300 transition-colors">
                                <span class="block font-medium text-slate-900">Düzeltme Hakkı</span>
                                <span class="text-sm text-slate-500">Eksik veya yanlış işlenmişse düzeltilmesini isteme.</span>
                            </div>
                            <div class="border border-slate-200 rounded-lg p-4 hover:border-indigo-300 transition-colors">
                                <span class="block font-medium text-slate-900">Silme Hakkı</span>
                                <span class="text-sm text-slate-500">Silinmesini veya yok edilmesini isteme.</span>
                            </div>
                            <div class="border border-slate-200 rounded-lg p-4 hover:border-indigo-300 transition-colors">
                                <span class="block font-medium text-slate-900">İtiraz Hakkı</span>
                                <span class="text-sm text-slate-500">İşlemlerin üçüncü kişilere bildirilmesini isteme.</span>
                            </div>
                        </div>
                    </section>

                    <section id="section-10" class="scroll-mt-24">
                        <div class="bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 rounded-2xl p-8 text-white">
                            <h2 class="text-2xl font-bold mb-4">10. İletişim</h2>
                            <p class="text-slate-300 mb-6">
                                Gizlilik Politikası ile ilgili her türlü soru ve talepleriniz için bizimle iletişime geçebilirsiniz.
                            </p>
                            <div class="flex flex-col md:flex-row gap-6">
                                <a href="mailto:info@dijitaldesin.com" class="flex items-center group">
                                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-indigo-500 transition-colors">
                                        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                    </div>
                                    <span class="ml-3 text-sm font-medium">info@dijitaldesin.com</span>
                                </a>
                                <a href="https://dijitaldesin.com" class="flex items-center group">
                                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-indigo-500 transition-colors">
                                        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                                    </div>
                                    <span class="ml-3 text-sm font-medium">dijitaldesin.com</span>
                                </a>
                            </div>
                        </div>
                    </section>
                </div>
            </main>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Select all links with the class 'js-scroll-link'
        const links = document.querySelectorAll('.js-scroll-link');

        links.forEach(link => {
            link.addEventListener('click', function(e) {
                // Prevent the default anchor click behavior (which updates the URL)
                e.preventDefault();

                // Get the target element id from the href attribute (e.g., "#section-1")
                const targetId = this.getAttribute('href').substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    // Smoothly scroll to the element
                    targetElement.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    });
</script>