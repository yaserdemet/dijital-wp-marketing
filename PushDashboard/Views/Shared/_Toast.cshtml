@* 
    Toast Notification Partial View 
    This view initializes the toast container and checks for server-side messages in TempData.
*@

<div id="toast-container" class="fixed top-5 right-5 z-[99999] flex flex-col gap-3 pointer-events-none" style="z-index: 99999 !important;"></div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>Toast.success(@Json.Serialize(TempData["SuccessMessage"]));</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>Toast.error(@Json.Serialize(TempData["ErrorMessage"]));</text>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <text>Toast.warning(@Json.Serialize(TempData["WarningMessage"]));</text>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <text>Toast.info(@Json.Serialize(TempData["InfoMessage"]));</text>
        }
    });
</script>
