            {
              var isActive = currentController == item.Item1;
              <li class="flex">
                <a href="@Url.Action("Index", item.Item1)" title="@item.Item2"
                   class="flex items-center h-full px-3.5 text-sm whitespace-nowrap border-b-2 transition-colors
                   @(isActive ? "text-primary bg-primary-50 font-semibold border-primary [&_svg]:text-primary" : "text-black border-transparent hover:text-black hover:bg-gray-50")">
                  @Html.Raw(item.Item3)
                  <span>@item.Item2</span>
                </a>
              </li>
            }

            @foreach (var group in navGroups)
            {
              if (!group.Items.Any()) { continue; }
              var groupActive = group.Items.Any(i => i.Controller == currentController);
              <li class="relative flex group">
                <button type="button"
                        class="flex items-center h-full px-3.5 text-sm whitespace-nowrap border-b-2 transition-colors focus:outline-none
                        @(groupActive ? "text-primary bg-primary-50 font-semibold border-primary" : "text-black border-transparent group-hover:text-black group-hover:bg-gray-50")">
                  <span>@group.Title</span>
                  <svg class="w-3.5 h-3.5 ml-1.5 transition-transform duration-200 group-hover:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                </button>
