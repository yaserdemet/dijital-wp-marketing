                  cm.CompanyId == effectiveCompanyId.Value &&
                  cm.ModuleId == favoriteProductModule.Id &&
                  cm.IsOwned && cm.IsActive && !cm.IsPassive &&
                  (!cm.ExpiresAt.HasValue || cm.ExpiresAt.Value > DateTime.UtcNow));
              }

            }
          }
        }
