                  <ul class="min-w-[220px] bg-white rounded-xl shadow-xl border border-gray-100 py-1.5">
                    @foreach (var child in group.Items)
                    {
                      var childActive = child.Controller == currentController;
                      <li>
                        <a href="@Url.Action("Index", child.Controller)"
                           class="flex items-center mx-1.5 px-3 py-2 rounded-lg text-sm whitespace-nowrap transition-colors
                           @(childActive ? "text-primary bg-primary-50 font-semibold [&_svg]:text-primary [&_i]:text-primary" : "text-black hover:text-black hover:bg-gray-50")">
                          @Html.Raw(child.Icon)
                          <span>@child.Title</span>
                        </a>
                      </li>
                    }
                  </ul>
                </div>
              </li>
            }

            @{
              var settingsActive = currentController == "Settings" && currentAction != "CompanyInfo";
            }
            <li class="flex">
              <a href="@Url.Action("Index", "Settings")" title="Ayarlar"
                 class="flex items-center h-full px-3.5 text-sm whitespace-nowrap border-b-2 transition-colors
                 @(settingsActive ? "text-primary bg-primary-50 font-semibold border-primary [&_svg]:text-primary" : "text-black border-transparent hover:text-black hover:bg-gray-50")">
                @Html.Raw(navSettings.Item3)
                <span>@navSettings.Item2</span>
              </a>
            </li>
          </ul>
        </nav>
        <div class="flex items-center ml-auto lg:ml-0 flex-shrink-0">
          @if (User.Identity?.IsAuthenticated == true)
