                                <input type="radio" name="animationType" value="slide" class="peer sr-only" @(Model.Settings?.AnimationType == "slide" || Model.Settings?.AnimationType == null ? "checked" : "") onchange="updateAnimationType('slide')">
                                <div class="rounded-xl border-2 border-gray-200 p-3 text-center peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-gray-300">
                                    <div class="text-xs font-bold text-gray-800">Kaydırma</div>
                                </div>
                            </label>
                            <!-- Fade -->
                            <label class="cursor-pointer relative">
                                <input type="radio" name="animationType" value="fade" class="peer sr-only" @(Model.Settings?.AnimationType == "fade" ? "checked" : "") onchange="updateAnimationType('fade')">
                                <div class="rounded-xl border-2 border-gray-200 p-3 text-center peer-checked:border-green-600 peer-checked:bg-green-50 transition-all hover:border-gray-300">
                                    <div class="text-xs font-bold text-gray-800">Soluklaşma</div>
