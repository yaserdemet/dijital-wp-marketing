@section Scripts {
    <script src="~/js/modules/product-slider-module.js"></script>
    <script src="~/js/product-slider-edit.js"></script>

    <script>
        // --- UI HELPER FUNCTIONS ---

        // 1. Display Type Selection
        window.selectDisplayType = function(type) {
            // Update hidden input
            const input = document.getElementById('displayType');
            if(input) {
                input.value = type;
                input.dispatchEvent(new Event('change')); // Trigger visibility handlers
            }

            // Visual Update
            document.querySelectorAll('.display-type-card').forEach(card => {
                // Reset styling
                card.className = 'display-type-card cursor-pointer group relative rounded-xl border-2 transition-all duration-200 hover:border-blue-400 hover:shadow-md overflow-hidden bg-gray-50 border-gray-200';

                // Remove checkmark
                const check = card.querySelector('.selection-check');
                if(check) check.remove();
            });

            // Highlight selected
            // We find the card by looking at the onclick attribute somewhat loosely or assume structure
            // Better: loop and check onclick argument? simpler: use event target if passed, but here we passed string.
            // Let's re-query based on onclick attribute matching
            const cards = document.querySelectorAll('.display-type-card');
            cards.forEach(card => {
                if(card.getAttribute('onclick').includes(`'${type}'`)) {
                    card.classList.remove('border-gray-200');
                    card.classList.add('border-blue-600', 'bg-blue-50/50', 'shadow-sm');

                    // Add checkmark
                    const check = document.createElement('div');
                    check.className = 'absolute top-2 right-2 text-blue-600 bg-white rounded-full p-1 shadow-sm selection-check';
                    check.innerHTML = '<i class="fas fa-check-circle text-lg"></i>';
                    card.appendChild(check);
                }
            });
        };

        // 2. Theme Selection
        window.updateTheme = function(theme) {
            const input = document.getElementById('theme');
            if(input) input.value = theme;
        };

        // 3. Aspect Ratio Selection
        window.updateRatioUI = function(element) {
             // Reset all options
             document.querySelectorAll('.ratio-option').forEach(el => {
                 el.classList.remove('border-purple-600', 'bg-purple-50');
             });
             // Select clicked
             element.classList.add('border-purple-600', 'bg-purple-50');
        };

        // 4. Animation Type Selection
        window.updateAnimationType = function(type) {
            const input = document.getElementById('animationType');
            if(input) input.value = type;
        };

        // --- ENHANCED LOGIC FOR NEW UI ---

        document.addEventListener('DOMContentLoaded', function() {
            // Color picker synchronization
            setupColorSync('primaryColor', 'primaryColorPicker');
            setupColorSync('secondaryColor', 'secondaryColorPicker');
            setupColorSync('backgroundColor', 'backgroundColorPicker');
            setupColorSync('textColor', 'textColorPicker');

            // Visibility logic
            setupVisibilityHandlers();

            // Açıklama toggle ve kaynak değişikliklerini dinle
            const showProductDescription = document.getElementById('showProductDescription');
            const descriptionSource = document.getElementById('descriptionSource');

            if (showProductDescription) {
                showProductDescription.addEventListener('change', function() {
                    const container = document.getElementById('descriptionSourceContainer');
                    if (container) {
                        container.classList.toggle('hidden', !this.checked);
                    }
                    updateManualDescriptionVisibility();
                });
            }

            if (descriptionSource) {
                descriptionSource.addEventListener('change', function() {
                    updateManualDescriptionVisibility();
                    updateDescriptionPreviews();
                    window.updateManualDescButtons();
                });
            }

            window.updateManualDescButtons = function() {
                const source = document.getElementById('descriptionSource')?.value || 'manual';
                const isManual = source === 'manual';
                document.querySelectorAll('.btn-toggle-manual-desc').forEach(btn => {
                    if (isManual) {
                        btn.removeAttribute('disabled');
                        btn.classList.remove('opacity-50', 'cursor-not-allowed');
                        btn.title = 'Açıklama Düzenle';
                    } else {
                        btn.setAttribute('disabled', 'disabled');
                        btn.classList.add('opacity-50', 'cursor-not-allowed');
                        btn.title = 'Açıklama kaynağı manuel seçili değilken bu düğme kullanılamaz.';
                    }
                });
            };

            function updateDescriptionPreviews() {
                const source = descriptionSource?.value || 'manual';
                document.querySelectorAll('.description-preview').forEach(el => {
                    const id = el.id?.replace('descriptionPreview-', '');
                    if (!id) return;
                    const manualEl = document.getElementById('manualDescription-' + id);
                    const manual = manualEl?.value?.trim() || '';
                    const product = (el.getAttribute('data-product-description') || '').trim();
                    const text = source === 'manual' ? manual : product;
                    el.textContent = text || '';
                    el.title = text || '';
                });
            }

            // Manuel açıklama görünürlüğünü güncelle
            function updateManualDescriptionVisibility() {
                const isDescriptionEnabled = showProductDescription?.checked || false;
                const source = descriptionSource?.value || 'manual';
                const showManual = isDescriptionEnabled && source === 'manual';

                document.querySelectorAll('[id^="manualDescriptionContainer-"]').forEach(container => {
                    if (showManual) {
                        container.classList.remove('hidden');
                    } else {
                        container.classList.add('hidden');
                    }
                });
            }

            // Toggle manual description
            window.toggleManualDescription = function(itemId) {
                const container = document.getElementById(`manualDescriptionContainer-${itemId}`);
                if (container) {
                    container.classList.toggle('hidden');
                    if (!container.classList.contains('hidden')) {
                        const textarea = document.getElementById(`manualDescription-${itemId}`);
                        if (textarea) {
                            textarea.focus();
                        }
                    }
                }
            };

            // Listen to all inputs for preview update
            const inputs = document.querySelectorAll('input, select, textarea');
            inputs.forEach(input => {
                input.addEventListener('input', () => {
                    handleVisibilityChange(input);
                    if (input.id && input.id.startsWith('manualDescription-')) updateDescriptionPreviews();
                });
                input.addEventListener('change', () => {
                    handleVisibilityChange(input);
                    if (input.id && input.id.startsWith('manualDescription-')) updateDescriptionPreviews();
                });
            });

            // Initial checks
            handleVisibilityChange(document.getElementById('displayType'));
            handleVisibilityChange(document.getElementById('enableAnimations'));

            window.updateManualDescButtons();

            // Initialize Status UI
            updateStatusUI();
        });

        window.toggleStatus = function() {
            const checkbox = document.getElementById('isActive');
            if(checkbox) {
                checkbox.checked = !checkbox.checked;
                updateStatusUI();
            }
        };

        window.updateStatusUI = function() {
            const checkbox = document.getElementById('isActive');
            const btn = document.getElementById('statusBtn');
            const indicator = document.getElementById('statusIndicator');
            const text = document.getElementById('statusText');

            if(checkbox && btn && indicator && text) {
                if(checkbox.checked) {
                    // Active State
                    btn.className = "px-3 lg:px-4 py-2 text-xs lg:text-sm font-medium rounded-lg transition-all flex items-center justify-center gap-2 border shadow-sm whitespace-nowrap w-full md:w-auto bg-green-50 text-green-700 border-green-200 hover:bg-green-100";
                    indicator.className = "w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse flex-shrink-0";
                    text.textContent = "Aktif";
                } else {
                    // Passive State
                    btn.className = "px-3 lg:px-4 py-2 text-xs lg:text-sm font-medium rounded-lg transition-all flex items-center justify-center gap-2 border shadow-sm whitespace-nowrap w-full md:w-auto bg-gray-50 text-gray-600 border-gray-200 hover:bg-gray-100";
                    indicator.className = "w-2.5 h-2.5 rounded-full bg-gray-400 flex-shrink-0";
                    text.textContent = "Pasif";
                }
            }
        };

        function setupColorSync(textId, pickerId) {
            const text = document.getElementById(textId);
            const picker = document.getElementById(pickerId);

            if(text && picker) {
                picker.addEventListener('input', () => { text.value = picker.value; });
                // Only if user types a valid hex
                text.addEventListener('input', () => {
                   if(/^#[0-9A-Fa-f]{6}$/i.test(text.value)) {
                       picker.value = text.value;
                   }
                });
            }
        }

        function setupVisibilityHandlers() {
             // Handled largely by the generic input listener calling handleVisibilityChange
        }

        function handleVisibilityChange(input) {
            if(!input) return;

            if(input.id === 'displayType') {
                const isSlider = input.value === 'slider';
                const sliderSettings = document.querySelectorAll('.slider-only-settings');
                sliderSettings.forEach(el => {
                    if(isSlider) el.classList.remove('hidden');
                    else el.classList.add('hidden');
                });
            }

            if(input.id === 'enableAnimations') {
                const container = document.getElementById('animationSettingsContainer');
                if(container) {
                     if(input.checked) container.classList.remove('opacity-50', 'pointer-events-none');
                     else container.classList.add('opacity-50', 'pointer-events-none');
                }
            }
        }


        // --- OVERRIDES FOR PREVIEW & SAVING ---

        window.triggerPreview = function() {
            console.log('[Edit] triggerPreview clicked');
            try {
                const config = window.getPreviewConfig();
                console.log('[Edit] Preview config:', config);

                // If it's a slider, grid or tabs, we trigger the popup directly
                if (config.displayType === 'slider' || config.displayType === 'grid' || config.displayType === 'tabs') {
                     if (window.productSlider) {
                         // Force inject base styles first
                         if (window.productSlider && typeof window.productSlider.injectBaseStyles === 'function') {
                             if (!document.getElementById('pushonica-slider-base-styles')) {
                                 window.productSlider.injectBaseStyles();
                             }
                         }

                         // Inject CSS first (using renderSlider logic part)
                         const styleId = `pushonica-style-${config.id || 'preview'}`;
                         let styleTag = document.getElementById(styleId);
                         if(styleTag) styleTag.remove();

                         styleTag = document.createElement('style');
                         styleTag.id = styleId;
                         // Use generateDynamicCSS to include all styles (layout + theme)
                         styleTag.textContent = window.productSlider.generateDynamicCSS(config.settings, config.id || 'preview');
                         document.head.appendChild(styleTag);

                         // Fix: Always remove existing preview popup to force fresh re-render
                         const existingPopup = document.querySelector(`.pushonica-slider-popup-${config.id || 'preview'}`);
                         if(existingPopup) {
                             existingPopup.remove();
                         }

                         // Now trigger the overlay
                         window.productSlider.showSliderOverlay(config);
                     }
                }
            } catch (e) {
                console.error(e);
                showNotification("Önizleme başlatılamadı: " + e.message, 'error');
            }
        };

        window.saveAllSettings = async function() {
            const saveBtn = document.querySelector('button[onclick="saveAllSettings()"]');
            const originalContent = saveBtn.innerHTML;
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...';

            try {
                // 1. Save Info
                const sliderId = document.getElementById('sliderId').value;


                // Settings Data
                const sliderNameEl = document.getElementById('sliderName');
                const sliderDescEl = document.getElementById('sliderDescription');
                const displayTypeEl = document.getElementById('displayType');
                const isActiveEl = document.getElementById('isActive');
                const descriptionSourceEl = document.getElementById('descriptionSource');

                const itemManualDescriptions = [];
                if (descriptionSourceEl?.value === 'manual') {
                    document.querySelectorAll('#productsList .product-item').forEach((el) => {
                        const itemId = parseInt(el.getAttribute('data-item-id'));
                        if (isNaN(itemId)) return;
                        const textarea = document.getElementById('manualDescription-' + itemId);
                        const value = textarea?.value?.trim() || '';
                        if (value) {
                            itemManualDescriptions.push({ itemId: itemId, manualDescription: value });
                        }
                    });
                }

                const settingsData = {
                    sliderId: parseInt(sliderId),
                    name: sliderNameEl?.value || null,
                    description: sliderDescEl?.value || null,
                    displayType: displayTypeEl?.value || null,
                    isActive: isActiveEl?.checked ?? null,
                    itemManualDescriptions: itemManualDescriptions.length ? itemManualDescriptions : null,
                    autoPlay: document.getElementById('autoPlay')?.checked ?? true,
                    autoPlayInterval: parseInt(document.getElementById('autoPlayInterval')?.value) || 5000,
                    showArrows: document.getElementById('showArrows')?.checked ?? true,
                    showDots: document.getElementById('showDots')?.checked ?? true,
                    itemsPerView: parseInt(document.getElementById('itemsPerView')?.value) || 4,
                    itemsPerViewMobile: parseInt(document.getElementById('itemsPerViewMobile')?.value) || 1,
                    itemsPerViewTablet: parseInt(document.getElementById('itemsPerViewTablet')?.value) || 2,
                    theme: document.getElementById('theme')?.value || 'modern',
                    primaryColor: document.getElementById('primaryColor')?.value || '#02379c',
                    secondaryColor: document.getElementById('secondaryColor')?.value || '#1f2937',
                    backgroundColor: document.getElementById('backgroundColor')?.value || '#ffffff',
                    textColor: document.getElementById('textColor')?.value || '#1F2937',
                    enableAnimations: document.getElementById('enableAnimations')?.checked ?? true,
                    transitionDuration: parseInt(document.getElementById('transitionDuration')?.value) || 300,
                    animationType: document.getElementById('animationType')?.value || 'slide',
                    showProductPrice: document.getElementById('showProductPrice')?.checked ?? true,
                    showProductDescription: document.getElementById('showProductDescription')?.checked ?? false,
                    showProductImage: document.getElementById('showProductImage')?.checked ?? true,
                    imageAspectRatio: document.getElementById('imageAspectRatio')?.value || 'square',
                    descriptionSource: document.getElementById('descriptionSource')?.value || 'manual',
                    customCSS: document.getElementById('customCSS')?.value || ''
                };

                 const settingsResponse = await fetch('/ProductSlider/UpdateSliderSettings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(settingsData)
                });

                if (!settingsResponse.ok) {
                    const errorText = await settingsResponse.text();
                    console.error('UpdateSliderSettings error:', settingsResponse.status, errorText);
                    try {
                        const errorJson = JSON.parse(errorText);
                        showNotification(errorJson.message || 'Ayarlar kaydedilirken hata oluştu.', 'error');
                    } catch {
                        showNotification('Ayarlar kaydedilirken hata oluştu: ' + errorText, 'error');
                    }
                    return;
                }

                const settingsResult = await settingsResponse.json();
                if (!settingsResult.success) {
                    showNotification(settingsResult.message || 'Ayarlar kaydedilirken hata oluştu.', 'error');
                    return;
                }

                 showNotification('Tüm ayarlar başarıyla kaydedildi!', 'success');

            } catch(e) {
                console.error("Save error:", e);
                showNotification('Kaydederken bir hata oluştu: ' + e.message, 'error');
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalContent;
            }
        };

        window.getPreviewConfig = function() {
            const products = [];
             document.querySelectorAll('#productsList .product-item').forEach((el) => {
                const title = el.querySelector('h4')?.textContent;
                const priceText = el.querySelector('.text-blue-600')?.textContent;
                const img = el.querySelector('img')?.src;
                products.push({
                    productTitle: title || 'Ürün',
                    productPrice: priceText ? parseFloat(priceText.split(' ')[0]) : 0,
                    currency: 'TRY',
                    productImage: img || '',
                    productUrl: '#',
                    productDescription: 'Örnek açıklama metni'
                });
            });

             if (products.length === 0) {
                 for(let i=1; i<=5; i++) {
                     products.push({
                         productTitle: 'Örnek Ürün ' + i,
                         productPrice: 150 * i,
                         currency: 'TRY',
                         productImage: 'https://via.placeholder.com/300x300?text=Product+' + i,
                         productDescription: 'Bu bir örnek ürün açıklamasıdır.'
                     });
                 }
            }

            return {
                id: 'preview',
                sliderId: 'preview',
                name: document.getElementById('sliderName').value,
                displayType: document.getElementById('displayType').value,
                items: products,
                settings: {
                    autoPlay: document.getElementById('autoPlay')?.checked ?? true,
                    autoPlayInterval: parseInt(document.getElementById('autoPlayInterval')?.value) || 5000,
                    showArrows: document.getElementById('showArrows')?.checked ?? true,
                    showDots: document.getElementById('showDots')?.checked ?? true,
                    itemsPerView: parseInt(document.getElementById('itemsPerView')?.value) || 4,
                    itemsPerViewMobile: parseInt(document.getElementById('itemsPerViewMobile')?.value) || 1,
                    itemsPerViewTablet: parseInt(document.getElementById('itemsPerViewTablet')?.value) || 2,
                    theme: document.getElementById('theme')?.value || 'modern',
                    primaryColor: document.getElementById('primaryColor')?.value || '#02379c',
                    secondaryColor: document.getElementById('secondaryColor')?.value || '#1f2937',
                    backgroundColor: document.getElementById('backgroundColor')?.value || '#ffffff',
                    textColor: document.getElementById('textColor')?.value || '#1F2937',
                    enableAnimations: document.getElementById('enableAnimations')?.checked ?? true,
                    transitionDuration: parseInt(document.getElementById('transitionDuration')?.value) || 300,
                    animationType: document.getElementById('animationType')?.value || 'slide',
                    showProductPrice: document.getElementById('showProductPrice')?.checked ?? true,
                    showProductDescription: document.getElementById('showProductDescription')?.checked ?? false,
                    showProductImage: document.getElementById('showProductImage')?.checked ?? true,
                    imageAspectRatio: document.getElementById('imageAspectRatio')?.value || 'square',
                    customCSS: document.getElementById('customCSS')?.value || ''
                }
            };
        };

        window.renderPreview = function() {
           // Disabled auto-render for clean separation
        };

        // Product List HTML Generator (Keep compatible)
        window.createProductItemHTML = function(product, itemId) {
             const priceVal = parseFloat(product.price) || 0;
             const discountVal = product.discountPrice != null ? parseFloat(product.discountPrice) : null;
             const name = product.name || 'Ürün';
             const image = product.image || '';
             const currency = product.currency || 'TRY';
             const kdvIncluded = product.kdvIncluded !== false;
             const taxRate = typeof product.taxRate === 'number' ? product.taxRate : (parseFloat(product.taxRate) || 18);
             const fmt = (n) => (Number(n).toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }));
             let priceDisplay = priceVal;
             let origDisplay = discountVal;
             if (!kdvIncluded && priceVal > 0) {
                 priceDisplay = Math.round(priceVal * (1 + taxRate / 100) * 100) / 100;
                 if (origDisplay != null && origDisplay > 0) origDisplay = Math.round(origDisplay * (1 + taxRate / 100) * 100) / 100;
             }
             const hasDiscount = origDisplay != null && origDisplay > priceDisplay;
             const priceHtml = priceVal > 0 ? (hasDiscount ? `<span class="text-xs text-gray-400 line-through opacity-75">${fmt(origDisplay)} ${currency}</span>` : '') + `<span class="text-sm text-blue-600 font-bold bg-blue-50 px-2 py-0.5 rounded">${fmt(priceDisplay)} ${currency}</span><span class="text-xs ${kdvIncluded ? 'text-green-600' : 'text-gray-500'}">${kdvIncluded ? 'KDV dahil değil' : 'KDV dahil'}</span>` : '';
             const imageHtml = image ? `<img src="${image}" alt="${name}" class="w-full h-full object-cover">` : `<div class="w-full h-full flex items-center justify-center text-gray-300"><i class="fas fa-image text-xl"></i></div>`;

             return `
                <div class="group bg-white border border-gray-200 rounded-xl p-3 hover:shadow-md transition-all product-item" data-item-id="${itemId}" data-item-active="true" draggable="true">
                    <div class="flex items-center gap-4">
                        <div class="drag-handle cursor-move text-gray-300 hover:text-gray-500 p-2"><i class="fas fa-grip-vertical"></i></div>
                        <div class="relative w-16 h-16 rounded-lg overflow-hidden bg-gray-100 border border-gray-100 flex-shrink-0">${imageHtml}</div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-semibold text-gray-900 truncate" title="${name}">${name}</h4>
                            <div class="flex items-center gap-3 mt-1 flex-wrap">${priceHtml}</div>
                        </div>
                        <div class="flex items-center gap-1 px-2">
                             <button type="button" onclick="toggleProductStatus(${itemId})" class="p-2 text-green-600 hover:bg-green-50 rounded-lg transition-all" title="Aktif - Pasife al"><i class="fas fa-eye"></i></button>
                             <button type="button" class="btn-toggle-manual-desc p-2 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all" data-item-id="${itemId}" title="Açıklama Düzenle" onclick="if(document.getElementById('descriptionSource')?.value==='manual') toggleManualDescription(${itemId})"><i class="fas fa-align-left"></i></button>
                             <button onclick="deleteProduct(${itemId})" class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all"><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                </div>`;
        };

        window.addProductToDOM = function(product, itemId) {
             const emptyState = document.getElementById('emptyState');
             if(emptyState) emptyState.style.display = 'none';

             const productsList = document.getElementById('productsList');
             if(productsList) {
                 const html = window.createProductItemHTML(product, itemId);
                 productsList.insertAdjacentHTML('beforeend', html);
                 if(typeof window.updateManualDescButtons === 'function') window.updateManualDescButtons();
                 if(typeof initializeDragAndDrop === 'function') initializeDragAndDrop();
                 const countBadge = document.getElementById('productCountBadge');
                 const count = document.querySelectorAll('.product-item').length;
                 if(countBadge) countBadge.textContent = count;
             }
        };

        window.loadEcommerceProducts = async function(page = 1) {
            const searchTerm = document.getElementById('productSearch')?.value || '';
            const categoryId = document.getElementById('categoryFilter')?.value || '';
            const brandId = document.getElementById('brandFilter')?.value || '';
            const inStock = document.getElementById('stockFilter')?.value || '';

            if(typeof window.showEcommerceLoading === 'function') window.showEcommerceLoading(true);

            try {
                 const sliderId = document.getElementById('sliderId').value;
                 const params = new URLSearchParams({
                    page: page,
                    pageSize: 10,
                    sliderId: sliderId,
                    ...(searchTerm && { searchTerm }),
                    ...(categoryId && { categoryId }),
                    ...(brandId && { brandId }),
                    ...(inStock && { inStock })
                });

                const response = await fetch(`/ProductSlider/GetEcommerceProducts?${params}`);
                const result = await response.json();

                if (result.success) {
                    if(typeof window.displayEcommerceProducts === 'function') window.displayEcommerceProducts(result.data);
                    if(typeof window.displayPagination === 'function') window.displayPagination(result.pagination);
                    if(typeof currentPage !== 'undefined') currentPage = page;
                } else {
                     if(typeof window.showError === 'function') window.showError(result.message || 'Ürünler yüklenirken hata oluştu.');
                     if(typeof window.showEcommerceEmpty === 'function') window.showEcommerceEmpty(true);
                     if(typeof window.hidePagination === 'function') window.hidePagination();
                }
            } catch (error) {
                console.error('Error loading ecommerce products:', error);
                if(typeof window.showEcommerceEmpty === 'function') window.showEcommerceEmpty(true);
            } finally {
                if(typeof window.showEcommerceLoading === 'function') window.showEcommerceLoading(false);
            }
        };

        // EXPLICIT OVERRIDE FOR SELECTION DISPLAY TO FIX MISSING ELEMENT ERRORS
        window.updateSelectedProductsDisplay = function() {
            const section = document.getElementById('selectedProductsSection');
            const countSpan = document.getElementById('selectedCount');
            const addBtn = document.getElementById('addSelectedBtn');

            if(countSpan) countSpan.textContent = selectedEcommerceProducts.length;
            if(addBtn) addBtn.disabled = selectedEcommerceProducts.length === 0;

            if (section) {
                if (selectedEcommerceProducts.length > 0) {
                    section.classList.remove('hidden');
                } else {
                    section.classList.add('hidden');
                }
            }
        };


    </script>
}
