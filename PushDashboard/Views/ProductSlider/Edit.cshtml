    <!-- Products Card -->
    <div class="lg:col-span-6 xl:col-span-5 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden lg:sticky lg:top-24">
        <div class="px-4 py-3 lg:px-6 lg:py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center flex-wrap gap-2">
            <div class="flex items-center gap-2">
                <h3 class="font-semibold text-gray-900">Ürünler</h3>
                <span id="productCountBadge" class="bg-blue-100 text-blue-700 text-xs font-bold px-2 py-0.5 rounded-full">@Model.Items.Count</span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="syncWithTicimax()" id="syncTicimaxBtn" class="bg-amber-500 hover:bg-amber-600 text-white px-3 py-1.5 lg:px-4 lg:py-2 rounded-lg text-xs lg:text-sm font-medium transition-all shadow-sm hover:shadow flex items-center gap-2">
                    <i class="fas fa-sync-alt"></i> <span class="hidden sm:inline">Ticimaxla Eşitle</span>
                </button>
                <button onclick="openEcommerceProductModal()" class="bg-gray-900 hover:bg-black text-white px-3 py-1.5 lg:px-4 lg:py-2 rounded-lg text-xs lg:text-sm font-medium transition-all shadow-sm hover:shadow flex items-center gap-2">
                    <i class="fas fa-plus"></i> <span class="hidden sm:inline">Ürün Ekle</span><span class="sm:hidden">Ekle</span>
                </button>
            </div>
        </div>

        <div class="p-3 lg:p-6 bg-gray-50/30">
            <div id="productsList" class="space-y-3 min-h-[100px]">
                <!-- Empty State -->
                <div id="emptyState" class="@(Model.Items.Any() ? "hidden" : "") flex flex-col items-center justify-center py-10 text-center border-2 border-dashed border-gray-200 rounded-xl bg-gray-50/50 hover:bg-gray-50 transition-colors cursor-pointer" onclick="openEcommerceProductModal()">
                    <div class="w-16 h-16 rounded-full bg-white shadow-sm border border-gray-100 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i class="fas fa-box-open text-gray-300 text-2xl"></i>
                    </div>
                    <h4 class="text-sm font-semibold text-gray-800">Henüz ürün eklenmemiş</h4>
                    <p class="text-xs text-gray-500 mt-1 max-w-[200px]">Sürükle bırak yapmak veya ürün eklemek için yukarıdaki butonu kullanın.</p>
                </div>

                @foreach (var item in Model.Items.OrderBy(i => i.SortOrder))
                {
                    <div class="group bg-white border border-gray-200 rounded-xl p-2 sm:p-3 hover:shadow-md transition-all product-item @(item.IsActive ? "" : "product-item-inactive")" data-item-id="@item.Id" data-item-active="@(item.IsActive ? "true" : "false")">
                        <div class="flex items-center gap-2 sm:gap-3">
                            <div class="drag-handle cursor-move text-gray-300 hover:text-gray-500 p-1 sm:p-2 flex-shrink-0">
                                <i class="fas fa-grip-vertical"></i>
                            </div>

                            <div class="relative w-12 h-12 sm:w-16 sm:h-16 rounded-lg overflow-hidden bg-gray-100 border border-gray-100 flex-shrink-0">
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@item.ProductImage" alt="@item.ProductTitle" class="w-full h-full object-cover">
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-gray-300">
                                        <i class="fas fa-image text-xl"></i>
                                    </div>
                                }
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h4 class="font-semibold text-gray-900 truncate" title="@item.ProductTitle">@item.ProductTitle</h4>
                                    @if (!item.IsActive)
                                    {
                                        <span class="item-status-badge">Pasif</span>
                                    }
                                </div>
                                <div class="flex items-center gap-3 mt-1 flex-wrap">
                                    @if (item.ProductPrice.HasValue || item.DiscountPrice.HasValue)
                                    {
                                        var taxRateDec = (decimal)(item.TaxRate > 0 ? item.TaxRate : 18) / 100m;
                                        var hasDiscount = item.DiscountPrice.HasValue && item.DiscountPrice > item.ProductPrice;
                                        decimal priceDisplay = item.ProductPrice ?? 0;
                                        decimal? origDisplay = hasDiscount ? item.DiscountPrice : null;
                                        if (!item.KdvIncluded && item.ProductPrice.HasValue)
                                        {
                                            priceDisplay = Math.Round(item.ProductPrice.Value * (1 + taxRateDec), 2);
                                            if (origDisplay.HasValue)
                                                origDisplay = Math.Round(origDisplay.Value * (1 + taxRateDec), 2);
                                        }
                                        <span class="inline-flex items-baseline gap-2 flex-wrap">
                                            @if (origDisplay.HasValue && origDisplay > priceDisplay)
                                            {
                                                <span class="text-xs text-gray-400 line-through opacity-75">@origDisplay.Value.ToString("N0") @item.Currency</span>
                                            }
                                            @if (item.ProductPrice.HasValue)
                                            {
                                                <span class="text-sm text-blue-600 font-bold bg-blue-50 px-2 py-0.5 rounded">@priceDisplay.ToString("N0") @item.Currency</span>
                                            }
                                            <span class="text-xs @(item.KdvIncluded ? "text-green-600" : "text-gray-500")">@(item.KdvIncluded ? "KDV dahil değil" : "KDV dahil")</span>
                                        </span>
                                    }
                                    <a href="@item.ProductUrl" target="_blank" class="text-xs text-gray-400 hover:text-blue-500 truncate max-w-[200px] hover:underline">
                                        <i class="fas fa-external-link-alt mr-1"></i> Ürüne Git
                                    </a>
                                </div>
                                @{
                                    var descSourceForItem = Model.Settings?.DescriptionSource ?? "manual";
                                    var effectiveDesc = string.Equals(descSourceForItem, "manual", StringComparison.OrdinalIgnoreCase) ? item.ManualDescription : item.ProductDescription;
                                }
                                <p class="mt-1.5 text-xs text-gray-500 line-clamp-3 break-words description-preview" id="descriptionPreview-@item.Id" data-product-description="@(item.ProductDescription != null ? System.Net.WebUtility.HtmlEncode(item.ProductDescription) : "")" title="@(effectiveDesc ?? "")">@(effectiveDesc ?? "")</p>
                                <div class="mt-2 @(string.IsNullOrWhiteSpace(item.ManualDescription) ? "hidden" : "")" id="manualDescriptionContainer-@item.Id">
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Manuel Açıklama</label>
                                    <textarea
                                                id="manualDescription-@item.Id"
                                                data-item-id="@item.Id"
                                                rows="2"
                                                class="w-full px-2 py-1.5 text-xs rounded-lg border border-gray-300 focus:border-blue-500 focus:ring-blue-500 resize-none"
                                                placeholder="Bu ürün için özel açıklama girin...">@item.ManualDescription</textarea>
                                </div>
                            </div>

                            @{
                                var isManualDesc = string.Equals(Model.Settings?.DescriptionSource ?? "manual", "manual", StringComparison.OrdinalIgnoreCase);
                            }
                            <div class="flex flex-col sm:flex-row items-center gap-0.5 sm:gap-1 px-0 sm:px-1 flex-shrink-0">
                                <button type="button" onclick="toggleProductStatus(@item.Id)" class="p-1.5 sm:p-2 @(item.IsActive ? "text-green-600 hover:bg-green-50" : "text-gray-400 hover:bg-gray-100") rounded-lg transition-all" title="@(item.IsActive ? "Aktif - Pasife al" : "Pasif - Aktife al")">
                                    <i class="fas fa-@(item.IsActive ? "eye" : "eye-slash")"></i>
                                </button>
                                <button type="button" class="btn-toggle-manual-desc p-1.5 sm:p-2 @(string.IsNullOrWhiteSpace(item.ManualDescription) ? "text-gray-400" : "text-blue-600") hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all @(!isManualDesc ? "opacity-50 cursor-not-allowed" : "")" data-item-id="@item.Id" title="@(isManualDesc ? "Açıklama Düzenle" : "Açıklama kaynağı manuel seçili değilken bu düğme kullanılamaz.")" @(!isManualDesc ? "disabled" : "") onclick="if(document.getElementById('descriptionSource')?.value==='manual') toggleManualDescription(@item.Id)">
                                    <i class="fas fa-align-left"></i>
                                </button>
                                <button onclick="deleteProduct(@item.Id)" class="p-1.5 sm:p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Sil">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>


    </div>
    </div>
</main>

