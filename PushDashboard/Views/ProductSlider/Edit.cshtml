@model PushDashboard.DTOs.ProductSliderDetailResponseDto
@{
    // Created by AI - Modernized Edit Page with Centralized Preview
    ViewData["Title"] = "Slider Düzenle - " + Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .product-item {
            cursor: grab;
            transition: all 0.2s ease;
        }
        .product-item:active {
            cursor: grabbing;
        }
        .product-item.dragging {
            opacity: 0.4;
            transform: scale(0.98);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        /* Color Input Styles */
        .color-input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }
        .color-input-wrapper input[type="color"] {
            -webkit-appearance: none;
            border: none;
            width: 40px;
            height: 40px;
            cursor: pointer;
            padding: 0;
            background: none;
        }
        .color-input-wrapper input[type="color"]::-webkit-color-swatch-wrapper {
            padding: 0;
        }
        .color-input-wrapper input[type="color"]::-webkit-color-swatch {
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem
        }
        .slider-preview-sticky {
            position: sticky;
            top: 2rem;
            z-index: 10;
        }
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .product-item.product-item-inactive {
            opacity: 0.75;
            border-color: #e5e7eb;
            background: #f9fafb;
        }
        .product-item.product-item-inactive .item-status-badge {
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            background: #e5e7eb;
            color: #6b7280;
        }
    </style>
}

@Html.AntiForgeryToken()
<input type="hidden" id="sliderId" value="@Model.Id" />

<main class="min-h-screen bg-gray-50/50 pb-20">
    <!-- Header -->
    <div class="sticky top-2 lg:top-4 z-20 px-2 lg:px-6 mb-4 lg:mb-6">
        <div class="max-w-[1600px] mx-auto flex flex-col md:flex-row items-center justify-between gap-3 md:gap-0 bg-white/90 backdrop-blur-md border border-gray-200 rounded-2xl shadow-sm px-4 py-3 lg:px-6 lg:py-4">
            <div class="flex items-center gap-3 lg:gap-4 w-full md:w-auto">
                <a href="@Url.Action("Index")" class="p-2 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-all flex-shrink-0">
                    <i class="fas fa-arrow-left text-lg"></i>
                </a>
                <div class="min-w-0">
                    <h2 class="text-lg lg:text-xl font-bold text-gray-900 truncate">Slider Düzenle</h2>
                    <div class="flex items-center gap-2 text-xs lg:text-sm text-gray-500 truncate">
                        <span class="truncate">@Model.Name</span>
                        <span class="w-1 h-1 rounded-full bg-gray-300 flex-shrink-0"></span>
                        <span class="text-blue-600 font-medium flex-shrink-0">Düzenleniyor</span>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-2 md:flex md:items-center gap-2 lg:gap-3 w-full md:w-auto mt-2 md:mt-0 justify-end">
                 <!-- Status Toggle -->
                 <input type="checkbox" id="isActive" name="isActive" @(Model.IsActive ? "checked" : "") class="hidden">
                 <button type="button" onclick="toggleStatus()" id="statusBtn" class="px-3 lg:px-4 py-2 text-xs lg:text-sm font-medium rounded-lg transition-all flex items-center justify-center gap-2 border shadow-sm whitespace-nowrap w-full md:w-auto">
                    <span id="statusIndicator" class="w-2.5 h-2.5 rounded-full flex-shrink-0"></span>
                    <span id="statusText"></span>
                 </button>

                 <button type="button" onclick="triggerPreview()" class="px-3 lg:px-4 py-2 text-xs lg:text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 shadow-sm transition-all flex items-center justify-center md:justify-start gap-2 whitespace-nowrap w-full md:w-auto">
                    <i class="fas fa-play"></i> <span class="hidden sm:inline">Önizleme</span><span class="inline sm:hidden">Önizle</span>
                </button>
                 <button type="button" onclick="saveAllSettings()" class="px-4 lg:px-6 py-2 text-xs lg:text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-sm hover:shadow transition-all flex items-center justify-center md:justify-start gap-2 whitespace-nowrap w-full md:w-auto">
                    <i class="fas fa-save"></i> Kaydet
                </button>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-[1600px] mx-auto px-2 lg:px-6 py-4 lg:py-8">

    <!-- Settings and Content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8 items-start">

    <!-- General Settings & Configuration -->
    <div class="lg:col-span-6 xl:col-span-7 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-4 lg:px-6 py-3 border-b border-gray-100 bg-gray-50/50">
        <h3 class="font-semibold text-gray-900 text-lg">Genel Ayarlar</h3>
    </div>

    <div class="p-4 lg:p-6 pt-4 space-y-6 lg:space-y-8">
    <!-- General Info Form -->
    <form id="sliderInfoForm" class="space-y-4 lg:space-y-6">
        <div class="space-y-4 lg:space-y-6">
            <!-- Basic Info -->
            <div class="space-y-3 lg:space-y-5">
                                <div>
                                    <label for="sliderName" class="block text-sm font-semibold text-gray-800 mb-2">Slider Adı</label>
                                    <input type="text" id="sliderName" name="name" value="@Model.Name" required
                                            class="block w-full px-4 py-2.5 rounded-xl border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm transition-all focus:shadow-md outline-none">
                                </div>
                                <div>
                                    <label for="sliderDescription" class="block text-sm font-semibold text-gray-800 mb-2">Açıklama</label>
                                    <textarea id="sliderDescription" name="description" rows="3"
                                        class="block w-full px-4 py-2.5 rounded-xl border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm resize-none transition-all focus:shadow-md outline-none">@Model.Description</textarea>
                </div>
            </div>

            <!-- Visual Selection for Display Type -->
            <div>
                <label class="block text-sm font-semibold text-gray-800 mb-3">Görüntüleme Tipi</label>
                <input type="hidden" id="displayType" name="displayType" value="@Model.DisplayType">
                <div class="grid grid-cols-3 gap-2 sm:gap-3 lg:gap-4">
                    <!-- Slider Card -->
                    <div class="display-type-card cursor-pointer group relative rounded-xl border-2 transition-all duration-200 hover:border-blue-400 hover:shadow-md overflow-hidden bg-gray-50 @(Model.DisplayType == "slider" ? "border-blue-600 bg-blue-50/50 shadow-sm" : "border-gray-200")"
                         onclick="selectDisplayType('slider')">
                        <div class="aspect-video w-full bg-white border-b border-gray-200 flex items-center justify-center p-2 sm:p-3 relative overflow-hidden">
                            <!-- Visual Mockup -->
                            <div class="flex gap-1 sm:gap-2 w-full overflow-hidden opacity-60">
                                <div class="h-8 sm:h-12 flex-1 bg-gray-200 rounded-md"></div>
                                <div class="h-8 sm:h-12 flex-1 bg-gray-200 rounded-md"></div>
                                <div class="h-8 sm:h-12 flex-1 bg-gray-200 rounded-md"></div>
                            </div>
                            <!-- Arrow overlay -->
                            <div class="absolute inset-x-1 flex justify-between text-gray-400">
                                <i class="fas fa-chevron-left text-[10px] sm:text-xs"></i>
                                <i class="fas fa-chevron-right text-[10px] sm:text-xs"></i>
                            </div>
                        </div>
                        <div class="p-2 sm:p-3 text-center">
                            <span class="block text-xs sm:text-sm font-semibold text-gray-800">Slider</span>
                        </div>
                        @if (Model.DisplayType == "slider")
                        {
                            <div class="absolute top-1 right-1 sm:top-2 sm:right-2 text-blue-600 bg-white rounded-full p-0.5 sm:p-1 shadow-sm selection-check"><i class="fas fa-check-circle text-base sm:text-lg"></i></div>
                        }
                    </div>

                    <!-- Tabs Card -->
                    <div class="display-type-card cursor-pointer group relative rounded-xl border-2 transition-all duration-200 hover:border-blue-400 hover:shadow-md overflow-hidden bg-gray-50 @(Model.DisplayType == "tabs" ? "border-blue-600 bg-blue-50/50 shadow-sm" : "border-gray-200")"
                         onclick="selectDisplayType('tabs')">
                        <div class="aspect-video w-full bg-white border-b border-gray-200 flex items-center justify-center p-2 sm:p-3">
                            <!-- Sidebar Layout Mockup (Right Sidebar) -->
                            <div class="flex h-full w-full gap-1 sm:gap-2 box-border opacity-80">
                                <div class="w-2/3 flex flex-col gap-1 sm:gap-2 pt-1">
                                    <div class="h-8 sm:h-10 w-full bg-gray-100 rounded-lg border border-gray-50"></div>
                                    <div class="h-1.5 sm:h-2 w-1/2 bg-gray-100 rounded-full"></div>
                                </div>
                                <div class="w-1/3 bg-gray-50 rounded-lg h-full flex flex-col gap-1 p-1 border border-gray-100">
                                    <div class="h-1.5 sm:h-2 w-full bg-blue-200/50 rounded-sm"></div>
                                    <div class="h-1 sm:h-1.5 w-3/4 bg-gray-200 rounded-sm"></div>
                                    <div class="h-1 sm:h-1.5 w-4/5 bg-gray-200 rounded-sm"></div>
                                    <div class="h-1 sm:h-1.5 w-2/3 bg-gray-200 rounded-sm"></div>
                                </div>
                            </div>
                        </div>
                        <div class="p-2 sm:p-3 text-center">
                            <span class="block text-xs sm:text-sm font-semibold text-gray-800">Sekmeler</span>
                        </div>
                        @if (Model.DisplayType == "tabs")
                        {
                            <div class="absolute top-1 right-1 sm:top-2 sm:right-2 text-blue-600 bg-white rounded-full p-0.5 sm:p-1 shadow-sm selection-check"><i class="fas fa-check-circle text-base sm:text-lg"></i></div>
                        }
                    </div>

                    <!-- Grid Card -->
                    <div class="display-type-card cursor-pointer group relative rounded-xl border-2 transition-all duration-200 hover:border-blue-400 hover:shadow-md overflow-hidden bg-gray-50 @(Model.DisplayType == "grid" ? "border-blue-600 bg-blue-50/50 shadow-sm" : "border-gray-200")"
                         onclick="selectDisplayType('grid')">
                        <div class="aspect-video w-full bg-white border-b border-gray-200 flex items-center justify-center p-2 sm:p-3">
                            <div class="grid grid-cols-2 gap-1 sm:gap-2 w-full h-full opacity-60">
                                <div class="bg-gray-200 rounded-md"></div>
                                <div class="bg-gray-200 rounded-md"></div>
                                <div class="bg-gray-200 rounded-md"></div>
                                <div class="bg-gray-200 rounded-md"></div>
                            </div>
                        </div>
                        <div class="p-2 sm:p-3 text-center">
                            <span class="block text-xs sm:text-sm font-semibold text-gray-800">Grid</span>
                        </div>
                        @if (Model.DisplayType == "grid")
                        {
                            <div class="absolute top-1 right-1 sm:top-2 sm:right-2 text-blue-600 bg-white rounded-full p-0.5 sm:p-1 shadow-sm selection-check"><i class="fas fa-check-circle text-base sm:text-lg"></i></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>

    <hr class="border-gray-100"/>

    <!-- Detailed Settings Form -->
    <form id="sliderSettingsForm" class="space-y-6 lg:space-y-10">

    <!-- Appearance Section -->
    <div class="settings-section" data-section="appearance">
        <div class="flex items-center gap-3 mb-6">
            <div class="p-2 bg-purple-50 text-purple-600 rounded-lg"><i class="fas fa-palette"></i></div>
            <h4 class="text-base font-bold text-gray-900">Görünüm & Tema</h4>
        </div>

        <div class="space-y-6">
            <!-- Theme Visual Select -->
            <div>
                <label for="theme" class="block text-sm font-semibold text-gray-700 mb-2">Tema Stili</label>
                <div class="grid grid-cols-3 gap-3">
                    <!-- Modern -->
                    <label class="cursor-pointer relative">
                        <input type="radio" name="theme_select" value="modern" class="peer sr-only" @(Model.Settings?.Theme == "modern" ? "checked" : "") onchange="updateTheme('modern')">
                        <div class="rounded-xl border-2 border-gray-200 p-3 text-center peer-checked:border-purple-600 peer-checked:bg-purple-50 transition-all hover:border-gray-300">
                            <div class="text-xs font-bold text-gray-800">Modern</div>
                        </div>
                    </label>
                    <!-- Classic -->
                    <label class="cursor-pointer relative">
                        <input type="radio" name="theme_select" value="classic" class="peer sr-only" @(Model.Settings?.Theme == "classic" ? "checked" : "") onchange="updateTheme('classic')">
                        <div class="rounded-xl border-2 border-gray-200 p-3 text-center peer-checked:border-purple-600 peer-checked:bg-purple-50 transition-all hover:border-gray-300">
                            <div class="text-xs font-bold text-gray-800">Klasik</div>
                        </div>
                    </label>
                    <!-- Minimal -->
                    <label class="cursor-pointer relative">
                        <input type="radio" name="theme_select" value="minimal" class="peer sr-only" @(Model.Settings?.Theme == "minimal" ? "checked" : "") onchange="updateTheme('minimal')">
                        <div class="rounded-xl border-2 border-gray-200 p-3 text-center peer-checked:border-purple-600 peer-checked:bg-purple-50 transition-all hover:border-gray-300">
                            <div class="text-xs font-bold text-gray-800">Minimal</div>
                        </div>
                    </label>
                    <input type="hidden" id="theme" value="@(Model.Settings?.Theme ?? "modern")">
                </div>
            </div>

            <!-- Aspect Ratio -->
            <div>
                <label for="imageAspectRatio" class="block text-sm font-semibold text-gray-700 mb-2">Görsel Oranı</label>
                <div class="grid grid-cols-3 gap-3">
                    <div onclick="document.getElementById('imageAspectRatio').value='square'; updateRatioUI(this);" class="ratio-option cursor-pointer rounded-xl border-2 border-gray-200 p-2 text-center hover:bg-gray-50 flex flex-col items-center gap-1 @(Model.Settings?.ImageAspectRatio == "square" ? "border-purple-600 bg-purple-50" : "")">
                        <div class="w-6 h-6 border border-gray-400 bg-gray-200"></div>
                        <span class="text-[10px] font-medium">Kare</span>
                    </div>
                    <div onclick="document.getElementById('imageAspectRatio').value='portrait'; updateRatioUI(this);" class="ratio-option cursor-pointer rounded-xl border-2 border-gray-200 p-2 text-center hover:bg-gray-50 flex flex-col items-center gap-1 @(Model.Settings?.ImageAspectRatio == "portrait" ? "border-purple-600 bg-purple-50" : "")">
                        <div class="w-4 h-6 border border-gray-400 bg-gray-200"></div>
                        <span class="text-[10px] font-medium">Dikey</span>
                    </div>
                    <div onclick="document.getElementById('imageAspectRatio').value='landscape'; updateRatioUI(this);" class="ratio-option cursor-pointer rounded-xl border-2 border-gray-200 p-2 text-center hover:bg-gray-50 flex flex-col items-center gap-1 @(Model.Settings?.ImageAspectRatio == "landscape" ? "border-purple-600 bg-purple-50" : "")">
                        <div class="w-6 h-4 border border-gray-400 bg-gray-200 mt-1 mb-1"></div>
                        <span class="text-[10px] font-medium">Yatay</span>
                    </div>
                    <select id="imageAspectRatio" class="hidden">
                        <option value="square" selected="@(Model.Settings?.ImageAspectRatio == "square")">Kare</option>
                        <option value="portrait" selected="@(Model.Settings?.ImageAspectRatio == "portrait")">Dikey</option>
                        <option value="landscape" selected="@(Model.Settings?.ImageAspectRatio == "landscape")">Yatay</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Colors Row -->
        <div class="grid grid-cols-2 gap-4 mt-6">
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-500 mb-2">Birincil Renk</label>
                <div class="flex items-center gap-2">
                    <input type="color" id="primaryColorPicker" value="@(Model.Settings?.PrimaryColor ?? "#02379c")" class="h-10 w-10 rounded cursor-pointer border-0 p-0">
                    <input type="text" id="primaryColor" value="@(Model.Settings?.PrimaryColor ?? "#02379c")" class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm font-mono uppercase">
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-500 mb-2">İkincil Renk</label>
                <div class="flex items-center gap-2">
                    <input type="color" id="secondaryColorPicker" value="@(Model.Settings?.SecondaryColor ?? "#1f2937")" class="h-10 w-10 rounded cursor-pointer border-0 p-0">
                    <input type="text" id="secondaryColor" value="@(Model.Settings?.SecondaryColor ?? "#1f2937")" class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm font-mono uppercase">
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-500 mb-2">Arkaplan</label>
                <div class="flex items-center gap-2">
                    <input type="color" id="backgroundColorPicker" value="@(Model.Settings?.BackgroundColor ?? "#ffffff")" class="h-10 w-10 rounded cursor-pointer border-0 p-0">
                    <input type="text" id="backgroundColor" value="@(Model.Settings?.BackgroundColor ?? "#ffffff")" class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm font-mono uppercase">
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-500 mb-2">Yazı Rengi</label>
                <div class="flex items-center gap-2">
                    <input type="color" id="textColorPicker" value="@(Model.Settings?.TextColor ?? "#1F2937")" class="h-10 w-10 rounded cursor-pointer border-0 p-0">
                    <input type="text" id="textColor" value="@(Model.Settings?.TextColor ?? "#1F2937")" class="block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm font-mono uppercase">
                </div>
            </div>
        </div>
    </div>

    <hr class="border-gray-100"/>

    <!-- Content & Behavior Section -->
    <div class="settings-section">
        <div class="flex items-center gap-3 mb-6">
            <div class="p-2 bg-blue-50 text-blue-600 rounded-lg"><i class="fas fa-sliders-h"></i></div>
            <h4 class="text-base font-bold text-gray-900">İçerik & Davranış</h4>
        </div>

        <div class="space-y-8">
            <!-- Display Toggles -->
            <div class="space-y-4">
                <h5 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Kart İçeriği</h5>
                <label class="flex items-center justify-between p-3 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer hover:bg-white hover:shadow-sm hover:border-blue-200 transition-all">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-gray-100 text-gray-500 flex items-center justify-center"><i class="fas fa-image"></i></div>
                        <span class="text-sm font-medium text-gray-700">Görsel</span>
                    </div>
                    <div class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="showProductImage" @(Model.Settings?.ShowProductImage != false ? "checked" : "") class="sr-only peer">
                        <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
                    </div>
                </label>
                <label class="flex items-center justify-between p-3 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer hover:bg-white hover:shadow-sm hover:border-blue-200 transition-all">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-gray-100 text-gray-500 flex items-center justify-center"><i class="fas fa-tag"></i></div>
                        <span class="text-sm font-medium text-gray-700">Fiyat</span>
                    </div>
                    <div class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="showProductPrice" @(Model.Settings?.ShowProductPrice != false ? "checked" : "") class="sr-only peer">
                        <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
                    </div>
                </label>
                <div class="mt-2 flex items-start gap-2 p-3 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 text-xs">
                    <i class="fas fa-info-circle mt-0.5 flex-shrink-0"></i>
                    <p>Ürün fiyatlarında "KDV dahil" veya "KDV dahil değil" bilgisi Ticimax ürün varyasyonundan gelir; Ticimax panelinde ilgili ürünün varyasyon ayarından açıp kapatabilirsiniz.</p>
                </div>
                <label class="flex items-center justify-between p-3 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer hover:bg-white hover:shadow-sm hover:border-blue-200 transition-all">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-gray-100 text-gray-500 flex items-center justify-center"><i class="fas fa-align-left"></i></div>
                        <span class="text-sm font-medium text-gray-700">Açıklama</span>
                    </div>
                    <div class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="showProductDescription" @(Model.Settings?.ShowProductDescription == true ? "checked" : "") class="sr-only peer">
                        <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
                    </div>
                </label>

                <div id="descriptionSourceContainer" class="mt-3 space-y-3 @(Model.Settings?.ShowProductDescription == true ? "" : "hidden")">
                    <label for="descriptionSource" class="block text-xs font-semibold text-gray-700 mb-1.5">
                        Açıklama Kaynağı
                    </label>
                    <select id="descriptionSource" name="descriptionSource" class="block w-full px-3 py-2 rounded-lg border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm bg-white">
                        @{
                            var descSource = Model.Settings?.DescriptionSource ?? "manual";
                        }
                        <option value="manual" selected="@(descSource == "manual")">Manuel Açıklama</option>
                        <option value="description" selected="@(descSource == "description")">Ürün Açıklaması (Ticimax)</option>
                    </select>
                </div>
            </div>

            <!-- Slider Controls -->
            <div class="space-y-4 slider-only-settings">
                <h5 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Navigasyon</h5>

                <!-- AutoPlay Group -->
                <div class="bg-gray-50 rounded-xl p-3 border border-gray-200 hover:border-blue-200 transition-colors">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-play-circle text-gray-400"></i>
                            <span class="text-sm font-medium text-gray-700">Oto. Oynat</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
