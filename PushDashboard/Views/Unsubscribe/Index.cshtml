@{
    Layout = null;
    ViewData["Title"] = "Bildirimden Çık";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dijitaldesin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen p-4">

    <div class="max-w-md w-full bg-white rounded-xl shadow-lg overflow-hidden">
        <div class="p-8">
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-100 text-red-500 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold text-gray-900">Bildirim Ayarları</h1>
                <p class="text-gray-500 mt-2">WhatsApp bildirimlerinden ayrılmak için lütfen telefon numaranızı doğrulayın.</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    @TempData["Success"]
                </div>
                <div class="text-center">
                     <p class="text-sm text-gray-500 mb-4">İşleminiz tamamlandı. Bu sayfayı kapatabilirsiniz.</p>
                </div>
            }
            else
            {
                <form asp-action="Update" method="post" class="space-y-6">
                    @if (TempData["Error"] != null)
                    {
                        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center">
                             <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            @TempData["Error"]
                        </div>
                    }

                    <div>
                        <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Telefon Numarası</label>
                        <input type="tel" id="phone" name="phone" value="@ViewBag.Phone" 
                               class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-colors"
                               placeholder="5XX XXX XX XX" required pattern="[0-9]{10,11}">
                        <p class="text-xs text-gray-400 mt-1">Başında 0 olmadan 10 haneli numaranızı girebilirsiniz.</p>
                    </div>

                    <button type="submit" class="w-full bg-gray-900 hover:bg-gray-800 text-white font-medium py-3 px-4 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900">
                        Bildirimden Çık
                    </button>
                    
                    <p class="text-xs text-center text-gray-400 mt-4">
                        Bu işlem sonrası size ticari elektronik ileti gönderimi durdurulacaktır.
                    </p>
                </form>
            }
        </div>
    </div>
</body>
</html>
