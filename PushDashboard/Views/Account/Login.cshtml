@model PushDashboard.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_BlankLayout";
}

@section Scripts {
    @await Html.PartialAsync("Partials/_AuthScriptsPartial")
    <script>
        document.getElementById('togglePasswordBtn')?.addEventListener('click', function () {
            const passwordInput = document.getElementById('password');
            const icon = this.querySelector('i');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });
    </script>
}

<div class="relative h-screen flex items-center justify-center overflow-hidden font-sans px-4 py-6 bg-gradient-to-br from-slate-50 via-indigo-50/60 to-emerald-50/50">

    <div class="pointer-events-none absolute -top-40 -left-32 w-[32rem] h-[32rem] rounded-full bg-indigo-200/40 blur-3xl"></div>
    <div class="pointer-events-none absolute top-10 left-48 w-[26rem] h-[26rem] rounded-full bg-emerald-200/40 blur-3xl"></div>

    <div class="relative z-10 w-full max-w-5xl bg-white rounded-3xl border border-gray-200/80 shadow-[0_8px_40px_rgba(15,23,42,0.08)] p-3 grid grid-cols-1 lg:grid-cols-2 gap-3 h-[min(44rem,calc(100vh-3rem))] grid-rows-[minmax(0,1fr)]">

        <div class="flex flex-col overflow-y-auto min-h-0 px-6 py-10 sm:px-10 lg:px-12 lg:py-12">

            <div class="w-full my-auto">
                <img src="https://dijitaldesin.com/wp-content/uploads/2023/02/dijitaldesin.svg" alt="Dijitaldesin" class="lg:hidden h-9 w-auto mb-8" />
            <div class="text-left mb-8">
                <h2 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Hoş Geldiniz</h2>
                <p class="text-gray-500">Panelinize erişmek için bilgilerinizi girin.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg flex items-center animate-fade-in-down">
                    <i class="fas fa-check-circle mr-3 text-lg"></i>
                    <span class="font-medium">@TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg flex items-center animate-fade-in-down">
                    <i class="fas fa-exclamation-circle mr-3 text-lg"></i>
                    <span class="font-medium">@TempData["ErrorMessage"]</span>
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" class="space-y-3">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                   <div class="p-4 rounded-lg bg-red-50 border border-red-100 mb-2">
                       <h3 class="text-sm font-bold text-red-800 flex items-center">
                           <i class="fas fa-times-circle mr-2"></i> Giriş Başarısız
                       </h3>
                       <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                       </ul>
                   </div>
                }

                <div class="group">
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1 ml-1">E-posta</label>
                    <div class="relative transition-all duration-300">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="far fa-envelope text-gray-400"></i>
                        </div>
                        <input asp-for="Email" type="email" placeholder="isim@sirket.com" 
                            class="block w-full pl-11 pr-4 py-2.5 border border-gray-200 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all bg-white" />
                    </div>
                    <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 ml-1 block"></span>
                </div>

                <div class="group">
                    <div class="flex items-center justify-between mb-1 ml-1">
                        <label asp-for="Password" class="block text-sm font-medium text-gray-700">Şifre</label>
                    </div>
                    <div class="relative transition-all duration-300">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="fas fa-lock text-gray-400"></i>
                        </div>
                        <input asp-for="Password" type="password" id="password" placeholder="••••••••" 
                            class="block w-full pl-11 pr-12 py-2.5 border border-gray-200 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all bg-white" />
                        
                        <button type="button" id="togglePasswordBtn" class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-gray-600 cursor-pointer transition-colors">
                            <i class="far fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 ml-1 block"></span>
                </div>

                <div class="flex items-center justify-between mt-2">
                    <div class="flex items-center ml-1">
                        <input asp-for="RememberMe" type="checkbox" class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded cursor-pointer transition-colors" />
                        <label asp-for="RememberMe" class="ml-2 block text-sm text-gray-600 cursor-pointer select-none">Oturumu açık tut</label>
                    </div>
                    <a asp-action="ForgotPassword" class="text-sm font-medium text-primary hover:text-primary-dark transition-colors">Şifremi unuttum?</a>
                </div>

                <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg text-sm font-medium text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors mt-4">
                    Giriş Yap
                </button>
            </form>
            
            <div class="relative mt-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-200"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-4 bg-white text-gray-400 font-medium">veya</span>
                </div>
            </div>

            <div class="mt-8 text-center">
                <p class="text-gray-600">
                    Henüz hesabınız yok mu? 
                    <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="font-bold text-primary hover:text-primary-800 transition-colors inline-flex items-center">
                        Hemen Üye Olun <i class="fas fa-arrow-right text-xs ml-1 mt-0.5"></i>
                    </a>
                </p>
            </div>

            <p class="mt-12 text-center text-xs text-gray-400 font-medium">
                &copy; 2026 Dijitaldesin. Tüm hakları saklıdır.
            </p>
            </div>
        </div>

        <div class="hidden lg:flex relative rounded-2xl overflow-hidden flex-col justify-end p-10 text-white bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900">

            <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-indigo-500/20 blur-3xl"></div>
            <div class="absolute -bottom-32 -left-24 w-96 h-96 rounded-full bg-emerald-400/10 blur-3xl"></div>

            <img src="https://dijitaldesin.com/wp-content/uploads/2023/02/dijitaldesin.svg" alt="Dijitaldesin" class="relative z-10 h-9 w-auto self-start mb-10 brightness-0 invert" />

            <div class="relative z-10 mt-auto space-y-8">
                <h1 class="text-4xl font-extrabold leading-tight tracking-tight">
                    Mağazanızı <br />
                    <span class="text-emerald-300">
                        büyüten
                    </span>
                    <br /> akıllı panel.
                </h1>
                
                <p class="text-slate-200 text-lg leading-relaxed max-w-md opacity-80">
                    Müşteri iletişimini otomatikleştirin, sepet ve sipariş süreçlerini tek yerden yönetin. Dijitaldesin ile her etkileşim satışa dönüşür.
                </p>

                <div class="border border-white/10 bg-white/5 backdrop-blur-sm rounded-xl p-6 mt-8">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-300 uppercase tracking-wider font-semibold">Gönderilen Mesaj</p>
                            <p class="text-3xl font-bold text-white mt-1">50M+</p>
                        </div>
                        <div class="h-10 w-px bg-white/15"></div>
                        <div>
                            <p class="text-xs text-slate-300 uppercase tracking-wider font-semibold">Satış Artışı</p>
                            <div class="flex items-center mt-1">
                                <svg class="w-4 h-4 mr-2 text-emerald-300/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
                                <span class="text-3xl font-bold text-white">%30</span>
                            </div>
                        </div>
                    </div>
                </div>



            <div class="space-y-4">
                <p class="text-xs text-slate-300 uppercase tracking-widest font-semibold opacity-70">Sektör Liderleriyle Entegre</p>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="inline-flex items-center bg-white rounded-md px-3 py-1.5 opacity-90 hover:opacity-100 transition-opacity">
                    <img alt="ikas" class="h-4 w-auto object-contain" src="~/images/ikas.png">
                  </span>
                  <span class="inline-flex items-center bg-white rounded-md px-3 py-1.5 opacity-90 hover:opacity-100 transition-opacity">
                    <img alt="Ticimax" class="h-4 w-auto object-contain" src="~/images/ticimax.png">
                  </span>
                </div>
            </div>
            </div>
        </div>

    </div>
</div>
