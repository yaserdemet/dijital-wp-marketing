@model PushDashboard.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Profil";
}

<div class="container mx-auto px-4 py-6 md:py-10">
    <div class="max-w-xl mx-auto">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-xl font-semibold text-gray-900">Profil Bilgilerim</h1>
            <a asp-action="ChangePassword" class="text-sm text-gray-500 hover:text-gray-900 transition-colors">
                Şifremi Değiştir
            </a>
        </div>

        @if (TempData["StatusMessage"] != null)
        {
            <div class="bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3 rounded-lg mb-4">
                <span>@TempData["StatusMessage"]</span>
            </div>
        }

        <div class="bg-white border border-gray-200 rounded-xl p-6">
            <form id="profileForm" asp-action="Profile" method="post" class="space-y-4">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="FirstName" class="block text-xs font-medium text-gray-500 mb-1"></label>
                        <input asp-for="FirstName" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-gray-900 focus:border-gray-900">
                        <span asp-validation-for="FirstName" class="text-red-500 text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="LastName" class="block text-xs font-medium text-gray-500 mb-1"></label>
                        <input asp-for="LastName" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-gray-900 focus:border-gray-900">
                        <span asp-validation-for="LastName" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Email" class="block text-xs font-medium text-gray-500 mb-1"></label>
                    <input asp-for="Email" readonly class="w-full px-3 py-2 text-sm text-gray-500 bg-gray-50 border border-gray-200 rounded-lg">
                    <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="block text-xs font-medium text-gray-500 mb-1"></label>
                    <input asp-for="PhoneNumber" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-gray-900 focus:border-gray-900">
                    <span asp-validation-for="PhoneNumber" class="text-red-500 text-xs"></span>
                </div>

                <div class="pt-2 flex justify-end">
                    <button type="submit"
                            class="px-5 py-2 text-sm font-medium text-white bg-gray-900 rounded-lg hover:bg-gray-700 transition-colors">
                        Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
