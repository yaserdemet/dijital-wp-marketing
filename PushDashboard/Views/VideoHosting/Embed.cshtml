@model PushDashboard.DTOs.VideoPlayerDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title</title>

    <!-- Open Graph / Social Media Meta Tags -->
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <meta property="og:description" content="@Model.Description">
    }
    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
    {
        <meta property="og:image" content="@Model.ThumbnailUrl">
    }
    <meta property="og:video" content="@Model.VideoUrl">
    <meta property="og:video:type" content="video/mp4">
    <meta property="og:video:width" content="@Model.Width">
    <meta property="og:video:height" content="@Model.Height">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="player">
    <meta name="twitter:title" content="@Model.Title">
    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
    {
        <meta name="twitter:image" content="@Model.ThumbnailUrl">
    }

    <style>
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            background-color: #000;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        .embed-container {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #000;
        }

        #videoPlayer {
            width: 100%;
            height: 100%;
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            display: block;
        }

        .video-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0,0,0,0.75));
            color: #fff;
            padding: 12px 16px;
            font-size: 12px;
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        .embed-container:hover .video-overlay {
            opacity: 1;
        }

        .video-title {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .video-branding {
            font-size: 10px;
            opacity: 0.7;
        }

        .video-branding a {
            color: #fff;
            text-decoration: none;
            pointer-events: auto;
        }

        .video-branding a:hover {
            text-decoration: underline;
        }

        /* Theme-specific styles */
        @if (Model.PlayerTheme == "dark")
        {
            <text>
            .embed-container { background-color: #1a1a1a; }
            </text>
        }
        else if (Model.PlayerTheme == "light")
        {
            <text>
            .embed-container { background-color: #f8f9fa; }
            </text>
        }

        /* Custom CSS from settings */
        @if (!string.IsNullOrEmpty(Model.CustomPlayerCss))
        {
            @Html.Raw(Model.CustomPlayerCss)
        }
    </style>
</head>
<body>
    <div class="embed-container">
        <video
            id="videoPlayer"
            @(Model.ShowControls ? "controls" : "")
            @(Model.AutoPlay ? "autoplay" : "")
            @(Model.Muted || Model.AutoPlay ? "muted" : "")
            poster="@(Model.ThumbnailUrl ?? "")"
            preload="metadata"
            playsinline
            webkit-playsinline>
            <source src="@Model.VideoUrl" type="video/mp4">
            <p>Tarayıcınız video oynatmayı desteklemiyor.</p>
        </video>

        <div class="video-overlay">
            <div class="video-title">@Model.Title</div>
            <div class="video-branding">Powered by <a href="https://dijitaldesin.com" target="_blank" rel="noopener">Dijitaldesin</a></div>
        </div>
    </div>

    <script>
        (function() {
            'use strict';

            var video = document.getElementById('videoPlayer');
            if (!video) return;

            var hasStartedPlaying = false;
            var watchStartTime = null;
            var videoId = '@Model.Id';
            var userWantsMuted = @(Model.Muted ? "true" : "false");
            var userWantsAutoPlay = @(Model.AutoPlay ? "true" : "false");

            // Autoplay policy: most browsers require muted for autoplay
            // If user wants autoplay with sound, start muted then try to unmute
            if (userWantsAutoPlay && !userWantsMuted) {
                video.muted = true;
                var playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.then(function() {
                        try { video.muted = false; } catch(e) {}
                    }).catch(function() {
                        // Autoplay blocked - user will need to click play
                    });
                }
            }

            // Analytics tracking
            video.addEventListener('play', function() {
                if (!hasStartedPlaying) {
                    hasStartedPlaying = true;
                    watchStartTime = Date.now();
                    recordVideoEvent('play');
                }
            });

            video.addEventListener('pause', function() {
                if (watchStartTime) {
                    var wd = (Date.now() - watchStartTime) / 1000;
                    recordVideoEvent('pause', video.currentTime, wd);
                }
            });

            video.addEventListener('ended', function() {
                if (watchStartTime) {
                    var wd = (Date.now() - watchStartTime) / 1000;
                    recordVideoEvent('complete', video.currentTime, wd);
                }
            });

            window.addEventListener('beforeunload', function() {
                if (watchStartTime && !video.paused && !video.ended) {
                    var wd = (Date.now() - watchStartTime) / 1000;
                    recordVideoEvent('exit', video.currentTime, wd);
                }
            });

            function recordVideoEvent(eventType, currentTime, watchDuration) {
                try {
                    var data = {
                        videoId: videoId,
                        event: eventType,
                        currentTime: currentTime || null,
                        watchDuration: watchDuration || null,
                        timestamp: Date.now(),
                        referrer: document.referrer
                    };

                    // Notify parent window if embedded via iframe
                    if (window.parent && window.parent !== window) {
                        window.parent.postMessage({
                            type: 'pushonica-video-event',
                            data: data
                        }, '*');
                    }

                    // Send analytics to server
                    if (navigator.sendBeacon) {
                        var blob = new Blob([JSON.stringify(data)], { type: 'application/json' });
                        navigator.sendBeacon('/VideoHosting/RecordView', blob);
                    } else {
                        fetch('/VideoHosting/RecordView', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data),
                            keepalive: true
                        }).catch(function() {});
                    }
                } catch (e) { /* silently fail */ }
            }

            // Download protection
            @if (!Model.AllowDownload)
            {
                <text>
                video.addEventListener('contextmenu', function(e) {
                    e.preventDefault();
                    return false;
                });

                document.addEventListener('keydown', function(e) {
                    if (e.ctrlKey && (e.key === 's' || e.key === 'S')) {
                        e.preventDefault();
                    }
                });

                video.addEventListener('dragstart', function(e) {
                    e.preventDefault();
                });
                </text>
            }

            // Responsive video sizing
            function handleResize() {
                var container = document.querySelector('.embed-container');
                if (container && video.videoWidth && video.videoHeight) {
                    var containerAspect = container.clientWidth / container.clientHeight;
                    var videoAspect = video.videoWidth / video.videoHeight;

                    if (containerAspect > videoAspect) {
                        video.style.width = 'auto';
                        video.style.height = '100%';
                    } else {
                        video.style.width = '100%';
                        video.style.height = 'auto';
                    }
                }
            }

            video.addEventListener('loadedmetadata', handleResize);
            window.addEventListener('resize', handleResize);
        })();
    </script>
</body>
</html>
