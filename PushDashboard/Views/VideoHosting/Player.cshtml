@model PushDashboard.DTOs.VideoPlayerDto
@{
    ViewData["Title"] = Model.Title;
    Layout = "_PlayerLayout";
}

<div class="video-container relative group">
    <button id="toggleInfoBtn" type="button" class="absolute top-4 right-4 z-20 bg-black bg-opacity-50 text-white px-3 py-1.5 rounded hover:bg-opacity-75 transition-all opacity-0 group-hover:opacity-100 flex items-center text-sm">
        <i class="fas fa-eye-slash mr-2"></i> <span>Bilgileri Gizle</span>
    </button>

    <div class="w-full flex justify-center">
        <video
            id="videoPlayer"
            @(Model.ShowControls ? "controls" : "")
            @(Model.AutoPlay ? "autoplay" : "")
            @(Model.Muted || Model.AutoPlay ? "muted" : "")
            poster="@Model.ThumbnailUrl"
            preload="metadata"
            playsinline
            webkit-playsinline
            class="max-w-full max-h-screen">
            <source src="@Model.VideoUrl" type="video/mp4">
            <p class="text-white">Tarayıcınız video oynatmayı desteklemiyor.</p>
        </video>
    </div>

    <div class="video-info" id="videoInfo">
        <h1 class="video-title">@Model.Title</h1>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="video-description">@Model.Description</p>
        }

        <div class="video-meta">
            <span>Süre: @Model.Duration.ToString(@"mm\:ss")</span>
            <span>@Model.Width x @Model.Height</span>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var video = document.getElementById('videoPlayer');
            var toggleBtn = document.getElementById('toggleInfoBtn');
            var videoInfo = document.getElementById('videoInfo');
            var isInfoVisible = true;
            var userWantsMuted = @(Model.Muted ? "true" : "false");
            var userWantsAutoPlay = @(Model.AutoPlay ? "true" : "false");

            if (toggleBtn && videoInfo) {
                toggleBtn.addEventListener('click', function() {
                    isInfoVisible = !isInfoVisible;
                    if (isInfoVisible) {
                        videoInfo.style.display = 'block';
                        toggleBtn.innerHTML = '<i class="fas fa-eye-slash mr-2"></i> <span>Bilgileri Gizle</span>';
                    } else {
                        videoInfo.style.display = 'none';
                        toggleBtn.innerHTML = '<i class="fas fa-eye mr-2"></i> <span>Bilgileri Göster</span>';
                    }
                });
            }

            // Autoplay policy: browsers require muted for autoplay
            // If user wants autoplay with sound, start muted then try to unmute
            if (userWantsAutoPlay && !userWantsMuted) {
                video.muted = true;
                var playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.then(function() {
                        try { video.muted = false; } catch(e) {}
                    }).catch(function() {
                        // Autoplay blocked - user will need to click play
                    });
                }
            }

            var hasStartedPlaying = false;

            // Apply theme styles
            @if (Model.PlayerTheme == "dark")
            {
                <text>
                document.body.style.backgroundColor = '#1a1a1a';
                </text>
            }
            else if (Model.PlayerTheme == "light")
            {
                <text>
                document.body.style.backgroundColor = '#f8f9fa';
                document.body.style.color = '#333';
                </text>
            }

            // Apply custom CSS
            @if (!string.IsNullOrEmpty(Model.CustomPlayerCss))
            {
                <text>
                var style = document.createElement('style');
                style.textContent = '@Html.Raw(Model.CustomPlayerCss)';
                document.head.appendChild(style);
                </text>
            }

            // Track video events for analytics
            video.addEventListener('play', function() {
                if (!hasStartedPlaying) {
                    hasStartedPlaying = true;
                    recordVideoEvent('play');
                }
            });

            video.addEventListener('ended', function() {
                recordVideoEvent('complete');
            });

            // Track watch duration every 10 seconds
            setInterval(function() {
                if (!video.paused && !video.ended) {
                    recordVideoEvent('progress', video.currentTime);
                }
            }, 10000);

            function recordVideoEvent(eventType, currentTime) {
                try {
                    var data = {
                        videoId: '@Model.Id',
                        event: eventType,
                        currentTime: currentTime || null,
                        timestamp: Date.now(),
                        referrer: document.referrer
                    };

                    if (navigator.sendBeacon) {
                        var blob = new Blob([JSON.stringify(data)], { type: 'application/json' });
                        navigator.sendBeacon('/VideoHosting/RecordView', blob);
                    } else {
                        fetch('/VideoHosting/RecordView', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data),
                            keepalive: true
                        }).catch(function() {});
                    }
                } catch(e) { /* silently fail */ }
            }

            // Disable right-click context menu if download is not allowed
            @if (!Model.AllowDownload)
            {
                <text>
                video.addEventListener('contextmenu', function(e) {
                    e.preventDefault();
                    return false;
                });

                document.addEventListener('keydown', function(e) {
                    if (e.ctrlKey && (e.key === 's' || e.key === 'S')) {
                        e.preventDefault();
                        return false;
                    }
                });
                </text>
            }
        });
    </script>
}
