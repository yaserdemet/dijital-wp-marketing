                        </div>
                    </div>
                     <button type="button" 
                            class="rounded-lg p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 transition-colors"
                            onclick="closePreviewModal()">
                        <span class="sr-only">Kapat</span>
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Simulation Area -->
                <div class="bg-gray-100/50 p-2 md:p-4 flex flex-col md:flex-row gap-6 h-auto md:h-[600px]">
                    <!-- Sidebar Controls -->
                    <div class="w-full md:w-64 shrink-0 space-y-4">
                         <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2 block">Bildirim Tipi</label>
                            <div class="space-y-2">
                                <label class="flex items-center p-2 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors border border-transparent hover:border-gray-100">
                                    <input type="radio" name="previewType" value="viewers" checked class="h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-500">
                                    <span class="ml-3 text-sm font-medium text-gray-700 flex items-center gap-2">
                                        <span>👀</span> İnceleyenler
                                    </span>
                                </label>
                                <label class="flex items-center p-2 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors border border-transparent hover:border-gray-100">
                                    <input type="radio" name="previewType" value="followers" class="h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-500">
                                    <span class="ml-3 text-sm font-medium text-gray-700 flex items-center gap-2">
                                        <span>❤️</span> Takip Edenler
                                    </span>
                                </label>
                                <label class="flex items-center p-2 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors border border-transparent hover:border-gray-100">
                                    <input type="radio" name="previewType" value="buyers" class="h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-500">
                                    <span class="ml-3 text-sm font-medium text-gray-700 flex items-center gap-2">
                                        <span>🛒</span> Satın Alanlar
                                    </span>
                                </label>
                            </div>
                        </div>

                         <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                             <div class="space-y-3">
                                 <button type="button"
                                        class="w-full inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
                                        onclick="startPreview()">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    Yeniden Başlat
                                </button>
                                <button type="button"
                                        class="w-full inline-flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
                                        onclick="stopPreview()">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    Durdur
                                </button>
                             </div>
                         </div>
                    </div>

                    <!-- Browser Mockup -->
                    <div class="flex-1 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden flex flex-col relative" id="previewArea">
                         <!-- Browser Bar -->
                        <div class="bg-gray-100 border-b border-gray-200 px-4 py-2 flex items-center gap-2">
                             <div class="flex gap-1.5">
                                 <div class="w-3 h-3 rounded-full bg-red-400"></div>
                                 <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                                 <div class="w-3 h-3 rounded-full bg-green-400"></div>
                             </div>
                             <div class="flex-1 ml-4 bg-white border border-gray-200 rounded px-3 py-1 text-xs text-gray-500 font-mono text-center">
                                 dijitaldesin.com/product/awesome-tshirt   
                             </div>
                        </div>

                        <div class="flex-1 p-4 md:p-8 overflow-y-auto relative h-[400px] md:h-auto">
                             <div class="flex flex-col md:flex-row gap-4 md:gap-8">
                                 <!-- Product Image Placeholder -->
                                 <div class="w-full md:w-1/2 aspect-square bg-gray-100 rounded-lg flex items-center justify-center text-gray-300">
                                     <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                 </div>
                                 <!-- Product Info -->
                                 <div class="w-full md:w-1/2 space-y-4">
                                     <div class="h-8 w-3/4 bg-gray-200 rounded"></div>
                                     <div class="h-4 w-1/4 bg-gray-200 rounded"></div>
                                     <div class="h-12 w-full bg-gray-100 rounded mt-8"></div>
                                     <div class="space-y-2 pt-4">
                                         <div class="h-4 w-full bg-gray-100 rounded"></div>
                                         <div class="h-4 w-full bg-gray-100 rounded"></div>
                                         <div class="h-4 w-2/3 bg-gray-100 rounded"></div>
                                     </div>
                                 </div>
                             </div>
                        </div>

                         <!-- The Widget (Injected Here) -->
                        <div id="previewWidget" class="absolute z-10 transition-all duration-300" style="display: none;">
                            <!-- Content injected via JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let previewConfig = null;
    let previewTimer = null;
    let currentPreviewType = 'viewers';

    function showPreviewModal(config, scriptUrl) {
        previewConfig = config;

        // Modal'ı göster
        const modal = document.getElementById('previewModal');
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden'; // Prevent body scroll

        // Önizlemeyi başlat
        setTimeout(() => {
            startPreview();
        }, 300);
    }

    function closePreviewModal() {
        const modal = document.getElementById('previewModal');
        modal.classList.add('hidden');
         document.body.style.overflow = ''; // Restore body scroll
        stopPreview();
    }

    function startPreview() {
        if (!previewConfig || !previewConfig.isActive) {
            // Even if not active in settings, we should allow preview if user clicked "Preview" button
            // But let's respect the config passed. If you want to force preview, handle it in Index.cshtml before passing config
        }
        
        stopPreview(); // Önceki timer'ı temizle
        
        updatePreviewWidget();
        
        // Periyodik güncelleme
        previewTimer = setInterval(() => {
            updatePreviewWidget();
        }, 3000); // 3 saniyede bir güncelle (demo için hızlı)
    }

    function stopPreview() {
        if (previewTimer) {
            clearInterval(previewTimer);
            previewTimer = null;
        }
        
        const previewWidget = document.getElementById('previewWidget');
        if(previewWidget) {
             previewWidget.style.display = 'none';
        }
    }

    function updatePreviewWidget() {
        const previewWidget = document.getElementById('previewWidget');
        if(!previewWidget) return;
        
        const selectedTypeInput = document.querySelector('input[name="previewType"]:checked');
        const selectedType = selectedTypeInput ? selectedTypeInput.value : 'viewers';
        
        let config, template;
        
        switch(selectedType) {
            case 'viewers':
                config = { min: previewConfig.viewersMin, max: previewConfig.viewersMax };
                template = previewConfig.textTemplates.viewersTemplate;
                break;
            case 'followers':
                config = { min: previewConfig.followersMin, max: previewConfig.followersMax };
                template = previewConfig.textTemplates.followersTemplate;
                break;
            case 'buyers':
                config = { min: previewConfig.buyersMin, max: previewConfig.buyersMax };
                template = previewConfig.textTemplates.buyersTemplate;
                break;
        }
        
        // Rastgele sayı üret
        const count = Math.floor(Math.random() * (config.max - config.min + 1)) + config.min;
        // Simple replace without regex for safety in demo
        const text = template.split('{count}').join(count);
        
        // Widget stilini uygula
        const displaySettings = previewConfig.displaySettings;
        
        // Build inner HTML for the widget
        // We can add an icon based on type if not in template, but usually template has text only
        // Let's add an icon automatically for better visuals
        let iconHtml = '';
        if(selectedType === 'viewers') iconHtml = '<span class="mr-2">👀</span>';
        if(selectedType === 'followers') iconHtml = '<span class="mr-2">❤️</span>';
        if(selectedType === 'buyers') iconHtml = '<span class="mr-2">🛒</span>';

        previewWidget.innerHTML = `
            <div class="flex items-center">
                ${iconHtml}
                <span>${text}</span>
            </div>
        `;
        
        // Apply styles
        previewWidget.style.backgroundColor = displaySettings.backgroundColor;
        previewWidget.style.color = displaySettings.textColor;
        previewWidget.style.borderRadius = displaySettings.borderRadius + 'px';
        previewWidget.style.fontSize = displaySettings.fontSize + 'px';
        
        // Reset positioning styles first
        previewWidget.style.top = 'auto';
        previewWidget.style.bottom = 'auto';
        previewWidget.style.left = 'auto';
        previewWidget.style.right = 'auto';
        previewWidget.style.transform = 'none';
        
        // Fixed basic styles
        previewWidget.style.padding = '12px 20px';
        previewWidget.style.maxWidth = '320px';
        previewWidget.style.fontFamily = 'inherit';
        previewWidget.style.fontWeight = '500';
        previewWidget.style.zIndex = '50';
        previewWidget.style.boxShadow = displaySettings.enableShadow ? '0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)' : 'none';

        // Pozisyon ayarla
        const margin = '24px';
        switch(displaySettings.position) {
            case 'bottom-left':
                previewWidget.style.bottom = margin;
                previewWidget.style.left = margin;
                break;
            case 'bottom-right':
                previewWidget.style.bottom = margin;
                previewWidget.style.right = margin;
                break;
            case 'top-left':
                previewWidget.style.top = margin;
                previewWidget.style.left = margin;
                break;
            case 'top-right':
                previewWidget.style.top = margin;
                previewWidget.style.right = margin;
                break;
        }
        
        // Show
        previewWidget.style.display = 'block';

        // Animasyon efekti (CSS animation reuse or JS simple fade)
        if (displaySettings.enableAnimation) {
             previewWidget.animate([
                { opacity: 0, transform: 'translateY(10px)' },
                { opacity: 1, transform: 'translateY(0)' }
            ], {
                duration: 400,
                easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
            });
        }
    }

    // Tip değiştiğinde önizlemeyi güncelle
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('input[name="previewType"]').forEach(radio => {
            radio.addEventListener('change', function() {
                if (previewTimer) { // Only if running
                    updatePreviewWidget();
                }
            });
        });
        
        // ESC tuşu ile modal'ı kapat
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const modal = document.getElementById('previewModal');
                if (!modal.classList.contains('hidden')) {
                    closePreviewModal();
                }
            }
        });
    });
</script>

