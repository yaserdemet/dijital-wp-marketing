                           class="focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-10 pr-12 sm:text-sm border-gray-300 rounded-lg py-3"
                           name="DisplayDuration"
                           id="DisplayDuration"
                           value="@Model.DisplayDuration"
                           min="3" max="15"
                           placeholder="5">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <span class="text-gray-500 sm:text-sm">sn</span>
                    </div>
                </div>
                <p class="mt-1 text-xs text-gray-400">Ekranda kalma süresi</p>
            </div>
        </div>

        <div class="border-t border-gray-100"></div>

        <!-- Number Ranges -->
        <div>
            <div class="flex items-center justify-between mb-4">
                <h4 class="text-sm font-semibold text-gray-900 flex items-center">
                    Sayı Aralıkları ve Metinler
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">Rastgele Değerler</span>
                </h4>
                <div class="text-xs text-gray-500 flex items-center gap-2">
                    <span>Değişken:</span>
                    <div class="cursor-move inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-indigo-100 text-indigo-700 border border-indigo-200 hover:bg-indigo-200 transition-all shadow-sm select-none"
                         draggable="true"
                         ondragstart="event.dataTransfer.setData('text/plain', '{count}'); event.dataTransfer.effectAllowed = 'copy';">
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                        {count}
                    </div>
                </div>
            </div>
                
