                            <!-- Primary Color (Icon/Accent) -->
                            <div class="relative group">
                                <label class="text-xs text-gray-500 mb-1 block">Vurgu/İkon</label>
                                <div class="h-10 w-full rounded-lg border border-gray-300 overflow-hidden relative cursor-pointer shadow-sm">
                                   <input type="color" name="PrimaryColor" id="PrimaryColor" value="@Model.DisplaySettings.PrimaryColor" class="absolute -top-2 -left-2 w-[150%] h-[150%] p-0 border-0 cursor-pointer">
