                    <div class="space-y-4">
                         <label class="block text-sm font-medium text-gray-700">Renk Paleti</label>
                        <div class="grid grid-cols-3 gap-4">
                            <!-- Background Color -->
                            <div class="relative group">
                                <label class="text-xs text-gray-500 mb-1 block">Arkaplan</label>
                                <div class="h-10 w-full rounded-lg border border-gray-300 overflow-hidden relative cursor-pointer shadow-sm">
                                   <input type="color" name="BackgroundColor" id="BackgroundColor" value="@Model.DisplaySettings.BackgroundColor" class="absolute -top-2 -left-2 w-[150%] h-[150%] p-0 border-0 cursor-pointer">
                                </div>
                            </div>
                             <!-- Text Color -->
                            <div class="relative group">
                                <label class="text-xs text-gray-500 mb-1 block">Metin</label>
                                <div class="h-10 w-full rounded-lg border border-gray-300 overflow-hidden relative cursor-pointer shadow-sm">
                                   <input type="color" name="TextColor" id="TextColor" value="@Model.DisplaySettings.TextColor" class="absolute -top-2 -left-2 w-[150%] h-[150%] p-0 border-0 cursor-pointer">
                                </div>
