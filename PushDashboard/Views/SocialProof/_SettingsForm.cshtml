                 </div>

                 <!-- Right Column: Live Small Preview & Effects -->
                 <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-semibold text-gray-900 mb-3">Canlı Önizleme</label>
                        
                        <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden relative group" id="componentPreviewContainer">
                             <!-- Mockup Header -->
                             <div class="h-8 bg-gray-50 border-b border-gray-200 flex items-center px-3 gap-1.5">
                                 <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
                                 <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
                                 <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
                             </div>

                             <!-- Preview Mockup Area -->
                             <div class="relative h-64 bg-gray-50/50">
                                  <!-- Abstract Background -->
                                  <div class="absolute inset-0 opacity-40" style="background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 20px 20px;"></div>
                                  
                                  <!-- Position Border Guide -->
                                  <div class="absolute inset-4 border border-dashed border-gray-300 rounded-lg pointer-events-none">
                                      <!-- The glowing dot indicator -->
                                      <div class="absolute w-3 h-3 bg-blue-500 rounded-full shadow-[0_0_10px_rgba(59,130,246,0.5)] ring-2 ring-blue-500/30 transition-all duration-500 z-0" id="pos-indicator"></div>
                                  </div>
                                  
                                  <!-- The actual widget container -->
                                  <div class="absolute inset-0 overflow-hidden">
                                      <div id="livePreviewContainer" class="w-full h-full relative z-10">
                                          <!-- JS injects preview here -->
                                      </div>
                                  </div>
