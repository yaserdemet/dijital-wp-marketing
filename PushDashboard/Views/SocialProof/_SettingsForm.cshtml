                        </div>
                        <p class="mt-3 text-xs text-center text-gray-500">Widget, web sitenizde seçili pozisyonda görünecektir.</p>
                    </div>

                    <!-- Effects Card -->
                    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm space-y-4">
                         <h4 class="text-sm font-semibold text-gray-900">Efekt & Animasyonlar</h4>
                         
                         <div class="space-y-3">
                             <div class="flex items-center justify-between group">
                                <div class="flex flex-col">
                                    <span class="text-sm font-medium text-gray-700 group-hover:text-gray-900 transition-colors">Giriş Animasyonu</span>
                                    <span class="text-xs text-gray-500">Yumuşak geçiş efekti</span>
                                </div>
                                <div class="flex items-center">
                                    <input type="hidden" name="EnableAnimation" value="false">
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" name="EnableAnimation" id="EnableAnimation" value="true" class="sr-only peer" @(Model.DisplaySettings.EnableAnimation ? "checked" : "")>
                                        <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-indigo-500 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600"></div>
                                    </label>
                                </div>
                            </div>
                            
                            <div class="border-t border-gray-100"></div>
                            
                            <div class="flex items-center justify-between group">
                                <div class="flex flex-col">
                                    <span class="text-sm font-medium text-gray-700 group-hover:text-gray-900 transition-colors">Gölge Efekti</span>
                                    <span class="text-xs text-gray-500">Daha belirgin görünüm</span>
                                </div>
                                 <div class="flex items-center">
                                    <input type="hidden" name="EnableShadow" value="false">
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" name="EnableShadow" id="EnableShadow" value="true" class="sr-only peer" @(Model.DisplaySettings.EnableShadow ? "checked" : "")>
                                        <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-indigo-500 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600"></div>
                                    </label>
                                </div>
                            </div>
                         </div>
                    </div>
                 </div>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()
</form>

<script>
    // Simple script to update the position indicator in the preview box
    const posSelect = document.getElementById('Position');
    const posIndicator = document.getElementById('pos-indicator');
    
    function updatePosIndicator() {
        if(!posSelect || !posIndicator) return;
        const val = posSelect.value;
        
        // Reset position classes
        // Use regex or list to clear all margin/position classes we might have added
        posIndicator.className = posIndicator.className.replace(/\s(top|bottom|left|right)-\[.*?\]/g, '');
        
        // Also remove hardcoded ones if any remain from previous logic
        posIndicator.classList.remove('-top-1.5', '-left-1.5', '-right-1.5', '-bottom-1.5');
        
        // Add new position classes based on corner of the border box
        // Using negative margins to center on the corner line
        switch(val) {
            case 'top-left':
                posIndicator.classList.add('-top-1.5', '-left-1.5');
                break;
            case 'top-right':
                posIndicator.classList.add('-top-1.5', '-right-1.5'); // corrected from right-1.5 to -right-1.5
                break;
            case 'bottom-left':
                posIndicator.classList.add('-bottom-1.5', '-left-1.5');
                break;
            case 'bottom-right':
                posIndicator.classList.add('-bottom-1.5', '-right-1.5');
                break;
        }
    }
    
    function selectPosition(element, value) {
        // Update Hidden Input
        const hiddenInput = document.getElementById('Position');
        hiddenInput.value = value;
        
        // Trigger change events for Live Preview listener in Index.cshtml
        hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
        hiddenInput.dispatchEvent(new Event('input', { bubbles: true }));
        
        // Visual Update
        const container = document.getElementById('positionSelector');
        const boxes = container.querySelectorAll('.active-pos-box');
        
        boxes.forEach(box => {
            // Remove active classes
            box.classList.remove('border-purple-600', 'ring-1', 'ring-purple-600', 'bg-purple-50');
            box.classList.add('border-gray-200', 'bg-white');
            
            // Remove check dot if exists
            const dot = box.querySelector('.check-dot');
            if(dot) dot.remove();
        });
        
        // Add active classes to selected
        element.classList.remove('border-gray-200', 'bg-white');
        element.classList.add('border-purple-600', 'ring-1', 'ring-purple-600', 'bg-purple-50');
        
        // Add check dot
        const dot = document.createElement('div');
        dot.className = 'absolute top-2 right-2 w-2 h-2 bg-purple-600 rounded-full check-dot';
        element.appendChild(dot);
        
        // Trigger generic update
        updatePosIndicator();
    }
    
    // Initial Load
    if(posSelect) {
        updatePosIndicator(); 
    }

    // Dual Slider Logic
    function initDualSlider(group, maxRange) {
        // Range Sliders (using data-slider attribute instead of name)
        const minRangeInput = document.querySelector(`input[data-slider="${group}MinRange"]`);
        const maxRangeInput = document.querySelector(`input[data-slider="${group}MaxRange"]`);
        // Text Inputs
        const minNumInput = document.querySelector(`input[name="${group}Min"]`);
        const maxNumInput = document.querySelector(`input[name="${group}Max"]`);
        
        const rangeBar = document.getElementById(`${group}RangeBar`);

        if(!minRangeInput || !maxRangeInput || !minNumInput || !maxNumInput) return;

        function updateUI() {
            let min = parseInt(minRangeInput.value);
            let max = parseInt(maxRangeInput.value);

            // Avoid crossing visually
             if (min > max) {
                 const tmp = min;
                 min = max;
                 max = tmp;
             }
             
            // Calculate percentage for bar
            const percentMin = (min / maxRange) * 100;
            const percentMax = (max / maxRange) * 100;

            if (rangeBar) {
                rangeBar.style.left = percentMin + "%";
                rangeBar.style.width = (percentMax - percentMin) + "%";
            }
        }

        // Attach listeners for text inputs to update sliders
        minNumInput.addEventListener('change', () => syncSlider(minNumInput, `${group}MinRange`));
        maxNumInput.addEventListener('change', () => syncSlider(maxNumInput, `${group}MaxRange`));

        // Initial UI update
        updateUI();
    }
    
    // Called when range slider moves
    function syncInput(slider, targetId) {
        const targetInput = document.getElementById(targetId);
        if(targetInput) {
            targetInput.value = slider.value;
            
            // Check cross constraint
            const group = targetId.replace('Min', '').replace('Max', '');
            const isMin = targetId.includes('Min');
            
            const otherInputId = isMin ? group + 'Max' : group + 'Min';
            const otherSliderName = isMin ? group + 'MaxRange' : group + 'MinRange';
            
            const otherInput = document.getElementById(otherInputId);
            const otherSlider = document.querySelector(`input[data-slider="${otherSliderName}"]`);
            
            if(otherInput && otherSlider) {
                let thisVal = parseInt(slider.value);
                let otherVal = parseInt(otherInput.value);
                
                if(isMin && thisVal > otherVal) {
                    targetInput.value = otherVal;
                    slider.value = otherVal;
                } else if(!isMin && thisVal < otherVal) {
                    targetInput.value = otherVal;
                    slider.value = otherVal;
                }
            }
            
            // Update the bar UI
            const minRangeInput = document.querySelector(`input[data-slider="${group}MinRange"]`);
            const maxRangeInput = document.querySelector(`input[data-slider="${group}MaxRange"]`);
            const rangeBar = document.getElementById(`${group}RangeBar`);
            
            // Re-calc bar
             if (minRangeInput && maxRangeInput && rangeBar) {
                 // Hacky way to get max from attribute, or assume passed in init
                 const maxScale = parseInt(minRangeInput.getAttribute('max')); 
                 const min = parseInt(minRangeInput.value);
                 const max = parseInt(maxRangeInput.value);
                 const percentMin = (min / maxScale) * 100;
                 const percentMax = (max / maxScale) * 100;
                 rangeBar.style.left = percentMin + "%";
                 rangeBar.style.width = (percentMax - percentMin) + "%";
             }
        }
    }
    
    // Called when text input changes
    function syncSlider(numInput, targetSliderName) {
        const slider = document.querySelector(`input[data-slider="${targetSliderName}"]`);
        if(slider) {
            // Validate constrain
            const group = numInput.id.replace('Min', '').replace('Max', '');
            const isMin = numInput.id.includes('Min');
             
            const otherInputId = isMin ? group + 'Max' : group + 'Min';
            const otherInput = document.getElementById(otherInputId);
            
            let val = parseInt(numInput.value);
            // bounds check
            const maxScale = parseInt(slider.max);
            if(val < 1) val = 1;
            if(val > maxScale) val = maxScale;
            
            if(otherInput) {
                let otherVal = parseInt(otherInput.value);
                if(isMin && val > otherVal) val = otherVal;
                if(!isMin && val < otherVal) val = otherVal;
            }
            
            numInput.value = val;
            slider.value = val;
            
             // Update the bar UI (duplicate logic, could refactor)
            const minRangeInput = document.querySelector(`input[data-slider="${group}MinRange"]`);
            const maxRangeInput = document.querySelector(`input[data-slider="${group}MaxRange"]`);
            const rangeBar = document.getElementById(`${group}RangeBar`);
            
             if (minRangeInput && maxRangeInput && rangeBar) {
                 const min = parseInt(minRangeInput.value);
                 const max = parseInt(maxRangeInput.value);
                 const percentMin = (min / maxScale) * 100;
                 const percentMax = (max / maxScale) * 100;
                 rangeBar.style.left = percentMin + "%";
                 rangeBar.style.width = (percentMax - percentMin) + "%";
             }
        }
    }

    // Initialize sliders
    document.addEventListener('DOMContentLoaded', () => {
        initDualSlider('Viewers', 500);
        initDualSlider('Followers', 500);
        initDualSlider('Buyers', 500);
    });

    initDualSlider('Viewers', 500);
    initDualSlider('Followers', 500);
    initDualSlider('Buyers', 500);

</script>

