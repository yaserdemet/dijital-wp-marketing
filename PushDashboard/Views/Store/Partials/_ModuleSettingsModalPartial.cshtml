<div id="module-settings-modal" class="fixed inset-0 z-50 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="closeModuleSettingsModal()"></div>

        <!-- Center modal -->
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full">
            <!-- Header -->
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4 border-b border-gray-200">
                <div class="flex justify-between items-center">
                    <div class="flex items-center">
                        <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-indigo-50 sm:mx-0 sm:h-10 sm:w-10">
                            <svg class="h-6 w-6 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="ml-4 text-left">
                            <h3 class="text-lg leading-6 font-medium text-gray-900" id="module-settings-modal-title">
                                Doğum Günü Hatırlatma
                            </h3>
                            <p class="text-sm text-gray-500">
                                Otomatik gönderim ve şablon ayarlarını yapılandırın
                            </p>
                        </div>
                    </div>
                    <button type="button" class="bg-white rounded-md text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" onclick="closeModuleSettingsModal()">
                        <span class="sr-only">Kapat</span>
                        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                
                <!-- Tabs -->
                <div class="mt-4 border-b border-gray-200">
                    <nav class="-mb-px flex space-x-8" aria-label="Tabs">
                        <a href="#" onclick="switchModalTab('settings')" id="tab-settings" class="border-pink-500 text-pink-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                            Ayarlar
                        </a>
                        <a href="#" onclick="switchModalTab('history')" id="tab-history" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                            Gönderim Geçmişi
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Content -->
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4 max-h-[70vh] overflow-y-auto">
                <!-- Settings Tab -->
                <div id="modal-content-settings">
                    <div id="module-settings-modal-content" class="space-y-6">
                        <!-- Settings will be loaded here -->
                        <div class="flex justify-center py-8">
                            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-pink-600"></div>
                        </div>
                    </div>
                </div>

                <!-- History Tab -->
                <div id="modal-content-history" class="hidden">
                    <div class="bg-gray-50 rounded-lg p-4 mb-4">
                        <div class="flex justify-between items-center">
                            <div>
                                <h4 class="text-base font-bold text-gray-900">Son Gönderimler</h4>
                                <p class="text-sm text-gray-600">Bu modül üzerinden yapılan son otomatik ve manuel gönderimler</p>
                            </div>
                            <button type="button" onclick="loadBirthdayHistory()" class="text-sm text-blue-600 hover:text-blue-800">
                                Yenile
                            </button>
                        </div>
                    </div>
                    
                    <div id="birthday-history-list" class="space-y-4">
                        <div class="flex justify-center py-8">
                            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-400"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                <button type="button" onclick="saveModuleSettings(true)" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-pink-600 text-base font-medium text-white hover:bg-pink-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-pink-500 sm:ml-3 sm:w-auto sm:text-sm">
                    Kaydet
                </button>
                <button type="button" onclick="closeModuleSettingsModal()" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                    Kapat
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function switchModalTab(tabName) {
        // Reset tabs
        document.getElementById('tab-settings').classList.remove('border-pink-500', 'text-pink-600');
        document.getElementById('tab-settings').classList.add('border-transparent', 'text-gray-500');
        
        document.getElementById('tab-history').classList.remove('border-pink-500', 'text-pink-600');
        document.getElementById('tab-history').classList.add('border-transparent', 'text-gray-500');
        
        // Hide content
        document.getElementById('modal-content-settings').classList.add('hidden');
        document.getElementById('modal-content-history').classList.add('hidden');
        
        // Activate selected
        const selectedTab = document.getElementById('tab-' + tabName);
        selectedTab.classList.remove('border-transparent', 'text-gray-500');
        selectedTab.classList.add('border-pink-500', 'text-pink-600');
        
        document.getElementById('modal-content-' + tabName).classList.remove('hidden');
        
        if (tabName === 'history') {
            loadBirthdayHistory();
        }
    }
    
    async function loadBirthdayHistory() {
        const historyList = document.getElementById('birthday-history-list');
        historyList.innerHTML = '<div class="flex justify-center py-8"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-400"></div></div>';
        
        try {
            const response = await axios.get('/Notification/GetBirthdayNotificationHistory', {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            if (response.data && response.data.success && response.data.data) {
                const notifications = response.data.data;
                
                if (notifications.length === 0) {
                    historyList.innerHTML = `
                        <div class="text-center py-8 text-gray-500">
                            <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p class="mt-2">Henüz gönderim geçmişi bulunmuyor.</p>
                        </div>`;
                    return;
                }
                
                let html = '<div class="space-y-3">';
                
                notifications.forEach(n => {
                    const statusClass = n.success ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800';
                    const statusText = n.success ? 'Başarılı' : 'Başarısız';
                    const channelIcon = getChannelIcon(n.channel);
                    const automaticBadge = n.isAutomatic 
                        ? '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800 ml-2">Otomatik</span>' 
                        : '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800 ml-2">Manuel</span>';
                    
                    const sentDate = new Date(n.sentAt);
                    const formattedDate = sentDate.toLocaleDateString('tr-TR', { 
                        day: '2-digit', 
                        month: '2-digit', 
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                    
                    html += `
                        <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                            <div class="flex items-start justify-between">
                                <div class="flex items-start space-x-3">
                                    <div class="flex-shrink-0">
                                        ${channelIcon}
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-900">${n.customerName || 'Bilinmiyor'}</p>
                                        <p class="text-sm text-gray-500">${n.customerEmail || n.customerPhone || '-'}</p>
                                        ${n.templateName ? `<p class="text-xs text-gray-400 mt-1">Şablon: ${n.templateName}</p>` : ''}
                                    </div>
                                </div>
                                <div class="flex flex-col items-end">
                                    <div class="flex items-center">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusClass}">
                                            ${statusText}
                                        </span>
                                        ${automaticBadge}
                                    </div>
                                    <p class="text-xs text-gray-400 mt-1">${formattedDate}</p>
                                    <p class="text-xs text-gray-500 mt-1">Maliyet: ${getCostDisplayText(n.channel)}</p>
                                </div>
                            </div>
                            ${!n.success && n.errorMessage ? `
                                <div class="mt-2 text-sm text-red-600 bg-red-50 rounded p-2">
                                    ${n.errorMessage}
                                </div>
                            ` : ''}
                        </div>`;
                });
                
                html += '</div>';
                
                // Pagination
                const pagination = response.data.pagination;
                if (pagination && pagination.totalPages > 1) {
                    html += `
                        <div class="flex justify-center items-center space-x-2 mt-4">
                            <button onclick="loadBirthdayHistoryPage(1)" class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 disabled:opacity-50" ${pagination.currentPage === 1 ? 'disabled' : ''}>
                                İlk
                            </button>
                            <button onclick="loadBirthdayHistoryPage(${pagination.currentPage - 1})" class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 disabled:opacity-50" ${pagination.currentPage === 1 ? 'disabled' : ''}>
                                Önceki
                            </button>
                            <span class="px-3 py-1 text-sm text-gray-600">
                                ${pagination.currentPage} / ${pagination.totalPages}
                            </span>
                            <button onclick="loadBirthdayHistoryPage(${pagination.currentPage + 1})" class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 disabled:opacity-50" ${pagination.currentPage === pagination.totalPages ? 'disabled' : ''}>
                                Sonraki
                            </button>
                            <button onclick="loadBirthdayHistoryPage(${pagination.totalPages})" class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 disabled:opacity-50" ${pagination.currentPage === pagination.totalPages ? 'disabled' : ''}>
                                Son
                            </button>
                        </div>`;
                }
                
                historyList.innerHTML = html;
            } else {
                historyList.innerHTML = '<p class="text-center text-gray-500 py-4">Kayıt bulunamadı.</p>';
            }
        } catch (error) {
            console.error('Error loading history:', error);
            historyList.innerHTML = '<p class="text-center text-red-500 py-4">Geçmiş yüklenirken bir hata oluştu.</p>';
        }
    }
    
    async function loadBirthdayHistoryPage(page) {
        const historyList = document.getElementById('birthday-history-list');
        historyList.innerHTML = '<div class="flex justify-center py-8"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-400"></div></div>';
        
        try {
            const response = await axios.get(`/Notification/GetBirthdayNotificationHistory?page=${page}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            if (response.data && response.data.success && response.data.data) {
                const notifications = response.data.data;
                
                if (notifications.length === 0) {
                    historyList.innerHTML = '<p class="text-center text-gray-500 py-4">Kayıt bulunamadı.</p>';
                    return;
                }
                
                let html = '<div class="space-y-3">';
                
                notifications.forEach(n => {
                    const statusClass = n.success ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800';
                    const statusText = n.success ? 'Başarılı' : 'Başarısız';
                    const channelIcon = getChannelIcon(n.channel);
                    const automaticBadge = n.isAutomatic 
                        ? '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800 ml-2">Otomatik</span>' 
                        : '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800 ml-2">Manuel</span>';
                    
                    const sentDate = new Date(n.sentAt);
                    const formattedDate = sentDate.toLocaleDateString('tr-TR', { 
                        day: '2-digit', 
                        month: '2-digit', 
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                    
                    html += `
                        <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                            <div class="flex items-start justify-between">
                                <div class="flex items-start space-x-3">
                                    <div class="flex-shrink-0">
                                        ${channelIcon}
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-900">${n.customerName || 'Bilinmiyor'}</p>
                                        <p class="text-sm text-gray-500">${n.customerEmail || n.customerPhone || '-'}</p>
                                        ${n.templateName ? `<p class="text-xs text-gray-400 mt-1">Şablon: ${n.templateName}</p>` : ''}
                                    </div>
                                </div>
                                <div class="flex flex-col items-end">
                                    <div class="flex items-center">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusClass}">
                                            ${statusText}
                                        </span>
                                        ${automaticBadge}
                                    </div>
                                    <p class="text-xs text-gray-400 mt-1">${formattedDate}</p>
                                    <p class="text-xs text-gray-500 mt-1">Maliyet: ${getCostDisplayText(n.channel)}</p>
                                </div>
                            </div>
                            ${!n.success && n.errorMessage ? `
                                <div class="mt-2 text-sm text-red-600 bg-red-50 rounded p-2">
                                    ${n.errorMessage}
                                </div>
                            ` : ''}
                        </div>`;
                });
                
                html += '</div>';
                
                // Pagination
                const pagination = response.data.pagination;
                if (pagination && pagination.totalPages > 1) {
                    html += `
                        <div class="flex justify-center items-center space-x-2 mt-4">
                            <button onclick="loadBirthdayHistoryPage(1)" class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 disabled:opacity-50" ${pagination.currentPage === 1 ? 'disabled' : ''}>
                                İlk
                            </button>
                            <button onclick="loadBirthdayHistoryPage(${pagination.currentPage - 1})" class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 disabled:opacity-50" ${pagination.currentPage === 1 ? 'disabled' : ''}>
                                Önceki
                            </button>
                            <span class="px-3 py-1 text-sm text-gray-600">
                                ${pagination.currentPage} / ${pagination.totalPages}
                            </span>
                            <button onclick="loadBirthdayHistoryPage(${pagination.currentPage + 1})" class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 disabled:opacity-50" ${pagination.currentPage === pagination.totalPages ? 'disabled' : ''}>
                                Sonraki
                            </button>
                            <button onclick="loadBirthdayHistoryPage(${pagination.totalPages})" class="px-3 py-1 text-sm border border-gray-300 rounded-md hover:bg-gray-100 disabled:opacity-50" ${pagination.currentPage === pagination.totalPages ? 'disabled' : ''}>
                                Son
                            </button>
                        </div>`;
                }
                
                historyList.innerHTML = html;
            } else {
                historyList.innerHTML = '<p class="text-center text-gray-500 py-4">Kayıt bulunamadı.</p>';
            }
        } catch (error) {
            console.error('Error loading history:', error);
            historyList.innerHTML = '<p class="text-center text-red-500 py-4">Geçmiş yüklenirken bir hata oluştu.</p>';
        }
    }
    
    function getChannelIcon(channel) {
        switch ((channel || '').toLowerCase()) {
            case 'whatsapp':
                return '<div class="w-8 h-8 rounded-full bg-green-50 flex items-center justify-center"><svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></div>';
            case 'email':
                return '<div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center"><svg class="w-5 h-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>';
            case 'sms':
                return '<div class="w-8 h-8 rounded-full bg-purple-50 flex items-center justify-center"><svg class="w-5 h-5 text-purple-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg></div>';
            default:
                return '<div class="w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center"><svg class="w-5 h-5 text-gray-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg></div>';
        }
    }
    
    function getCostDisplayText(channel) {
        switch ((channel || '').toLowerCase()) {
            case 'whatsapp':
                return '1 TL';
            case 'email':
            case 'sms':
            default:
                return 'Ücretsiz';
        }
    }
    
    function closeModuleSettingsModal() {
        document.getElementById('module-settings-modal').classList.add('hidden');
    }
    
    function openModuleSettingsModal(title) {
        document.getElementById('module-settings-modal-title').textContent = title;
        document.getElementById('module-settings-modal').classList.remove('hidden');
        switchModalTab('settings');
    }
</script>