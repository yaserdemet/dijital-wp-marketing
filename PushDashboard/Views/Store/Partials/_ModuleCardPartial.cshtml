@model PushDashboard.ViewModels.StoreIndexViewModel.ModuleViewModel



@* 
    Color Theme: #02379c (Navy Blue)
*@

<div class="group relative flex flex-col h-full bg-white rounded-xl border border-gray-200 transition-shadow duration-300 hover:shadow-[0_2px_8px_rgba(0,0,0,0.05)] overflow-visible module-card"
     data-category-id="@Model.CategoryId"
     data-category-name="@Model.CategoryName"
     data-status="@(Model.IsOwned ? "owned" : "available")"
     data-module-id="@Model.Id"
     data-module-name="@Model.Name">


    @* Owned Status Indicator (Corner Ribbon or Badge) *@
    @if (Model.IsOwned)
    {
        <div class="absolute top-4 right-4 z-20 flex gap-2">
            @if (!Model.IsPassive)
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-green-50 text-green-700 border border-green-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span>
                    Aktif
                </span>
            }
            else 
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-gray-100 text-gray-500 border border-gray-200">
                   <span class="w-1.5 h-1.5 rounded-full bg-gray-400 mr-1.5"></span>
                   Pasif
                </span>
            }
             <label class="relative inline-flex items-center cursor-pointer" title="@(!Model.IsPassive ? "Modülü Pasifleştir" : "Modülü Etkinleştir")">
                <input type="checkbox" class="sr-only peer" onchange="toggleModuleStatus('@Model.Id', '@Model.Name', this)" @(!Model.IsPassive ? "checked" : "")>
                <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-gray-900"></div>
            </label>
        </div>
    }

    else if (!string.IsNullOrEmpty(Model.StatusBadge))
    {
         <div class="absolute top-4 right-4 z-20">
            <span class="px-3 py-1 text-xs font-bold @Model.StatusBadgeClass rounded-full ring-1 ring-inset ring-black/5">
                @Model.StatusBadge
            </span>
        </div>
    }

    <div class="p-6 flex flex-col h-full relative z-10">
        @* Header: Icon & Title *@
        <div class="flex items-start gap-4 mb-5">
            <div class="flex-shrink-0 w-16 h-16 rounded-xl flex items-center justify-center text-3xl border border-indigo-100 bg-indigo-50 text-indigo-600">
                @if (!string.IsNullOrEmpty(Model.IconClass))
                {
                    <i class="@Model.IconClass"></i>
                }
                else
                {
                    <svg class="w-8 h-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z"></path></svg>
                }
            </div>
            <div class="flex-grow pt-1 min-w-0">
                 <div class="text-[10px] uppercase tracking-wider font-bold text-gray-400 mb-1 truncate">
                    @Model.CategoryName
                </div>
                <h3 class="text-xl font-bold text-gray-900 leading-tight transition-colors line-clamp-2" title="@Model.Name">
                    @Model.Name
                </h3>
            </div>
        </div>

        @* Description *@
        <div class="mb-6 flex-grow">
            <p class="text-gray-500 text-sm leading-relaxed line-clamp-3">
                @Model.Description
            </p>
        </div>

        @* Features List *@
        @if (Model.Features?.Any() == true)
        {
            <div class="mb-6 bg-gray-50 rounded-xl p-3 border border-gray-200">
                <ul class="space-y-2">
                    @foreach (var feature in Model.Features.Take(2))
                    {
                        <li class="flex items-start text-xs font-medium text-gray-600">
                             <svg class="w-4 h-4 text-emerald-600 mr-2 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            <span class="line-clamp-1">@feature</span>
                        </li>
                    }
                     @if(Model.Features.Count > 2)
                    {
                        <li class="pl-6 relative">
                            <button type="button" class="feature-popover-toggle flex items-center text-xs text-gray-700 font-semibold gap-2" aria-expanded="false" aria-controls="more-features-@Model.Id" data-module-id="@Model.Id" title="Diğer özellikleri göster">
                                <span>+@(Model.Features.Count - 2) diğer özellik</span>
                                <svg class="w-3 h-3 text-gray-700 transition-transform" data-rotate-icon viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>

                            <div id="more-features-@Model.Id" class="absolute left-0 top-full mt-2 w-64 max-h-48 overflow-auto bg-white border border-gray-200 rounded-lg p-3 ring-1 ring-black/5 hidden z-30" role="dialog" aria-modal="false" aria-hidden="true" aria-label="Diğer özellikler">
                                <span class="absolute -top-2 left-6 w-3 h-3 bg-white border border-gray-200 transform rotate-45 pointer-events-none"></span>
                                <ul class="space-y-2 text-xs text-gray-600">
                                    @foreach (var feature in Model.Features.Skip(2))
                                    {
                                        <li class="flex items-start">
                                            <svg class="w-4 h-4 text-emerald-600 mr-2 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                            <span class="line-clamp-1">@feature</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
        else 
        {
            <div class="mb-6 h-[86px]"></div> @* Spacer for alignment if no features *@
        }

        @* Bottom Section: Pricing & Actions *@
        <div class="mt-auto pt-2">
             @if (!Model.IsOwned)
            {
               <div class="mb-4">
                   @if (Model.HasPackages)
                   {
                       <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-lg">
                           <i class="fas fa-layer-group text-indigo-500 text-[10px]"></i>
                           <span class="text-xs font-semibold text-gray-700">Paket fiyatlarını gör</span>
                       </div>
                   }
                   else
                   {
                       <div class="flex items-baseline gap-1">
                           <span class="text-2xl font-semibold text-gray-900">@Model.FormattedPrice</span>
                       </div>
                   }
               </div>
            }

            <div class="flex gap-2">
                 @if (Model.IsOwned)
                {
                    <div class="w-full flex flex-col gap-3">
                         @{
                             var _pct = (Model.HasQuotaInfo && Model.TotalQuota!.Value > 0)
                                 ? (int)((Model.RemainingQuota!.Value / Model.TotalQuota.Value) * 100)
                                 : 0;
                             var _barColor = _pct > 50 ? "bg-green-500" : (_pct > 20 ? "bg-orange-400" : "bg-red-500");
                         }
                         @* Quota Info (for package-based modules like Yorum Taşıma) *@
                         @if (Model.HasQuotaInfo)
                         {
                             <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                                 <div class="flex items-center justify-between mb-2">
                                     <div class="flex items-center gap-1.5">
                                         <i class="fas fa-layer-group text-indigo-500 text-xs"></i>
                                         <span class="text-xs font-semibold text-gray-700">@Model.PackageName (@(Model.SubscriptionType == "Yearly" ? "Yıllık" : "Aylık"))</span>
                                     </div>
                                     <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-100 text-gray-700">%@_pct kaldı</span>
                                 </div>
                                 <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden mb-2">
                                     <div class="@_barColor h-2 rounded-full transition-all duration-500" style="width: @_pct%"></div>
                                 </div>
                                 <div class="flex items-center justify-between text-[11px] text-gray-500">
                                     <span><strong class="text-gray-700">@Model.RemainingQuota!.Value.ToString("N0")</strong> kullanım kaldı</span>
                                     <span>(@Model.TotalQuota!.Value.ToString("N0") toplam)</span>
                                 </div>
                                 <button onclick="purchaseModule('@Model.Id', '@Model.Name', '@Model.Price', '@Model.MonthlyPrice', '@Model.YearlyPrice', true)"
                                         class="mt-2.5 w-full text-xs font-semibold text-gray-700 border border-gray-200 bg-white hover:bg-gray-50 rounded-lg py-1.5 transition-all">
                                     <i class="fas fa-arrows-rotate mr-1"></i> Paket Yükselt / Yenile
                                 </button>
                             </div>
                         }
                         else if (Model.ExpiresAt.HasValue)
                         {
                             @* Subscription Info (for subscription-based modules) *@
                             <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
                                 <div class="flex items-center justify-between mb-2">
                                     <span class="text-xs text-gray-500">Abonelik Süresi (@(Model.SubscriptionType == "Yearly" ? "Yıllık" : "Aylık"))</span>
                                     @{
                                         var daysRemaining = (Model.ExpiresAt.Value - DateTime.Now).Days;
                                         var isExpiringSoon = daysRemaining <= 7 && daysRemaining > 0;
                                         var isExpired = daysRemaining <= 0;
                                         var badgeClass = isExpired ? "bg-red-100 text-red-700" : (isExpiringSoon ? "bg-orange-100 text-orange-700" : "bg-gray-100 text-gray-700");
                                     }
                                     <span class="px-2 py-0.5 rounded text-[10px] font-medium @badgeClass">
                                         @if (isExpired)
                                         {
                                             <text>Süresi doldu</text>
                                         }
                                         else if (daysRemaining == 0)
                                         {
                                             <text>Bugün doluyor</text>
                                         }
                                         else if (daysRemaining == 1)
                                         {
                                             <text>1 gün kaldı</text>
                                         }
                                         else
                                         {
                                             <text>@daysRemaining gün kaldı</text>
                                         }
                                     </span>
                                 </div>
                                 <div class="flex items-center justify-between text-sm">
                                     <span class="text-gray-600">@Model.ExpiresAt.Value.ToString("dd MMM yyyy")</span>
                                     <label class="inline-flex items-center cursor-pointer" title="@(Model.AutoRenewal ? "Yenilemeyi Kapat" : "Yenilemeyi Aç")">
                                         <span class="mr-2 text-xs text-gray-500">Oto. Yenileme</span>
                                         <input type="checkbox" class="sr-only peer autorenewal-toggle" data-module-id="@Model.Id" @(Model.AutoRenewal ? "checked" : "")>
                                         <div class="w-8 h-4 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-gray-900 relative"></div>
                                     </label>
                                 </div>
                             </div>
                         }
                        
                         @* Control Row *@
                         <div class="flex items-center justify-between">
                             <button onclick="openModuleSettings('@Model.Id', '@Model.Name')" 
                                     class="w-full flex items-center justify-center px-4 py-2 bg-gray-50 hover:bg-white border border-gray-200 text-gray-700 rounded-lg transition-all text-sm font-medium group/btn" title="Modül Ayarları">
                                <svg class="w-4 h-4 mr-2 text-gray-400 transition-colors" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5H3"></path><path d="M12 19H3"></path><path d="M14 3v4"></path><path d="M16 17v4"></path><path d="M21 12h-9"></path><path d="M21 19h-5"></path><path d="M21 5h-7"></path><path d="M8 10v4"></path><path d="M8 12H3"></path></svg>
                                Hızlı Ayarlar
                             </button>
                         </div>

                        @if (Model.HasPageUrl)
                        {
                            <a href="@Model.PageUrl" class="w-full inline-flex justify-center items-center px-4 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg transition-all text-sm font-medium translate-y-0 hover:translate-y-0.5">
                                Yönetim Paneli
                                <svg class="w-4 h-4 ml-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
                            </a>
                        }
                        else
                        {
                            <div class="w-full flex items-center justify-center px-4 py-2 bg-gray-50 text-gray-700 rounded-lg border border-gray-200 text-xs font-medium text-center">
                                <svg class="w-4 h-4 mr-2 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                                Ayarlar bu sayfadan yapılır
                            </div>
                        }
                    </div>
                }
                else
                {
                    <button onclick="purchaseModule('@Model.Id', '@Model.Name', '@Model.Price', '@Model.MonthlyPrice', '@Model.YearlyPrice', @(Model.HasPackages ? "true" : "false"))" class="flex-1 px-4 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg transition-all text-sm font-medium">
                        Hemen Satın Al
                    </button>
                    <button onclick="openModuleDetails('@Model.Id', '@Model.Name')" class="px-3 py-2.5 bg-white text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 hover:border-gray-300 transition-colors" title="Detayları İncele">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><circle cx="12" cy="12" r="1"></circle><path d="M18.944 12.33a1 1 0 0 0 0-.66 7.5 7.5 0 0 0-13.888 0 1 1 0 0 0 0 .66 7.5 7.5 0 0 0 13.888 0"></path></svg>
                    </button>
                }
            </div>
        </div>
    </div>
</div>


