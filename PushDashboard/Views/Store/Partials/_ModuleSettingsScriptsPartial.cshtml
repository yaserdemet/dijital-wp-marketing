  // Save Stock Reminder settings
  async function saveStockReminderSettings() {
    try {
      const settings = {
        enabled: document.getElementById('setting-stock-reminder-enabled')?.checked || false,
        emailEnabled: document.getElementById('setting-enable-email')?.checked || false,
        smsEnabled: document.getElementById('setting-enable-sms')?.checked || false,
        whatsAppEnabled: document.getElementById('setting-enable-whatsapp')?.checked || false,
        pushEnabled: false,
        stockThreshold: parseInt(document.getElementById('setting-stock-threshold')?.value) || 10,
        
        // Template settings
        emailTemplate: document.getElementById('setting-email-template')?.value || '',
        emailTemplateName: document.getElementById('setting-email-template-name')?.value || '',
        smsTemplate: document.getElementById('setting-sms-template')?.value || '',
        smsTemplateName: document.getElementById('setting-sms-template-name')?.value || '',
        whatsAppTemplate: document.getElementById('setting-whatsapp-template')?.value || '',
        whatsAppTemplateName: document.getElementById('setting-whatsapp-template-name')?.value || ''
      };

      const response = await axios.post('/api/StockReminderModule/settings', settings, {
        headers: {
          'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
          'Content-Type': 'application/json'
        }
      });

      if (response.status === 200) {
        showNotification('Stok hatırlatma ayarları başarıyla kaydedildi!', 'success');
        currentModuleSettings = settings;
      } else {
        showNotification(response.data.message || 'Ayarlar kaydedilemedi.', 'error');
      }
    } catch (error) {
      console.error('Error saving stock reminder settings:', error);
      if (error.response && error.response.data && error.response.data.message) {
        showNotification(error.response.data.message, 'error');
      } else {
        showNotification('Ayarlar kaydedilirken bir hata oluştu.', 'error');
      }
    }
  }



