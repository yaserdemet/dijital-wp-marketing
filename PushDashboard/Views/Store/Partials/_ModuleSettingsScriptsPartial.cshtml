  // Collect settings from form
  function collectSettingsFromForm() {
    const settings = {};

    // General settings
    settings.enabled = document.getElementById('setting-enabled')?.checked || false;
    settings.notifications = document.getElementById('setting-notifications')?.checked || false;

    // Collect enabled channels for bulk messaging
    const enabledChannels = [];
    const emailCheckbox = document.getElementById('setting-enable-bulk-email');
    const whatsappCheckbox = document.getElementById('setting-enable-bulk-whatsapp');

    if (emailCheckbox && emailCheckbox.checked) {
      enabledChannels.push('email');
    }
    if (whatsappCheckbox && whatsappCheckbox.checked) {
      enabledChannels.push('whatsapp');
    }

    if (enabledChannels.length > 0) {
      settings.enabledChannels = enabledChannels;
    }

    // Collect template settings for birthday module (always save, even if empty)
    const emailTemplate = document.getElementById('setting-email-template')?.value || '';
    const emailTemplateName = document.getElementById('setting-email-template-name')?.value || '';
    const smsTemplate = document.getElementById('setting-sms-template')?.value || '';
    const smsTemplateName = document.getElementById('setting-sms-template-name')?.value || '';
    const whatsappTemplate = document.getElementById('setting-whatsapp-template')?.value || '';
    const whatsappTemplateName = document.getElementById('setting-whatsapp-template-name')?.value || '';

    settings.emailTemplate = emailTemplate;
    settings.emailTemplateName = emailTemplateName;
    settings.smsTemplate = smsTemplate;
    settings.smsTemplateName = smsTemplateName;
    settings.whatsappTemplate = whatsappTemplate;
    settings.whatsappTemplateName = whatsappTemplateName;

    // Collect gift voucher settings for birthday module
    const enableGiftVoucher = document.getElementById('setting-enable-gift-voucher')?.checked || false;
    const giftVoucherAmount = parseFloat(document.getElementById('setting-gift-voucher-amount')?.value) || 50;
    const giftVoucherDiscountType = parseInt(document.getElementById('setting-gift-voucher-discount-type')?.value) || 1;
    const giftVoucherValidityDays = parseInt(document.getElementById('setting-gift-voucher-validity-days')?.value) || 365;
    const giftVoucherDescription = document.getElementById('setting-gift-voucher-description')?.value || 'Doğum Günü Hediye Çeki';

    settings.enableGiftVoucher = enableGiftVoucher;
    settings.giftVoucherAmount = giftVoucherAmount;
    settings.giftVoucherDiscountType = giftVoucherDiscountType;
    settings.giftVoucherValidityDays = giftVoucherValidityDays;
    settings.giftVoucherDescription = giftVoucherDescription;

    // Collect module specific settings from both sidebar and modal containers
    const inputs = document.querySelectorAll('#module-settings-content input, #module-settings-content select, #module-settings-content textarea, #module-settings-modal-content input, #module-settings-modal-content select, #module-settings-modal-content textarea');
    inputs.forEach(input => {
      if (input.id && input.id.startsWith('setting-')) {
        // Skip bulk channel checkboxes as they are handled above
        if (input.id.includes('enable-bulk-')) {
          return;
        }
        if (input.id.includes('-template') || input.id.includes('-template-name')) {
          return;
        }

        const key = input.id.replace('setting-', '').replace(/-([a-z])/g, (g) => g[1].toUpperCase());

        if (input.type === 'checkbox') {
          settings[key] = input.checked;
          if (key === 'autoSend' && !input.checked) {
            settings[key] = false;
          }
        } else if (input.type === 'number') {
          const value = parseFloat(input.value);
          settings[key] = isNaN(value) ? 0 : value;
        } else {
          settings[key] = input.value;
        }
      }
    });

    if (!settings.hasOwnProperty('autoSend')) {
      const autoSendCheckbox = document.getElementById('setting-auto-send');
      if (autoSendCheckbox) {
        settings.autoSend = autoSendCheckbox.checked;
      } else {
        settings.autoSend = false;
      }
    }

    return settings;
  }

  // Reset module settings
async function resetModuleSettings() {
  if (!currentModuleId) return;

  showConfirmationDialog('Ayarları Sıfırla', "Ayarları varsayılan değerlere sıfırlamak istediğinizden emin misiniz?", 'Evet', 'Hayır', async () => {
    try {
      const response = await axios.post(`/Store/ResetModuleSettings?moduleId=${currentModuleId}`, {}, {
        headers: {
          "RequestVerificationToken": document.querySelector("input[name=\"__RequestVerificationToken\"]").value,
          "Content-Type": "application/json"
        }
      });

      if (response.data.success) {
        showNotification("Ayarlar varsayılan değerlere sıfırlandı!", 'success');
        // Reload settings to show default values
        loadModuleSettings(currentModuleId);
      } else {
        showNotification(response.data.message || "Ayarlar sıfırlanamadı.", 'error');
      }
    } catch (error) {
      console.error("Error resetting module settings:", error);
      showNotification("Ayarlar sıfırlanırken bir hata oluştu.", 'error');
    }
  });
}
