    } catch (error) {
      console.error('Error testing gift voucher:', error);
      showNotification('Hediye çeki testi sırasında hata oluştu.', 'error');
    }
  }



  // Escape key handling - PushDialog manages its own key events
  // Kept for backward compatibility with modal-based modules
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      // PushDialog handles escape internally, no manual sidebar check needed
    }
  });

  // Template selector modal functions
  let currentTemplateChannelType = '';
  let currentTemplateChannelName = '';
  let currentModuleType = ''; // Modül tipi için (FirstOrder, BulkMessaging, etc.)
  let templateSelectorDialog = null;

  async function openTemplateSelector(channelType, channelName, moduleType = '') {
    currentTemplateChannelType = channelType;
    currentTemplateChannelName = channelName;
    currentModuleType = moduleType;

    if (!templateSelectorDialog) {
        templateSelectorDialog = new PushDialog({
            title: `${channelName} Şablonları`,
            size: 'md',
            position: 'center',
            closeOnOverlayClick: true,
            closeOnEsc: true
        });
    } else {
        templateSelectorDialog.setTitle(`${channelName} Şablonları`);
        templateSelectorDialog.setContent(''); // Clear previous content
    }

    // Set initial loading content
    const loadingHtml = `
      <div class="text-center py-8">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-pink-600"></div>
        <p class="mt-2 text-sm text-gray-600">Şablonlar yükleniyor...</p>
      </div>
    `;
    templateSelectorDialog.setContent(loadingHtml);
    templateSelectorDialog.open();

    try {
      const response = await axios.get(`/TemplateModule/GetChannelTemplates?channelType=${channelType}&moduleType=${currentModuleType || ''}`, {
        headers: {
          'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        }
      });

      if (response.data.success && response.data.data && response.data.data.length > 0) {
        const templates = response.data.data;
        const currentSelectedTemplate = document.getElementById(`setting-${channelType}-template-id`)?.value || 
                                        document.getElementById(`setting-${channelType}-template`)?.value || '';

        const templatesHtml = templates.map(template => {
          const templateName = (template.name || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
          const displayName = (template.displayName || template.name || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          const previewContent = template.previewContent ? (template.previewContent || '').replace(/</g, '&lt;').replace(/>/g, '&gt;') : '';
          const subject = template.subject ? (template.subject || '').replace(/</g, '&lt;').replace(/>/g, '&gt;') : '';
          const displayNameForOnClick = (template.displayName || template.name || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');

          return `
          <div class="p-3 mb-2 border border-gray-200 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors ${currentSelectedTemplate === template.name ? 'bg-pink-50 border-pink-300' : ''}"
               onclick="selectTemplate('${templateName}', '${displayNameForOnClick}')">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="font-medium text-sm text-gray-900">${displayName}</div>
                ${previewContent ? `<div class="text-xs text-gray-500 mt-1 line-clamp-2">${previewContent}</div>` : ''}
                ${subject ? `<div class="text-xs text-gray-400 mt-1">Konu: ${subject}</div>` : ''}
              </div>
              ${currentSelectedTemplate === template.name ? `
                <svg class="w-5 h-5 text-pink-600 ml-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              ` : ''}
            </div>
          </div>
        `;
        }).join('');
        
        templateSelectorDialog.setContent(`<div class="space-y-2 max-h-[60vh] overflow-y-auto">${templatesHtml}</div>`);

      } else {
        const emptyHtml = `
          <div class="text-center py-8">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <p class="mt-2 text-sm text-gray-600">Bu kanal için şablon bulunamadı.</p>
          </div>
        `;
        templateSelectorDialog.setContent(emptyHtml);
      }
    } catch (error) {
      console.error('Error loading templates:', error);
      templateSelectorDialog.setContent('<p class="text-center text-red-500 py-4">Şablonlar yüklenirken hata oluştu.</p>');
      showNotification('Şablonlar yüklenirken hata oluştu.', 'error');
    }
  }

  function selectTemplate(templateName, templateDisplayName) {
    // İlk olarak doğum günü modülü için kullanılan standard ID'leri dene
    let templateInput = document.getElementById(`setting-${currentTemplateChannelType}-template`);
    let templateNameInput = document.getElementById(`setting-${currentTemplateChannelType}-template-name`);
    
    // Eğer bulunamazsa ilk alışveriş modülü için kullanılan ID'leri dene
    if (!templateInput) {
      templateInput = document.getElementById(`setting-${currentTemplateChannelType}-template-id`);
    }
    
    const templateDisplayDiv = document.getElementById(`selected-template-${currentTemplateChannelType}`);

    if (templateInput) {
      templateInput.value = templateName;
    }
    if (templateNameInput) {
      templateNameInput.value = templateDisplayName;
    }
    if (templateDisplayDiv) {
      const escapedName = templateDisplayName.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      templateDisplayDiv.innerHTML = `<span class="font-medium">${escapedName}</span>`;
    }

    if (templateSelectorDialog) {
        templateSelectorDialog.close();
    }
    showNotification('Şablon seçildi.', 'success');
  }

  // Toggle auto send visibility (artık buton her zaman görünür, bu fonksiyon sadece bilgilendirme için)
  function toggleAutoSend() {
    // Buton artık her zaman görünür, sadece log tutabiliriz
    const autoSendCheckbox = document.getElementById('setting-auto-send');
    if (autoSendCheckbox) {
      const isAutoSend = autoSendCheckbox.checked;
      console.log('Auto send toggled:', isAutoSend);
    }
  }

  // Ensure 24-hour format for send time input
  function ensure24HourFormat() {
    const sendTimeInput = document.getElementById('setting-send-time');
    if (sendTimeInput) {
      // HTML5 time input already uses 24-hour format, but we can add validation
      sendTimeInput.addEventListener('change', function() {
        const value = this.value;
        if (value) {
          const [hours, minutes] = value.split(':');
          const hour = parseInt(hours, 10);
          if (hour < 0 || hour > 23) {
            showNotification('Saat 00:00 ile 23:59 arasında olmalıdır (24 saatlik format).', 'error');
            this.value = '09:00';
          }
        }
      });
    }
  }

  // Send birthday notifications now
  async function sendBirthdayNotificationsNow(event) {
    if (!currentModuleId) return;

    const button = event?.target || document.querySelector('#birthday-summary button, #manual-send-section button');
    if (!button) return;

    const originalText = button.textContent;

    try {
      button.disabled = true;
      button.textContent = 'Gönderiliyor...';

      const response = await axios.post('/Notification/SendBirthdayNotifications', {}, {
        headers: {
          'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
          'Content-Type': 'application/json'
        }
      });

      if (response.data.success) {
        showNotification(response.data.message || `Doğum günü bildirimleri başarıyla gönderildi! (${response.data.notificationsSent || 0} adet)`, 'success');
        // Özet raporu güncelle
        const birthdayCount = await getTodaysBirthdayCount();
        const summaryDiv = document.getElementById('birthday-summary');
        if (summaryDiv) {
          const countElement = summaryDiv.querySelector('.text-sm.font-bold');
          if (countElement) {
            countElement.textContent = `${birthdayCount} müşteri`;
          }
        }
      } else {
        showNotification(response.data.message || 'Bildirimler gönderilemedi.', 'error');
      }
    } catch (error) {
      console.error('Error sending birthday notifications:', error);
      showNotification('Bildirimler gönderilirken bir hata oluştu.', 'error');
    } finally {
      button.disabled = false;
      button.textContent = originalText;
    }
  }
</script>