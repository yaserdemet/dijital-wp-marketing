  // Save module settings
  async function saveModuleSettings(isModal = false) {
    if (!currentModuleId) return;

    // Check if this is the First Order module
    const moduleInfo = await getModuleInfo(currentModuleId);

    if (moduleInfo && moduleInfo.name === 'İlk Alışveriş Mesajı') {
      await saveFirstOrderSettings();
      return;
    }

    // Check if this is the Basket Reminder module
    if (moduleInfo && moduleInfo.name === 'Sepet Hatırlatma') {
      await saveBasketReminderSettings();
      return;
    }

    // Check if this is the Stock Reminder module
    if (moduleInfo && moduleInfo.name === 'Stok Hatırlatma') {
      await saveStockReminderSettings();
      return;
    }

    const settings = collectSettingsFromForm();

    try {
      const response = await axios.post(`/Store/SaveModuleSettings?moduleId=${currentModuleId}`, {
        settings: settings
      }, {
        headers: {
          'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
          'Content-Type': 'application/json'
        }
      });

      if (response.data.success) {
        showNotification('Ayarlar başarıyla kaydedildi!', 'success');
        currentModuleSettings = settings;
        if (isModal) {
            closeModuleSettingsModal();
        } else {
            closeModuleSettings(); // Close PushDialog
        }
      } else {
        showNotification(response.data.message || 'Ayarlar kaydedilemedi.', 'error');
      }
    } catch (error) {
      console.error('Error saving module settings:', error);
      showNotification('Ayarlar kaydedilirken bir hata oluştu.', 'error');
    }
  }

