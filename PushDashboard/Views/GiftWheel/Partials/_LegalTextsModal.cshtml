            .replaceAll('[FIRMA_UNVANI]', companyName)
            .replaceAll('[KAYIT_URL]', regUrl);
            
        // HTML Version
        const htmlContent = template.html
            .replaceAll('[FIRMA_UNVANI]', companyName)
            .replaceAll('[KAYIT_URL]', regUrl);

        const textArea = document.getElementById('modalContentText');
        const htmlArea = document.getElementById('modalContentHtml');

        if(textArea) textArea.value = textContent;
        if(htmlArea) htmlArea.value = htmlContent;
    }

    function updateLegalView(viewType) {
        const txtArea = document.getElementById('modalContentText');
        const htmlArea = document.getElementById('modalContentHtml');
        const btnTxt = document.getElementById('btnModalText');
        const btnHtml = document.getElementById('btnModalHtml');

        if (!txtArea || !htmlArea) return;

        // Reset Styles
        btnTxt.className = "px-3 py-1.5 rounded-md text-xs font-medium transition-all text-gray-500 hover:text-gray-900 hover:bg-white/50";
        btnHtml.className = "px-3 py-1.5 rounded-md text-xs font-medium transition-all text-gray-500 hover:text-gray-900 hover:bg-white/50";

        if (viewType === 'text') {
            txtArea.classList.remove('hidden');
            htmlArea.classList.add('hidden');
            // Active Style for Text
            btnTxt.className = "px-3 py-1.5 rounded-md text-xs font-medium transition-all bg-white shadow-sm text-gray-900 border border-gray-200";
        } else {
            txtArea.classList.add('hidden');
            htmlArea.classList.remove('hidden');
            // Active Style for HTML
            btnHtml.className = "px-3 py-1.5 rounded-md text-xs font-medium transition-all bg-white shadow-sm text-gray-900 border border-gray-200";
        }
    }

    function copyLegalModalContent() {
        const txtArea = document.getElementById('modalContentText');
        const htmlArea = document.getElementById('modalContentHtml');
        let textToCopy = '';

        if (!txtArea.classList.contains('hidden')) {
            textToCopy = txtArea.value;
        } else {
            textToCopy = htmlArea.value;
        }

        navigator.clipboard.writeText(textToCopy).then(() => {
            // Show Feedback
            const overlay = document.getElementById('copyOverlay');
            if (overlay) {
                overlay.style.opacity = '1';
                setTimeout(() => {
                    overlay.style.opacity = '0';
                }, 1500);
            }
        });
    }

</script>