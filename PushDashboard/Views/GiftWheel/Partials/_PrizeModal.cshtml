<!-- Prize Add/Edit Modal Template -->
<template id="prizeFormTemplate">
    <form id="prizeForm" class="p-0 space-y-6">

        <!-- Quick Select Prizes -->
        <div class="bg-indigo-50/50 rounded-xl p-4 border border-indigo-100 flex flex-col gap-2 mb-2">
            <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-1">Hızlı Ekle:</span>
            <div class="flex flex-wrap gap-2">
                <!-- %10 İndirim (Süre Bazlı) -->
                <button type="button" class="quick-prize-btn px-3 py-1.5 bg-white border border-indigo-200 text-indigo-700 rounded-lg text-xs font-medium hover:bg-indigo-50 transition-colors shadow-sm"
                        data-name="%10 İndirim Fırsatı" 
                        data-type="voucher" 
                        data-amount="10" 
                        data-dtype="2" 
                        data-color="#ff6b6b"
                        data-textcolor="#ffffff"
                        data-vouchermode="duration"
                        data-validity="7"
                        data-vouchercodeformat="full_auto"
                        title="7 Gün Geçerli %10 İndirim">
                   <i class="fas fa-percent mr-1"></i> %10 (7 Gün)
                </button>

                <!-- 50 TL İndirim (Kullanım Bazlı) -->
                <button type="button" class="quick-prize-btn px-3 py-1.5 bg-white border border-indigo-200 text-indigo-700 rounded-lg text-xs font-medium hover:bg-indigo-50 transition-colors shadow-sm"
                        data-name="50 TL Hediye Çeki" 
                        data-type="voucher" 
                        data-amount="50" 
                        data-dtype="1" 
                        data-color="#4ecdc4"
                        data-textcolor="#ffffff"
                        data-vouchermode="usage"
                        data-vouchercodeformat="full_auto"
                        title="Tek Kullanımlık 50 TL Çeki">
                   <i class="fas fa-tag mr-1"></i> 50 TL (Tek)
                </button>

                <!-- Özel Kupon (Sabit Ön Ek) -->
                <button type="button" class="quick-prize-btn px-3 py-1.5 bg-white border border-indigo-200 text-indigo-700 rounded-lg text-xs font-medium hover:bg-indigo-50 transition-colors shadow-sm"
                       data-name="Kış İndirimi" 
                       data-type="voucher" 
                       data-amount="20"
                       data-dtype="1"
                       data-color="#a55eea"
                       data-textcolor="#ffffff"
                       data-vouchermode="duration"
                       data-validity="30"
                       data-vouchercodeformat="fixed_prefix"
                       data-prefix="KIS2024"
                       title="Sabit Ön Ekli (KIS2024...) 20 TL">
                   <i class="fas fa-font mr-1"></i> Özel (KIS2024)
                </button>

                <!-- Ücretsiz Kargo (24 Saat) -->
                <button type="button" class="quick-prize-btn px-3 py-1.5 bg-white border border-indigo-200 text-indigo-700 rounded-lg text-xs font-medium hover:bg-indigo-50 transition-colors shadow-sm"
                       data-name="Ücretsiz Kargo" 
                       data-type="cargo" 
                       data-amount="100"
                       data-color="#45aaf2"
                       data-textcolor="#ffffff"
                       data-vouchermode="duration"
                       data-validity="1"
                       data-vouchercodeformat="full_auto"
                       title="24 Saatlik Ücretsiz Kargo">
                   <i class="fas fa-truck mr-1"></i> Kargo (24h)
                </button>

                <!-- Tekrar Dene (Mesaj) -->
                <button type="button" class="quick-prize-btn px-3 py-1.5 bg-white border border-indigo-200 text-indigo-700 rounded-lg text-xs font-medium hover:bg-indigo-50 transition-colors shadow-sm"
                       data-name="Tekrar Deneyiniz" 
                       data-type="message" 
                       data-color="#95a5a6"
                       data-textcolor="#ffffff"
                       title="Pasif Ödül">
                   <i class="fas fa-redo mr-1"></i> Tekrar Dene
                </button>
            </div>
        </div>

        <!-- Hidden ID Field -->
        <input type="hidden" id="prizeId" name="prizeId">

                    <!-- Row 1: Name & Type -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Prize Name -->
                        <div class="space-y-1">
                            <label for="prizeName" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                Ödül Adı <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="prizeName" name="prizeName" required
                                   class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-gray-800 text-sm font-medium bg-gray-50/30 hover:bg-white transition-all placeholder:text-gray-400"
                                   placeholder="Örn: 100 TL Hediye Çeki" maxlength="100">
                            <div class="text-red-500 text-xs mt-1 hidden" id="prizeNameError"></div>
                        </div>

                        <!-- Prize Type -->
                        <div class="space-y-1">
                            <label for="prizeType" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                Ödül Türü <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <select id="prizeType" name="prizeType" required
                                        class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-gray-800 text-sm font-medium bg-gray-50/30 hover:bg-white transition-all appearance-none cursor-pointer">
                                    <option value="voucher">Hediye Çeki</option>
                                    <option value="cargo">Kargo İndirimi</option>
                                    <option value="message">Yeniden Deneyin</option>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
                                    <i class="fas fa-chevron-down text-xs"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Message Type Info Box -->
                    <div id="messageTypeInfo" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-4">
                        <div class="flex items-start space-x-3">
                            <div class="flex-shrink-0">
                                <i class="fas fa-info-circle text-amber-500 text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-amber-800">Bilgilendirme</h4>
                                <p class="text-sm text-amber-700 mt-1">
                                    Bu ödül türünde hediye çeki oluşturulmayacaktır. Kullanıcıya sadece "Yeniden Deneyin" mesajı gösterilecektir.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Cargo Type Info Box -->
                    <div id="cargoTypeInfo" class="hidden bg-blue-50 border border-blue-200 rounded-xl p-4">
                        <div class="flex items-start space-x-3">
                            <div class="flex-shrink-0">
                                <i class="fas fa-truck text-blue-500 text-lg"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-blue-800">Kargo İndirimi</h4>
                                <p class="text-sm text-blue-700 mt-1">
                                    Bu indirim tüm kargo seçeneklerinde geçerli olacaktır. Aşağıdan yüzde olarak indirim oranını belirleyiniz.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Cargo Settings (Conditional) -->
                    <div id="cargoSettings" class="hidden bg-blue-50/50 rounded-xl p-5 border border-blue-100/50 space-y-4 transition-all">
                        <div class="flex items-center space-x-2 text-blue-900 mb-2">
                             <i class="fas fa-truck text-blue-500"></i>
                             <h4 class="text-sm font-bold">Kargo İndirim Ayarları</h4>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-start">
                            <!-- Cargo Discount Percentage -->
                            <div class="space-y-1">
                                <label for="cargoDiscountAmount" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                    Kargo İndirim Oranı <span class="text-red-500">*</span>
                                </label>
                                <div class="relative group">
                                     <input type="number" id="cargoDiscountAmount" name="cargoDiscountAmount"
                                       min="1" max="100" step="1" value="100"
                                       class="w-full pl-3 pr-8 py-2 rounded-lg border border-blue-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 text-gray-800 text-xs font-medium bg-white transition-all"
                                       placeholder="100">
                                      <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                        <span class="text-gray-400 text-xs font-bold group-focus-within:text-blue-500 transition-colors">%</span>
                                      </div>
                                </div>
                                <p class="text-[10px] text-gray-400 mt-1 leading-tight">100 = Ücretsiz Kargo, 50 = %50 İndirim</p>
                            </div>

                            <!-- Validity -->
                            <div class="space-y-1" id="cargoValidityDaysContainer">
                                <label for="cargoValidityDays" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                    Geçerlilik Süresi (Gün)
                                </label>
                                <div class="relative group">
                                     <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="far fa-clock text-gray-400 group-focus-within:text-blue-500 transition-colors text-xs"></i>
                                    </div>
                                    <input type="number" id="cargoValidityDays" name="cargoValidityDays"
                                       min="1" max="9999" value="30"
                                      class="w-full pl-9 pr-3 py-2 rounded-lg border border-blue-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 text-xs font-medium bg-white transition-all"
                                       placeholder="30">
                                </div>
                                <p class="text-[10px] text-gray-400 mt-1 leading-tight">Yüklenme tarihinden itibaren.</p>
                            </div>

                            <div class="space-y-1" id="cargoMinimumOrderAmountContainer">
                                <label for="cargoMinimumOrderAmount" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                    Minimum Sepet Tutarı (TL)
                                </label>
                                <div class="relative group">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-shopping-cart text-gray-400 group-focus-within:text-blue-500 transition-colors text-xs"></i>
                                    </div>
                                    <input type="number" id="cargoMinimumOrderAmount" name="cargoMinimumOrderAmount"
                                           min="0" max="999999.99" step="0.01"
                                           class="w-full pl-9 pr-3 py-2 rounded-lg border border-blue-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 text-xs font-medium bg-white transition-all"
                                           placeholder="2000.00">
                                </div>
                                <p class="text-[10px] text-gray-400 mt-1 leading-tight">0 veya boş bırakılırsa sınırsız kullanım.</p>
                            </div>
                        </div>

                        <!-- Cargo Voucher Mode -->
                        <div class="space-y-1">
                            <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                Kupon Çalışma Modu
                            </label>
                            <div class="grid grid-cols-2 gap-3">
                                <label class="relative cursor-pointer group">
                                    <input type="radio" name="cargoVoucherMode" value="duration" class="peer sr-only" checked>
                                    <div class="bg-white border border-blue-200 rounded-lg p-2.5 flex items-center space-x-3 hover:border-blue-300 peer-checked:border-blue-500 peer-checked:ring-1 peer-checked:ring-blue-500 peer-checked:bg-blue-50/50 transition-all">
                                        <div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center text-blue-400 peer-checked:bg-blue-100 peer-checked:text-blue-600 shrink-0 transition-colors">
                                            <i class="far fa-clock text-xs"></i>
                                        </div>
                                        <div class="flex flex-col">
                                            <span class="text-xs font-bold text-gray-700 peer-checked:text-blue-900 group-hover:text-blue-800 transition-colors">Süre Bazlı</span>
                                            <span class="text-[10px] text-gray-400 group-hover:text-gray-500 leading-none mt-0.5">Belirtilen gün kadar geçerli</span>
                                        </div>
                                        <div class="absolute top-2 right-2 text-blue-500 opacity-0 peer-checked:opacity-100 transition-opacity">
                                            <i class="fas fa-check-circle text-xs"></i>
                                        </div>
                                    </div>
                                </label>
                                <label class="relative cursor-pointer group">
                                    <input type="radio" name="cargoVoucherMode" value="usage" class="peer sr-only">
                                     <div class="bg-white border border-blue-200 rounded-lg p-2.5 flex items-center space-x-3 hover:border-blue-300 peer-checked:border-blue-500 peer-checked:ring-1 peer-checked:ring-blue-500 peer-checked:bg-blue-50/50 transition-all">
                                        <div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center text-blue-400 peer-checked:bg-blue-100 peer-checked:text-blue-600 shrink-0 transition-colors">
                                            <i class="fas fa-user-tag text-xs"></i>
                                        </div>
                                        <div class="flex flex-col">
                                            <span class="text-xs font-bold text-gray-700 peer-checked:text-blue-900 group-hover:text-blue-800 transition-colors">Kullanım Bazlı</span>
                                            <span class="text-[10px] text-gray-400 group-hover:text-gray-500 leading-none mt-0.5">Tek seferlik kullanım, 365 gün geçerli</span>
                                        </div>
                                         <div class="absolute top-2 right-2 text-blue-500 opacity-0 peer-checked:opacity-100 transition-opacity">
                                            <i class="fas fa-check-circle text-xs"></i>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Cargo Voucher Code Format -->
                        <div class="space-y-1">
                            <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                Kupon Kodu Formatı
                            </label>
                            <div class="grid grid-cols-3 gap-2">
                                <label class="relative cursor-pointer group">
                                    <input type="radio" name="cargoVoucherCodeFormat" value="full_auto" class="peer sr-only" checked>
                                    <div class="bg-white border border-blue-200 rounded-lg p-2 flex flex-col items-center justify-center text-center hover:border-blue-300 peer-checked:border-blue-500 peer-checked:ring-1 peer-checked:ring-blue-500 peer-checked:bg-blue-50/50 transition-all h-full">
                                        <span class="text-[10px] font-bold text-gray-700 peer-checked:text-blue-900 mb-1 group-hover:text-blue-800">Tam Otomatik</span>
                                        <code class="text-[9px] bg-gray-100 px-1.5 py-0.5 rounded text-gray-500 font-mono peer-checked:bg-white peer-checked:text-blue-600 border border-transparent peer-checked:border-blue-100">X9A-2K1</code>
                                    </div>
                                </label>
                                <label class="relative cursor-pointer group">
                                    <input type="radio" name="cargoVoucherCodeFormat" value="auto_prefix" class="peer sr-only">
                                     <div class="bg-white border border-blue-200 rounded-lg p-2 flex flex-col items-center justify-center text-center hover:border-blue-300 peer-checked:border-blue-500 peer-checked:ring-1 peer-checked:ring-blue-500 peer-checked:bg-blue-50/50 transition-all h-full">
                                        <span class="text-[10px] font-bold text-gray-700 peer-checked:text-blue-900 mb-1 group-hover:text-blue-800">Ön Ekli Oto.</span>
                                        <code class="text-[9px] bg-gray-100 px-1.5 py-0.5 rounded text-gray-500 font-mono peer-checked:bg-white peer-checked:text-blue-600 border border-transparent peer-checked:border-blue-100">YAZ-X9A</code>
                                    </div>
                                </label>
                                <label class="relative cursor-pointer group">
                                    <input type="radio" name="cargoVoucherCodeFormat" value="fixed_prefix" class="peer sr-only">
                                     <div class="bg-white border border-blue-200 rounded-lg p-2 flex flex-col items-center justify-center text-center hover:border-blue-300 peer-checked:border-blue-500 peer-checked:ring-1 peer-checked:ring-blue-500 peer-checked:bg-blue-50/50 transition-all h-full">
                                        <span class="text-[10px] font-bold text-gray-700 peer-checked:text-blue-900 mb-1 group-hover:text-blue-800">Sabit Ön Ek</span>
                                        <code class="text-[9px] bg-gray-100 px-1.5 py-0.5 rounded text-gray-500 font-mono peer-checked:bg-white peer-checked:text-blue-600 border border-transparent peer-checked:border-blue-100">INDIRIM-20</code>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Cargo Voucher Prefix -->
                        <div class="space-y-1 hidden" id="cargoVoucherPrefixContainer">
                            <label for="cargoVoucherPrefix" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                Kupon Ön Eki
                            </label>
                            <input type="text" id="cargoVoucherPrefix" name="cargoVoucherPrefix"
                                   maxlength="10"
                                   class="w-full px-4 py-2 rounded-lg border border-blue-200 focus:border-blue-500 text-sm bg-white uppercase"
                                   placeholder="Örn: KARGO">
                        </div>

                        <!-- Cargo Allow Discounted Products -->
                        <div class="flex items-center justify-between p-3 bg-white rounded-lg border border-blue-200">
                            <div>
                                <span class="text-sm font-medium text-gray-700">İndirimli ürünlerde geçerli</span>
                                <p class="text-xs text-gray-500">Zaten indirimde olan ürünlerde bu kupon kullanılabilsin mi?</p>
                            </div>
                            <label class="inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="cargoAllowDiscountedProducts" name="cargoAllowDiscountedProducts" checked class="sr-only peer">
                                <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                            </label>
                        </div>

                        <!-- Cargo Combine With Other Campaigns -->
                        <div class="flex items-center justify-between p-3 bg-white rounded-lg border border-blue-200">
                            <div>
                                <span class="text-sm font-medium text-gray-700">Başka kampanyalarla birleştirilebilir</span>
                                <p class="text-xs text-gray-500">Bu kupon diğer kampanyalarla birlikte kullanılabilsin mi?</p>
                            </div>
                            <label class="inline-flex items-center cursor-pointer relative">
                                <input type="checkbox" id="cargoCombineWithOtherCampaigns" name="cargoCombineWithOtherCampaigns" class="absolute inset-0 w-11 h-6 opacity-0 peer z-10">
                                <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                            </label>
                        </div>
                    </div>

                    <!-- Voucher Settings (Conditional) -->
                    <div id="voucherSettings" class="bg-indigo-50/50 rounded-xl p-5 border border-indigo-100/50 space-y-4 transition-all">
                        <div class="flex items-center space-x-2 text-indigo-900 mb-2">
                             <i class="fas fa-ticket-alt text-indigo-500"></i>
                             <h4 class="text-sm font-bold">Kupon Ayarları</h4>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <!-- Discount Amount -->
                            <div class="space-y-1">
                                <label for="discountAmount" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                    Miktar <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                     <input type="number" id="discountAmount" name="discountAmount"
                                       min="0.01" max="999999.99" step="0.01"
                                       class="w-full pl-4 pr-12 py-2.5 rounded-lg border border-indigo-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-gray-800 text-sm font-medium bg-white transition-all"
                                       placeholder="0.00">
                                      <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                        <span class="text-gray-400 text-xs font-bold" id="amountSuffix">TL</span>
                                      </div>
                                </div>
                                <div class="text-red-500 text-xs mt-1 hidden" id="discountAmountError"></div>
                            </div>

                            <!-- Discount Type -->
                            <div class="space-y-1">
                                <label for="discountType" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                    İndirim Tipi <span class="text-red-500">*</span>
                                </label>
                                <div class="flex bg-white rounded-lg p-1 border border-indigo-200">
                                    <label class="flex-1 cursor-pointer">
                                        <input type="radio" name="discountType" value="1" class="peer sr-only" checked>
                                        <div class="text-center py-1.5 rounded-md text-xs font-medium text-gray-500 peer-checked:bg-indigo-100 peer-checked:text-indigo-700 transition-all">
                                            Tutar (TL)
                                        </div>
                                    </label>
                                    <label class="flex-1 cursor-pointer">
                                        <input type="radio" name="discountType" value="2" class="peer sr-only">
                                        <div class="text-center py-1.5 rounded-md text-xs font-medium text-gray-500 peer-checked:bg-indigo-100 peer-checked:text-indigo-700 transition-all">
                                            Yüzde (%)
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Validity -->
                        <div class="space-y-1" id="validityDaysContainer">
                            <label for="validityDays" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                Geçerlilik Süresi (Gün)
                            </label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="far fa-clock text-gray-400 group-focus-within:text-indigo-500 transition-colors"></i>
                                </div>
                                <input type="number" id="validityDays" name="validityDays"
                                   min="1" max="9999" value="30"
                                   class="w-28 pl-9 pr-3 py-2 rounded-lg border border-indigo-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 text-xs font-medium bg-white transition-all"
                                   placeholder="30">
                            </div>
                        </div>

                        <div class="space-y-1" id="minimumOrderAmountContainer">
                            <label for="minimumOrderAmount" class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                Minimum Sepet Tutarı (TL)
                            </label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-shopping-cart text-gray-400 group-focus-within:text-indigo-500 transition-colors"></i>
                                </div>
                                <input type="number" id="minimumOrderAmount" name="minimumOrderAmount"
                                       min="0" max="999999.99" step="0.01"
                                       class="w-full pl-9 pr-3 py-2 rounded-lg border border-indigo-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10 text-xs font-medium bg-white transition-all"
                                       placeholder="2000.00">
                            </div>
                            <p class="text-[10px] text-gray-400 mt-1 leading-tight">0 veya boş bırakılırsa sınırsız kullanım.</p>
                        </div>

                        <!-- Voucher Mode -->
                        <div class="space-y-1">
                            <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wide">
                                Kupon Çalışma Modu
                            </label>
                             <div class="grid grid-cols-2 gap-3">
                                <label class="relative cursor-pointer group">
                                    <input type="radio" name="voucherMode" value="duration" class="peer sr-only" checked>
                                    <div class="bg-white border border-indigo-200 rounded-lg p-2.5 flex items-center space-x-3 hover:border-indigo-300 peer-checked:border-indigo-500 peer-checked:ring-1 peer-checked:ring-indigo-500 peer-checked:bg-indigo-50/50 transition-all">
