<script>
window.initPrizeFormListeners = function() {
    const form = document.getElementById('prizeForm');
    if (!form) return; // Should not happen if dialog is open

    const prizeTypeSelect = document.getElementById('prizeType');
    const voucherSettings = document.getElementById('voucherSettings');
    const probabilitySlider = document.getElementById('probabilitySlider');
    const probabilityInput = document.getElementById('probability');
    const colorInput = document.getElementById('prizeColor');
    const colorTextInput = document.getElementById('prizeColorText');
    const textColorInput = document.getElementById('textColor');
    const textColorTextInput = document.getElementById('textColorText');
    const amountSuffix = document.getElementById('amountSuffix');
    const discountRadios = document.getElementsByName('discountType');

    // Handle discount type radio change to update suffix
    function updateSuffix() {
        // Find checked radio
        let selectedValue = '1';
        for(const radio of discountRadios) {
            if(radio.checked) {
                selectedValue = radio.value;
                break;
            }
        }
        amountSuffix.textContent = selectedValue === '1' ? 'TL' : '%';
    }

    // Add listener to radios
    Array.from(discountRadios).forEach(radio => {
        radio.addEventListener('change', () => {
             updateSuffix();
             updatePreview();
        });
    });

    // Prize type change handler
    const cargoSettings = document.getElementById('cargoSettings');
    const cargoTypeInfo = document.getElementById('cargoTypeInfo');
    const messageTypeInfo = document.getElementById('messageTypeInfo');

    prizeTypeSelect.addEventListener('change', function() {
        // Hide all conditional sections first
        voucherSettings.classList.add('hidden');
        cargoSettings.classList.add('hidden');
        cargoTypeInfo.classList.add('hidden');
        messageTypeInfo.classList.add('hidden');
        document.getElementById('discountAmount').required = false;

        if (this.value === 'voucher') {
            voucherSettings.classList.remove('hidden');
            document.getElementById('discountAmount').required = true;
        } else if (this.value === 'cargo') {
            cargoSettings.classList.remove('hidden');
            cargoTypeInfo.classList.remove('hidden');
        } else if (this.value === 'message') {
            messageTypeInfo.classList.remove('hidden');
        }
        updatePreview();
    });

    // Voucher code format change - show/hide prefix input
    const voucherCodeFormatRadios = document.getElementsByName('voucherCodeFormat');
    const voucherPrefixContainer = document.getElementById('voucherPrefixContainer');

    function updateVoucherPrefixVisibility() {
        const selectedFormat = document.querySelector('input[name="voucherCodeFormat"]:checked')?.value;
        if (selectedFormat === 'auto_prefix' || selectedFormat === 'fixed_prefix') {
            voucherPrefixContainer.classList.remove('hidden');
        } else {
            voucherPrefixContainer.classList.add('hidden');
        }
    }

    Array.from(voucherCodeFormatRadios).forEach(radio => {
        radio.addEventListener('change', updateVoucherPrefixVisibility);
    });

    // Cargo voucher code format change
    const cargoVoucherCodeFormatRadios = document.getElementsByName('cargoVoucherCodeFormat');
    const cargoVoucherPrefixContainer = document.getElementById('cargoVoucherPrefixContainer');

    function updateCargoVoucherPrefixVisibility() {
        const selectedFormat = document.querySelector('input[name="cargoVoucherCodeFormat"]:checked')?.value;
        if (selectedFormat === 'auto_prefix' || selectedFormat === 'fixed_prefix') {
            cargoVoucherPrefixContainer.classList.remove('hidden');
        } else {
            cargoVoucherPrefixContainer.classList.add('hidden');
        }
    }

    Array.from(cargoVoucherCodeFormatRadios).forEach(radio => {
        radio.addEventListener('change', updateCargoVoucherPrefixVisibility);
    });

    // Voucher Mode Toggle - Validity Visibility
    const voucherModeRadios = document.getElementsByName('voucherMode');
    const validityDaysContainer = document.getElementById('validityDaysContainer');

    function updateValidityVisibility() {
        let selectedMode = 'duration';
        for(const radio of voucherModeRadios) {
            if(radio.checked) {
                selectedMode = radio.value;
                break;
            }
        }
        
        if(validityDaysContainer) {
            if (selectedMode === 'duration') {
                validityDaysContainer.classList.remove('hidden');
            } else {
                validityDaysContainer.classList.add('hidden');
            }
        }

        const fixedPrefixRadio = document.querySelector('input[name="voucherCodeFormat"][value="fixed_prefix"]');
        if (fixedPrefixRadio) {
            const fixedPrefixLabel = fixedPrefixRadio.closest('label');
            if (selectedMode === 'usage') {
                fixedPrefixRadio.disabled = true;
                if (fixedPrefixRadio.checked) {
                    const fullAutoRadio = document.querySelector('input[name="voucherCodeFormat"][value="full_auto"]');
                    if (fullAutoRadio) {
                        fullAutoRadio.checked = true;
                        fullAutoRadio.dispatchEvent(new Event('change'));
                    }
                }
                if (fixedPrefixLabel) {
                    fixedPrefixLabel.style.opacity = '0.5';
                    fixedPrefixLabel.style.cursor = 'not-allowed';
                }
            } else {
                fixedPrefixRadio.disabled = false;
                if (fixedPrefixLabel) {
                    fixedPrefixLabel.style.opacity = '1';
                    fixedPrefixLabel.style.cursor = 'pointer';
                }
            }
        }
    }

    Array.from(voucherModeRadios).forEach(radio => {
        radio.addEventListener('change', updateValidityVisibility);
    });

    // Cargo Voucher Mode Toggle - Validity Visibility
    const cargoVoucherModeRadios = document.getElementsByName('cargoVoucherMode');
    const cargoValidityDaysContainer = document.getElementById('cargoValidityDaysContainer');

    function updateCargoValidityVisibility() {
         let selectedMode = 'duration';
        for(const radio of cargoVoucherModeRadios) {
            if(radio.checked) {
                selectedMode = radio.value;
                break;
            }
        }

        if(cargoValidityDaysContainer) {
             if (selectedMode === 'duration') {
                cargoValidityDaysContainer.classList.remove('hidden');
            } else {
                cargoValidityDaysContainer.classList.add('hidden');
            }
        }

        const cargoFixedPrefixRadio = document.querySelector('input[name="cargoVoucherCodeFormat"][value="fixed_prefix"]');
        if (cargoFixedPrefixRadio) {
            const cargoFixedPrefixLabel = cargoFixedPrefixRadio.closest('label');
            if (selectedMode === 'usage') {
                cargoFixedPrefixRadio.disabled = true;
                if (cargoFixedPrefixRadio.checked) {
                    const cargoFullAutoRadio = document.querySelector('input[name="cargoVoucherCodeFormat"][value="full_auto"]');
                    if (cargoFullAutoRadio) {
                        cargoFullAutoRadio.checked = true;
                        cargoFullAutoRadio.dispatchEvent(new Event('change'));
                    }
                }
                if (cargoFixedPrefixLabel) {
                    cargoFixedPrefixLabel.style.opacity = '0.5';
                    cargoFixedPrefixLabel.style.cursor = 'not-allowed';
                }
            } else {
                cargoFixedPrefixRadio.disabled = false;
                if (cargoFixedPrefixLabel) {
                    cargoFixedPrefixLabel.style.opacity = '1';
                    cargoFixedPrefixLabel.style.cursor = 'pointer';
                }
            }
        }
    }

    Array.from(cargoVoucherModeRadios).forEach(radio => {
        radio.addEventListener('change', updateCargoValidityVisibility);
    });

    // Initial calls for visibility
    updateValidityVisibility();
    updateCargoValidityVisibility();
    updateVoucherPrefixVisibility();
    updateCargoVoucherPrefixVisibility();

    // Probability slider sync
    probabilitySlider.addEventListener('input', function() {
        probabilityInput.value = this.value;
        updatePreview();
        checkProbabilityWarning();
    });

    probabilityInput.addEventListener('input', function() {
        probabilitySlider.value = this.value;
        updatePreview();
        checkProbabilityWarning();
    });

    // Color picker sync
    colorInput.addEventListener('input', function() {
        colorTextInput.value = this.value;
        updatePreview();
    });

    colorTextInput.addEventListener('input', function() {
        if (/^#[0-9A-Fa-f]{6}$/.test(this.value)) {
            colorInput.value = this.value;
            updatePreview();
        }
    });

    // Text color picker sync
    textColorInput.addEventListener('input', function() {
        textColorTextInput.value = this.value;
        updatePreview();
    });

    textColorTextInput.addEventListener('input', function() {
        if (/^#[0-9A-Fa-f]{6}$/.test(this.value)) {
            textColorInput.value = this.value;
            updatePreview();
        }
    });

    // Color presets for background
    document.querySelectorAll('.bg-color-preset').forEach(btn => {
        btn.addEventListener('click', function() {
            const color = this.dataset.color;
            colorInput.value = color;
            colorTextInput.value = color;
            updatePreview();
        });
    });

    // Color presets for text
    document.querySelectorAll('.text-color-preset').forEach(btn => {
        btn.addEventListener('click', function() {
            const color = this.dataset.color;
            textColorInput.value = color;
            textColorTextInput.value = color;
            updatePreview();
        });
    });

    // Form inputs change handler for preview
    ['prizeName', 'discountAmount', 'validityDays', 'minimumOrderAmount', 'cargoMinimumOrderAmount'].forEach(id => {
        const el = document.getElementById(id);
        if(el) el.addEventListener('input', updatePreview);
    });

    // Update preview function
    function updatePreview() {
    }

    // Check probability warning (delegated)
    function checkProbabilityWarning() {
        if (window.checkTotalProbability) {
            window.checkTotalProbability();
        }
    }

    // Form Validation & Submit
    function clearErrors() {
        document.querySelectorAll('[id$="Error"]').forEach(el => {
            el.classList.add('hidden');
            el.textContent = '';
        });
    }

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        clearErrors();

        let isValid = true;
        const prizeName = document.getElementById('prizeName').value.trim();

        if (!prizeName) {
            showError('prizeNameError', 'Ödül adı gereklidir');
            isValid = false;
        }

        if (prizeTypeSelect.value === 'voucher') {
            const discountAmount = parseFloat(document.getElementById('discountAmount').value);
            if (!discountAmount || discountAmount <= 0) {
                showError('discountAmountError', 'Geçerli bir indirim miktarı giriniz');
                isValid = false;
            }

            const minOrderAmount = document.getElementById('minimumOrderAmount')?.value;
            if (minOrderAmount && parseFloat(minOrderAmount) < 0) {
                showError('discountAmountError', 'Minimum sepet tutarı 0 veya daha büyük olmalıdır');
                isValid = false;
            }
        }

        if (prizeTypeSelect.value === 'cargo') {
            const cargoMinOrderAmount = document.getElementById('cargoMinimumOrderAmount')?.value;
            if (cargoMinOrderAmount && parseFloat(cargoMinOrderAmount) < 0) {
                showError('discountAmountError', 'Minimum sepet tutarı 0 veya daha büyük olmalıdır');
                isValid = false;
            }
        }

        const probability = parseInt(document.getElementById('probability').value);
        if (isNaN(probability) || probability < 0 || probability > 100) {
            showError('probabilityError', 'Olasılık 0-100 arasında olmalıdır');
            isValid = false;
        }

        if (isValid) {
            // Because we changed radio buttons layout, we need to ensure functionality works.
            // The standard FormData collection should still pick up the radio value correctly
            // because they share the name 'discountType'.

            if (window.giftWheelAdmin && window.giftWheelAdmin.submitPrizeForm) {
                 window.giftWheelAdmin.submitPrizeForm(new FormData(form));
            } else if (window.submitPrizeForm) {
                 window.submitPrizeForm(new FormData(form));
            }
        }
    });

    function showError(elementId, message) {
        const errorElement = document.getElementById(elementId);
        if(errorElement) {
            errorElement.textContent = message;
            errorElement.classList.remove('hidden');
        }
    }

    // Initial call
    updateSuffix();
};
</script>
