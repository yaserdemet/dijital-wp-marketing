@using PushDashboard.ViewModels
@model GiftWheelViewModel

<div class="space-y-8">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h3 class="text-lg font-medium text-gray-900">İstatistikler</h3>
            <p class="text-sm text-gray-600">Çarkınızın performansını ve kullanım verilerini görüntüleyin</p>
        </div>

        <!-- Date Range Filter -->
        <div class="flex items-center space-x-3">
            <select id="statsDateRange" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                <option value="1">Son 24 saat</option>
                <option value="7">Son 7 gün</option>
                <option value="30" selected>Son 30 gün</option>
                <option value="90">Son 90 gün</option>
                <option value="365">Son 1 yıl</option>
                <option value="custom">Özel tarih</option>
            </select>
            <button id="syncOrdersBtn" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium transition-colors flex items-center">
                <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span id="syncOrdersBtnText">Senkronize Et</span>
            </button>
        </div>
    </div>

    <!-- Custom Date Range (Hidden by default) -->
    <div id="customDateRange" class="bg-gray-50 rounded-lg p-4 hidden">
        <div class="flex items-center space-x-4">
            <div>
                <label for="startDate" class="block text-sm font-medium text-gray-700 mb-1">Başlangıç</label>
                <input type="date" id="startDate" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div>
                <label for="endDate" class="block text-sm font-medium text-gray-700 mb-1">Bitiş</label>
                <input type="date" id="endDate" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div class="pt-6">
                <button id="applyCustomDateBtn" class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
                    Uygula
                </button>
            </div>
        </div>
    </div>



    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Daily Activity Chart -->
        <div class="bg-white rounded-lg shadow-sm p-6">
            <h4 class="text-lg font-medium text-gray-900 mb-4">
                <i class="fas fa-chart-line mr-2 text-indigo-600"></i>
                Günlük Aktivite
            </h4>
            <div class="h-64">
                <canvas id="dailyActivityChart"></canvas>
            </div>
        </div>

        <!-- Prize Distribution Chart -->
        <div class="bg-white rounded-lg shadow-sm p-6">
            <h4 class="text-lg font-medium text-gray-900 mb-4">
                <i class="fas fa-chart-pie mr-2 text-indigo-600"></i>
                Ödül Dağılımı
            </h4>
            <div class="h-64">
                <canvas id="prizeDistributionChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Prize Performance Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-indigo-50/80 to-purple-50/50 border-b border-gray-100">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center shadow-sm">
                    <i class="fas fa-trophy text-white text-sm"></i>
                </div>
                <div>
                    <h4 class="text-base font-semibold text-gray-900">Ödül Performansı</h4>
                    <p class="text-xs text-gray-500 mt-0.5">Her ödülün gerçekleşen ve beklenen oranı</p>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead>
                    <tr class="border-b border-gray-100">
                        <th class="px-6 py-3.5 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Ödül</th>
                        <th class="px-6 py-3.5 text-center text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Kazanma</th>
                        <th class="px-6 py-3.5 text-center text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Kazanma Oranı</th>
                        <th class="px-6 py-3.5 text-center text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Olasılık</th>
                        <th class="px-6 py-3.5 text-center text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Performans</th>
                    </tr>
                </thead>
                <tbody id="prizePerformanceTable" class="divide-y divide-gray-50">
                    @foreach (var prizeStats in Model.Stats.PrizeStats)
                    {
                        var prize = Model.Prizes.FirstOrDefault(p => p.Id == prizeStats.PrizeId);
                        if (prize != null)
                        {
                            var performance = prize.Probability > 0 ? prizeStats.WinRate / prize.Probability : 0;
                            var perfBg = performance > 1.2m ? "bg-red-50 text-red-700 ring-red-600/10" : performance < 0.8m ? "bg-amber-50 text-amber-700 ring-amber-600/10" : "bg-emerald-50 text-emerald-700 ring-emerald-600/10";
                            var perfIcon = performance > 1.2m ? "fa-arrow-trend-up" : performance < 0.8m ? "fa-arrow-trend-down" : "fa-check";
                            var barWidth = Math.Min(prizeStats.WinRate, 100);
                            <tr class="group hover:bg-gray-50/70 transition-colors duration-150">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg flex items-center justify-center shadow-sm ring-1 ring-black/5" style="background-color: @prize.Color">
                                            <i class="fas fa-gift text-white text-xs"></i>
                                        </div>
                                        <span class="font-semibold text-sm text-gray-900">@prize.Name</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="text-sm font-bold text-gray-900">@prizeStats.TimesWon</span>
                                    <span class="text-xs text-gray-400 ml-0.5">kez</span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-col items-center gap-1.5">
                                        <span class="text-sm font-semibold text-gray-800">@prizeStats.WinRate.ToString("F1")%</span>
                                        <div class="w-full max-w-[80px] h-1.5 bg-gray-100 rounded-full overflow-hidden">
                                            <div class="h-full rounded-full transition-all duration-500" style="width: @barWidth%; background-color: @prize.Color"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="text-sm text-gray-500 font-medium">@prize.Probability%</span>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold ring-1 ring-inset @perfBg">
                                        <i class="fas @perfIcon text-[10px]"></i>
                                        @performance.ToString("F2")x
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detailed Logs Section -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-slate-50/90 to-indigo-50/40 border-b border-gray-100">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-sm">
                        <i class="fas fa-scroll text-white text-sm"></i>
                    </div>
                    <div>
                        <h4 class="text-base font-semibold text-gray-900">Detaylı İşlem Logları</h4>
                        <p class="text-xs text-gray-500 mt-0.5"><span id="logsTotalCount" class="font-medium text-indigo-600">0</span> kayıt bulundu</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button id="refreshLogsBtn" class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-all duration-150" title="Yenile">
                        <i class="fas fa-arrow-rotate-right text-sm"></i>
                    </button>
                    <button id="toggleLogsFilter" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-all duration-150">
                        <i class="fas fa-sliders text-[10px]"></i>Filtrele
                    </button>
                </div>
            </div>
        </div>

        <!-- Logs Filter Section -->
        <div id="logsFilterSection" class="px-6 py-5 bg-gradient-to-b from-gray-50/80 to-white border-b border-gray-100 hidden">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Başlangıç</label>
                    <input type="date" id="logsStartDate" class="w-full px-3 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-gray-700 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-400 transition-all">
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Bitiş</label>
                    <input type="date" id="logsEndDate" class="w-full px-3 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-gray-700 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-400 transition-all">
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Durum</label>
                    <select id="logsVoucherUsed" class="w-full px-3 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-gray-700 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-400 transition-all">
                        <option value="">Tüm kayıtlar</option>
                        <option value="true">Kullanıldı</option>
                        <option value="false">Kullanılmadı</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Arama</label>
                    <div class="relative">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-xs"></i>
                        <input type="text" id="logsSearchTerm" placeholder="İsim, telefon, kupon kodu..." class="w-full pl-9 pr-3 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-gray-700 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-400 transition-all placeholder:text-gray-300">
                    </div>
                </div>
            </div>
            <div class="flex justify-end mt-4 gap-2">
                <button id="clearLogsFilter" class="px-4 py-2 text-xs font-medium text-gray-500 hover:text-gray-700 rounded-lg hover:bg-gray-100 transition-all">
                    <i class="fas fa-eraser mr-1 text-[10px]"></i>Temizle
                </button>
                <button id="applyLogsFilter" class="px-5 py-2 bg-indigo-600 text-white text-xs font-semibold rounded-lg hover:bg-indigo-700 shadow-sm hover:shadow transition-all">
                    Uygula
                </button>
            </div>
        </div>

        <!-- Logs Table -->
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead>
                    <tr class="border-b border-gray-100">
                        <th class="px-5 py-3.5 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Müşteri</th>
                        <th class="px-5 py-3.5 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider">İletişim</th>
                        <th class="px-5 py-3.5 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Ödül</th>
                        <th class="px-5 py-3.5 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Kupon</th>
                        <th class="px-5 py-3.5 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Sipariş</th>
                        <th class="px-5 py-3.5 text-center text-[11px] font-semibold text-gray-400 uppercase tracking-wider">İzin</th>
                        <th class="px-5 py-3.5 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Tarih</th>
                        <th class="px-5 py-3.5 text-center text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Durum</th>
                    </tr>
                </thead>
                <tbody id="detailedLogsTable" class="divide-y divide-gray-50">
                    <tr>
                        <td colspan="8" class="px-6 py-16 text-center">
                            <div class="flex flex-col items-center gap-2">
                                <div class="w-10 h-10 rounded-full bg-indigo-50 flex items-center justify-center">
                                    <i class="fas fa-spinner fa-spin text-indigo-400"></i>
                                </div>
                                <span class="text-sm text-gray-400">Yükleniyor...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between bg-gray-50/50">
            <div class="text-xs text-gray-400">
                Sayfa <span id="logsCurrentPage" class="font-semibold text-gray-600">1</span> / <span id="logsTotalPages" class="font-semibold text-gray-600">1</span>
            </div>
            <div class="flex items-center gap-1.5">
                <button id="logsPrevPage" class="w-8 h-8 flex items-center justify-center border border-gray-200 rounded-lg text-xs text-gray-500 hover:bg-white hover:border-gray-300 hover:text-gray-700 disabled:opacity-40 disabled:hover:bg-transparent transition-all" disabled>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button id="logsNextPage" class="w-8 h-8 flex items-center justify-center border border-gray-200 rounded-lg text-xs text-gray-500 hover:bg-white hover:border-gray-300 hover:text-gray-700 disabled:opacity-40 disabled:hover:bg-transparent transition-all" disabled>
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>


    <!-- Export Options -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-5 bg-gradient-to-r from-gray-50/90 to-emerald-50/30 border-b border-gray-100">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-sm">
                    <i class="fas fa-cloud-arrow-down text-white text-sm"></i>
                </div>
                <div>
                    <h4 class="text-base font-semibold text-gray-900">Veri Dışa Aktarma</h4>
                    <p class="text-xs text-gray-500 mt-0.5">Seçili tarih aralığındaki tüm veriler</p>
                </div>
            </div>
        </div>
        <div class="px-6 py-5 flex flex-wrap items-center gap-3">
            <button id="exportExcelBtn" class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all duration-150">
                <i class="fas fa-file-excel"></i>
                Excel
            </button>
            <button id="exportCsvBtn" class="inline-flex items-center gap-2 px-5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all duration-150">
                <i class="fas fa-file-csv"></i>
                CSV
            </button>
            <button id="exportPdfBtn" class="inline-flex items-center gap-2 px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all duration-150">
                <i class="fas fa-file-pdf"></i>
                PDF Rapor
            </button>
        </div>
    </div>
</div>

<!-- html2pdf.js library for PDF generation -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<!-- 
  Note: Date range filtering, chart rendering, and data loading are handled by
  gift-wheel-admin.js (GiftWheelAdmin class). The statistics tab is loaded
  when the user switches tabs via switchTab('stats') in Index.cshtml.
  No inline script needed here — all event listeners and data loading
  are managed centrally in gift-wheel-admin.js to avoid duplicate handlers.
-->
