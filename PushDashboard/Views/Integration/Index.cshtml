                  <button type="button" onclick="openLegalTextsModal('etk')" title="Örnek Metni Al"
                            class="group relative inline-flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-700 bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 hover:border-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:border-gray-200 transition-all duration-200 whitespace-nowrap">
