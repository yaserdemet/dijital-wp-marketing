      // Update status mapping
      function updateStatusMapping(selectElement, integrationId) {
        // This function is called when a mapping is changed
        // We will save all mappings when the save button is clicked
      }

      // Save status mappings
      async function saveStatusMappings(integrationId) {
        try {
          // Tüm eşleştirmeleri sıfırla ve yeniden oluştur
          const mappings = {};
          const selects = document.querySelectorAll('select[data-system-status]');

          console.log('Found selects:', selects.length);

          // Her sistem durumu için eşleştirmeyi kontrol et
          selects.forEach(select => {
            const systemStatus = select.getAttribute('data-system-status');
            const ticimaxStatus = select.value;
            console.log(`System: ${systemStatus}, Ticimax: ${ticimaxStatus}`);

            // Sadece seçilmiş (boş olmayan) değerleri kaydet
            if (ticimaxStatus && ticimaxStatus !== '') {
              mappings[ticimaxStatus] = systemStatus;
            }
          });

          console.log('Saving mappings:', mappings);

          const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

          const response = await fetch('/Integration/SaveStatusMappings', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'RequestVerificationToken': token
            },
            body: JSON.stringify({
              integrationId: integrationId,
              statusMappings: mappings
            })
          });

          const result = await response.json();

          if (result.success) {
            showNotification(result.message || 'Durum eşleştirmeleri başarıyla kaydedildi.', 'success');
          } else {
            showNotification(result.message || 'Durum eşleştirmeleri kaydedilirken hata oluştu.', 'error');
          }
        } catch (error) {
          console.error('Error saving status mappings:', error);
          showNotification('Durum eşleştirmeleri kaydedilirken hata oluştu.', 'error');
        }
      }

      // Embed kod fonksiyonları
      async function loadEmbedCode() {
        try {
          const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
          const response = await axios.get('/Integration/GetModuleEmbedCode', {
            headers: {
              'RequestVerificationToken': token
            }
          });

          if (response.data.success) {
            const embedCodeDisplay = document.getElementById('embed-code-display');
            if (embedCodeDisplay) {
              embedCodeDisplay.textContent = response.data.embedCode;
            }
          } else {
            const embedCodeDisplay = document.getElementById('embed-code-display');
            if (embedCodeDisplay) {
              embedCodeDisplay.textContent = 'Kod yüklenirken hata oluştu: ' + response.data.message;
            }
          }
        } catch (error) {
          const embedCodeDisplay = document.getElementById('embed-code-display');
          if (embedCodeDisplay) {
            embedCodeDisplay.textContent = 'Kod yüklenirken hata oluştu.';
          }
        }
      }

          async function copyEmbedCode(e) {
              try {
                  const embedCodeDisplay = document.getElementById('embed-code-display');

                  // 1) Element gerçekten var mı?
                  if (!embedCodeDisplay) {
                      console.warn('embed-code-display bulunamadı');
                      showNotification('Kod bulunamadı.', 'error');
                      return;
                  }

                  const embedCode = (embedCodeDisplay.textContent || '').trim();

                  // 2) Yüklenmemiş veya hata aldıysa uyar
                  if (!embedCode || embedCode === 'Kod yükleniyor...' || embedCode.includes('hata oluştu')) {
                      showNotification('Önce kodun başarıyla yüklenmesini bekleyin.', 'warning');
                      return;
                  }

                  // 3) Panoya yaz
                  await navigator.clipboard.writeText(embedCode);

                  // 4) Buton referansı (event üzerinden güvenli al)
                  const copyButton = e?.currentTarget || e?.target?.closest('button');

                  if (copyButton) {
                      const originalHTML = copyButton.innerHTML;

                      copyButton.innerHTML = `
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"></path>
          </svg>
          Kopyalandı!
        `;
                      copyButton.classList.remove('bg-primary-100', 'hover:bg-primary-200', 'text-primary');
                      copyButton.classList.add('bg-green-100', 'text-green-600');

                      setTimeout(() => {
                          copyButton.innerHTML = originalHTML;
                          copyButton.classList.remove('bg-green-100', 'text-green-600');
                          copyButton.classList.add('bg-primary-100', 'hover:bg-primary-200', 'text-primary');
                      }, 2000);
                  }

                  showNotification('Embed kodu panoya kopyalandı!', 'success');
              } catch (error) {
                  console.error('copyEmbedCode error:', error);
                  showNotification('Kopyalama işlemi başarısız oldu.', 'error');
              }
  }

    </script>
}

<main class="p-4 bg-gray-50">
