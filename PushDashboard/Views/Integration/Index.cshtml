@model PushDashboard.ViewModels.IntegrationIndexViewModel
@{
  ViewData["Title"] = "Entegrasyonlar";
}

@section Scripts
  {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
      // Global variable to track connection test status
      let connectionTestPassed = false;
      let currentIntegrationId = null;    // Integration functionality
      function addIntegration(integrationId, integrationName) {
        showIntegrationModal(integrationId, integrationName);
      }

      function showIntegrationModal(integrationId, integrationName) {
        const modal = document.createElement('div');
        modal.className = 'fixed inset-0 bg-gray-900/50 overflow-y-auto h-full w-full z-50 transition-opacity duration-300';
        modal.id = 'integration-modal';

        modal.innerHTML = `
          <div class="relative top-20 mx-auto p-0 border-0 w-[28rem] rounded-xl bg-white overflow-hidden transform transition-all scale-100">
            <div class="p-6 text-center">
              <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-xl bg-gray-50 border border-gray-200 mb-4">
                <svg class="h-8 w-8 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
              </div>
              <h3 class="text-xl leading-6 font-bold text-gray-900 mb-2">Entegrasyon Ekle</h3>
              <div class="mt-2 px-2 py-2">
                <p class="text-sm text-gray-500 leading-relaxed">
                  <span class="font-bold text-gray-800">${integrationName}</span> entegrasyonunu hesabınıza eklemek ve yapılandırmaya başlamak istediğinizden emin misiniz?
                </p>
              </div>
            </div>
            <div class="bg-gray-50 px-6 py-4 flex gap-3">
               <button id="cancel-integration"
                      class="flex-1 px-4 py-2.5 bg-white text-gray-700 border border-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 hover:text-gray-900 transition-colors">
                Vazgeç
              </button>
              <button id="confirm-integration"
                      class="flex-1 px-4 py-2.5 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary-dark transition-colors">
                Entegrasyonu Ekle
              </button>
            </div>
          </div>
        `;

        document.body.appendChild(modal);

        // Event listeners
        document.getElementById('confirm-integration').addEventListener('click', () => {
          performAddIntegration(integrationId, integrationName);
          document.body.removeChild(modal);
        });

        document.getElementById('cancel-integration').addEventListener('click', () => {
          document.body.removeChild(modal);
        });

        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            document.body.removeChild(modal);
          }
        });
      }

      async function performAddIntegration(integrationId, integrationName) {
        try {
          // Show loading notification
          showNotification('Entegrasyon ekleniyor...', 'info');

          // Get anti-forgery token
          const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

          // Prepare integration data
          const integrationData = {
            integrationId: parseInt(integrationId)
          };

          // Make API call
          const response = await axios.post('/Integration/AddIntegration', integrationData, {
            headers: {
              'Content-Type': 'application/json',
              'RequestVerificationToken': token
            }
          });

          if (response.data.success) {
            // Show success notification
            showNotification(response.data.message, 'success');

            console.log('Integration added successfully, reloading page...');

            // Reload page to show updated integration status
            setTimeout(() => {
              window.location.reload();
            }, 1500);
          } else {
            showNotification(response.data.message, 'error');
          }

        } catch (error) {
          console.error('Integration add error:', error);
          if (error.response && error.response.data && error.response.data.message) {
            showNotification(error.response.data.message, 'error');
          } else {
            showNotification('Entegrasyon eklenirken bir hata oluştu.', 'error');
          }
        }
      }

      document.addEventListener('DOMContentLoaded', function() {
        initializeDialogs();
        attachSyncAllListener();
      });

      // Tümünü Senkronize Et butonu listener'ı
      function attachSyncAllListener() {
        const syncAllBtn = document.getElementById('sync-all-btn');
        if (syncAllBtn) {
          syncAllBtn.addEventListener('click', syncAllIntegrations);
        }
      }

      // Tüm entegrasyonları senkronize et
      async function syncAllIntegrations() {
        const syncAllBtn = document.getElementById('sync-all-btn');
        const syncButtons = document.querySelectorAll('.sync-integration-btn');

        if (syncButtons.length === 0) {
          showNotification('Senkronize edilecek entegrasyon bulunamadı.', 'warning');
          return;
        }

        // Butonu devre dışı bırak
        const originalText = syncAllBtn.innerHTML;
        syncAllBtn.disabled = true;
        syncAllBtn.innerHTML = `
          <svg class="animate-spin inline-block w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Tümü senkronize ediliyor...
        `;

        let successCount = 0;
        let failureCount = 0;
        const results = [];

        // Tüm senkronize et butonlarını sırayla çalıştır
        for (const button of syncButtons) {
          const integrationId = button.getAttribute('data-integration-id');
          const integrationName = button.getAttribute('data-integration-name');

          try {
            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!csrfToken) {
              failureCount++;
              results.push(`${integrationName}: Güvenlik token'ı bulunamadı`);
              continue;
            }

            const response = await axios.post('/Integration/SyncIntegration', {
              integrationId: parseInt(integrationId)
            }, {
              headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': csrfToken.value
              }
            });

            if (response.data.success) {
              successCount++;
              results.push(`✓ ${integrationName}: Başarılı`);
            } else {
              failureCount++;
              results.push(`✗ ${integrationName}: ${response.data.message}`);
            }
          } catch (error) {
            failureCount++;
            const errorMsg = error.response?.data?.message || error.message || 'Bilinmeyen hata';
            results.push(`✗ ${integrationName}: ${errorMsg}`);
          }

          // Kısa bir gecikme ekle (API'ye aşırı yük binmesin diye)
          await new Promise(resolve => setTimeout(resolve, 500));
        }

        // Butonu tekrar aktif et
        syncAllBtn.disabled = false;
        syncAllBtn.innerHTML = originalText;

        // Sonuçları göster
        const message = `Senkronizasyon tamamlandı. Başarılı: ${successCount}, Başarısız: ${failureCount}`;
        showNotification(message, successCount > 0 ? 'success' : 'error');

        // Sayfayı yenile (başarılı olanlar varsa)
        if (successCount > 0) {
          setTimeout(() => {
            window.location.reload();
          }, 2000);
        }
      }

      let integrationSettingsDialog = null;

      function initializeDialogs() {
        // Initialize PushDialog
        integrationSettingsDialog = new PushDialog({
          title: 'Entegrasyon Ayarları',
          size: '3xl', // Genişlik artırıldı
          scrollBehavior: 'inside', // Scroll inside the dialog content
          position: 'center', // Center on screen
          closeOnOverlayClick: true,
          content: '<div id="drawer-content"></div>'
        });

        // Settings butonlarına event listener ekle
        attachSettingsListeners();

        // Sync butonlarına event listener ekle
        attachSyncListeners();
      }

      function attachSettingsListeners() {
        const settingsButtons = document.querySelectorAll('.settings-btn');
        console.log('Found settings buttons:', settingsButtons.length);

        settingsButtons.forEach((button, index) => {
          // Remove old listeners? No easy way, but this runs once on DOM load mostly.
          // Cloning node is a trick to remove listeners but might be overkill.
          // Assuming pages doesn't reload scripts partially.
          
          button.addEventListener('click', (e) => {
            e.preventDefault();
            const integrationName = button.getAttribute('data-integration-name');
            const integrationId = button.getAttribute('data-integration-id');
            console.log('Settings button clicked:', integrationName, integrationId);
            openIntegrationSettingsDialog(integrationName, integrationId);
          });
        });
      }

      function attachSyncListeners() {
        const syncButtons = document.querySelectorAll('.sync-integration-btn');
        console.log('Found sync buttons:', syncButtons.length);

        syncButtons.forEach((button, index) => {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            const integrationId = button.getAttribute('data-integration-id');
            const integrationName = button.getAttribute('data-integration-name');
            console.log('Sync button clicked:', integrationName, integrationId);
            syncIntegration(integrationId, integrationName, button);
          });
        });
      }

      // Dialog'ı açma fonksiyonu
      async function openIntegrationSettingsDialog(integrationName, integrationId) {
        if (!integrationSettingsDialog) return;

        // Başlık ayarla
        integrationSettingsDialog.setTitle(integrationName + ' Entegrasyon Ayarları');

        // Footer'ı temizle (Yüklenirken butonlar görünmesin)
        if (typeof integrationSettingsDialog.setFooter === 'function') {
            integrationSettingsDialog.setFooter(null);
        }

        // Loading göster
        integrationSettingsDialog.setContent(`
          <div id="drawer-content">
            <div class="flex items-center justify-center py-8">
              <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
              <span class="ml-2">Ayarlar yükleniyor...</span>
            </div>
          </div>
        `);

        // Dialog'ı aç
        integrationSettingsDialog.open();

        try {
          // Entegrasyon ayarlarını yükle
          // drawer-content ID'si dialog içinde oluşturduğumuz için çalışacaktır.
          // Ancak DOM güncellenmesi için kısa bir süre beklemek gerekebilir, 
          // ama PushDialog.setContent senkron yapar, innerHTML değişir.
          await loadIntegrationSettings(integrationId, integrationName);
        } catch (error) {
          console.error('Error loading integration settings:', error);
          const drawerContent = document.getElementById('drawer-content');
          if (drawerContent) {
            drawerContent.innerHTML = `
              <div class="text-center py-8">
                <div class="text-red-500 mb-2">Ayarlar yüklenirken hata oluştu</div>
                <button onclick="closeDrawer()" class="px-4 py-2 bg-gray-500 text-white rounded-md">Kapat</button>
              </div>
            `;
          }
        }
      }

