                                      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-orange-50 text-orange-700 border border-orange-100">
                                         <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                        Eksik
                                      </span>
                                    }
                                  }
                                  else 
                                  {
                                      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-gray-100 text-gray-500 border border-gray-200">
                                         Kurulmadı
                                      </span>
                                  }
                             </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-6 flex-grow">
                            <p class="text-gray-500 text-sm leading-relaxed line-clamp-3">
                               @integration.Description
                            </p>
                            
                             @{
                                 var stats = hasIntegration && isConfigured ? companyIntegration.SyncStats : new Dictionary<string, object>();
                                 var hasSyncedProducts = stats.ContainsKey("syncedProducts");
                                 var hasSyncedOrders = stats.ContainsKey("syncedOrders");
                                 var hasSentMessages = stats.ContainsKey("sentMessages");
                                 var hasAnyStats = hasSyncedProducts || hasSyncedOrders || hasSentMessages;
                             }

                             @if (hasIntegration && isConfigured && !deactivatedByService && !string.IsNullOrEmpty(companyIntegration.SyncStatsJson) && hasAnyStats)
                             {
                                 <div class="mt-4 bg-gray-50 rounded-xl p-3 border border-gray-200">
                                    <div class="text-xs font-semibold text-gray-500 mb-2 uppercase tracking-wide">İstatistikler</div>
                                    <div class="grid grid-cols-2 gap-2">
                                      @if (hasSyncedProducts)
                                      {
                                         <div class="flex flex-col">
                                            <span class="text-[10px] text-gray-400">Ürün</span>
                                            <span class="font-semibold text-gray-900">@stats["syncedProducts"]</span>
                                         </div>
                                      }
                                      @if (hasSyncedOrders)
                                      {
                                          <div class="flex flex-col">
                                            <span class="text-[10px] text-gray-400">Sipariş</span>
                                            <span class="font-semibold text-gray-900">@stats["syncedOrders"]</span>
                                         </div>
                                      }
                                      @if (hasSentMessages)
                                      {
                                          <div class="flex flex-col">
                                            <span class="text-[10px] text-gray-400">Mesaj</span>
                                            <span class="font-semibold text-gray-900">@stats["sentMessages"]</span>
                                         </div>
                                      }
                                   </div>
                                 </div>
                             }
                        </div>

                        <!-- Actions -->
                        <div class="mt-auto pt-2">
                            <div class="flex gap-2">
                                @if (hasIntegration)
                                {
                                    <div class="w-full flex flex-col gap-3">
                                         <div class="flex items-center justify-between gap-2">
                                            <button class="flex-1 flex items-center justify-center px-4 py-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 rounded-lg transition-colors text-sm font-medium settings-btn"
                                                    data-integration-name="@integration.Name"
                                                    data-integration-id="@integration.Id">
                                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                                Ayarlar
                                            </button>
                                            
                                            @if (integration.Type == "ecommerce" && isConfigured && !deactivatedByService)
                                            {
                                                <button class="flex-1 flex items-center justify-center px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg transition-all text-sm font-medium sync-integration-btn"
                                                        data-integration-id="@integration.Id"
                                                        data-integration-name="@integration.Name">
                                                    <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path><path d="M16 21h5v-5"></path></svg>
                                                    Senkronize
                                                </button>
                                            }
                                            else if (integration.Type == "communication" && isConfigured)
                                            {
                                                if (integration.Name == "SMS")
                                                {
                                                  <a href="/SmsTemplate" class="flex-1 flex items-center justify-center px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg transition-all text-sm font-medium">Şablonlar</a>
                                                }
                                                else if (integration.Name == "WhatsApp")
                                                {
                                                  <a href="/WhatsAppTemplate" class="flex-1 flex items-center justify-center px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg transition-all text-sm font-medium">Şablonlar</a>
                                                }
                                                else if (integration.Name == "Email SMTP")
                                                {
                                                  <a href="/EmailTemplate" class="flex-1 flex items-center justify-center px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg transition-all text-sm font-medium">Şablonlar</a>
                                                }
                                            }
                                            else if (!isConfigured)
                                            {
                                                <div class="hidden"></div> <!-- Placeholder for alignment -->
                                            }
                                            else
                                            {
                                                <button class="flex-1 px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg transition-all text-sm font-medium">Test Gönder</button>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button onclick="addIntegration('@integration.Id', '@integration.Name')" class="w-full px-4 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-lg transition-all text-sm font-medium">
                                        Entegrasyonu Başlat
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                 </div>
          }
            </div>
          </div>
    }
    </div>
</main>

@functions {
  private string GetTimeAgo(DateTime dateTime)
  {
    var timeSpan = DateTime.Now - dateTime;

    if (timeSpan.TotalMinutes < 1)
      return "Az önce";
    else if (timeSpan.TotalMinutes < 60)
      return $"{(int)timeSpan.TotalMinutes} dakika önce";
    else if (timeSpan.TotalHours < 24)
      return $"{(int)timeSpan.TotalHours} saat önce";
    else
      return $"{(int)timeSpan.TotalDays} gün önce";
  }
}
