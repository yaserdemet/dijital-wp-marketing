function deleteReminderRule(id) {
    showConfirmationDialog(
        'Kuralı Sil',
        'Bu kuralı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.',
        'Evet, Sil',
        'Vazgeç',
        () => {
            fetch('/BasketReminder/Delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Id: id })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showNotification(data.message, 'success');
                    loadReminderRules();
                } else {
                    showNotification(data.message, 'error');
                }
            })
            .catch(e => {
                console.error(e);
                showNotification('Bir hata oluştu.', 'error');
            });
        }
    );
}

function toggleRuleStatus(id) {
    fetch('/BasketReminder/ToggleStatus', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ Id: id })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            showNotification(data.message, 'success');
            loadReminderRules();
        } else {
            showNotification(data.message, 'error');
        }
    })
    .catch(e => {
        console.error(e);
        showNotification('Durum güncellenirken bir hata oluştu.', 'error');
    });
}

