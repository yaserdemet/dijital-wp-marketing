});

function setupEventListeners() {
    // Sync button
    document.getElementById('syncBaskets').addEventListener('click', syncBaskets);

    // Excel export button
    document.getElementById('exportExcel').addEventListener('click', exportToExcel);

    // Filter buttons
    document.getElementById('applyFilters').addEventListener('click', applyFilters);
    document.getElementById('clearFilters').addEventListener('click', clearFilters);

    // Pagination buttons
    document.getElementById('prevPage').addEventListener('click', () => {
        if (currentPage > 1) {
            currentPage--;
            loadBaskets();
        }
    });

    document.getElementById('nextPage').addEventListener('click', () => {
        currentPage++;
        loadBaskets();
    });

    // Page size selector
    document.getElementById('pageSizeSelect').addEventListener('change', function() {
        currentPageSize = parseInt(this.value);
        currentPage = 1;
        loadBaskets();
    });

    // Enter key support for all text inputs
    const textInputs = ['searchTerm', 'customerName', 'customerEmail'];
    textInputs.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
            element.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    applyFilters();
                }
            });
        }
    });

    // Debounce helper
    let debounceTimer;
    const debounce = (callback, delay = 500) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(callback, delay);
    };

    // Debounced input for text fields (anlık filtreleme)
    textInputs.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
            element.addEventListener('input', function() {
                debounce(applyFilters, 500);
            });
        }
    });

    // Number inputs için debounced filtreleme
    const numberInputs = ['minProductCount', 'maxProductCount', 'minAmount', 'maxAmount'];
    numberInputs.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
            element.addEventListener('input', function() {
                debounce(applyFilters, 500);
            });
        }
    });

    // Tarih inputları için change event (seçim tamamlandığında filtrele)
    const dateInputs = ['dateFrom', 'dateTo'];
    dateInputs.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
            element.addEventListener('change', function() {
                applyFilters();
            });
        }
    });

    // Select değişikliklerinde anlık filtreleme
    const selectInputs = ['statusFilter', 'sortBy', 'sortDirection'];
    selectInputs.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
            element.addEventListener('change', function() {
                applyFilters();
            });
        }
    });

    setupAbandonedTimePanel();
}
// Terk edilmiş sepet süresi paneli için event listener'lar
function setupAbandonedTimePanel() {
    const settingsBtn = document.getElementById('alarmBtn');
    const panel = document.getElementById('timeBox');
    const timeButtons = document.querySelectorAll('.time-option');

    if (!settingsBtn || !panel) return;

    // Ayar butonuna tıklandığında paneli aç/kapat
    settingsBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        panel.classList.toggle('hidden');
    });

    // Panel dışına tıklandığında paneli kapat
    document.addEventListener('click', function(e) {
        if (!panel.contains(e.target) && e.target !== settingsBtn) {
            panel.classList.add('hidden');
        }
    });

    // Saat butonlarına tıklandığında
    timeButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const hours = parseInt(this.dataset.value);
            updateAbandonedTime(hours);
        });
    });
}

// Mevcut terk edilmiş sepet süresini yükle
function loadAbandonedTime() {
    fetch('/Basket/GetAbandonedTime')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                updateAbandonedTimeUI(data.data);
            }
        })
        .catch(error => {
            console.error('Error loading abandoned time:', error);
        });
}

// Terk edilmiş sepet süresini güncelle
function updateAbandonedTime(hours) {
    const panel = document.getElementById('timeBox');

    console.log('updateAbandonedTime called with hours:', hours);

    if (!hours || isNaN(hours) || hours <= 0) {
        console.error('Invalid hours value:', hours);
        showNotification('Geçersiz saat değeri', 'error');
        return;
    }

    const requestBody = JSON.stringify({ Hours: hours });
    console.log('Request body:', requestBody);

    fetch('/Basket/UpdateAbandonedTime', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
        },
        body: requestBody
    })
    .then(response => {
        console.log('Response status:', response.status);
        return response.json();
    })
    .then(data => {
        console.log('Response data:', data);
        if (data.success) {
            updateAbandonedTimeUI(hours);
            panel.classList.add('hidden');
            showNotification(data.message, 'success');
            loadBaskets();
        } else {
            showNotification('Hata: ' + data.message, 'error');
        }
    })
    .catch(error => {
        console.error('Error updating abandoned time:', error);
        showNotification('Terk edilmiş sepet süresi güncellenirken hata oluştu.', 'error');
    });
}

// UI'ı güncelle
function updateAbandonedTimeUI(hours) {
    // Saat değerini göster (eğer element varsa)
    const abandonedTimeValue = document.getElementById('abandonedTimeValue');
    if (abandonedTimeValue) {
        abandonedTimeValue.textContent = hours;
    }

    const timeButtons = document.querySelectorAll('.abandoned-time-btn');
    timeButtons.forEach(btn => {
        if (parseInt(btn.dataset.hours) === hours) {
            btn.classList.remove('border-gray-300', 'text-gray-700');
            btn.classList.add('border-primary', 'bg-primary', 'text-white');
        } else {
            btn.classList.remove('border-primary', 'bg-primary', 'text-white');
            btn.classList.add('border-gray-300', 'text-gray-700');
        }
    });

    const timeOptions = document.querySelectorAll('.time-option');
    timeOptions.forEach(opt => {
        const isSelected = parseInt(opt.dataset.value) === hours;

        if (isSelected) {
            opt.classList.remove('text-gray-700', 'hover:bg-gray-100');
            opt.classList.add('bg-primary', 'text-white');
        } else {
            opt.classList.add('text-gray-700', 'hover:bg-gray-100');
            opt.classList.remove('bg-primary', 'text-white');
        }
    });
}

function loadBaskets() {
    if (isLoading) return;

    isLoading = true;
    showLoading();

    const params = new URLSearchParams({
        page: currentPage,
        pageSize: currentPageSize,
        ...currentFilters
    });

    fetch(`/Basket/GetBaskets?${params}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                updateStats(data.data.stats);
                updateBasketsTable(data.data.baskets);
                updatePagination(data.data.pagination);
            } else {
                showNotification('Hata: ' + data.message, 'error');
                showEmptyState();
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showNotification('Sepetler yüklenirken hata oluştu.', 'error');
            showEmptyState();
        })
        .finally(() => {
            isLoading = false;
            hideLoading();
        });
}

function updateStats(stats) {
    document.getElementById('totalBaskets').textContent = stats.totalBaskets.toLocaleString();
    document.getElementById('activeBaskets').textContent = stats.activeBaskets.toLocaleString();
    document.getElementById('abandonedBaskets').textContent = stats.abandonedBaskets.toLocaleString();


    // Son senkronizasyon tarihini göster
    const lastSyncDateElement = document.getElementById('lastSyncDate');
    if (lastSyncDateElement) {
        const syncDate = stats.lastSyncDate || stats.LastSyncDate;

        if (syncDate) {
            try {
                const date = new Date(syncDate);
                if (!isNaN(date.getTime())) {
                    const formattedDate = date.toLocaleDateString('tr-TR', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                    lastSyncDateElement.textContent = formattedDate;
                } else {
                    lastSyncDateElement.textContent = 'Henüz senkronize edilmemiş';
                }
            } catch (error) {
                console.error('Date parsing error:', error);
                lastSyncDateElement.textContent = 'Henüz senkronize edilmemiş';
            }
        } else {
            lastSyncDateElement.textContent = 'Henüz senkronize edilmemiş';
        }
    }
}

