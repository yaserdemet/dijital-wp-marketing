function saveRule() {
    const selectedChannels = getSelectedChannels();
    if (selectedChannels.length === 0) {
        showNotification('En az bir iletişim kanalı seçmelisiniz.', 'warning');
        return;
    }

    // Validation
    const isWhatsAppSelected = selectedChannels.includes('WhatsApp');
    const whatsappId = document.getElementById('whatsappTemplate')?.value;
    
    const isSmsSelected = selectedChannels.includes('SMS');
    const smsId = document.getElementById('smsTemplate')?.value;
    
    const isEmailSelected = selectedChannels.includes('Email');
    const emailId = document.getElementById('emailTemplate')?.value;

    if (isWhatsAppSelected && !whatsappId) {
        showNotification('WhatsApp şablonu seçimi zorunludur.', 'warning');
        return;
    }
    if (isSmsSelected && !smsId) {
        showNotification('SMS şablonu seçimi zorunludur.', 'warning');
        return;
    }
    if (isEmailSelected && !emailId) {
        showNotification('E-posta şablonu seçimi zorunludur.', 'warning');
        return;
    }
    
    const reminderHoursValue = document.getElementById('reminderHours').value;
    if (!reminderHoursValue) {
        showNotification('Lütfen gönderim zamanı seçiniz.', 'warning');
        return;
    }

    // Build ChannelMessages
    const channelMessages = { default: "" };

    if (isWhatsAppSelected && whatsappId) {
        const t = whatsappTemplates.find(x => x.id === whatsappId);
        channelMessages.WhatsApp = {
            templateId: whatsappId,
            templateName: t ? t.name : ''
        };
    }
    if (isSmsSelected && smsId) {
        const t = smsTemplates.find(x => x.id == smsId);
        channelMessages.SMS = {
            templateId: smsId,
            templateName: t ? t.name : ''
        };
    }
    if (isEmailSelected && emailId) {
        const t = emailTemplates.find(x => x.id == emailId);
        channelMessages.Email = {
            templateId: emailId,
            templateName: t ? t.name : ''
        };
    }

    const formData = {
        id: parseInt(document.getElementById('reminderId').value),
        name: document.getElementById('reminderName').value.trim(),
        message: "",
        hours: parseInt(document.getElementById('reminderHours').value),
        isActive: document.getElementById('reminderActive').checked,
        allowResendForSentCustomers: document.getElementById('allowResendForSentCustomers').checked,
        communicationChannels: JSON.stringify(selectedChannels),
        channelMessages: JSON.stringify(channelMessages)
    };

    const url = isEditMode ? '/BasketReminder/Update' : '/BasketReminder/Create';
    const btn = document.querySelector('.push-dialog-footer button:last-child'); // Target save button if possible, or generic
    
    if (btn) BusyIndicator.show(btn, { size: 'sm' });

    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            showNotification(data.message, 'success');
            if (reminderDialog) reminderDialog.close();
            loadReminderRules();
        } else {
            showNotification(data.message.title || data.message, 'error');
        }
    })
    .catch(e => {
        console.error(e);
        showNotification('Bir hata oluştu.', 'error');
    })
    .finally(() => {
        if (btn) BusyIndicator.hide(btn);
    });
}

function loadReminderLogs() {
    // Rule loading removed from here as it is now in toggleReminderRulesSection
    
    const scheduleId = document.getElementById('reminderFilterSchedule').value;
    const status = document.getElementById('reminderFilterStatus').value;
    
    const params = new URLSearchParams({
        page: currentReminderLogsPage,
        pageSize: currentReminderLogsPageSize
    });
    
    if (scheduleId) params.append('scheduleId', scheduleId);
    if (status) params.append('status', status);

    const tbody = document.getElementById('reminderLogsTableBody');
    tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-4 text-center">Yükleniyor...</td></tr>';

    fetch(`/Basket/GetReminderLogs?${params}`)
    .then(r => r.json())
    .then(resp => {
        if (resp.success) {
            const logs = resp.data;
            hasMoreReminderLogs = resp.hasMore;
            
            if (logs.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-4 text-center text-gray-500">Kayıt bulunamadı.</td></tr>';
            } else {
                tbody.innerHTML = logs.map(l => `
                    <tr>
                         <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                             <div class="font-medium">${l.customerName || '-'}</div>
                             <div class="text-gray-500 max-w-xs truncate">${l.customerEmail}</div>
                         </td>
                         <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${l.templateName}</td>
                         <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${l.channel}</td>
                         <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${l.sentAt}</td>
                         <td class="px-6 py-4 whitespace-nowrap text-sm">
                             <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${l.status === 'Başarılı' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                                ${l.status}
                             </span>
                         </td>
                         <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate" title="${l.errorMessage || ''}">
                             ${l.errorMessage || '-'}
                         </td>
                    </tr>
                `).join('');
            }
            
            updateReminderPagination();
        }
    });
}

function changeReminderLogsPage(delta) {
    currentReminderLogsPage += delta;
    if (currentReminderLogsPage < 1) currentReminderLogsPage = 1;
    loadReminderLogs();
}

function updateReminderPagination() {
    document.getElementById('reminderLogsPageInfo').textContent = `Sayfa ${currentReminderLogsPage}`;
    document.getElementById('reminderLogsPrev').disabled = currentReminderLogsPage <= 1;
    document.getElementById('reminderLogsNext').disabled = !hasMoreReminderLogs;
}
