@model PushDashboard.ViewModels.BasketIndexViewModel
@{
    ViewData["Title"] = "Sepet Hatırlatma";
}

<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Sepet Hatırlatma</h1>
      <p class="mt-1 text-sm text-gray-500">Sepet hatırlatma kurallarını ve gönderimlerini yönetin</p>
      <div class="mt-2 text-sm text-gray-500">
        <span class="font-medium">Son Senkronizasyon:</span> <span id="lastSyncDate">-</span>
      </div>
    </div>
    <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
      <button id="sendReminderBtn" onclick="openSendReminderModal()" class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary disabled:opacity-50 disabled:cursor-not-allowed" disabled>
        <i class="fa-regular fa-paper-plane text-blue-600 mr-2"></i>
        <span class="hidden xs:inline sm:inline">Hatırlatma Gönder</span>
        <span class="xs:hidden sm:hidden">Gönder</span>
      </button>
      <button id="sendAllReminderBtn" onclick="openSendAllReminderModal()" class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
        <i class="fa-solid fa-paper-plane text-indigo-600 mr-2"></i>
        <span class="hidden xs:inline sm:inline">Tümüne Gönder</span>
        <span class="xs:hidden sm:hidden">Tümü</span>
      </button>
      <button id="exportExcel" class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
        <i class="fa-solid fa-file-excel text-green-600 mr-2"></i>
        <span class="hidden sm:inline">Excel'e Aktar</span>
        <span class="sm:hidden">Excel</span>
      </button>
      <button id="syncBaskets" class="inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
        <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span class="hidden sm:inline">Senkronize Et</span>
        <span class="sm:hidden">Senkronize</span>
      </button>
    </div>
  </div>

  <!-- Tab Navigation -->
  <div class="border-b border-gray-200 overflow-x-auto">
    <nav class="-mb-px flex space-x-4 sm:space-x-8 min-w-max" aria-label="Tabs">
      <button onclick="switchTab('basket-list')" id="tab-btn-basket-list" class="tab-btn border-primary text-primary whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
        <i class="fa-solid fa-cart-shopping mr-1 sm:mr-2"></i>Sepet Listesi
      </button>
      <button onclick="switchTab('basket-reminders')" id="tab-btn-basket-reminders" class="tab-btn border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
        <i class="fa-regular fa-paper-plane mr-1 sm:mr-2"></i>Hatırlatma Geçmişi
      </button>
    </nav>
  </div>

  <div id="tab-basket-list" class="basket-page-tab space-y-6">

  <!-- Stats Cards -->
  <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6" id="statsContainer">
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="21" r="1"></circle>
              <circle cx="19" cy="21" r="1"></circle>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Toplam Sepet</dt>
              <dd class="text-lg font-medium text-gray-900" id="totalBaskets">-</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-green-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22,4 12,14.01 9,11.01"></polyline>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Aktif Sepet</dt>
              <dd class="text-lg font-medium text-gray-900" id="activeBaskets">-</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg relative z-20">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-yellow-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Terk Edilmiş</dt>
              <dd class="text-lg font-medium text-gray-900" id="abandonedBaskets">-</dd>
            </dl>
          </div>
          <div class="relative">
              <button id="alarmBtn"
                      class="text-gray-400 hover:text-blue-600 focus:outline-none">
                  <i class="fa-regular fa-clock text-lg"></i>
              </button>

              <!-- Saat Seçici -->
              <div id="timeBox"
                   class="hidden absolute right-0 top-9 w-48 bg-white rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 z-50 overflow-hidden origin-top-right focus:outline-none">
                  <div class="px-3 py-2 border-b border-gray-100 bg-gray-50">
                      <p class="text-xs font-semibold text-gray-500 tracking-wider">Terk Süresi (Saat)</p>
                  </div>
                  <div class="p-2 grid grid-cols-3 gap-1">
                      <button class="time-option border flex items-center justify-center py-2 text-sm font-medium text-gray-700 rounded hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors" data-value="4">4</button>
                      <button class="time-option border flex items-center justify-center py-2 text-sm font-medium text-gray-700 rounded hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors" data-value="6">6</button>
                      <button class="time-option border flex items-center justify-center py-2 text-sm font-medium text-gray-700 rounded hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors" data-value="8">8</button>
                      <button class="time-option border flex items-center justify-center py-2 text-sm font-medium text-gray-700 rounded hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors" data-value="12">12</button>
                      <button class="time-option border flex items-center justify-center py-2 text-sm font-medium text-gray-700 rounded hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors" data-value="24">24</button>
                      <button class="time-option border flex items-center justify-center py-2 text-sm font-medium text-gray-700 rounded hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors" data-value="48">48</button>
                  </div>
              </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Toplam Değer Kartı (TL cinsinden - TCMB kurları ile) -->
    <div id="totalValueCard" class="bg-white overflow-hidden shadow rounded-lg cursor-pointer hover:shadow-md transition-all duration-300" onclick="toggleCurrencyPanel()">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <i class="fa-solid fa-turkish-lira-sign text-blue-400 text-2xl"></i>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate flex items-center gap-2">
                Toplam Değer (TL)
                <span id="tcmbBadge" class="hidden inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">
                  <i class="fa-solid fa-sync-alt mr-1 text-[10px]"></i>TCMB
                </span>
              </dt>
              <dd class="text-lg font-medium text-gray-900" id="totalValueTry">-</dd>
            </dl>
          </div>
          <div class="flex-shrink-0">
            <i id="currencyPanelIcon" class="fa-solid fa-chevron-down text-gray-400 text-sm transition-transform duration-300"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Para Birimi Bazlı Toplamlar - Açılır/Kapanır Panel -->
  <div id="currencyPanel" class="hidden overflow-hidden transition-all duration-300">
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-4 sm:px-6 border-b border-gray-200">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-semibold text-gray-900 flex items-center gap-2">
            <i class="fa-solid fa-coins text-yellow-500"></i>
            Para Birimi Bazlı Toplamlar
          </h3>
          <div id="rateUpdateTime" class="text-xs text-gray-500">
            <i class="fa-regular fa-clock mr-1"></i>
            <span id="rateTimeText">Kur bilgisi yükleniyor...</span>
          </div>
        </div>
      </div>
      <div class="p-4">
        <div id="currencyCardsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          <!-- Loading -->
          <div class="col-span-full text-center py-8">
            <div class="inline-flex items-center">
              <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Para birimi toplamları yükleniyor...
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reminder Rules Section -->
  <div class="bg-white shadow-[0_8px_30px_rgb(0,0,0,0.04)] rounded-2xl overflow-visible mb-10 mt-8 border border-gray-100">
    <div class="px-4 sm:px-8 py-4 sm:py-6 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white gap-4">
        <div class="flex items-center gap-3 sm:gap-5">
            <div class="h-10 w-10 sm:h-14 sm:w-14 rounded-2xl bg-[#02379c]/5 flex items-center justify-center text-[#02379c] shadow-sm ring-1 ring-[#02379c]/10 flex-shrink-0">
                <i class="fa-solid fa-wand-magic-sparkles text-lg sm:text-2xl"></i>
            </div>
            <div>
                <h3 class="text-base sm:text-xl font-bold text-gray-900 tracking-tight">Otomatik Hatırlatma Kuralları</h3>
                <p class="text-xs sm:text-sm text-gray-500 font-medium mt-0.5 sm:mt-1">Sepet terk senaryolarını ve iletişim kanallarını yönetin</p>
            </div>
        </div>
        <button onclick="openRuleDialog()" 
                class="w-full sm:w-auto group relative inline-flex items-center justify-center px-4 sm:px-6 py-2.5 sm:py-3 text-sm font-bold text-white transition-all duration-200 bg-[#02379c] rounded-xl hover:bg-[#02379c]/90 hover:shadow-lg hover:shadow-blue-900/30 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#02379c]">
            <i class="fa-solid fa-plus mr-2 transition-transform duration-200 group-hover:rotate-90"></i>
            Yeni Kural Oluştur
        </button>
    </div>
    <div class="overflow-x-auto min-h-[150px]">
        <table class="min-w-full divide-y divide-gray-100">
            <thead>
                <tr class="bg-gray-50/80">
                    <th class="px-8 py-5 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Kural Adı</th>
                    <th class="px-6 py-5 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Gönderim Zamanı</th>
                    <th class="px-6 py-5 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Aktif Kanallar</th>
                    <th class="px-6 py-5 text-center text-xs font-bold text-gray-400 uppercase tracking-wider">Durum</th>
                    <th class="px-8 py-5 text-right text-xs font-bold text-gray-400 uppercase tracking-wider">İşlemler</th>
                </tr>
            </thead>
            <tbody id="reminderRulesTableBody" class="bg-white divide-y divide-gray-100">
                <tr><td colspan="5" class="px-8 py-10 text-center text-gray-500">
                    <div class="flex flex-col items-center justify-center">
                        <i class="fa-solid fa-circle-notch fa-spin text-2xl text-[#02379c] mb-3"></i>
                        <span class="font-medium">Kurallar yükleniyor...</span>
                    </div>
                </td></tr>
            </tbody>
        </table>
    </div>
  </div>

  <!-- Filters - Collapsible Panel -->
  <div class="bg-white shadow-[0_8px_30px_rgb(0,0,0,0.04)] rounded-2xl border border-gray-100 overflow-visible mb-6">
    <!-- Filter Header - Always Visible -->
    <div class="px-6 py-5 border-b border-gray-100 cursor-pointer hover:bg-gray-50/50 transition-colors rounded-t-2xl" id="filterHeader" onclick="toggleFilterPanel()">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="h-10 w-10 bg-[#02379c]/5 rounded-xl flex items-center justify-center text-[#02379c]">
            <i class="fa-solid fa-filter"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-gray-900">Filtreler</h3>
            <p class="text-xs text-gray-500 font-medium" id="activeFilterCount">Tüm sepetler gösteriliyor</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span id="filterBadge" class="hidden inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-[#02379c] text-white shadow-sm shadow-blue-900/20">
            <span id="filterBadgeCount">0</span> filtre aktif
          </span>
          <div class="h-8 w-8 rounded-full bg-gray-50 flex items-center justify-center text-gray-400">
            <i id="filterPanelIcon" class="fa-solid fa-chevron-down text-xs transition-transform duration-300"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Content - Collapsible -->
    <div id="filterContent" class="hidden">
      <div class="px-6 py-6 space-y-6">
        <!-- Hızlı Arama -->
        <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
          <h4 class="text-sm font-bold text-gray-800 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-magnifying-glass text-[#02379c]"></i>
            Hızlı Arama
          </h4>
          <input type="text" id="searchTerm" placeholder="Müşteri adı, e-posta veya sepet ID ile ara..."
                 class="block w-full border-gray-200 rounded-xl py-2.5 shadow-sm focus:ring-2 focus:ring-[#02379c]/20 focus:border-[#02379c] sm:text-sm transition-all focus:bg-white bg-white">
        </div>

        <!-- Müşteri Bilgileri Accordion -->
        <div class="border border-gray-200 rounded-xl overflow-hidden">
          <button type="button" class="w-full px-5 py-3.5 bg-white flex items-center justify-between text-left hover:bg-gray-50 transition-colors" onclick="toggleAccordion('customerFilters')">
            <span class="font-bold text-gray-700 text-sm flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-gray-300"></span>
              Müşteri Bilgileri
            </span>
            <i id="customerFiltersIcon" class="fa-solid fa-chevron-down text-gray-400 text-xs transition-transform duration-300"></i>
          </button>
          <div id="customerFilters" class="hidden p-5 space-y-4 border-t border-gray-100 bg-gray-50/30">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="customerName" class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">İsim - Soyisim</label>
                <input type="text" id="customerName" placeholder="Müşteri adı..."
                       class="block w-full border-gray-200 rounded-xl py-2.5 shadow-sm focus:ring-2 focus:ring-[#02379c]/20 focus:border-[#02379c] sm:text-sm transition-all">
              </div>
              <div>
                <label for="customerEmail" class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">E-posta Adresi</label>
                <input type="email" id="customerEmail" placeholder="E-posta adresi..."
                       class="block w-full border-gray-200 rounded-xl py-2.5 shadow-sm focus:ring-2 focus:ring-[#02379c]/20 focus:border-[#02379c] sm:text-sm transition-all">
              </div>
            </div>
          </div>
        </div>

        <!-- Tarih Filtresi Accordion -->
        <div class="border border-gray-200 rounded-xl overflow-hidden">
          <button type="button" class="w-full px-5 py-3.5 bg-white flex items-center justify-between text-left hover:bg-gray-50 transition-colors" onclick="toggleAccordion('dateFilters')">
            <span class="font-bold text-gray-700 text-sm flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-gray-300"></span>
              Tarih Filtresi
            </span>
            <i id="dateFiltersIcon" class="fa-solid fa-chevron-down text-gray-400 text-xs transition-transform duration-300"></i>
          </button>
          <div id="dateFilters" class="hidden p-5 space-y-4 border-t border-gray-100 bg-gray-50/30">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="dateFrom" class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Başlangıç Tarihi</label>
                <input type="date" id="dateFrom"
                       class="block w-full border-gray-200 rounded-xl py-2.5 shadow-sm focus:ring-2 focus:ring-[#02379c]/20 focus:border-[#02379c] sm:text-sm transition-all text-gray-600">
              </div>
              <div>
                <label for="dateTo" class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Bitiş Tarihi</label>
                <input type="date" id="dateTo"
                       class="block w-full border-gray-200 rounded-xl py-2.5 shadow-sm focus:ring-2 focus:ring-[#02379c]/20 focus:border-[#02379c] sm:text-sm transition-all text-gray-600">
              </div>
            </div>
            <!-- Hızlı Tarih Seçimleri -->
            <div class="flex flex-wrap gap-2 pt-2">
              <button type="button" onclick="setDateRange('today')" class="px-4 py-2 text-xs font-semibold rounded-lg border border-gray-200 text-gray-600 hover:bg-[#02379c]/5 hover:text-[#02379c] hover:border-[#02379c]/30 transition-all">
                Bugün
              </button>
              <button type="button" onclick="setDateRange('yesterday')" class="px-4 py-2 text-xs font-semibold rounded-lg border border-gray-200 text-gray-600 hover:bg-[#02379c]/5 hover:text-[#02379c] hover:border-[#02379c]/30 transition-all">
                Dün
              </button>
              <button type="button" onclick="setDateRange('week')" class="px-4 py-2 text-xs font-semibold rounded-lg border border-gray-200 text-gray-600 hover:bg-[#02379c]/5 hover:text-[#02379c] hover:border-[#02379c]/30 transition-all">
                Son 7 Gün
              </button>
              <button type="button" onclick="setDateRange('month')" class="px-4 py-2 text-xs font-semibold rounded-lg border border-gray-200 text-gray-600 hover:bg-[#02379c]/5 hover:text-[#02379c] hover:border-[#02379c]/30 transition-all">
                Son 30 Gün
              </button>
              <button type="button" onclick="setDateRange('quarter')" class="px-4 py-2 text-xs font-semibold rounded-lg border border-gray-200 text-gray-600 hover:bg-[#02379c]/5 hover:text-[#02379c] hover:border-[#02379c]/30 transition-all">
                Son 3 Ay
              </button>
            </div>
          </div>
        </div>

        <!-- Sepet Detayları Accordion -->
        <div class="border border-gray-200 rounded-xl overflow-hidden">
          <button type="button" class="w-full px-5 py-3.5 bg-white flex items-center justify-between text-left hover:bg-gray-50 transition-colors" onclick="toggleAccordion('basketFilters')">
            <span class="font-bold text-gray-700 text-sm flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-gray-300"></span>
              Sepet Detayları
            </span>
            <i id="basketFiltersIcon" class="fa-solid fa-chevron-down text-gray-400 text-xs transition-transform duration-300"></i>
          </button>
          <div id="basketFilters" class="hidden p-5 space-y-4 border-t border-gray-100 bg-gray-50/30">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
              <div>
                <label for="minProductCount" class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Min Ürün</label>
                <input type="number" id="minProductCount" min="0" placeholder="0"
                       class="block w-full border-gray-200 rounded-xl py-2.5 shadow-sm focus:ring-2 focus:ring-[#02379c]/20 focus:border-[#02379c] sm:text-sm transition-all">
              </div>
              <div>
                <label for="maxProductCount" class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Max Ürün</label>
                <input type="number" id="maxProductCount" min="0" placeholder="∞"
                       class="block w-full border-gray-200 rounded-xl py-2.5 shadow-sm focus:ring-2 focus:ring-[#02379c]/20 focus:border-[#02379c] sm:text-sm transition-all">
              </div>
