        rateTimeText.textContent = `Güncellenme: ${date.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}`;
    }

    // Para birimi kartlarını TCMB verileriyle güncelle
    if (tcmbData.conversions && tcmbData.conversions.length > 0) {
        updateCurrencyCardsWithRates(tcmbData.conversions);
    }
}

// Para birimi kartlarını güncelle
function updateCurrencyCards(currencyTotals) {
    const grid = document.getElementById('currencyCardsGrid');

    // Para birimi simge ve renk eşleştirmeleri
    const currencyConfig = {
        'TRY': { icon: 'fa-turkish-lira-sign', color: 'text-blue-500', bg: 'bg-blue-50', border: 'border-blue-200', name: 'Türk Lirası' },
        'USD': { icon: 'fa-dollar-sign', color: 'text-green-500', bg: 'bg-green-50', border: 'border-green-200', name: 'Amerikan Doları' },
        'EUR': { icon: 'fa-euro-sign', color: 'text-purple-500', bg: 'bg-purple-50', border: 'border-purple-200', name: 'Euro' },
        'GBP': { icon: 'fa-sterling-sign', color: 'text-orange-500', bg: 'bg-orange-50', border: 'border-orange-200', name: 'İngiliz Sterlini' },
        'JPY': { icon: 'fa-yen-sign', color: 'text-pink-500', bg: 'bg-pink-50', border: 'border-pink-200', name: 'Japon Yeni' },
        'CHF': { icon: 'fa-franc-sign', color: 'text-cyan-500', bg: 'bg-cyan-50', border: 'border-cyan-200', name: 'İsviçre Frangı' },
        'RUB': { icon: 'fa-ruble-sign', color: 'text-red-500', bg: 'bg-red-50', border: 'border-red-200', name: 'Rus Rublesi' },
        'CNY': { icon: 'fa-yen-sign', color: 'text-yellow-600', bg: 'bg-yellow-50', border: 'border-yellow-200', name: 'Çin Yuanı' },
        'SAR': { icon: 'fa-coins', color: 'text-emerald-500', bg: 'bg-emerald-50', border: 'border-emerald-200', name: 'Suudi Riyali' },
        'AED': { icon: 'fa-coins', color: 'text-indigo-500', bg: 'bg-indigo-50', border: 'border-indigo-200', name: 'BAE Dirhemi' }
    };

    // Her zaman gösterilecek para birimleri
    const requiredCurrencies = ['TRY', 'USD', 'EUR', 'GBP'];

    // API'den gelen verileri bir map'e dönüştür
    const currencyDataMap = {};
    if (currencyTotals && currencyTotals.length > 0) {
        currencyTotals.forEach(c => {
            currencyDataMap[c.currency] = c;
        });
    }

    // Tüm para birimlerini birleştir (önce zorunlu olanlar, sonra API'den gelen diğerleri)
    const allCurrencies = [...requiredCurrencies];
    if (currencyTotals) {
        currencyTotals.forEach(c => {
            if (!allCurrencies.includes(c.currency)) {
                allCurrencies.push(c.currency);
            }
        });
    }

    const defaultConfig = { icon: 'fa-coins', color: 'text-gray-500', bg: 'bg-gray-50', border: 'border-gray-200', name: 'Diğer' };

    grid.innerHTML = allCurrencies.map((currencyCode) => {
        const config = currencyConfig[currencyCode] || defaultConfig;
        const data = currencyDataMap[currencyCode] || {
            currency: currencyCode,
            totalAmount: 0,
            basketCount: 0,
            formattedTotalAmount: '0,00'
        };

        const hasData = data.basketCount > 0;
        const opacityClass = hasData ? '' : 'opacity-60';

        return `
            <div class="${config.bg} ${config.border} border rounded-lg p-4 hover:shadow-md transition-all duration-200 ${opacityClass}" data-currency="${currencyCode}">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm">
                            <i class="fa-solid ${config.icon} ${config.color} text-lg"></i>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-gray-900">${currencyCode}</p>
                            <p class="text-xs text-gray-500">${data.basketCount || 0} sepet</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-base font-bold text-gray-900">${data.formattedTotalAmount || '0,00'}</p>
                        <p class="text-xs text-gray-400 currency-try-value" data-currency="${currencyCode}">${hasData ? '-' : ''}</p>
                    </div>
                </div>
            </div>
        `;
    }).join('');
}

// Para birimi kartlarını TCMB kurları ile güncelle
function updateCurrencyCardsWithRates(conversions) {
    conversions.forEach(conversion => {
        const tryValueElement = document.querySelector(`.currency-try-value[data-currency="${conversion.currency}"]`);
        if (tryValueElement && conversion.currency !== 'TRY' && conversion.currency !== 'TL') {
            tryValueElement.textContent = `≈ ${conversion.formattedConvertedAmount}`;
            tryValueElement.classList.remove('text-gray-400');
            tryValueElement.classList.add('text-green-600');
        } else if (tryValueElement) {
            tryValueElement.textContent = '';
        }
    });
}

function updateBasketsTable(baskets) {
    const tbody = document.getElementById('basketsTableBody');

    if (baskets.length === 0) {
        showEmptyState();
        return;
    }

    tbody.innerHTML = baskets.map(basket => {
        // Geçen süreyi hesapla
        // Handle UTC date from server (which is actually sending LOCAL TIME as UTC!)
        let dateStr = basket.basketDate;
        if (dateStr && dateStr.endsWith('Z')) {
            // Remove 'Z' to treat as LOCAL time, matching user expectation
            dateStr = dateStr.slice(0, -1);
        }
        
        const basketDate = new Date(dateStr);
        const now = new Date();
        const diffMs = now - basketDate;
        
        const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
        const diffDays = Math.floor(diffHours / 24);

        let elapsedTimeText = '';
        let elapsedTimeClass = 'text-gray-600';

        if (diffDays > 0) {
            elapsedTimeText = `${diffDays} gün ${diffHours % 24} saat`;
            elapsedTimeClass = diffDays >= 7 ? 'text-red-600 font-medium' : 'text-orange-600';
        } else if (diffHours > 0) {
            elapsedTimeText = `${diffHours} saat`;
            elapsedTimeClass = diffHours >= 24 ? 'text-orange-600' : 'text-gray-600';
        } else {
            const diffMinutes = Math.floor(diffMs / (1000 * 60));
            // Ensure we don't show negative minutes due to slight clock diffs
            const displayMinutes = Math.max(0, diffMinutes);
            elapsedTimeText = `${displayMinutes} dakika`;
            elapsedTimeClass = 'text-green-600';
        }

        // Terk edilmiş durumu
        const abandonedBadge = basket.isAbandoned
            ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 shadow-sm"><i class="fa-solid fa-clock-rotate-left mr-1"></i>Terk Edilmiş</span>'
            : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 shadow-sm"><i class="fa-solid fa-cart-shopping mr-1"></i>Aktif</span>';

        const isSelected = selectedBaskets.has(basket.id);
        
        // Profil ikonu
        const profileIcon = `<div class="h-10 w-10 rounded-full bg-[#02379c]/5 text-[#02379c] flex items-center justify-center">
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
        </div>`

        return `
        <tr class="hover:bg-gray-50 transition-colors ${basket.isAbandoned ? 'bg-red-50/20' : ''}">
            <td class="px-6 py-4 whitespace-nowrap">
                <input type="checkbox" class="basket-checkbox rounded border-gray-300 text-[#02379c] focus:ring-[#02379c] h-4 w-4" value="${basket.id}" onchange="toggleBasketSelection('${basket.id}', this)" ${isSelected ? 'checked' : ''}>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10">
                        ${profileIcon}
                    </div>
                    <div class="ml-4">
                        <div class="text-sm font-bold text-gray-900">${basket.displayCustomerName}</div>
                        <div class="text-sm text-gray-500">${basket.displayCustomerEmail}</div>
                        <div class="mt-1">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium border border-gray-200 text-gray-600 bg-gray-50 ${basket.membershipStatusBadgeClass}">
                                ${basket.membershipStatusText}
                            </span>
                        </div>
                    </div>
                </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                ${abandonedBadge}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                    <i class="fa-regular fa-clock mr-2 text-gray-400"></i>
                    <span class="text-sm font-medium ${elapsedTimeClass}">${elapsedTimeText}</span>
                </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#02379c]/10 text-[#02379c] border border-[#02379c]/20">
                        ${basket.currency}
                    </span>
                </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700">
                ${basket.productCount} Adet
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">
                ${basket.formattedTotalAmount}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                ${basket.formattedBasketDate}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <div class="flex space-x-2">
                    <button onclick="viewBasket('${basket.externalId}')" class="group p-2 rounded-lg bg-gray-50 hover:bg-[#02379c]/10 text-gray-400 hover:text-[#02379c] transition-colors" title="Detay Görüntüle">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </td>
        </tr>
    `}).join('');

    showBasketsTable();
    updateSelectAllCheckbox();
}

function updatePagination(pagination) {
    document.getElementById('recordInfo').textContent =
        `${pagination.startRecord}-${pagination.endRecord} / ${pagination.totalCount} kayıt`;
    document.getElementById('pageInfo').textContent =
        `${pagination.currentPage} / ${pagination.totalPages}`;

    document.getElementById('prevPage').disabled = !pagination.hasPrevious;
    document.getElementById('nextPage').disabled = !pagination.hasNext;
}

function applyFilters() {
    // Tüm filtre değerlerini topla
    currentFilters = {
        searchTerm: document.getElementById('searchTerm').value || '',
        status: document.getElementById('statusFilter').value || '',
        sortBy: document.getElementById('sortBy').value || 'basketdate',
        sortDirection: document.getElementById('sortDirection').value || 'desc',
        // Gelişmiş filtreler
        customerName: document.getElementById('customerName').value || '',
        customerEmail: document.getElementById('customerEmail').value || '',
        dateFrom: document.getElementById('dateFrom').value || '',
        dateTo: document.getElementById('dateTo').value || '',
        minProductCount: document.getElementById('minProductCount').value || '',
        maxProductCount: document.getElementById('maxProductCount').value || '',
        minAmount: document.getElementById('minAmount').value || '',
        maxAmount: document.getElementById('maxAmount').value || ''
    };

    // Boş değerleri temizle
    Object.keys(currentFilters).forEach(key => {
        if (!currentFilters[key]) {
            delete currentFilters[key];
        }
    });

    currentPage = 1;
    updateActiveFilterCount();
    loadBaskets();
}

function clearFilters() {
    // Tüm filtreleri temizle
    document.getElementById('searchTerm').value = '';
    document.getElementById('statusFilter').value = '';
    document.getElementById('sortBy').value = 'basketdate';
    document.getElementById('sortDirection').value = 'desc';
    document.getElementById('customerName').value = '';
    document.getElementById('customerEmail').value = '';
    document.getElementById('dateFrom').value = '';
    document.getElementById('dateTo').value = '';
    document.getElementById('minProductCount').value = '';
    document.getElementById('maxProductCount').value = '';
    document.getElementById('minAmount').value = '';
    document.getElementById('maxAmount').value = '';

    currentFilters = {};
    currentPage = 1;
    updateActiveFilterCount();
    loadBaskets();
}

function syncBaskets() {
    const button = document.getElementById('syncBaskets');

    button.disabled = true;
    BusyIndicator.show(button, { variant: 'overlay', color: 'white', size: 'sm' });

    fetch('/Basket/SyncBaskets', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showNotification(data.message, 'success');
            loadBaskets(); // Verileri yenile
            loadCurrencyTotals(); // Para birimi toplamlarını yenile
        } else {
            showNotification('Hata: ' + data.message, 'error');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showNotification('Senkronizasyon sırasında hata oluştu.', 'error');
    })
    .finally(() => {
        button.disabled = false;
        BusyIndicator.hide(button);
    });
}

// Excel'e aktar fonksiyonu
function exportToExcel() {
    const button = document.getElementById('exportExcel');

    button.disabled = true;
    BusyIndicator.show(button, { variant: 'overlay', size: 'sm' });

    // Anlık filtre değerlerini al (form elemanlarından)
    const filters = {
        searchTerm: document.getElementById('searchTerm').value || '',
        status: document.getElementById('statusFilter').value || '',
        sortBy: document.getElementById('sortBy').value || 'basketdate',
        sortDirection: document.getElementById('sortDirection').value || 'desc',
        customerName: document.getElementById('customerName').value || '',
        customerEmail: document.getElementById('customerEmail').value || '',
        dateFrom: document.getElementById('dateFrom').value || '',
        dateTo: document.getElementById('dateTo').value || '',
        minProductCount: document.getElementById('minProductCount').value || '',
        maxProductCount: document.getElementById('maxProductCount').value || '',
        minAmount: document.getElementById('minAmount').value || '',
        maxAmount: document.getElementById('maxAmount').value || ''
    };

    // Boş değerleri temizle
    const params = new URLSearchParams();
    Object.entries(filters).forEach(([key, value]) => {
        if (value) params.append(key, value);
    });

    fetch(`/Basket/ExportToExcel?${params}`)
        .then(response => {
            if (!response.ok) {
                throw new Error('Export failed');
            }
            return response.blob();
        })
        .then(blob => {
            // Dosyayı indir
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            const date = new Date().toISOString().split('T')[0];
            a.download = `Sepetler_${date}.xlsx`;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            a.remove();
            showNotification('Excel dosyası başarıyla indirildi', 'success');
        })
        .catch(error => {
            console.error('Error:', error);
            showNotification('Excel dosyası oluşturulurken hata oluştu.', 'error');
        })
        .finally(() => {
            button.disabled = false;
            BusyIndicator.hide(button);
        });
}

