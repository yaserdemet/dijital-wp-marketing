    document.getElementById('confirmSendAllBtn').textContent = 'Gönderimi Başlat';
    document.getElementById('cancelSendAllBtn').textContent = 'İptal';
    document.getElementById('sendAllCircle').style.strokeDashoffset = '326.73';
    document.getElementById('sendAllCircle').style.stroke = '';
    document.getElementById('sendAllPercentText').textContent = '0%';
    document.getElementById('sendAllStatusLabel').textContent = 'Gönderiliyor';
    document.getElementById('sendAllLiveText').textContent = 'Hatırlatmalar gönderiliyor...';
    document.getElementById('sendAllLiveText').className = 'text-sm text-gray-400 animate-pulse';
    buildSendAllFilterSummary();
    // Fetch basket count
    document.getElementById('sendAllBasketCount').textContent = '...';
    const params = new URLSearchParams(currentFilters);
    fetch(`/Basket/GetAllBasketIds?${params}`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById('sendAllBasketCount').textContent = data.totalCount.toLocaleString('tr-TR');
            } else {
                document.getElementById('sendAllBasketCount').textContent = '?';
            }
        })
        .catch(() => {
            document.getElementById('sendAllBasketCount').textContent = '?';
        });
    document.getElementById('sendAllReminderModal').classList.remove('hidden');
}

function buildSendAllFilterSummary() {
    const container = document.getElementById('sendAllFilterSummary');
    const statusLabels = { active: 'Aktif', abandoned: 'Terk Edilmiş', inactive: 'Pasif', member: 'Üyelikli', guest: 'Üyeliksiz' };
    const filters = [];

    if (currentFilters.searchTerm) filters.push({ label: 'Arama', value: currentFilters.searchTerm });
    if (currentFilters.status) filters.push({ label: 'Durum', value: statusLabels[currentFilters.status] || currentFilters.status });
    if (currentFilters.customerName) filters.push({ label: 'Müşteri Adı', value: currentFilters.customerName });
    if (currentFilters.customerEmail) filters.push({ label: 'E-posta', value: currentFilters.customerEmail });
    if (currentFilters.dateFrom) filters.push({ label: 'Başlangıç Tarihi', value: currentFilters.dateFrom });
    if (currentFilters.dateTo) filters.push({ label: 'Bitiş Tarihi', value: currentFilters.dateTo });
    if (currentFilters.minProductCount) filters.push({ label: 'Min Ürün', value: currentFilters.minProductCount });
    if (currentFilters.maxProductCount) filters.push({ label: 'Max Ürün', value: currentFilters.maxProductCount });
    if (currentFilters.minAmount) filters.push({ label: 'Min Tutar', value: currentFilters.minAmount });
    if (currentFilters.maxAmount) filters.push({ label: 'Max Tutar', value: currentFilters.maxAmount });

    if (filters.length === 0) {
        container.innerHTML = '<div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-lg border border-gray-200"><i class="fa-solid fa-filter text-gray-400 text-xs"></i><span class="text-sm text-gray-500">Filtre uygulanmadı — tüm sepetler dahil edilecek.</span></div>';
    } else {
        container.innerHTML = '<div class="px-3 py-2 bg-indigo-50 rounded-lg border border-indigo-200 space-y-2">' +
            '<div class="flex items-center gap-2 text-xs font-semibold text-indigo-700 uppercase tracking-wide"><i class="fa-solid fa-filter"></i>Uygulanan Filtreler</div>' +
            '<div class="flex flex-wrap gap-1.5">' +
            filters.map(f => `<span class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-white border border-indigo-200 text-xs"><span class="font-medium text-indigo-700">${f.label}:</span><span class="text-gray-700">${f.value}</span></span>`).join('') +
            '</div></div>';
    }
}

