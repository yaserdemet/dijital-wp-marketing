// --- Tab Management ---
function switchTab(tabId) {
    document.querySelectorAll('.basket-page-tab').forEach(el => el.classList.add('hidden'));
    document.getElementById(`tab-${tabId}`).classList.remove('hidden');

    document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('border-primary', 'text-primary');
        el.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700');
    });

    const activeBtn = document.getElementById(`tab-btn-${tabId}`);
    if (activeBtn) {
        activeBtn.classList.remove('border-transparent', 'text-gray-500', 'hover:text-gray-700');
        activeBtn.classList.add('border-primary', 'text-primary');
    }

    if (tabId === 'basket-reminders') {
        loadReminderLogs();
        loadReminderSchedules();
    }
}

// --- Checkbox Management ---
document.getElementById('selectAllBaskets')?.addEventListener('change', function(e) {
    const isChecked = e.target.checked;
    const checkboxes = document.querySelectorAll('.basket-checkbox');
    checkboxes.forEach(cb => {
        cb.checked = isChecked;
        toggleBasketSelection(cb.value, cb);
    });
});

function toggleBasketSelection(basketId, checkbox) {
    if (checkbox.checked) {
        selectedBaskets.add(basketId);
    } else {
        selectedBaskets.delete(basketId);
    }
    updateSendReminderButton();
}

function updateSelectAllCheckbox() {
    const checkboxes = Array.from(document.querySelectorAll('.basket-checkbox'));
    if (checkboxes.length > 0) {
        const allChecked = checkboxes.every(cb => cb.checked);
        const selectAll = document.getElementById('selectAllBaskets');
        if (selectAll) selectAll.checked = allChecked;
    }
    updateSendReminderButton();
}

function updateSendReminderButton() {
    const btn = document.getElementById('sendReminderBtn');
    const modalCount = document.getElementById('selectedBasketCount');
    
    if (selectedBaskets.size > 0) {
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
        btn.disabled = true;
        btn.classList.add('opacity-50', 'cursor-not-allowed');
    }
    
    if (modalCount) modalCount.textContent = selectedBaskets.size;
}

// --- Reminder Modal ---
function openSendReminderModal() {
    if (selectedBaskets.size === 0) return;
    
    // Load schedules if not loaded
    if (document.getElementById('modalScheduleSelect').options.length <= 1) {
        loadReminderSchedules();
    }
    
    document.getElementById('sendReminderModal').classList.remove('hidden');
}

function closeSendReminderModal() {
    document.getElementById('sendReminderModal').classList.add('hidden');
}

function confirmSendReminder() {
    const scheduleId = document.getElementById('modalScheduleSelect').value;
    if (!scheduleId) {
        showNotification('Lütfen bir şablon seçiniz.', 'warning');
        return;
    }

    const confirmBtn = document.getElementById('confirmSendReminderBtn');
    const cancelBtn = document.getElementById('cancelSendReminderBtn');

    confirmBtn.disabled = true;
    cancelBtn.disabled = true;
    confirmBtn.dataset.originalText = confirmBtn.textContent.trim();
    confirmBtn.innerHTML = '<span class="flex items-center justify-center"><svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Gönderiliyor...</span>';

    const basketIds = Array.from(selectedBaskets); // GUID array

    fetch('/Basket/SendReminderManual', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            // 'RequestVerificationToken': ... (if needed)
        },
        body: JSON.stringify({ basketIds, scheduleId: parseInt(scheduleId) })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            showNotification(data.message, 'success');
            closeSendReminderModal();
            selectedBaskets.clear();
            loadBaskets(); 
        } else {
            showNotification(data.message, 'error');
            if (data.errors && data.errors.length > 0) {
                 console.error(data.errors);
            }
        }
    })
    .catch(err => {
        console.error(err);
        showNotification('Bir hata oluştu.', 'error');
    })
    .finally(() => {
        confirmBtn.disabled = false;
        cancelBtn.disabled = false;
        confirmBtn.textContent = confirmBtn.dataset.originalText || 'Gönder';
    });
}

// --- Send All Reminder (Batch) ---
let sendAllCancelled = false;

function openSendAllReminderModal() {
    // Load schedules into modal select
    const modalAllSelect = document.getElementById('modalAllScheduleSelect');
    if (modalAllSelect.options.length <= 1) {
        fetch('/Basket/GetReminderSchedules')
            .then(r => r.json())
            .then(data => {
                while (modalAllSelect.options.length > 1) modalAllSelect.remove(1);
                data.forEach(s => modalAllSelect.add(new Option(s.name, s.id)));
            });
    }
    // Reset UI
    sendAllCancelled = false;
    document.getElementById('sendAllStep1').classList.remove('hidden');
    document.getElementById('sendAllStep2').classList.add('hidden');
    document.getElementById('confirmSendAllBtn').disabled = false;
