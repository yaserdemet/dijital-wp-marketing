// TL toplamını güncelle
function updateTotalValueTry(tcmbData) {
    const totalValueElement = document.getElementById('totalValueTry');
    const tcmbBadge = document.getElementById('tcmbBadge');
    const rateTimeText = document.getElementById('rateTimeText');

    if (tcmbData.formattedTotalInTry) {
        totalValueElement.textContent = tcmbData.formattedTotalInTry;
        tcmbBadge.classList.remove('hidden');
    }

    if (tcmbData.rateDate) {
