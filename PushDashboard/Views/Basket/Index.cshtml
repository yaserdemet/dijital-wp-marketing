@section Scripts {
<script>
let basketDetailDialog = null; // Dialog instance
let currentPage = 1;
let currentPageSize = 50;
let currentFilters = {};
let isLoading = false;
let isFilterPanelOpen = false;
let selectedBaskets = new Set();
let currentReminderLogsPage = 1;
let currentReminderLogsPageSize = 50;
let hasMoreReminderLogs = false;

// Filtre Panel Yönetimi
function toggleFilterPanel() {
    const content = document.getElementById('filterContent');
    const icon = document.getElementById('filterPanelIcon');

    isFilterPanelOpen = !isFilterPanelOpen;

    if (isFilterPanelOpen) {
        content.classList.remove('hidden');
        icon.classList.add('rotate-180');
    } else {
        content.classList.add('hidden');
        icon.classList.remove('rotate-180');
    }
}

// Accordion Yönetimi
function toggleAccordion(id) {
    const content = document.getElementById(id);
    const icon = document.getElementById(id + 'Icon');

    if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        icon.classList.add('rotate-180');
    } else {
        content.classList.add('hidden');
        icon.classList.remove('rotate-180');
    }
}

// Hızlı Tarih Seçimi
function setDateRange(range) {
    const dateFrom = document.getElementById('dateFrom');
    const dateTo = document.getElementById('dateTo');
    const today = new Date();

    // Bugünü formatla
    const formatDate = (date) => {
        return date.toISOString().split('T')[0];
    };

    switch(range) {
        case 'today':
            dateFrom.value = formatDate(today);
            dateTo.value = formatDate(today);
            break;
        case 'yesterday':
            const yesterday = new Date(today);
            yesterday.setDate(yesterday.getDate() - 1);
            dateFrom.value = formatDate(yesterday);
            dateTo.value = formatDate(yesterday);
            break;
        case 'week':
            const weekAgo = new Date(today);
            weekAgo.setDate(weekAgo.getDate() - 7);
            dateFrom.value = formatDate(weekAgo);
            dateTo.value = formatDate(today);
            break;
        case 'month':
            const monthAgo = new Date(today);
            monthAgo.setDate(monthAgo.getDate() - 30);
            dateFrom.value = formatDate(monthAgo);
            dateTo.value = formatDate(today);
            break;
        case 'quarter':
            const quarterAgo = new Date(today);
            quarterAgo.setDate(quarterAgo.getDate() - 90);
            dateFrom.value = formatDate(quarterAgo);
            dateTo.value = formatDate(today);
            break;
    }

    // Hızlı uygulama için filtrele
    applyFilters();
}

// Aktif Filtre Sayısını Güncelle
function updateActiveFilterCount() {
    let count = 0;
    const filters = [
        'searchTerm', 'customerName', 'customerEmail',
        'dateFrom', 'dateTo', 'minProductCount', 'maxProductCount',
        'minAmount', 'maxAmount', 'statusFilter'
    ];

    filters.forEach(id => {
        const element = document.getElementById(id);
        if (element && element.value && element.value.trim() !== '') {
            count++;
        }
    });

    const badge = document.getElementById('filterBadge');
    const badgeCount = document.getElementById('filterBadgeCount');
    const activeFilterText = document.getElementById('activeFilterCount');

    if (count > 0) {
        badge.classList.remove('hidden');
        badgeCount.textContent = count;
        activeFilterText.textContent = `${count} filtre aktif`;
    } else {
        badge.classList.add('hidden');
        activeFilterText.textContent = 'Tüm sepetler gösteriliyor';
    }
}

// Sayfa yüklendiğinde sepetleri yükle
document.addEventListener('DOMContentLoaded', function() {
    console.log('Basket Index Loaded');
    
    // Ensure default tab is visible
    const defaultTab = document.getElementById('tab-basket-list');
    if (defaultTab && defaultTab.classList.contains('hidden')) {
        defaultTab.classList.remove('hidden');
    }

    loadBaskets();
    loadReminderRules(); // Load rules initially since they are on the main page now
    loadCurrencyTotals();
    loadAbandonedTime();
