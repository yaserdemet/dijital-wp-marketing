function sendAllAddLog(message, type) {
    const logArea = document.getElementById('sendAllLogArea');
    const colorClass = type === 'success' ? 'text-green-600' : type === 'error' ? 'text-red-600' : 'text-gray-600';
    const div = document.createElement('div');
    div.className = colorClass;
    div.textContent = message;
    logArea.appendChild(div);
    logArea.scrollTop = logArea.scrollHeight;
}

function updateSendAllProgress(sent, failed, total) {
    const processed = sent + failed;
    const percent = total > 0 ? Math.round((processed / total) * 100) : 0;
    const circumference = 326.73;
    const offset = circumference - (circumference * percent / 100);

    document.getElementById('sendAllTotal').textContent = total.toLocaleString('tr-TR');
    document.getElementById('sendAllSent').textContent = sent.toLocaleString('tr-TR');
    document.getElementById('sendAllFailed').textContent = failed.toLocaleString('tr-TR');
    document.getElementById('sendAllCircle').style.strokeDashoffset = offset;
    document.getElementById('sendAllPercentText').textContent = `${percent}%`;
}

async function startSendAll() {
    const scheduleId = document.getElementById('modalAllScheduleSelect').value;
    if (!scheduleId) {
        showNotification('Lütfen bir şablon seçiniz.', 'warning');
        return;
    }

    const confirmBtn = document.getElementById('confirmSendAllBtn');
    const cancelBtn = document.getElementById('cancelSendAllBtn');
    confirmBtn.disabled = true;
    confirmBtn.innerHTML = '<span class="flex items-center justify-center"><svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Sepetler alınıyor...</span>';

    // Step 1: Get all basket IDs matching current filters
    const params = new URLSearchParams(currentFilters);
    let allBasketIds;
    try {
        const resp = await fetch(`/Basket/GetAllBasketIds?${params}`);
        const data = await resp.json();
        if (!data.success) {
            showNotification('Sepet listesi alınamadı.', 'error');
            confirmBtn.disabled = false;
            confirmBtn.textContent = 'Gönderimi Başlat';
            return;
        }
        allBasketIds = data.basketIds;
    } catch (err) {
        console.error(err);
        showNotification('Sepet listesi alınırken hata oluştu.', 'error');
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'Gönderimi Başlat';
        return;
    }

    if (allBasketIds.length === 0) {
        showNotification('Filtrelere uyan sepet bulunamadı.', 'warning');
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'Gönderimi Başlat';
        return;
    }

    // Step 2: Show progress UI
    document.getElementById('sendAllStep1').classList.add('hidden');
    document.getElementById('sendAllStep2').classList.remove('hidden');
    cancelBtn.textContent = 'İptal Et';
    cancelBtn.disabled = false;
    cancelBtn.onclick = function() {
        sendAllCancelled = true;
        cancelBtn.textContent = 'İptal ediliyor...';
        cancelBtn.disabled = true;
    };

    const BATCH_SIZE = 50;
    const totalCount = allBasketIds.length;
    const batches = [];
    for (let i = 0; i < allBasketIds.length; i += BATCH_SIZE) {
        batches.push(allBasketIds.slice(i, i + BATCH_SIZE));
    }

    let totalSent = 0;
    let totalFailed = 0;
    const totalBatches = batches.length;

    updateSendAllProgress(0, 0, totalCount);

    // Step 3: Process batches
    for (let i = 0; i < batches.length; i++) {
        if (sendAllCancelled) {
            break;
        }

        const batch = batches[i];
        const batchIndex = i + 1;

        try {
            const resp = await fetch('/Basket/SendReminderManual', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ basketIds: batch, scheduleId: parseInt(scheduleId) })
            });
            const data = await resp.json();

            if (data.success) {
                // Parse the response message to extract counts
                const successMatch = data.message.match(/(\d+) sepet için hatırlatma gönderildi/);
                const failMatch = data.message.match(/(\d+) sepet için gönderim başarısız/);
                const batchSuccess = successMatch ? parseInt(successMatch[1]) : batch.length;
                const batchFail = failMatch ? parseInt(failMatch[1]) : 0;

                totalSent += batchSuccess;
                totalFailed += batchFail;
            } else {
                totalFailed += batch.length;
            }
        } catch (err) {
            totalFailed += batch.length;
        }

        updateSendAllProgress(totalSent, totalFailed, totalCount);
    }

    // Done
    const liveText = document.getElementById('sendAllLiveText');
    const statusLabel = document.getElementById('sendAllStatusLabel');
    liveText.classList.remove('animate-pulse');

    if (sendAllCancelled) {
        liveText.textContent = `İptal edildi — ${totalSent} gönderildi, ${totalCount - totalSent - totalFailed} gönderilemedi.`;
        liveText.className = 'text-sm text-orange-500 font-medium';
        statusLabel.textContent = 'İptal Edildi';
        document.getElementById('sendAllCircle').style.stroke = '#f59e0b';
    } else if (totalFailed > 0) {
        liveText.textContent = `Tamamlandı — ${totalFailed} gönderim başarısız oldu.`;
        liveText.className = 'text-sm text-orange-500 font-medium';
        statusLabel.textContent = 'Tamamlandı';
    } else {
        liveText.textContent = 'Tüm hatırlatmalar başarıyla gönderildi!';
        liveText.className = 'text-sm text-green-600 font-medium';
        statusLabel.textContent = 'Tamamlandı';
        document.getElementById('sendAllCircle').style.stroke = '#22c55e';
    }

    showNotification(
        sendAllCancelled ? `Gönderim iptal edildi. ${totalSent} başarılı.` : `${totalSent} hatırlatma gönderildi.`,
        totalFailed > 0 || sendAllCancelled ? 'warning' : 'success'
    );

    confirmBtn.classList.add('hidden');
    cancelBtn.disabled = false;
    cancelBtn.textContent = 'Kapat';
    cancelBtn.onclick = function() {
        document.getElementById('sendAllReminderModal').classList.add('hidden');
        loadBaskets();
    };
}

