        const templateContainer = document.createElement('div');
        templateContainer.id = `template_container_${channel.name}`;
        templateContainer.className = 'mt-3 pt-3 border-t border-[#02379c]/10 hidden w-full animate-fadeIn'; // Add hidden by default
        
        let templateSelectorHtml = '';
        if (['WhatsApp', 'SMS', 'Email'].includes(channel.name)) {
            templateSelectorHtml = `
                <div class="flex flex-col gap-1.5 w-full">
                    <label for="${channel.name.toLowerCase()}Template" class="text-[10px] uppercase font-bold tracking-wider text-gray-500">
                        ${channel.displayName} Şablonu
                    </label>
                    <select id="${channel.name.toLowerCase()}Template" class="template-select block w-full pl-2 pr-8 py-1.5 text-xs text-gray-700 bg-white border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#02379c]/20 focus:border-[#02379c] transition-shadow">
                        <option value="">Şablon seçiniz...</option>
                    </select>
                </div>
            `;
        } else {
            templateSelectorHtml = `<p class="text-xs text-green-600 flex items-center"><i class="fa-solid fa-check-circle mr-1"></i>Otomatik</p>`;
        }
        
        templateContainer.innerHTML = templateSelectorHtml;

        channelWrapper.innerHTML = content;
        channelWrapper.appendChild(templateContainer);
        
        // Event Listener for visual toggle
        const checkbox = channelWrapper.querySelector('input[type="checkbox"]');
        if(checkbox) {
            checkbox.addEventListener('change', function() {
                // Update visual state of card parent
                if (this.checked) {
                    channelWrapper.classList.remove('bg-white', 'border-gray-100', 'hover:border-gray-200');
                    channelWrapper.classList.add('bg-blue-50/50', 'border-[#02379c]', 'shadow-sm');
                } else {
                    channelWrapper.classList.add('bg-white', 'border-gray-100', 'hover:border-gray-200');
                    channelWrapper.classList.remove('bg-blue-50/50', 'border-[#02379c]', 'shadow-sm');
                }
                handleChannelSelectionChange();
            });
        }
        
        container.appendChild(channelWrapper);
    });
}

function handleChannelSelectionChange() {
    const selectedChannels = getSelectedChannels();
    availableChannels.forEach(channel => {
        const container = document.getElementById(`template_container_${channel.name}`);
        if (container) {
            if (selectedChannels.includes(channel.name)) {
                container.classList.remove('hidden');
                if (channel.name === 'WhatsApp' && whatsappTemplates.length === 0) loadWhatsAppTemplates();
                if (channel.name === 'SMS' && smsTemplates.length === 0) loadSmsTemplates();
                if (channel.name === 'Email' && emailTemplates.length === 0) loadEmailTemplates();
            } else {
                container.classList.add('hidden');
            }
        }
    });

    if (selectedChannels.includes('WhatsApp')) renderWhatsAppTemplateOptions();
    if (selectedChannels.includes('SMS')) renderSmsTemplateOptions();
    if (selectedChannels.includes('Email')) renderEmailTemplateOptions();
}

function getSelectedChannels() {
    return Array.from(document.querySelectorAll('.channel-checkbox:checked')).map(cb => cb.value);
}

function setSelectedChannels(channels) {
    document.querySelectorAll('.channel-checkbox').forEach(cb => {
        cb.checked = channels.includes(cb.value);
    });
    handleChannelSelectionChange();
}

