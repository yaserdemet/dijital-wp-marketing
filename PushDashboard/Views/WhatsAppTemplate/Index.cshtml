<!-- Preview Template Modal -->
<div id="previewModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="previewModalLabel" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
        <div class="fixed inset-0 bg-gray-900/40 transition-opacity" aria-hidden="true"></div>

        <div class="relative w-full max-w-sm p-4 my-8 text-left transition-all transform bg-transparent shadow-none rounded-lg flex justify-center">
             <!-- Phone Emulator -->
            <div class="relative border-gray-800 dark:border-gray-800 bg-gray-800 border-[14px] rounded-[2.5rem] h-[600px] w-[300px]">
                <div class="w-[148px] h-[18px] bg-gray-800 top-0 rounded-b-[1rem] left-1/2 -translate-x-1/2 absolute"></div>
                <div class="h-[32px] w-[3px] bg-gray-800 absolute -left-[17px] top-[72px] rounded-l-lg"></div>
                <div class="h-[46px] w-[3px] bg-gray-800 absolute -left-[17px] top-[124px] rounded-l-lg"></div>
                <div class="h-[46px] w-[3px] bg-gray-800 absolute -left-[17px] top-[178px] rounded-l-lg"></div>
                <div class="h-[64px] w-[3px] bg-gray-800 absolute -right-[17px] top-[142px] rounded-r-lg"></div>
                <div class="rounded-[2rem] overflow-hidden w-full h-full bg-white dark:bg-gray-800 relative flex flex-col">
                     <!-- Status Bar (Fixed inside frame) -->
                    <div class="bg-[#008069] h-6 w-full flex-shrink-0"></div>
                     <!-- App Bar (Fixed inside frame) -->
                    <div class="bg-[#008069] text-white px-4 py-2 flex items-center z-10 flex-shrink-0">
                        <div class="flex items-center space-x-2">
                            <div class="w-8 h-8 bg-white bg-opacity-20 rounded-full flex items-center justify-center overflow-hidden">
                                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-sm font-semibold truncate w-32" id="previewModalName">WhatsApp Şablon</span>
                                <span class="text-[10px] text-white text-opacity-80">Online</span>
                            </div>
                        </div>
                    </div>

                    <!-- Screen Content -->
                    <div class="bg-[#e5ddd5] w-full flex-1 overflow-y-auto relative scrollbar-hide">
                        <!-- Chat Area -->
                        <div class="min-h-full flex flex-col chat-content relative">
                            <!-- Content will be injected here -->
                        </div>
                    </div>

                    <!-- Close Button Overlay -->
                    <button id="closePreviewModalBtn" class="absolute bottom-4 left-1/2 transform -translate-x-1/2 bg-gray-900 text-white rounded-full p-2 hover:bg-black focus:outline-none opacity-50 hover:opacity-100 transition-opacity z-20">
                         <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="templateModuleSelectorWrapper" class="hidden">
    <div id="templateModuleSelectorContent">
        <p class="text-sm text-gray-500 mb-4">
            Lütfen oluşturmak istediğiniz şablon için bir modül (veri kaynağı) seçin.
        </p>
        <partial name="_TemplateModuleSelector" />
    </div>
</div>

<!-- Template Analytics Modal -->
<div id="analyticsModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="analyticsModalLabel" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
        <div class="fixed inset-0 bg-gray-900/40 transition-opacity" aria-hidden="true"></div>

        <div class="relative w-full max-w-2xl p-6 my-8 text-left transition-all transform bg-white rounded-xl">
            <!-- Header -->
            <div class="flex items-center justify-between pb-4 border-b border-gray-200">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center" id="analyticsModalLabel">
                        <svg class="w-5 h-5 mr-2 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                        Şablon Analitiği
                    </h3>
                    <p class="text-sm text-gray-500 mt-1" id="analyticsTemplateName">-</p>
                </div>
                <button type="button" class="text-gray-400 hover:text-gray-600" id="closeAnalyticsModalBtn">
                    <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Date Range Selector -->
            <div class="mt-4 flex items-center gap-4">
                <div class="flex-1">
                    <label class="block text-xs font-medium text-gray-600 mb-1">Başlangıç Tarihi</label>
                    <input type="date" id="analyticsStartDate" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-primary focus:border-primary">
                </div>
                <div class="flex-1">
                    <label class="block text-xs font-medium text-gray-600 mb-1">Bitiş Tarihi</label>
                    <input type="date" id="analyticsEndDate" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-primary focus:border-primary">
                </div>
                <div class="flex-shrink-0 pt-5">
                    <button type="button" id="refreshAnalyticsBtn" class="p-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Loading State -->
            <div id="analyticsLoading" class="hidden py-12 text-center">
                <svg class="animate-spin h-8 w-8 text-primary mx-auto mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <p class="text-gray-500">Analitik verileri yükleniyor...</p>
            </div>

            <!-- Error State -->
            <div id="analyticsError" class="hidden py-8 text-center">
                <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
                    <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <p class="text-red-600 font-medium" id="analyticsErrorMessage">Hata oluştu</p>
            </div>

            <!-- Empty State -->
            <div id="analyticsEmpty" class="hidden py-8 text-center">
                <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                    <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                </div>
                <p class="text-gray-500">Bu tarih aralığında analitik verisi bulunamadı.</p>
            </div>

            <!-- Analytics Content -->
            <div id="analyticsContent" class="hidden mt-6">
                <!-- Stats Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                    <div class="bg-sky-50 rounded-lg p-4 text-center">
                        <div class="text-2xl font-semibold text-sky-700" id="statSent">0</div>
                        <div class="text-xs text-sky-700 mt-1">Gönderilen</div>
                    </div>
                    <div class="bg-emerald-50 rounded-lg p-4 text-center">
                        <div class="text-2xl font-semibold text-emerald-700" id="statDelivered">0</div>
                        <div class="text-xs text-emerald-700 mt-1">İletilen</div>
                    </div>
                    <div class="bg-violet-50 rounded-lg p-4 text-center">
                        <div class="text-2xl font-semibold text-violet-700" id="statRead">0</div>
                        <div class="text-xs text-violet-700 mt-1">Okunan</div>
                    </div>
                    <div class="bg-rose-50 rounded-lg p-4 text-center">
                        <div class="text-2xl font-semibold text-rose-700" id="statFailed">0</div>
                        <div class="text-xs text-rose-700 mt-1">Başarısız</div>
                    </div>
                </div>

                <!-- Rates -->
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-medium text-gray-700">Teslimat Oranı</span>
                            <span class="text-lg font-semibold text-emerald-700" id="rateDelivery">0%</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-emerald-400 h-2 rounded-full transition-all duration-500" id="rateDeliveryBar" style="width: 0%"></div>
                        </div>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-medium text-gray-700">Okunma Oranı</span>
                            <span class="text-lg font-semibold text-violet-700" id="rateRead">0%</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-violet-400 h-2 rounded-full transition-all duration-500" id="rateReadBar" style="width: 0%"></div>
                        </div>
                    </div>
                </div>

                <!-- Button Clicks -->
                <div id="buttonClicksSection" class="hidden">
                    <h4 class="text-sm font-medium text-gray-700 mb-3">Buton Tıklamaları</h4>
                    <div id="buttonClicksList" class="space-y-2">
                        <!-- Button stats will be inserted here -->
                    </div>
                </div>

                <!-- Conversion Tracking Section -->
                <div id="conversionSection" class="hidden mt-6">
                    <h4 class="text-sm font-medium text-gray-700 mb-3 flex items-center">
                        <svg class="w-4 h-4 mr-2 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Dönüşüm Takibi
                    </h4>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-orange-50 rounded-lg p-4 text-center">
                            <div class="text-2xl font-bold text-orange-700" id="conversionOrderCount">0</div>
                            <div class="text-xs text-orange-600 mt-1">Sipariş Sayısı</div>
                        </div>
                        <div class="bg-yellow-50 rounded-lg p-4 text-center">
                            <div class="text-2xl font-bold text-yellow-700" id="conversionRevenue">₺0</div>
                            <div class="text-xs text-yellow-600 mt-1">Toplam Ciro</div>
                        </div>
                    </div>
                    <div id="conversionOrdersList" class="mt-4 hidden">
                        <h5 class="text-xs font-medium text-gray-600 mb-2">Son Siparişler</h5>
                        <div class="max-h-32 overflow-y-auto space-y-1" id="conversionOrdersListContent">
                            <!-- Orders will be listed here -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex justify-end mt-6 pt-4 border-t border-gray-200">
                <button type="button" id="closeAnalyticsModalBtn2" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">
                    Kapat
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script src="~/js/template-module-selector.js" asp-append-version="true"></script>
    <script src="~/js/facebook-whatsapp-templates.js" asp-append-version="true"></script>
    <script src="~/js/whatsapp-templates-ui.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var refreshBtn = document.getElementById('refreshTemplatesBtn');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', function() {
                    var icon = refreshBtn.querySelector('.refresh-icon');
                    if (icon) icon.classList.add('animate-spin');
                    refreshBtn.disabled = true;
                    window.location.reload();
                });
            }
        });
    </script>
}
