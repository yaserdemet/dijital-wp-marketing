@model PushDashboard.ViewModels.WhatsAppTemplateIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "WhatsApp Şablonları";
}

<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900 tracking-tight">WhatsApp Şablonları</h1>
            <p class="text-sm text-gray-500 mt-1">WhatsApp mesaj şablonlarınızı yönetin, filtreleyin ve performanslarını izleyin.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
             <button type="button" id="refreshTemplatesBtn" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium flex items-center justify-center transition-colors duration-200 border border-gray-200" title="Şablonları yenile">
                <svg class="w-5 h-5 mr-2 refresh-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Yenile
            </button>
             <button id="createTemplateBtn" class="bg-primary hover:bg-primary-dark text-white px-4 py-2 rounded-lg text-sm font-medium flex items-center justify-center transition-colors duration-200">
                <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4" />
                </svg>
                Yeni Şablon
            </button>
        </div>
    </div>

    <!-- Conversion Tracking Info Banner -->
    <div class="mb-6 flex items-start gap-3 bg-amber-50 border border-amber-100 rounded-xl px-5 py-4">
        <div class="flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20A10 10 0 0012 2z" />
            </svg>
        </div>
        <div>
            <p class="text-sm font-semibold text-amber-800 mb-1">
                Dönüşüm ve Ciro Takibi İçin Önemli Not
            </p>
            <p class="text-sm text-amber-700 leading-relaxed">
                Gönderdiğiniz WhatsApp mesajlarından elde edilen <span class="font-semibold">satış cirolarını</span> ve <span class="font-semibold">dönüşüm oranlarını</span> doğru şekilde izleyebilmek için şablonlarınızda mutlaka <span class="font-semibold">buton (CTA) kullanmanızı</span> tavsiye ederiz.
                Buton içermeyen mesajlarda kullanıcı tıklamaları takip edilemediğinden kampanya performansınızı ve gelir verilerini analiz etmek mümkün olmayacaktır.
            </p>
        </div>
    </div>

    <!-- Tabs -->
    <div class="border-b border-gray-200 mb-6 overflow-x-auto scrollbar-hide">
        <nav class="-mb-px flex space-x-6 sm:space-x-8 min-w-max px-1" aria-label="Tabs" id="templateTabs">
            <button class="tab-btn active border-primary text-primary whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors duration-200" data-tab="my-templates">
                Şablonlarım
                <span class="ml-2 bg-primary-50 text-primary py-0.5 px-2.5 rounded-full text-xs">@Model.AllTemplates.Count</span>
            </button>
            <button class="tab-btn border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors duration-200" data-tab="template-library">
                Şablon Kütüphanesi
                 <span class="ml-2 bg-gray-100 text-gray-600 py-0.5 px-2.5 rounded-full text-xs">@Model.SampleTemplates.Count</span>
            </button>
        </nav>
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
        <!-- Sidebar Filters -->
        <div class="w-full lg:w-64 flex-shrink-0 space-y-6 hidden lg:block" id="filtersSidebar">
             <!-- Status Filters -->
            <div id="statusFilterWrapper" class="bg-white rounded-xl border border-gray-200 p-4">
                <h3 class="font-medium text-gray-900 mb-3 text-xs uppercase tracking-wider text-opacity-70">Durum</h3>
                <div class="space-y-1" id="statusFilterContainer">
                    <!-- Filters will be injected via JS -->
                    <div class="animate-pulse space-y-2">
                        <div class="h-8 bg-gray-100 rounded"></div>
                        <div class="h-8 bg-gray-100 rounded"></div>
                        <div class="h-8 bg-gray-100 rounded"></div>
                    </div>
                </div>
            </div>
            
             <!-- Category Filter -->
            <div class="bg-white rounded-xl border border-gray-200 p-4">
                <h3 class="font-medium text-gray-900 mb-3 text-xs uppercase tracking-wider text-opacity-70">Kategori</h3>
                <div class="space-y-2" id="categoryFilterContainer">
                    <!-- Dynamic Content -->
                </div>
            </div>

            <!-- Language Filter - Kept distinct but visible -->
             <div class="bg-white rounded-xl border border-gray-200 p-4">
                 <h3 class="font-medium text-gray-900 mb-2 text-xs uppercase tracking-wider text-opacity-70">Dil</h3>
                 <select id="languageFilter" class="block w-full pl-3 pr-10 py-2 text-sm border-gray-300 focus:outline-none focus:ring-primary focus:border-primary rounded-md bg-gray-50">
                     <option value="ALL">Tümü</option>
                     <option value="tr">Türkçe</option>
                     <option value="en">İngilizce</option>
                 </select>
             </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 min-w-0">
            <!-- Toolbar -->
            <div class="bg-white rounded-xl border border-gray-200 p-4 mb-6 flex flex-col sm:flex-row gap-4 justify-between items-center">
                <!-- Search -->
                <div class="relative w-full sm:w-96">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                           <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <input type="text" id="templateSearch" class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-primary focus:border-primary sm:text-sm transition-shadow duration-200" placeholder="Şablon adı, ID veya içerik ile ara">
                </div>
                
                <div class="flex items-center gap-3 w-full sm:w-auto">
                    <!-- Sort -->
                    <select id="sortSelect" class="block w-full sm:w-auto pl-3 pr-8 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md transition-shadow">
                        <option value="updated_desc">Son Güncellenen</option>
                        <option value="updated_asc">En Eski Güncellenen</option>
                        <option value="name_asc">İsim (A-Z)</option>
                        <option value="name_desc">İsim (Z-A)</option>
                    </select>

                    <!-- View Toggle -->
                    <div class="hidden sm:flex bg-gray-100 p-1 rounded-lg border border-gray-200">
                        <button id="viewGrid" class="p-1.5 rounded-md bg-white text-primary transition-all duration-200" title="Kart Görünümü">
                             <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                        </button>
                        <button id="viewList" class="p-1.5 rounded-md text-gray-500 hover:text-primary hover:bg-gray-200 transition-all duration-200" title="Liste Görünümü">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            <div id="templatesContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 transition-all duration-300">
                 <!-- Template Cards go here -->
            </div>
            
            <!-- Empty State -->
            <div id="emptyState" class="hidden bg-white rounded-xl border border-gray-200 p-12 text-center">
                <div class="text-gray-400 mb-4">
                    <svg class="w-16 h-16 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">Şablon Bulunamadı</h3>
                <p class="text-gray-600">Arama kriterlerinize uygun şablon bulunamadı.</p>
                <button id="resetFilters" class="mt-4 text-primary hover:text-primary-dark font-medium">Filtreleri Temizle</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Initial Data Injection
    window.initialTemplates = @Html.Raw(Json.Serialize(Model.AllTemplates));
    window.sampleTemplates = @Html.Raw(Json.Serialize(Model.SampleTemplates));
</script>

@* Load the main script that handles the UI interaction *@



<!-- Create Template Modal -->
<div id="templateModal" class="fixed inset-0 z-50 hidden overflow-hidden" aria-labelledby="templateModalLabel" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen p-4 text-center sm:p-0">
        <div class="fixed inset-0 bg-gray-900/40 transition-opacity" aria-hidden="true"></div>

        <div class="relative text-left transition-all transform bg-white shadow-[0_8px_30px_rgba(0,0,0,0.08)] border border-gray-200 rounded-xl flex flex-col h-[90svh] w-[95svw] max-w-7xl">
            <div class="flex items-center justify-between p-4 border-b border-gray-200 flex-shrink-0">
                <h3 class="text-lg font-semibold text-gray-900" id="templateModalLabel">
                    <svg class="w-5 h-5 inline mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <span id="templateName">WhatsApp Şablon</span>
                </h3>
                <button type="button" class="text-gray-400 hover:text-gray-600" id="closeModalBtn">
                    <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="flex-grow overflow-hidden flex flex-col">
                <!-- Create Template Form -->
                <div id="createTemplateForm" class="hidden h-full">
                    <form id="createForm" class="flex flex-col h-full">
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 p-4 overflow-y-auto flex-grow custom-scrollbar">
                            <!-- Left Column - Form Builder -->
                            <div class="lg:col-span-7 xl:col-span-8 space-y-6">

                                <!-- 1. Template Details -->
                                <div class="bg-white p-5 rounded-xl border border-gray-200">
                                    <h3 class="text-base font-medium text-gray-900 mb-4 flex items-center">
                                        <span class="flex items-center justify-center w-6 h-6 rounded-md bg-primary-50 text-primary text-xs font-medium mr-2">1</span>
                                        Şablon Bilgileri
                                    </h3>
                                    
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                        <div>
                                            <label for="createTemplateName" class="block text-sm font-medium text-gray-700 mb-1">
                                                Şablon Adı <span class="text-red-500">*</span>
                                            </label>
                                            <input type="text" id="createTemplateName" name="name"
                                                   class="w-full px-3 py-2 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block"
                                                   placeholder="ornek_sablon_adi" required>
                                            <p class="text-xs text-gray-500 mt-1">Küçük harf, rakam ve alt çizgi</p>
                                        </div>
                                        <div>
                                            <label for="createTemplateLanguage" class="block text-sm font-medium text-gray-700 mb-1">
                                                Dil <span class="text-red-500">*</span>
                                            </label>
                                            <select id="createTemplateLanguage" name="language"
                                                    class="w-full px-3 py-2 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block">
                                                <option value="tr">Türkçe (tr)</option>
                                                <option value="en">English (en)</option>
                                                <option value="en_US">English US (en_US)</option>
                                                <option value="ar">العربية (ar)</option>
                                                <option value="de">Deutsch (de)</option>
                                                <option value="es">Español (es)</option>
                                                <option value="fr">Français (fr)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Kategori <span class="text-red-500">*</span>
                                        </label>
                                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                            <label class="cursor-pointer relative group">
                                                <input type="radio" name="category" value="MARKETING" class="peer sr-only" checked>
                                                <div class="rounded-lg border border-gray-200 p-3 hover:bg-gray-50 peer-checked:border-primary peer-checked:ring-1 peer-checked:ring-primary peer-checked:bg-primary-50 transition-all flex items-center">
                                                    <div class="mr-3 p-1.5 rounded-lg bg-violet-50 text-violet-600">
                                                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <span class="block text-sm font-medium text-gray-900">Marketing</span>
                                                        <span class="text-xs text-gray-500">Pazarlama</span>
                                                    </div>
                                                </div>
                                            </label>
                                            <label class="cursor-pointer relative group">
                                                <input type="radio" name="category" value="UTILITY" class="peer sr-only">
                                                <div class="rounded-lg border border-gray-200 p-3 hover:bg-gray-50 peer-checked:border-primary peer-checked:ring-1 peer-checked:ring-primary peer-checked:bg-primary-50 transition-all flex items-center">
                                                    <div class="mr-3 p-1.5 rounded-lg bg-emerald-50 text-emerald-600">
                                                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <span class="block text-sm font-medium text-gray-900">Utility</span>
                                                        <span class="text-xs text-gray-500">İşlemsel</span>
                                                    </div>
                                                </div>
                                            </label>
                                            <label class="cursor-pointer relative group">
                                                <input type="radio" name="category" value="AUTHENTICATION" class="peer sr-only">
                                                <div class="rounded-lg border border-gray-200 p-3 hover:bg-gray-50 peer-checked:border-primary peer-checked:ring-1 peer-checked:ring-primary peer-checked:bg-primary-50 transition-all flex items-center">
                                                    <div class="mr-3 p-1.5 rounded-lg bg-amber-50 text-amber-600">
                                                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <span class="block text-sm font-medium text-gray-900">Auth</span>
                                                        <span class="text-xs text-gray-500">Doğrulama</span>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2. Header (Optional) -->
                                <div class="bg-white p-5 rounded-xl border border-gray-200">
                                    <div class="flex items-center justify-between mb-4">
                                        <h3 class="text-base font-medium text-gray-900 flex items-center">
                                            <span class="flex items-center justify-center w-6 h-6 rounded-md bg-primary-50 text-primary text-xs font-medium mr-2">2</span>
                                            Header (Opsiyonel)
                                        </h3>
                                        <select id="headerType" class="text-sm border-gray-300 rounded-md focus:border-primary focus:ring-primary px-2 py-1">
                                            <option value="NONE">Yok</option>
                                            <option value="TEXT">Metin</option>
                                            <option value="IMAGE">Görsel</option>
                                            <option value="VIDEO">Video</option>
                                            <option value="DOCUMENT">Döküman</option>
                                        </select>
                                    </div>

                                    <div id="headerConfig" class="hidden space-y-4">
                                        <div id="headerTextConfig" class="hidden">
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Header Metni</label>
                                            <input type="text" id="headerText" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary"
                                                   placeholder="Başlık metni giriniz" maxlength="60">
                                            <p class="text-xs text-gray-500 mt-1 text-right"><span id="headerTextCount">0</span>/60</p>
                                        </div>
                                        <div id="headerMediaConfig" class="hidden">
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Medya Örneği</label>
                                            
                                            <!-- URL Input -->
                                            <div class="mb-2">
                                                <input type="url" id="headerMediaUrl" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" 
                                                       placeholder="https://example.com/media.jpg">
                                            </div>

                                            <div class="relative flex py-1 items-center">
                                                <div class="flex-grow border-t border-gray-200"></div>
                                                <span class="flex-shrink-0 mx-2 text-gray-400 text-xs">VEYA</span>
                                                <div class="flex-grow border-t border-gray-200"></div>
                                            </div>

                                            <div class="flex gap-2 mt-1">
                                                <button type="button" id="uploadHeaderMediaBtn" class="flex-1 bg-gray-50 border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-100 flex items-center justify-center">
                                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                                    Medya Yükle
                                                </button>
                                            </div>
                                            <p class="text-xs text-gray-500 mt-1">Şablon onayı için bir örnek medya URL'i girin veya dosya yükleyin.</p>
                                            <div id="headerMediaPreview" class="mt-2 hidden p-2 border border-gray-200 rounded bg-gray-50 text-sm text-gray-600"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 3. Body (Required) -->
                                <div class="bg-white p-5 rounded-xl border border-gray-200">
                                    <h3 class="text-base font-medium text-gray-900 mb-4 flex items-center">
                                        <span class="flex items-center justify-center w-6 h-6 rounded-md bg-primary-50 text-primary text-xs font-medium mr-2">3</span>
                                        Mesaj İçeriği (Body) <span class="text-red-500 ml-1">*</span>
                                    </h3>
                                    
                                    <div class="relative">
                                        <div class="flex items-center space-x-1 border border-gray-300 border-b-0 rounded-t-lg bg-gray-50 p-2">
                                            <button type="button" class="format-btn p-1.5 hover:bg-gray-200 rounded text-gray-600" data-format="bold" title="Kalın">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 4h8a4 4 0 014 4 4 4 0 01-4 4H6V4zm0 8h9a4 4 0 014 4 4 4 0 01-4 4H6v-8z"></path></svg>
                                            </button>
                                            <button type="button" class="format-btn p-1.5 hover:bg-gray-200 rounded text-gray-600" data-format="italic" title="İtalik">
